<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">

<div class="vectra-home vectra-story" data-vectra-home data-vectra-story>
  {% content_for 'blocks' %}
  {% render 'vectra-contact-modal' %}
</div>

{% schema %}
{
  "name": "VECTRA Our Story",
  "class": "vectra-story-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "MEGA Navigation",
      "info": "Select the nested MEGA Nav menu from Online Store > Navigation."
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "VECTRA Our Story",
      "blocks": [
        { "type": "vectra-header" },
        { "type": "vectra-story-hero" },
        { "type": "vectra-story-ceo" },
        { "type": "vectra-story-main" },
        { "type": "vectra-story-join" },
        { "type": "vectra-footer" }
      ]
    }
  ]
}
{% endschema %}
