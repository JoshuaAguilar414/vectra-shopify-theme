{% render 'homepage-styles' %}

<div
  class="section-background hp-bg color-custom-{{ section.id }}"
  style="--hp-section-bg: {{ section.settings.background_color }};"
></div>
<div class="section section--page-width hp">
  <div class="hp-wrap" style="--hp-pad-y: {{ section.settings.padding_y }}px;">
    {%- if section.settings.heading != blank -%}
      <div class="hp-impact__intro">
        <h2 class="hp-title">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="hp-impact__split">
      <div class="hp-media hp-impact__media">
        {% render 'hp-media', image: section.settings.image, alt: section.settings.image_alt, placeholder: 'lifestyle-2' %}
      </div>
      <div>
        {%- if section.settings.subheading != blank -%}
          <p class="hp-eyebrow">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.block_heading != blank -%}
          <h3 class="hp-title">{{ section.settings.block_heading | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="hp-copy rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="hp-btn" href="{{ section.settings.button_link | default: '#' }}" style="margin-top: 22px;">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="hp-impact__stats">
        {%- for block in section.blocks -%}
          <article class="hp-stat" {{ block.shopify_attributes }}>
            <div class="hp-stat__icon">
              {%- if block.settings.icon_image != blank -%}
                {{
                  block.settings.icon_image
                  | image_url: width: 80
                  | image_tag: alt: block.settings.heading, loading: 'lazy', width: 36, height: 36
                }}
              {%- else -%}
                {% render 'hp-icon', name: block.settings.icon %}
              {%- endif -%}
            </div>
            {%- if block.settings.stat != blank -%}
              <p class="hp-stat__value">{{ block.settings.stat | escape }}</p>
            {%- endif -%}
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Homepage impact",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "globe", "label": "Globe" },
            { "value": "chart", "label": "Chart" },
            { "value": "users", "label": "People" },
            { "value": "shield", "label": "Shield" },
            { "value": "building", "label": "Building" },
            { "value": "energy", "label": "Energy" },
            { "value": "report", "label": "Report" }
          ],
          "default": "chart"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon" },
        { "type": "text", "id": "stat", "label": "Stat", "default": "30+" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Countries reached" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Unlocking sustainable value & impact" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Sustainability & responsibility" },
    { "type": "text", "id": "block_heading", "label": "Block heading", "default": "Partnering with sustainability leaders" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We help organizations turn ESG ambition into operating reality — from strategy and disclosure to climate, social impact, and governance programs that last.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn More" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    {
      "name": "Homepage impact",
      "blocks": [
        { "type": "stat", "settings": { "icon": "chart", "heading": "Comprehensive ESG Strategy" } },
        { "type": "stat", "settings": { "icon": "shield", "heading": "Regulatory Compliance" } },
        { "type": "stat", "settings": { "icon": "globe", "heading": "Climate & Nature" } },
        { "type": "stat", "settings": { "icon": "users", "heading": "Social Impact" } }
      ]
    }
  ]
}
{% endschema %}
