{% render 'homepage-styles' %}

<div
  class="section-background hp-bg color-custom-{{ section.id }}"
  style="--hp-section-bg: {{ section.settings.background_color }};"
></div>
<div class="section section--page-width hp" id="why">
  <div class="hp-wrap" style="--hp-pad-y: {{ section.settings.padding_y }}px;">
    {%- if section.settings.heading != blank -%}
      <homepage-reveal>
        {%- if section.settings.heading contains 'Positive' or section.settings.heading contains 'positive' -%}
          <h2 class="hp-title hp-impact__head">
            Enabling P<span class="hp-impact__o" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                <path d="M16 5.2a10.8 10.8 0 0 1 9.4 5.6l1.9-3.2.9 8.2-7.6-2.4 2.2-1.8A8.4 8.4 0 0 0 16 7.6V5.2Z" fill="currentColor"/>
                <path d="M25.2 20.4A10.8 10.8 0 0 1 16 26.8v2.4a13.2 13.2 0 0 0 11.2-6.4l2 1.4-2.4-7.6-3.4 5.8 1.8 2Z" fill="currentColor"/>
                <path d="M8.2 22.6A10.8 10.8 0 0 1 7.4 11l-3.4.6L9.6 5.8l2.2 7.6-2.6-1.2A8.4 8.4 0 0 0 8.6 21l1.8 1.8-2.2-.2Z" fill="currentColor"/>
              </svg>
            </span>sitive Business Impact
          </h2>
        {%- else -%}
          <h2 class="hp-title hp-impact__head">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </homepage-reveal>
    {%- endif -%}

    <div class="hp-impact__feature">
      <homepage-reveal data-from="left">
        <div class="hp-impact__media">
          {% render 'hp-media', image: section.settings.image, asset: 'hp-why.png', alt: section.settings.feature_heading, placeholder: 'lifestyle-2' %}
        </div>
      </homepage-reveal>
      <homepage-reveal data-from="right" data-delay="2">
        <div class="hp-impact__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="hp-eyebrow hp-impact__eyebrow">
              <img class="hp-impact__rule hp-impact__rule--left" src="{{ 'hp-label-left.svg' | asset_url }}" alt="" width="20" height="8">
              {{ section.settings.eyebrow | escape }}
              <img class="hp-impact__rule" src="{{ 'hp-label-right.svg' | asset_url }}" alt="" width="20" height="8">
            </p>
          {%- endif -%}
          {%- if section.settings.feature_heading != blank -%}
            <h3 class="hp-title">{{ section.settings.feature_heading | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="hp-copy">{{ section.settings.text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a class="hp-btn" href="{{ section.settings.button_link | default: '#' }}">
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </homepage-reveal>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="hp-impact__stats">
        {%- for block in section.blocks -%}
          {%- liquid
            assign icon_asset = block.settings.icon_asset
            if icon_asset == blank
              assign icon_asset = 'hp-pillar-' | append: forloop.index | append: '.svg'
            endif
          -%}
          <homepage-reveal data-from="up" data-delay="{{ forloop.index }}">
            <article class="hp-impact__stat" {{ block.shopify_attributes }}>
              <div class="hp-impact__icon">
                {% render 'hp-asset-icon', name: icon_asset, alt: block.settings.heading %}
              </div>
              {%- if block.settings.stat != blank -%}
                <p class="hp-impact__value" data-hp-count="{{ block.settings.stat | escape }}">{{ block.settings.stat | escape }}</p>
              {%- endif -%}
              <h3>{{ block.settings.heading | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </article>
          </homepage-reveal>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Homepage impact",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "pillar",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "icon_asset",
          "label": "Icon asset filename",
          "default": "hp-pillar-1.svg"
        },
        { "type": "text", "id": "stat", "label": "Stat", "default": "50+" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Projects worldwide" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Enabling global business impact."
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "Feature heading",
      "default": "Sustainability with accountability. Built for impact that lasts."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We combine human expertise, an ecosystem of specialists, AI-enabled intelligence, and structured execution—then stay accountable for the outcomes that matter."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "cases_label", "label": "Secondary button" },
    { "type": "url", "id": "cases_link", "label": "Secondary button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    {
      "name": "Homepage impact",
      "blocks": [
        { "type": "pillar", "settings": { "icon_asset": "hp-pillar-1.svg", "stat": "50+", "heading": "Projects worldwide" } },
        { "type": "pillar", "settings": { "icon_asset": "hp-pillar-2.svg", "stat": "25+", "heading": "Countries" } },
        { "type": "pillar", "settings": { "icon_asset": "hp-pillar-3.svg", "stat": "15+", "heading": "Years of experience" } },
        { "type": "pillar", "settings": { "icon_asset": "hp-pillar-4.svg", "stat": "500+", "heading": "Clients served" } }
      ]
    }
  ]
}
{% endschema %}
