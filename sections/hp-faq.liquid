<div
  class="section-background hp-bg color-custom-{{ section.id }}"
  style="--hp-section-bg: {{ section.settings.background_color }};"
></div>
<div class="section section--full-width hp" id="faq">
  <div class="hp-wrap" style="--hp-pad-y: {{ section.settings.padding_y }}px;">
    <homepage-reveal>
      <div class="hp-faq">
      <img class="hp-faq__deco" src="{{ 'hp-faq-deco.svg' | asset_url }}" alt="" width="120" height="120" aria-hidden="true">
      <aside class="hp-contact-card">
        <img class="hp-contact-card__shape" src="{{ 'hp-faq-shape.svg' | asset_url }}" alt="" width="80" height="80" aria-hidden="true">
        <p class="hp-eyebrow" style="color: #fff;">{{ section.settings.contact_heading | escape }}</p>
        {%- if section.settings.contact_text != blank -%}
          <h2>{{ section.settings.contact_text | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.support_text != blank -%}
          <p class="hp-contact-card__text">{{ section.settings.support_text | escape }}</p>
        {%- endif -%}
        <dl>
          {%- if section.settings.email != blank -%}
            <div>
              <dt>
                <img src="{{ 'hp-icon-email.svg' | asset_url }}" alt="" width="20" height="20" aria-hidden="true">
                Have a question
              </dt>
              <dd><a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a></dd>
            </div>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <div>
              <dt>
                <img src="{{ 'hp-icon-phone.svg' | asset_url }}" alt="" width="20" height="20" aria-hidden="true">
                Give Us A Call
              </dt>
              <dd><a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone | escape }}</a></dd>
            </div>
          {%- endif -%}
          {%- if section.settings.address != blank -%}
            <div>
              <dt>
                <img src="{{ 'hp-icon-pin.svg' | asset_url }}" alt="" width="20" height="20" aria-hidden="true">
                Our Address
              </dt>
              <dd>{{ section.settings.address | escape | newline_to_br }}</dd>
            </div>
          {%- endif -%}
        </dl>
        {%- if section.settings.button_label != blank -%}
          <a class="hp-btn hp-btn--light" href="{{ section.settings.button_link | default: '#contact' }}">
            {{ section.settings.button_label | escape }}
            <img src="{{ 'hp-arrow-green.svg' | asset_url }}" alt="" width="16" height="9" aria-hidden="true">
          </a>
        {%- endif -%}
      </aside>

      <div>
        <p class="hp-eyebrow">{{ section.settings.faq_eyebrow | escape }}</p>
        {%- if section.settings.heading != blank -%}
          <h2 class="hp-title" style="margin-bottom: 10px;">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.faq_intro != blank -%}
          <p class="hp-copy" style="margin-bottom: 22px;">{{ section.settings.faq_intro | escape }}</p>
        {%- endif -%}
        <div class="hp-acc">
          {%- for block in section.blocks -%}
            <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>
                {{ block.settings.question | escape }}
                <img class="hp-acc__icon" src="{{ 'hp-acc-open.svg' | asset_url }}" alt="" width="12" height="8" aria-hidden="true">
              </summary>
              <div class="hp-acc__body">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
      </div>
    </homepage-reveal>
  </div>
</div>

{% schema %}
{
  "name": "Homepage FAQ",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do we get started with Vectra?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Share your current priorities and we’ll match you with a specialist who can scope a practical next step.</p>"
        }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "faq_eyebrow", "label": "FAQ eyebrow", "default": "Our FAQ" },
    { "type": "text", "id": "heading", "label": "FAQ heading", "default": "Frequently Asked Questions" },
    {
      "type": "textarea",
      "id": "faq_intro",
      "label": "FAQ intro",
      "default": "Answers to common questions about working with VECTRA."
    },
    { "type": "text", "id": "contact_heading", "label": "Contact eyebrow", "default": "You Have Different" },
    { "type": "textarea", "id": "contact_text", "label": "Contact heading", "default": "Questions?" },
    {
      "type": "textarea",
      "id": "support_text",
      "label": "Support text",
      "default": "Reach our team directly — we’ll help you find the right next step."
    },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+32 495 239088" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@vectra-intl.com" },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Chaussée de Wavre 1517B\n1160 Brussels, Belgium"
    },
    { "type": "text", "id": "button_label", "label": "Contact button", "default": "Contact Us" },
    { "type": "url", "id": "button_link", "label": "Contact button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    {
      "name": "Homepage FAQ",
      "blocks": [
        { "type": "item", "settings": { "question": "What are the different types of trading?" } },
        { "type": "item", "settings": { "question": "What is the difference between trading and investing?" } },
        { "type": "item", "settings": { "question": "How do I protect my trading account?" } },
        { "type": "item", "settings": { "question": "How do I deposit money into my trading account?" } }
      ]
    }
  ]
}
{% endschema %}
