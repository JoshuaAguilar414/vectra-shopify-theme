{% render 'homepage-styles' %}

<div
  class="section-background hp-bg color-custom-{{ section.id }}"
  style="--hp-section-bg: {{ section.settings.background_color }};"
></div>
<div class="section section--page-width hp" id="marketplace">
  <div class="hp-wrap" style="--hp-pad-y: {{ section.settings.padding_y }}px;">
    <div class="hp-market__head">
      <h2 class="hp-title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="hp-eyebrow">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <homepage-filters>
      <div class="hp-filters">
        <label class="hp-filters__search">
          <img src="{{ 'hp-search.svg' | asset_url }}" alt="" width="16" height="16" aria-hidden="true">
          <input
            class="hp-field"
            type="search"
            data-hp-search
            placeholder="{{ section.settings.search_placeholder | escape }}"
            aria-label="{{ section.settings.search_placeholder | escape }}"
          >
        </label>
        {%- for block in section.blocks -%}
          {%- if block.type == 'filter' -%}
            <div class="hp-filters__select">
              <select class="hp-field" data-hp-filter="{{ block.settings.key | handle }}" {{ block.shopify_attributes }}>
                <option value="">{{ block.settings.label | escape }}</option>
                {%- assign options = block.settings.options | split: ',' -%}
                {%- for option in options -%}
                  {%- assign option_value = option | strip -%}
                  <option value="{{ option_value | handle }}">{{ option_value | escape }}</option>
                {%- endfor -%}
              </select>
              <img class="hp-filters__caret" src="{{ 'hp-filter-caret.svg' | asset_url }}" alt="" width="12" height="8" aria-hidden="true">
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="hp-courses">
        {%- assign course_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'course' -%}
            {%- assign course_index = course_index | plus: 1 -%}
            {%- liquid
              assign media_asset = block.settings.asset
              if media_asset == blank
                assign media_asset = 'hp-course-' | append: course_index | append: '.png'
              endif
            -%}
            <article
              class="hp-course"
              data-hp-card
              data-search="{{ block.settings.title | escape }} {{ block.settings.excerpt | escape }}"
              data-regulation="{{ block.settings.regulation | handle }}"
              data-stage="{{ block.settings.stage | handle }}"
              data-role="{{ block.settings.role | handle }}"
              {{ block.shopify_attributes }}
            >
              <div class="hp-media hp-course__media">
                {% render 'hp-media', image: block.settings.image, asset: media_asset, alt: block.settings.title, placeholder: 'collection-2' %}
              </div>
              {%- if block.settings.badge != blank -%}
                <p class="hp-course__badge">{{ block.settings.badge | escape }}</p>
              {%- endif -%}
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.excerpt != blank -%}
                <p>{{ block.settings.excerpt | escape }}</p>
              {%- endif -%}
              <div class="hp-course__meta">
                {%- if block.settings.price != blank -%}
                  <strong>{{ block.settings.price | escape }}</strong>
                {%- endif -%}
                <a class="hp-course__cta" href="{{ block.settings.link | default: '#' }}">
                  {{ block.settings.button_label | default: 'Access this course' | escape }}
                </a>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </homepage-filters>
  </div>
</div>

{% schema %}
{
  "name": "Homepage marketplace",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [
    {
      "type": "filter",
      "name": "Filter",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Regulation" },
        { "type": "text", "id": "key", "label": "Data key", "default": "regulation" },
        { "type": "textarea", "id": "options", "label": "Options (comma separated)", "default": "CSRD, CSDDD, GRI" }
      ]
    },
    {
      "type": "course",
      "name": "Course",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Fallback theme asset", "default": "hp-course-1.png" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Certificate Course" },
        { "type": "text", "id": "title", "label": "Title", "default": "Acronyms Used in ESG Area" },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt",
          "default": "This course decodes the ESG framework into actionable business tools."
        },
        { "type": "text", "id": "price", "label": "Price", "default": "$20.00" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Access this course" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "regulation", "label": "Regulation tag", "default": "CSRD" },
        { "type": "text", "id": "stage", "label": "Stage tag", "default": "Foundation" },
        { "type": "text", "id": "role", "label": "Role tag", "default": "Practitioner" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don’t Know Where To Start?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Search courses, assessments and bundles." },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search courses, assessments and bundles"
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f4f6f8" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    {
      "name": "Homepage marketplace",
      "blocks": [
        { "type": "filter", "settings": { "label": "Regulation", "key": "regulation", "options": "CSRD, CSDDD, GRI" } },
        { "type": "filter", "settings": { "label": "Stage", "key": "stage", "options": "Foundation, Advanced" } },
        { "type": "filter", "settings": { "label": "Role", "key": "role", "options": "Practitioner, Leader" } },
        {
          "type": "course",
          "settings": {
            "title": "Acronyms Used in ESG Area",
            "excerpt": "This course decodes the ESG framework, transforming alphabet-soup acronyms into actionable business tools.",
            "price": "$20.00"
          }
        },
        {
          "type": "course",
          "settings": {
            "title": "Preventative and Corrective Measures",
            "excerpt": "A dual approach using preventative measures as a proactive shield and corrective measures as a surgical fix.",
            "price": "$20.00"
          }
        },
        {
          "type": "course",
          "settings": {
            "title": "Optimizing Purchasing Practices",
            "excerpt": "Essential strategies for enhancing procurement and building stronger supplier relationships.",
            "price": "$20.00"
          }
        },
        {
          "type": "course",
          "settings": {
            "title": "Disability Accommodation Training",
            "excerpt": "Legal frameworks and practical strategies for tailoring accommodations to individual needs.",
            "price": "$20.00"
          }
        }
      ]
    }
  ]
}
{% endschema %}
