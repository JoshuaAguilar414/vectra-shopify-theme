<div
  class="section-background hp-bg color-custom-{{ section.id }}"
  style="--hp-section-bg: {{ section.settings.background_color }};"
></div>
<div class="section section--full-width hp hp--navy" id="partners">
  <homepage-particles class="hp-particles hp-particles--dark" data-mode="dark">
    <div class="hp-wrap hp-partners" style="--hp-pad-y: {{ section.settings.padding_y }}px;">
      <homepage-reveal>
        <div class="hp-partners__intro">
          {%- if section.settings.heading != blank -%}
            <h2 class="hp-title">{{ section.settings.heading | escape | newline_to_br }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="hp-copy">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      </homepage-reveal>

      <div class="hp-partners__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign logo_asset = block.settings.asset
            if logo_asset == blank
              case forloop.index
                when 1
                  assign logo_asset = 'hp-partner-otto.png'
                when 2
                  assign logo_asset = 'hp-partner-crh.png'
                else
                  assign logo_asset = 'hp-partner-kodak.png'
              endcase
            endif
          -%}
          <homepage-reveal data-from="up" data-delay="{{ forloop.index }}">
            <a class="hp-partner" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                {{
                  block.settings.logo
                  | image_url: width: 400
                  | image_tag: alt: block.settings.name, loading: 'lazy'
                }}
              {%- else -%}
                <img src="{{ logo_asset | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="200" height="80">
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <strong>{{ block.settings.name | escape }}</strong>
              {%- endif -%}
              {%- if block.settings.industry != blank -%}
                <span>{{ block.settings.industry | escape }}</span>
              {%- endif -%}
            </a>
          </homepage-reveal>
        {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <homepage-reveal data-delay="2">
          <div class="hp-partners__cta">
            <a class="hp-btn" href="{{ section.settings.button_link | default: '#' }}">
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        </homepage-reveal>
      {%- endif -%}
    </div>
  </homepage-particles>
</div>

{% schema %}
{
  "name": "Homepage partners",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 9,
  "blocks": [
    {
      "type": "partner",
      "name": "Partner",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "asset", "label": "Fallback theme asset", "default": "hp-partner-otto.png" },
        { "type": "text", "id": "name", "label": "Name", "default": "Partner" },
        { "type": "text", "id": "industry", "label": "Location / label", "default": "Hamburg, Germany" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you need to ensure your supply chain transparency."
    },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Expand solutions" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#00263d" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    {
      "name": "Homepage partners",
      "blocks": [
        { "type": "partner", "settings": { "asset": "hp-partner-otto.png", "name": "OTTO Group", "industry": "Hamburg, Germany" } },
        { "type": "partner", "settings": { "asset": "hp-partner-crh.png", "name": "CRH", "industry": "Hamburg, Germany" } },
        { "type": "partner", "settings": { "asset": "hp-partner-kodak.png", "name": "Kodak", "industry": "Hamburg, Germany" } }
      ]
    }
  ]
}
{% endschema %}
