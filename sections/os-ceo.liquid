<div class="section-background hp-bg" style="--hp-section-bg: {{ section.settings.background_color }};"></div>
<div class="section section--full-width hp os-ceo" id="founder">
  <div class="os-ceo__inner">
    <homepage-reveal data-from="left">
      <div class="os-ceo__media">
        <div class="os-ceo__photos">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag: class: 'os-ceo__photo os-ceo__photo--main', alt: section.settings.name, loading: 'lazy'
            }}
          {%- else -%}
            <img
              class="os-ceo__photo os-ceo__photo--main"
              src="{{ 'os-ceo-1.png' | asset_url }}"
              alt="{{ section.settings.name | escape }}"
              width="740"
              height="740"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="os-ceo__name">
          <span>{{ section.settings.name | escape }}</span>
        </div>
      </div>
    </homepage-reveal>

    <homepage-reveal data-from="right" data-delay="2">
      <div class="os-ceo__copy">
        <img
          class="os-ceo__mark"
          src="{{ 'hp-positive-icon.png' | asset_url }}"
          alt=""
          width="737"
          height="743"
          loading="lazy"
        >
        {%- if section.settings.eyebrow != blank -%}
          <p class="os-ceo__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.quote != blank -%}
          <div class="os-ceo__quote">{{ section.settings.quote }}</div>
        {%- endif -%}
      </div>
    </homepage-reveal>
  </div>
</div>

{% schema %}
{
  "name": "Our Story CEO",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Meet the Founder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Message from Our CEO" },
    { "type": "text", "id": "name", "label": "Name", "default": "Patrick Neyts" },
    { "type": "image_picker", "id": "image", "label": "Portrait" },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote",
      "default": "<p>Most organizations don’t struggle because of a lack of data, they struggle when performance, priorities, and execution are not fully aligned.</p><p>At VECTRA International, we provide end-to-end business solutions with relentless customer focus, helping organizations, from global enterprises to micro businesses, improve performance, strengthen decision-making, and deliver consistent results.</p><p>We believe business is a force for good when better performance leads to better outcomes for your organization, your customers, people, and society.</p>"
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Our Story CEO" }]
}
{% endschema %}
