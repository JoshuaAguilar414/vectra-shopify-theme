{% comment %}
  VECTRA “How it works” section
{% endcomment %}

<section
  id="VectraHowItWorks-{{ section.id }}"
  class="vectra-how-it-works"
  aria-labelledby="VectraHowItWorksHeading-{{ section.id }}"
>
  <div class="vectra-how-it-works__shell">
    <header class="vectra-how-it-works__header">
      {% if section.settings.eyebrow != blank %}
        <p class="vectra-how-it-works__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 id="VectraHowItWorksHeading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="vectra-how-it-works__body">{{ section.settings.body }}</div>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div class="vectra-how-it-works__steps" role="list" aria-label="Assessment benefits">
        {% for block in section.blocks %}
          <article class="vectra-how-it-works__card" role="listitem" {{ block.shopify_attributes }}>
            <div class="vectra-how-it-works__icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'pathway' %}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <circle cx="7" cy="7" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
                    <circle cx="17" cy="7" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
                    <circle cx="7" cy="17" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M9.5 7h5M7 9.5v5M9.5 17h3.2c2.4 0 4.3-1.9 4.3-4.3V9.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/>
                  </svg>

                {% when 'arrow' %}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M5 12h13M13 6.8 18.2 12 13 17.2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                  </svg>

                {% when 'search' %}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <circle cx="10.5" cy="10.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
                    <path d="m14.7 14.7 4.3 4.3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/>
                  </svg>

                {% when 'document' %}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M7 3.8h7l4 4v12.4H7z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7"/>
                    <path d="M14 3.8v4h4M10 12h5M10 15.5h5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/>
                  </svg>

                {% when 'supplier_risk' %}
                  <svg viewBox="0 0 24 24" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="10" cy="10" r="6"/>
                    <path d="m14.5 14.5 5 5M10 7v3.5M10 13h.01"/>
                  </svg>

                {% when 'due_diligence' %}
                  <svg viewBox="0 0 24 24" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3 4.5 6v5c0 4.5 3 7.8 7.5 10 4.5-2.2 7.5-5.5 7.5-10V6L12 3Z"/>
                    <path d="m8.5 11.5 2.3 2.3 4.7-4.7"/>
                  </svg>

                {% when 'visibility' %}
                  <svg viewBox="0 0 24 24" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>

                {% when 'monitoring' %}
                  <svg viewBox="0 0 24 24" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="13" rx="2"/>
                    <path d="M8 21h8M12 17v4M6 11h3l2-4 3 7 2-3h2"/>
                  </svg>

                {% when 'residual_risk' %}
                  <svg viewBox="0 0 24 24" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3 9 17H3L12 3ZM12 9v5M12 17h.01"/>
                  </svg>

                {% else %}
                  <svg viewBox="0 0 24 24" focusable="false">
                    <rect x="6" y="5" width="12" height="15" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M9.5 5V3.8h5V5M9.2 12.2l1.7 1.7 3.9-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                  </svg>
              {% endcase %}
            </div>

            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading | escape }}</h3>
            {% endif %}

            {% if block.settings.body != blank %}
              <div class="vectra-how-it-works__card-copy">{{ block.settings.body }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #VectraHowItWorks-{{ section.id }} {
    --vhiw-background: {{ section.settings.background_color }};
    --vhiw-card: {{ section.settings.card_color }};
    --vhiw-navy: {{ section.settings.heading_color }};
    --vhiw-green: {{ section.settings.accent_color }};
    --vhiw-body: {{ section.settings.body_color }};
    --vhiw-border: {{ section.settings.border_color }};
    position: relative;
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    background: var(--vhiw-background);
    color: var(--vhiw-navy);
    font-family: 'Poppins', var(--font-body-family, Arial, sans-serif);
  }

  #VectraHowItWorks-{{ section.id }} *,
  #VectraHowItWorks-{{ section.id }} *::before,
  #VectraHowItWorks-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__shell {
    width: min({{ section.settings.content_width }}px, 100%);
    margin-inline: auto;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__header {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__eyebrow {
    margin: 0 0 20px;
    color: var(--vhiw-green);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__header h2 {
    max-width: 760px;
    margin: 0 auto;
    color: var(--vhiw-navy);
    font-size: clamp(38px, 5vw, {{ section.settings.heading_size }}px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -.052em;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__body {
    max-width: 780px;
    margin: 24px auto 0;
    color: var(--vhiw-body);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__body p,
  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__card-copy p {
    margin: 0;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__steps {
    --vhiw-columns: {{ section.blocks.size | at_most: 5 | at_least: 1 }};
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: {{ section.settings.card_gap }}px;
    margin-top: {{ section.settings.cards_margin_top }}px;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__card {
    position: relative;
    isolation: isolate;
    flex: 0 0 calc((100% - (var(--vhiw-columns) - 1) * {{ section.settings.card_gap }}px) / var(--vhiw-columns));
    min-width: 0;
    min-height: {{ section.settings.card_height }}px;
    overflow: hidden;
    padding: 28px 20px;
    border: 1px solid var(--vhiw-border);
    border-radius: {{ section.settings.card_radius }}px;
    background: var(--vhiw-card);
    text-align: left;
    overflow-wrap: anywhere;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20px;
    width: 36px;
    height: 3px;
    background: var(--vhiw-green);
    border-radius: 0 0 3px 3px;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 24px;
    border-radius: 14px;
    background: var(--vhiw-navy);
    color: var(--vhiw-green);
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__icon svg {
    width: 24px;
    height: 24px;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__card h3 {
    margin: 0;
    color: var(--vhiw-navy);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -.025em;
    text-wrap: pretty;
  }

  #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__card-copy {
    margin-top: 14px;
    color: var(--vhiw-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.65;
  }

  @media screen and (max-width: 989px) {
    #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__steps {
      --vhiw-columns: {{ section.blocks.size | at_most: 2 | at_least: 1 }};
      max-width: 720px;
      margin-inline: auto;
    }

    #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__card {
      min-height: 0;
      padding: 28px 24px;
    }

    #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__card::before {
      left: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    #VectraHowItWorks-{{ section.id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__eyebrow {
      margin-bottom: 15px;
    }

    #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__body {
      margin-top: 18px;
      font-size: 14px;
    }

    #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__steps {
      --vhiw-columns: 1;
      margin-top: 40px;
    }

    #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__card h3 {
      font-size: 18px;
    }

    #VectraHowItWorks-{{ section.id }} .vectra-how-it-works__card-copy {
      font-size: 14px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "VECTRA how it works",
  "tag": "section",
  "class": "section-vectra-how-it-works",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Turn Assessment Findings Into Clear Supply Chain Priorities"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Introduction",
      "default": "<p>The full assessment goes beyond identifying risk. It shows how due diligence is working across your supply chain and what needs to improve.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 960,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1260
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 42,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 58
    },
    {
      "type": "range",
      "id": "cards_margin_top",
      "min": 32,
      "max": 96,
      "step": 8,
      "unit": "px",
      "label": "Space above cards",
      "default": 64
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card gap",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 260,
      "max": 420,
      "step": 10,
      "unit": "px",
      "label": "Card height",
      "default": 330
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card corners",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top spacing",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Cards",
      "default": "#fbfcfb"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings and icons",
      "default": "#082946"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#6c7d92"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#55c900"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card borders",
      "default": "#dce4dd"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "clipboard",
          "options": [
            {
              "value": "clipboard",
              "label": "Clipboard"
            },
            {
              "value": "pathway",
              "label": "Pathway"
            },
            {
              "value": "arrow",
              "label": "Arrow"
            },
            {
              "value": "search",
              "label": "Search"
            },
            {
              "value": "document",
              "label": "Document"
            },
            {
              "value": "supplier_risk",
              "label": "Supplier risk"
            },
            {
              "value": "due_diligence",
              "label": "Due diligence controls"
            },
            {
              "value": "visibility",
              "label": "Visibility and evidence"
            },
            {
              "value": "monitoring",
              "label": "Monitoring and corrective action"
            },
            {
              "value": "residual_risk",
              "label": "Residual risk and next priorities"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Step heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Description",
          "default": "<p>Explain what happens at this stage.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VECTRA how it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "supplier_risk",
            "heading": "Identify Where Supplier Risk Needs More Attention",
            "body": "<p>See which suppliers, activities, or parts of the supply chain need closer review.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "due_diligence",
            "heading": "Strengthen Due Diligence Controls",
            "body": "<p>Find out where governance, responsibilities, and processes work well, and where they need strengthening.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "visibility",
            "heading": "Close Gaps in Supply Chain Visibility and Evidence",
            "body": "<p>Spot where supplier information or documentation is incomplete or inconsistent.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "monitoring",
            "heading": "Strengthen Monitoring and Corrective Action",
            "body": "<p>Know where monitoring is enough and where closer oversight or corrective action is needed.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "residual_risk",
            "heading": "Understand and Address Residual Risk",
            "body": "<p>Get clear recommendations on the risk that remains and what to address next.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}