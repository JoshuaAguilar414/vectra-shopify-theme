{% render 'homepage-styles' %}

<div class="section-background hp-bg" style="--hp-section-bg: {{ section.settings.background_color }};"></div>
<div class="section section--full-width hp os-people" id="people">
  <homepage-squares class="os-squares"></homepage-squares>
  <div class="hp-wrap os-people__wrap">
    <homepage-reveal data-from="scale">
      <div class="os-people__copy">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    </homepage-reveal>
    <homepage-reveal data-from="up" data-delay="2">
      <div class="os-people__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: class: 'os-people__img', alt: section.settings.heading, loading: 'lazy'
          }}
        {%- else -%}
          <img
            class="os-people__img"
            src="{{ 'os-people.jpg' | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            width="757"
            height="400"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </homepage-reveal>
  </div>
</div>

{% schema %}
{
  "name": "Our Story people",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "People that make VECTRA" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Our presence goes beyond locations. It reflects how we help bring structure, clarity, and control into complex global challenges."
    },
    { "type": "image_picker", "id": "image", "label": "Map image" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Our Story people" }]
}
{% endschema %}
