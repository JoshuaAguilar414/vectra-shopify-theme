<div
  class="section-background hp-bg color-custom-{{ section.id }}"
  style="--hp-section-bg: {{ section.settings.background_color }};"
></div>
<div class="section section--full-width hp hp--navy" id="solutions">
  <homepage-particles class="hp-particles hp-particles--dark" data-mode="dark">
    <div class="hp-wrap" style="--hp-pad-y: {{ section.settings.padding_y }}px;">
      <div class="hp-solhead">
        <img class="hp-solhead__deco" src="{{ 'hp-solutions-deco.svg' | asset_url }}" alt="" width="48" height="48" aria-hidden="true">
        {%- if section.settings.eyebrow != blank -%}
          {%- assign eyebrow_rest = section.settings.eyebrow | remove_first: 'VECTRA' | strip -%}
          <p class="hp-eyebrow">
            {%- if section.settings.eyebrow contains 'VECTRA' -%}
              <span>VECTRA</span> {{ eyebrow_rest | escape }}
            {%- else -%}
              {{ section.settings.eyebrow | escape }}
            {%- endif -%}
          </p>
        {%- endif -%}
        <h2 class="hp-title">{{ section.settings.heading | escape }}</h2>
      </div>

      <homepage-solutions class="hp-solstage">
        <div class="hp-solstage__copy">
          {%- for block in section.blocks -%}
            <div class="hp-solpanel{% if forloop.first %} is-active{% endif %}" data-hp-sol-panel {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="hp-btn" href="{{ block.settings.link | default: section.settings.intro_button_link | default: '#contact' }}">
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="hp-solstage__gallery" data-hp-sol-gallery>
          {%- for block in section.blocks -%}
            {%- liquid
              assign media_asset = block.settings.asset
              if media_asset == blank
                assign media_asset = 'hp-solution-' | append: forloop.index | append: '.png'
              endif
            -%}
            <button
              class="hp-solthumb{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-hp-sol-thumb
              aria-label="{{ block.settings.title | escape }}"
            >
              {% render 'hp-media', image: block.settings.image, asset: media_asset, alt: block.settings.title, placeholder: 'collection-1' %}
            </button>
          {%- endfor -%}
        </div>
      </homepage-solutions>

      {%- if section.settings.button_label != blank -%}
        <homepage-reveal data-delay="2">
          <div class="hp-solgrid__cta">
            <a class="hp-btn hp-btn--glow" href="{{ section.settings.button_link | default: '#' }}">
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        </homepage-reveal>
      {%- endif -%}
    </div>
  </homepage-particles>
</div>

{% schema %}
{
  "name": "Homepage solutions",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 6,
  "blocks": [
    {
      "type": "card",
      "name": "Solution",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "asset",
          "label": "Fallback theme asset",
          "default": "hp-solution-1.png"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Operational Resilience" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Build operational control, continuity, and a stronger response to disruption."
        },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Start a briefing" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "VECTRA Solutions" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right solution for you and your team, fast."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    { "type": "text", "id": "intro_button_label", "label": "Intro button" },
    { "type": "url", "id": "intro_button_link", "label": "Intro button link" },
    { "type": "text", "id": "button_label", "label": "Footer button", "default": "Explore All Solutions →" },
    { "type": "url", "id": "button_link", "label": "Footer button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#05192d" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    {
      "name": "Homepage solutions",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "asset": "hp-solution-1.png",
            "title": "Operational Resilience",
            "text": "Build operational control, continuity, and a stronger response to disruption.",
            "button_label": "Start a briefing"
          }
        }
      ]
    }
  ]
}
{% endschema %}
