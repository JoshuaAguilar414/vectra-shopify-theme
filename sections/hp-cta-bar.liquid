{% render 'homepage-styles' %}

{% liquid
  assign badge_text = section.settings.badge_text | default: shop.name
%}

<div
  class="section-background hp-bg color-custom-{{ section.id }}"
  style="--hp-section-bg: {{ section.settings.background_color }};"
></div>
<div class="section section--full-width hp">
  <div class="hp-wrap" style="--hp-pad-y: {{ section.settings.padding_y }}px;">
    <div class="hp-cta">
      <div class="hp-cta__brand">
        <div class="hp-cta__badge">
          {%- if section.settings.badge_image != blank -%}
            {{
              section.settings.badge_image
              | image_url: width: 200
              | image_tag: alt: badge_text, loading: 'lazy'
            }}
          {%- else -%}
            {{ badge_text | upcase | truncate: 10, '' }}
          {%- endif -%}
        </div>
        <h2 class="hp-title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="hp-btn" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Homepage CTA bar",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "badge_image", "label": "Badge image" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "VECTRA" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Scale to Your Best Potential with Vectra"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Services" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "Homepage CTA bar" }]
}
{% endschema %}
