{% render 'homepage-styles' %}

<div
  class="section-background hp-bg color-custom-{{ section.id }}"
  style="--hp-section-bg: {{ section.settings.background_color }};"
></div>
<div class="section section--page-width hp">
  <div class="hp-wrap hp-careers" style="--hp-pad-y: {{ section.settings.padding_y }}px;">
    <h2 class="hp-title">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="hp-copy">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="hp-btn" href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Homepage careers",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join Our Team" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Help organizations turn sustainability ambition into lasting impact." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Opportunities" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "Homepage careers" }]
}
{% endschema %}
