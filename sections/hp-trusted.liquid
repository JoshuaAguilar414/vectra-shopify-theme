{% comment %}
  Trusted-by badge + CTA + logo marquee (screenshot layout, Figma marquee motion).
{% endcomment %}

<div
  class="section-background hp-bg color-custom-{{ section.id }}"
  style="--hp-section-bg: {{ section.settings.background_color }};"
></div>
<div class="section section--full-width hp" id="trusted">
  <div class="hp-trusted" style="--hp-pad-y: {{ section.settings.padding_y }}px;">
    <div class="hp-trusted__bar">
      <div class="hp-trusted__badge-wrap">
        {%- if section.settings.badge_image != blank -%}
          {{
            section.settings.badge_image
            | image_url: width: 400
            | image_tag: loading: 'lazy', class: 'hp-trusted__badge', alt: section.settings.badge_alt
          }}
        {%- else -%}
          <img
            class="hp-trusted__badge"
            src="{{ 'hp-trusted-badge.png' | asset_url }}"
            alt="{{ section.settings.badge_alt | escape }}"
            width="198"
            height="191"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <p class="hp-trusted__heading">{{ section.settings.heading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="hp-btn" href="{{ section.settings.button_link | default: '#solutions' }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="hp-trusted__marquee" aria-label="Trusted by">
      <div class="hp-trusted__track">
        {%- for i in (1..10) -%}
          <img src="{{ 'hp-logo-' | append: i | append: '.png' | asset_url }}" alt="" height="64" loading="lazy">
        {%- endfor -%}
        {%- for i in (1..10) -%}
          <img src="{{ 'hp-logo-' | append: i | append: '.png' | asset_url }}" alt="" height="64" loading="lazy" aria-hidden="true">
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Homepage trusted bar",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by the world’s leading corporations & investors"
    },
    { "type": "image_picker", "id": "badge_image", "label": "Badge image" },
    {
      "type": "text",
      "id": "badge_alt",
      "label": "Badge alt text",
      "default": "Trusted by 500+ Companies"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore solutions" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [{ "name": "Homepage trusted bar" }]
}
{% endschema %}
