{% render 'homepage-styles' %}

{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  if slides.size == 0
    assign slides = section.blocks
  endif
-%}

<div class="hp-hero" id="hp-top" data-hp-hero>
  <homepage-slider class="hp-hero__slider" data-autoplay="6000">
    <div class="hp-hero__viewport">
      <div class="hp-hero__track" data-hp-slider-track>
        {%- if slides.size > 0 -%}
          {%- for block in slides -%}
            {%- liquid
              assign slide_asset = block.settings.asset | default: 'hp-hero.png'
            -%}
            <div class="hp-hero__slide{% if forloop.first %} is-active{% endif %}" data-hp-slide {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag: loading: 'lazy', class: 'hp-hero__img', alt: block.settings.heading
                }}
              {%- else -%}
                <img
                  class="hp-hero__img"
                  src="{{ slide_asset | asset_url }}"
                  alt="{{ block.settings.heading | escape }}"
                  {% if forloop.first %}
                    fetchpriority="high"
                  {% else %}
                    loading="lazy"
                  {% endif %}
                >
              {%- endif -%}
              <div class="hp-hero__shade"></div>
              <div class="hp-hero__content">
                <h1>{{ block.settings.heading | escape }}</h1>
                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="hp-hero__slide is-active" data-hp-slide>
            <img class="hp-hero__img" src="{{ 'hp-hero.png' | asset_url }}" alt="{{ section.settings.heading | escape }}" fetchpriority="high">
            <div class="hp-hero__shade"></div>
            <div class="hp-hero__content">
              <h1>{{ section.settings.heading | escape }}</h1>
              <p>{{ section.settings.text | escape }}</p>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <button class="hp-hero__arrow hp-hero__arrow--prev" type="button" data-hp-prev aria-label="Previous slide">
      <img src="{{ 'hp-nav-arrow.svg' | asset_url }}" alt="" width="19" height="15">
    </button>
    <button class="hp-hero__arrow hp-hero__arrow--next" type="button" data-hp-next aria-label="Next slide">
      <img src="{{ 'hp-nav-arrow.svg' | asset_url }}" alt="" width="19" height="15">
    </button>
  </homepage-slider>

  <div class="hp-hero__topbar">
    <div class="hp-hero__glass">
      <a class="hp-hero__logo" href="{{ routes.root_url }}">
        <img src="{{ 'hp-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="161" height="42">
      </a>

      <nav class="hp-hero__nav" aria-label="Primary">
        <a href="{{ section.settings.link_dna | default: '#why' }}">Our DNA</a>
        <a href="{{ section.settings.link_help | default: '#solutions' }}">How We Help</a>
        <a href="{{ section.settings.link_market | default: '#marketplace' }}">Marketplace</a>
        <a href="{{ section.settings.link_resources | default: '#articles' }}">Resources</a>
        <a class="hp-hero__cta" href="{{ section.settings.link_contact | default: '#contact' }}">
          Contact Us
          <img src="{{ 'hp-arrow.svg' | asset_url }}" alt="" width="16" height="9">
        </a>
      </nav>
    </div>

    <div class="hp-hero__actions">
      <button class="hp-hero__chip" type="button" aria-label="Language">
        <span>ENG</span>
        <img src="{{ 'hp-lang.png' | asset_url }}" alt="" width="22" height="22">
      </button>
      <a class="hp-hero__chip" href="{{ routes.account_login_url }}">
        <span>Log In</span>
        <img src="{{ 'hp-login.png' | asset_url }}" alt="" width="18" height="20">
      </a>
      <a class="hp-hero__chip" href="{{ routes.account_register_url }}">
        <span>Join us</span>
        <img src="{{ 'hp-join.png' | asset_url }}" alt="" width="18" height="18">
      </a>
    </div>
  </div>

  {%- if section.settings.float_label != blank -%}
    <a class="hp-hero__float" href="{{ section.settings.float_link | default: '#solutions' }}">
      {{ section.settings.float_label | escape }}
      <img src="{{ 'hp-arrow.svg' | asset_url }}" alt="" width="16" height="9">
    </a>
  {%- endif -%}

  <div class="hp-hero__curve" aria-hidden="true"></div>
</div>

{% schema %}
{
  "name": "Homepage hero",
  "tag": "section",
  "class": "hp-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Fallback asset", "default": "hp-hero.png" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Who We Are" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Driven by innovation and built on trust, we help businesses transform ideas into measurable impact. Discover our mission, meet the team behind our solutions, and see how our values shape every partnership."
        }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "Who We Are" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Fallback text",
      "default": "Driven by innovation and built on trust, we help businesses transform ideas into measurable impact."
    },
    { "type": "text", "id": "float_label", "label": "Floating CTA", "default": "Learn How We Can Help" },
    { "type": "url", "id": "float_link", "label": "Floating CTA link" },
    { "type": "url", "id": "link_dna", "label": "Our DNA link" },
    { "type": "url", "id": "link_help", "label": "How We Help link" },
    { "type": "url", "id": "link_market", "label": "Marketplace link" },
    { "type": "url", "id": "link_resources", "label": "Resources link" },
    { "type": "url", "id": "link_contact", "label": "Contact link" }
  ],
  "presets": [
    {
      "name": "Homepage hero",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "asset": "hp-hero.png",
            "heading": "Who We Are",
            "text": "Driven by innovation and built on trust, we help businesses transform ideas into measurable impact. Discover our mission, meet the team behind our solutions, and see how our values shape every partnership."
          }
        },
        {
          "type": "slide",
          "settings": {
            "asset": "hp-solution-1.png",
            "heading": "Who We Are",
            "text": "Driven by innovation and built on trust, we help businesses transform ideas into measurable impact."
          }
        },
        {
          "type": "slide",
          "settings": {
            "asset": "hp-why.png",
            "heading": "Who We Are",
            "text": "Discover our mission, meet the team behind our solutions, and see how our values shape every partnership."
          }
        }
      ]
    }
  ]
}
{% endschema %}
