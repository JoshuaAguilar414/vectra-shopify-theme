  #VectraQuiz-{{ section.id }} .vectra-quiz__review-accordion { margin-top: 16px; padding: 14px 16px; border: 1px solid var(--vq-line); border-radius: 12px; text-align: left; }
  #VectraQuiz-{{ section.id }} .vectra-quiz__review-accordion summary { cursor: pointer; color: var(--vq-navy); font-size: 13px; font-weight: 700; }
  #VectraQuiz-{{ section.id }} .vectra-quiz__review-accordion p { font-size: 12px; line-height: 1.65; color: var(--vq-muted); }
  #VectraQuiz-{{ section.id }} .vectra-quiz__result-note { margin-top: 16px; padding: 12px 14px; }
  @media screen and (min-width: 750px) {
    #VectraQuiz-{{ section.id }} .vectra-quiz__options { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; }
    #VectraQuiz-{{ section.id }} .vectra-quiz__option { grid-template-columns: 18px minmax(0, 1fr); align-items: start; }
    #VectraQuiz-{{ section.id }} .vectra-quiz__option svg { display: none; }
    #VectraQuiz-{{ section.id }} .vectra-quiz__option-marker { width: 18px; height: 18px; margin-top: 1px; }

  }
  @media screen and (max-width: 749px) {
    #VectraQuiz-{{ section.id }} .vectra-quiz__panel { padding: 22px 18px; }
    #VectraQuiz-{{ section.id }} .vectra-quiz__options { grid-template-columns: 1fr; }
  }

  /* Uniform answer cards in canonical A–E reading order. */
  #VectraQuiz-{{ section.id }} .vectra-quiz__options {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: row;
    grid-auto-rows: 1fr;
    align-items: stretch;
    gap: 10px;
  }
  #VectraQuiz-{{ section.id }} .vectra-quiz__option {
    grid-column: span 2;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: start;
    width: 100%;
    min-width: 0;
    height: 100%;
    min-height: 58px;
    padding: 12px;
    gap: 10px;
  }
  #VectraQuiz-{{ section.id }} .vectra-quiz__option:last-child:nth-child(odd) {
    grid-column: 2 / span 2;
  }
  #VectraQuiz-{{ section.id }} .vectra-quiz__option-marker {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin: 0;
    border: 1.5px solid #aebbb1;
    border-radius: 50%;
    background: #fff;
    color: var(--vq-navy);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }
  #VectraQuiz-{{ section.id }} .vectra-quiz__option:has(input:checked) .vectra-quiz__option-marker {
    border: 1.5px solid var(--vq-green);
    background: var(--vq-green);
    color: var(--vq-navy);
  }
  #VectraQuiz-{{ section.id }} .vectra-quiz__option-copy {
    min-width: 0;
    overflow-wrap: anywhere;
    line-height: 1.5;
  }
  #VectraQuiz-{{ section.id }} .vectra-quiz__option svg { display: none; }
  @media screen and (max-width: 749px) {
    #VectraQuiz-{{ section.id }} .vectra-quiz__options {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
    }
    #VectraQuiz-{{ section.id }} .vectra-quiz__option,
    #VectraQuiz-{{ section.id }} .vectra-quiz__option:last-child:nth-child(odd) {
      grid-column: auto;
      height: auto;
    }
  }
{% endstyle %}



<script>
  (() => {
    const initialize = () => {
      const root = document.getElementById('VectraQuiz-{{ section.id }}');
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';
      const form = root.querySelector('.vectra-quiz__form');
      form.noValidate = true; // Validate the visible panel before navigating or submitting.
      // Use the approved spreadsheet as the default question source. Never infer a
      // service tier from scores; the source specifies no routing thresholds.
      if (root.dataset.questionSource !== 'custom') {
        const source = JSON.parse(root.querySelector('[data-scdd-questionnaire]').textContent);
        root.querySelectorAll('[data-panel="question"]').forEach(q => q.remove());
        const reviewPanel = root.querySelector('[data-panel="review"]');
        source.forEach((item, index) => {
          const q = document.createElement('fieldset');
          q.className = 'vectra-quiz__panel vectra-quiz__question';
          q.dataset.panel = 'question'; q.dataset.questionIndex = index + 1;
          q.dataset.questionId = item.id; q.dataset.questionType = item.type;
          q.innerHTML = `<legend class="visually-hidden"></legend>
            <div class="vectra-quiz__question-meta"><span></span><span></span></div>
            <h3></h3><p class="vectra-quiz__helper"></p>
            <div class="vectra-quiz__options" role="radiogroup" aria-required="true"></div>
            <p class="vectra-quiz__required-note" data-validation role="status">Please choose one answer to continue.</p>
            <div class="vectra-quiz__actions">
              <button class="vectra-quiz__button vectra-quiz__button--secondary" type="button" data-back>Back</button>
              <button class="vectra-quiz__button vectra-quiz__button--primary" type="button" data-next disabled><span></span></button>
            </div>`;
          q.querySelector('legend').textContent = `Question ${index + 1}: ${item.question}`;
          const meta = q.querySelectorAll('.vectra-quiz__question-meta span');
          meta[0].textContent = item.category; meta[1].textContent = `Question ${index + 1} of ${source.length}`;
          q.querySelector('h3').textContent = item.question + ' ';
          const required = document.createElement('span'); required.className = 'vectra-quiz__required';
          required.setAttribute('aria-hidden', 'true'); required.textContent = '*'; q.querySelector('h3').append(required);
          q.querySelector('.vectra-quiz__helper').textContent = item.type === 'core'
            ? 'Choose the one statement that best matches your current position.'
            : 'Choose one answer. This adds context and is not scored.';
          const options = q.querySelector('.vectra-quiz__options'); options.setAttribute('aria-label', item.question);
          item.options.forEach((option, optionIndex) => {
            const label = document.createElement('label'); label.className = 'vectra-quiz__option';
            const input = document.createElement('input'); input.type = 'radio';
            input.name = `vectra_question_${index + 1}`; input.value = option.text;
            input.dataset.score = option.score === null ? '' : String(option.score);
            input.dataset.optionIndex = optionIndex; input.dataset.optionId = option.id;
            const marker = document.createElement('span'); marker.className = 'vectra-quiz__option-marker'; marker.setAttribute('aria-hidden', 'true');
            const copy = document.createElement('span'); copy.className = 'vectra-quiz__option-copy'; copy.textContent = option.text;
            label.append(input, marker, copy); options.append(label);
          });
          reviewPanel.before(q);
        });
        root.dataset.questionCount = source.length;
      }
      const panels = Array.from(root.querySelectorAll('[data-panel]'));
      const questions = Array.from(root.querySelectorAll('[data-panel="question"]'));
      const details = root.querySelector('[data-panel="details"]');
      const review = root.querySelector('[data-panel="review"]');
      const result = root.querySelector('[data-panel="result"]');
      const fields = Array.from(details.querySelectorAll('[data-lead-field]'));
      const start = root.querySelector('[data-start]');
      const restart = root.querySelector('[data-restart]');
      const resumeBanner = root.querySelector('[data-resume-banner]');
      const status = root.querySelector('[data-save-status]');
      const tagsInput = root.querySelector('[data-tags-input]');
      const originalTags = tagsInput?.value || '';
      const storageKey = 'vectra-scdd-draft:v1:' + location.pathname + ':' + root.id;
      const lifetime = 30 * 24 * 60 * 60 * 1000;
      const signature = JSON.stringify(questions.map(q => [
        q.dataset.questionId,
        q.querySelector('h3').textContent.trim(),
        Array.from(q.querySelectorAll('input[type="radio"]')).map(a => [a.value, a.dataset.score]).sort((a, b) => a[0].localeCompare(b[0]))
      ]));
      // Always show canonical source order, including when restoring an older
      // draft whose answer order was shuffled. Keep saved answers unchanged.
      const orderOptions = () => questions.forEach(q => {
        const container = q.querySelector('.vectra-quiz__options');
        const inputs = Array.from(container.querySelectorAll('input[type="radio"]'));
        inputs.sort((a, b) => Number(a.dataset.optionIndex) - Number(b.dataset.optionIndex));
        inputs.forEach(input => {
          const label = input.closest('label');
          label.querySelector('.vectra-quiz__option-marker').textContent = String.fromCharCode(65 + Number(input.dataset.optionIndex));
          container.append(label);
        });
      });
      orderOptions();
      let phase = 'details';
      let questionIndex = 0;
      let resultLevel = 1;
      let resumeTarget = null;
      let editing = false;
      let saveTimer;
      let submitted = false;
      let draftEnabled = !window.Shopify?.designMode;
      const selected = q => q.querySelector('input[type="radio"]:checked');
      const invalidFields = () => fields.filter(field => {
        const blankText = field.required && field.type !== 'checkbox' && !field.value.trim();
        return blankText || !field.validity.valid;
      });
      const complete = () => questions.length > 0 && questions.every(q => selected(q));
      const leadData = () => Object.fromEntries(fields.map(f => [f.name, f.type === 'checkbox' ? f.checked : f.value]));
      const removeDraft = () => {
        clearTimeout(saveTimer);
        try { localStorage.removeItem(storageKey); } catch (error) {}
      };
      const saveDraft = () => {
        if (!draftEnabled || submitted) return;
        const hasInput = fields.some(f => f.type === 'checkbox' ? f.checked : f.value.trim()) || questions.some(q => selected(q));
        if (!hasInput) { removeDraft(); return; }
        try {
          localStorage.setItem(storageKey, JSON.stringify({
            version: 1, signature, expiresAt: Date.now() + lifetime,
            phase: resumeTarget?.phase || phase, questionIndex: resumeTarget?.questionIndex ?? questionIndex, fields: leadData(),
            answers: questions.map(q => selected(q)?.value || null)
          }));
          status.textContent = 'Progress saved in this browser for 30 days. Use Start again to clear it.';
        } catch (error) {
          status.textContent = 'Browser saving is unavailable. Keep this page open to retain your progress.';
        }
      };
      const queueSave = () => {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(saveDraft, 250);
      };
      const updateButtons = () => {
        const invalid = invalidFields();
        root.querySelector('[data-start-copy]').textContent = editing ? 'Save details and review' : {{ section.settings.start_label | json }};
        start.disabled = invalid.length > 0 || !questions.length || submitted;
        root.querySelector('[data-details-status]').textContent = !questions.length
          ? 'This assessment is not available yet.'
          : invalid.length
            ? 'To continue, complete: ' + invalid.map(f => f.dataset.fieldLabel).join(', ') + '.' + (invalid.some(f => f.type === 'email' && f.value) ? ' Enter a valid work email.' : '')
            : 'Your required details are complete. You can continue.';
        questions.forEach(q => {
          const answered = Boolean(selected(q));
          q.querySelector('[data-next]').disabled = !answered;
          q.querySelector('[data-next] span').textContent = editing ? 'Save answer and review' : (q === questions[questions.length - 1] ? 'Review answers' : 'Next question');
          q.querySelector('[data-validation]').hidden = answered;
        });
        const ready = !invalid.length && complete();
        root.querySelector('[data-review-continue]').disabled = !ready;
        root.querySelector('[data-review-status]').textContent = ready
          ? 'Everything is complete. Continue to preview your summary before final submission.'
          : 'Complete your required details and all questions before continuing.';
        const submit = root.querySelector('[data-native-submit]');
        if (submit) submit.disabled = !ready || submitted;
        const handoff = root.querySelector('[data-forms-handoff]');
        if (handoff) handoff.setAttribute('aria-disabled', String(!ready));
        restart.hidden = submitted || (!fields.some(f => f.type === 'checkbox' ? f.checked : f.value) && !questions.some(q => selected(q)));
      };
      const updateChrome = () => {
        const progress = root.querySelector('[data-progress-wrap]');
        const bar = root.querySelector('[data-progress-bar]');
        const label = root.querySelector('[data-phase-label]');
        const count = root.querySelector('[data-step-count]');
        progress.hidden = phase === 'details';
        if (phase === 'details') {
          label.textContent = {{ section.settings.details_step_label | json }};
          count.textContent = editing ? 'Update your details' : 'Before we begin';
        } else if (phase === 'question') {
          label.textContent = questions[questionIndex].querySelector('.vectra-quiz__question-meta span')?.textContent || 'Assessment';
          count.textContent = `Question ${questionIndex + 1} of ${questions.length}`;
          bar.style.width = `${questions.filter(q => selected(q)).length / questions.length * 100}%`;
        } else {
          label.textContent = phase === 'review' ? 'Review before continuing' : 'Your assessment summary';
          count.textContent = phase === 'review' ? 'Check your details and answers' : 'Ready for final submission';
          bar.style.width = '100%';
        }
      };
      const renderReview = () => {
        const dl = root.querySelector('[data-review-details]');
        dl.replaceChildren();
        fields.forEach(f => {
          const dt = document.createElement('dt'); dt.textContent = f.dataset.fieldLabel;
          const dd = document.createElement('dd');
          dd.textContent = f.type === 'checkbox' ? (f.checked ? 'Agreed' : 'Required') : (f.value || 'Not provided');
          dl.append(dt, dd);
        });
        const list = root.querySelector('[data-review-list]'); list.replaceChildren();
        questions.forEach((q, index) => {
          const li = document.createElement('li');
          const copy = document.createElement('div');
          const heading = document.createElement('strong');
          heading.textContent = `${index + 1}. ${q.querySelector('h3').textContent.replace(/\s*\*\s*$/, '').trim()}`;
          const answer = document.createElement('p'); answer.textContent = selected(q)?.value || 'Not answered';
          copy.append(heading, answer);
          const edit = document.createElement('button'); edit.type = 'button'; edit.className = 'vectra-quiz__restart';
          edit.textContent = 'Edit'; edit.setAttribute('aria-label', `Edit answer to question ${index + 1}`);
          edit.addEventListener('click', () => { editing = true; go('question', index); });
          li.append(copy, edit); list.append(li);
        });
      };
      const calculateResult = () => {
        const answers = questions.map(q => selected(q));
        const scoredQuestions = questions.filter(q => q.dataset.questionType !== 'commercial');
        const score = scoredQuestions.reduce((sum, q) => sum + Number(selected(q)?.dataset.score || 0), 0);
        const scoreMaximum = scoredQuestions.length * 5;
        const averageScore = scoredQuestions.length ? score / scoredQuestions.length : null;
        resultLevel = 1; // Assessment type only. This is NOT a service recommendation.
        root.querySelector('[data-result-level]').textContent = 'Self-reported baseline';
        root.querySelector('[data-score-total]').textContent = scoredQuestions.length ? `${score} / ${scoreMaximum}` : 'Not scored';
        root.querySelector('[data-score-average]').textContent = averageScore === null ? 'Not scored' : `${averageScore.toFixed(1)} / 5`;
        tagsInput.value = [originalTags, 'SCDD pre-assessment complete', 'SCDD self-reported baseline', `SCDD answering for: ${details.querySelector('[name="vectra_answering_for"]').value}`].filter(Boolean).join(', ');
        return {
          level: 1, assessmentLevel: 1, assessmentType: 'pre-assessment',
          recommendedLevel: null, score, scoreMaximum, averageScore,
          scoringVersion: 'SCDD Pre-Assessment (4): Q1-Q10 scored; T1-T2 unscored',
          lead: leadData(),
          commercial: Object.fromEntries(questions.filter(q => q.dataset.questionType === 'commercial').map(q => [q.dataset.questionId, selected(q)?.value || ''])),
          answers: answers.map((answer, index) => ({
            question: index + 1, questionId: questions[index].dataset.questionId,
            questionType: questions[index].dataset.questionType || 'core',
            questionText: questions[index].querySelector('h3').textContent.replace(/\s*\*\s*$/, '').trim(),
            answer: answer?.value || '',
            score: questions[index].dataset.questionType === 'commercial' ? null : Number(answer?.dataset.score || 0)
          }))
        };
      };
      const go = (nextPhase, index = questionIndex, focus = true) => {
        phase = nextPhase;
        questionIndex = Math.max(0, Math.min(index, Math.max(questions.length - 1, 0)));
        if (phase === 'review') renderReview();
        if (phase === 'result') calculateResult();
        const panel = phase === 'question' ? questions[questionIndex] : root.querySelector(`[data-panel="${phase}"]`);
        panels.forEach(p => { p.classList.toggle('is-active', p === panel); p.setAttribute('aria-hidden', String(p !== panel)); });
        updateButtons(); updateChrome(); saveDraft();
        if (focus && panel) {
          const heading = panel.querySelector('h3');
          if (heading) { heading.tabIndex = -1; heading.focus({ preventScroll: true }); }
          root.querySelector('.vectra-quiz__card').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        }
      };
      const validateLead = () => {
        const invalid = invalidFields();
        if (!invalid.length) return true;
        go('details');
        invalid[0].setAttribute('aria-invalid', 'true');
        invalid[0].focus(); invalid[0].reportValidity();
        return false;
      };
      const reset = () => {
        removeDraft();
        try { sessionStorage.removeItem('vectraAssessmentResult'); } catch (error) {}
        form.reset();
        orderOptions();
        fields.forEach(f => { if (f.type === 'checkbox') f.checked = false; else f.value = ''; f.removeAttribute('aria-invalid'); });
        questions.forEach(q => q.querySelectorAll('input[type="radio"]').forEach(a => { a.checked = false; }));
        tagsInput.value = originalTags;
        submitted = false; editing = false; resumeTarget = null; resumeBanner.hidden = true;
        go('details', 0);
      };
      start.addEventListener('click', () => {
        if (!validateLead() || !questions.length) return;
        resumeBanner.hidden = true;
        if (editing) { editing = false; go('review'); }
        else if (resumeTarget) {
          const target = resumeTarget; resumeTarget = null;
          go(target.phase, target.questionIndex);
        } else go('question', 0);
      });
      questions.forEach((q, index) => {
        q.querySelector('[data-next]').addEventListener('click', () => {
          if (!selected(q)) return;
          if (editing || index === questions.length - 1) { editing = false; go('review'); }
          else go('question', index + 1);
        });
        q.querySelector('[data-back]').addEventListener('click', () => {
          if (editing) { editing = false; go('review'); }
          else if (index === 0) go('details');
          else go('question', index - 1);
        });
      });
      root.querySelector('[data-edit-details]').addEventListener('click', () => { editing = true; go('details'); });
      root.querySelector('[data-review-back]').addEventListener('click', () => go('question', questions.length - 1));
      root.querySelector('[data-review-continue]').addEventListener('click', () => {
        if (validateLead() && complete()) go('result');
      });
      root.querySelector('[data-result-back]').addEventListener('click', () => go('review'));
      restart.addEventListener('click', reset);
      root.querySelector('[data-discard]').addEventListener('click', reset);
      root.querySelector('[data-resume]').addEventListener('click', () => {
        resumeBanner.hidden = true;
        if (!validateLead()) return;
        const target = resumeTarget || { phase: 'question', questionIndex: 0 };
        resumeTarget = null; go(target.phase, target.questionIndex);
      });
      fields.forEach(field => {
        field.addEventListener('blur', () => {
          if (field.required) field.setAttribute('aria-invalid', String(invalidFields().includes(field)));
        });
      });
      form.addEventListener('input', event => {
        event.target.removeAttribute('aria-invalid'); updateButtons(); queueSave();
      });
      form.addEventListener('change', () => { updateButtons(); saveDraft(); });
      const finalPayload = () => {
        const payload = { ...calculateResult(), completedAt: new Date().toISOString() };
        try { sessionStorage.setItem('vectraAssessmentResult', JSON.stringify(payload)); } catch (error) {}
        root.dispatchEvent(new CustomEvent('vectra:assessment-complete', { bubbles: true, detail: payload }));
        return payload;
      };
      form.addEventListener('submit', event => {
        if (root.dataset.integrationMode === 'shopify_forms') { event.preventDefault(); return; }
        if (phase !== 'result' || submitted) { event.preventDefault(); return; }
        if (!validateLead() || !complete()) { event.preventDefault(); if (!invalidFields().length) go('review'); return; }
        saveDraft();
        finalPayload();
        submitted = true;
        // Keep the draft until Shopify confirms success; rejected submissions can resume.
      });
      root.querySelector('[data-forms-handoff]')?.addEventListener('click', event => {
        if (!validateLead() || !complete()) { event.preventDefault(); return; }
        finalPayload(); saveDraft();
        root.dispatchEvent(new CustomEvent('vectra:shopify-forms-handoff', {
          bubbles: true, detail: { level: 1, assessmentLevel: 1, recommendedLevel: null, url: root.dataset.formsUrl, lead: leadData() }
        }));
        // A handoff is not confirmed submission. Preserve the draft for the return visit.
      });
      // Read only known fields and matching questions; never replay HTML or scores from storage.
      if (root.querySelector('[data-posted-successfully]').value === 'true') {
        removeDraft(); submitted = true;
        try { sessionStorage.removeItem('vectraAssessmentResult'); } catch (error) {}
        status.textContent = 'Your result has been submitted. Your saved browser draft has been cleared.';
        panels.forEach(p => { p.classList.remove('is-active'); p.setAttribute('aria-hidden', 'true'); });
        root.querySelector('[data-progress-wrap]').hidden = true;
        restart.hidden = true;
        return;
      }
      if (draftEnabled) {
        try {
          const draft = JSON.parse(localStorage.getItem(storageKey) || 'null');
          if (draft) {
            if (draft.version !== 1 || draft.signature !== signature || !(draft.expiresAt > Date.now()) || !Array.isArray(draft.answers) || draft.answers.length !== questions.length) {
              removeDraft();
            } else {
              fields.forEach(f => {
                const value = draft.fields?.[f.name];
                if (f.type === 'checkbox') f.checked = value === true;
                else if (typeof value === 'string') f.value = value;
              });
              questions.forEach((q, index) => q.querySelectorAll('input[type="radio"]').forEach(a => { a.checked = a.value === draft.answers[index]; }));
              // Older drafts may contain a shuffled answerOrders array.
              // Ignore presentation order and retain selected values and position.
              orderOptions();

              const savedPhase = ['details', 'question', 'review', 'result'].includes(draft.phase) ? draft.phase : 'details';
              const firstMissing = questions.findIndex(q => !selected(q));
              resumeTarget = {
                phase: (savedPhase === 'review' || savedPhase === 'result') && !complete() ? 'question' : savedPhase,
                questionIndex: Number.isInteger(draft.questionIndex) ? Math.max(0, Math.min(draft.questionIndex, questions.length - 1)) : Math.max(0, firstMissing)
              };
              resumeBanner.hidden = false;
            }
          }
        } catch (error) {
          status.textContent = 'Browser saving is unavailable. Keep this page open to retain your progress.';
        }
      }
      updateButtons(); updateChrome();
      // Flush pending keystrokes when leaving; no network request or lead submission occurs.
      window.addEventListener('pagehide', () => { if (root.isConnected) saveDraft(); });
      document.addEventListener('visibilitychange', () => { if (document.hidden && root.isConnected) saveDraft(); });
    };
    initialize();
    document.addEventListener('shopify:section:load', initialize);
  })();
</script>


{% schema %}
{
  "name": "VECTRA interactive quiz",
  "tag": "section",
  "class": "section-vectra-interactive-quiz",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "question_source",
      "label": "Question source",
      "default": "sheet",
      "options": [
        {
          "value": "sheet",
          "label": "Approved spreadsheet (12 questions)"
        },
        {
          "value": "custom",
          "label": "Custom question blocks"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": "Spreadsheet mode uses 10 scored questions (1–5) and two unscored commercial questions. Choices always appear in the spreadsheet’s A–E order. There are no approved score cutoffs for service-level recommendations. Custom blocks are used only in Custom mode."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SCDD readiness screening"
