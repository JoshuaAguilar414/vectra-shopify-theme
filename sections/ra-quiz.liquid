{% comment %}
  VECTRA interactive SCDD screening quiz

  Drafts: saved in localStorage for 30 days on this origin/path/section.
  No lead is submitted by autosave. Start again deletes the local draft.
  A confirmed native Shopify success deletes the local draft. A Forms
  handoff retains it because this section cannot confirm that form's success.

  New standard name/phone controls are included in the native form.
  Custom organization/role/scope data and answers are available in the
  final vectra:assessment-complete event's detail.lead and detail.answers.
  Map these custom properties in the connected CRM integration; collecting
  them here does not itself create Shopify customer metafields.

  Shopify integration modes:
  1. Shopify customer form — submits the lead to Shopify and adds the
     pre-assessment completion as customer tags. This uses Shopify's native
     {% form 'customer' %} endpoint.
  2. Shopify Forms handoff — sends the visitor to a published Shopify Forms
     inline-form landing page after the response summary is calculated. Add that page's
     URL in the section settings.

  Shopify Forms does not expose a documented storefront JavaScript submission
  API, so this section does not imitate or reverse-engineer one. A custom
  `vectra:assessment-complete` browser event is emitted for analytics or a
  future app integration.
{% endcomment %}

{% liquid
  assign quiz_form_id = 'VectraQuizForm-' | append: section.id
  assign integration_mode = section.settings.integration_mode
  assign question_count = 0
  for block in section.blocks
    if block.type == 'question'
      assign question_count = question_count | plus: 1
    endif
  endfor
%}

<section
  id="VectraQuiz-{{ section.id }}"
  class="vectra-quiz"
  data-integration-mode="{{ integration_mode }}"
  data-question-source="{{ section.settings.question_source | default: 'sheet' }}"
  data-question-count="{{ question_count }}"
  data-forms-url="{{ section.settings.shopify_forms_url | escape }}"
  aria-labelledby="VectraQuizHeading-{{ section.id }}"
>
  <div class="vectra-quiz__shell">
    <header class="vectra-quiz__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="vectra-quiz__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 id="VectraQuizHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.intro != blank %}
        <div class="vectra-quiz__intro-copy">{{ section.settings.intro | replace: "Answer ten focused questions to receive a recommended VECTRA assessment pathway.", "Answer ten core screening questions and two short context questions to establish your self-reported supply chain due diligence baseline." }}</div>
      {% endif %}
      <div class="vectra-quiz__assurance" aria-label="Assessment information">
        <span>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Zm0 3v4.2l2.8 1.7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6"/></svg>
          {{ section.settings.time_label | escape }}
        </span>
        <span>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.4 16 4.7v4.5c0 3.8-2.3 6.5-6 8.2-3.7-1.7-6-4.4-6-8.2V4.7Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/><path d="m7 9.9 1.8 1.8 4-4.2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
          {{ section.settings.privacy_label | escape }}
        </span>
      </div>
    </header>

    <div class="vectra-quiz__card">
      <div class="vectra-quiz__resume" data-resume-banner hidden>
        <p><strong>Welcome back.</strong> Your saved assessment is ready to resume.</p>
        <div>
          <button type="button" class="vectra-quiz__button vectra-quiz__button--primary" data-resume>Resume assessment</button>
          <button type="button" class="vectra-quiz__restart" data-discard>Start again</button>
        </div>
      </div>
      <p class="vectra-quiz__save-status" data-save-status role="status">Your progress is saved in this browser for 30 days. Use Start again to clear it.</p>
      <div class="vectra-quiz__topline">
        <div>
          <span class="vectra-quiz__phase-label" data-phase-label>{{ section.settings.details_step_label | escape }}</span>
          <strong data-step-count>Before we begin</strong>
        </div>
        <button class="vectra-quiz__restart" type="button" data-restart hidden>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.1 7.3A6.5 6.5 0 1 1 4 12.2M4.1 7.3V3.8m0 3.5h3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/></svg>
          Start again
        </button>
      </div>

      <div class="vectra-quiz__progress" data-progress-wrap hidden>
        <span data-progress-bar></span>
      </div>

      {% form 'customer', id: quiz_form_id, class: 'vectra-quiz__form' %}
        <input type="hidden" data-posted-successfully value="{% if form.posted_successfully? %}true{% else %}false{% endif %}">
        <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tag | escape }}" data-tags-input>

        {% if form.errors %}
          <div class="vectra-quiz__notice vectra-quiz__notice--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        {% if form.posted_successfully? %}
          <div class="vectra-quiz__notice vectra-quiz__notice--success" role="status">
            {{ section.settings.submit_success | escape }}
          </div>
        {% endif %}

        <div class="vectra-quiz__panel is-active" data-panel="details">
          <div class="vectra-quiz__panel-heading">
            <span class="vectra-quiz__number">01</span>
            <div>
              <h3>{{ section.settings.details_heading | escape }}</h3>
              <p>{{ section.settings.details_body | escape }}</p>
            </div>
          </div>

          <p class="vectra-quiz__required-note"><span class="vectra-quiz__required" aria-hidden="true">*</span> Required fields</p>
          <div class="vectra-quiz__fields">
            <label class="vectra-quiz__field">
              <span>First name <span class="vectra-quiz__required" aria-hidden="true">*</span></span>
              <input type="text" name="contact[first_name]" autocomplete="given-name" required data-lead-field data-field-label="First name">
            </label>
            <label class="vectra-quiz__field">
              <span>Last name <span class="vectra-quiz__required" aria-hidden="true">*</span></span>
              <input type="text" name="contact[last_name]" autocomplete="family-name" required data-lead-field data-field-label="Last name">
            </label>
            <label class="vectra-quiz__field">
              <span>Work email <span class="vectra-quiz__required" aria-hidden="true">*</span></span>
              <input type="email" name="contact[email]" autocomplete="email" required data-lead-field data-field-label="Work email">
            </label>
            <label class="vectra-quiz__field">
              <span>Phone number <small>(optional)</small></span>
              <input type="tel" name="contact[phone]" autocomplete="tel" data-lead-field data-field-label="Phone number">
            </label>
            <label class="vectra-quiz__field">
              <span>Organization <span class="vectra-quiz__required" aria-hidden="true">*</span></span>
              <input type="text" name="vectra_organization" autocomplete="organization" required data-lead-field data-field-label="Organization">
            </label>
            <label class="vectra-quiz__field">
              <span>Role <span class="vectra-quiz__required" aria-hidden="true">*</span></span>
              <input type="text" name="vectra_role" autocomplete="organization-title" required data-lead-field data-field-label="Role">
            </label>
            <label class="vectra-quiz__field vectra-quiz__field--wide">
              <span>Who are you answering for? <span class="vectra-quiz__required" aria-hidden="true">*</span></span>
              <select name="vectra_answering_for" required data-lead-field data-field-label="Who you are answering for">
                <option value="">Select an option</option>
                <option value="Own company">My own company</option>
                <option value="Supplier">A supplier</option>
                <option value="Partner">A partner</option>
              </select>
            </label>
            <label class="vectra-quiz__field vectra-quiz__field--wide">
              <span>Assessment scope <span class="vectra-quiz__required" aria-hidden="true">*</span></span>
              <select name="vectra_scope" required data-lead-field data-field-label="Assessment scope">
                <option value="">Select the scope that fits best</option>
                <option>Whole organization / corporate</option>
                <option>Division or region</option>
                <option>Factory or operating site</option>
                <option>Supplier or supply-chain group</option>
                <option>Not sure yet</option>
              </select>
            </label>
          </div>

          <label class="vectra-quiz__consent">
            <input type="checkbox" name="vectra_consent" required data-lead-field data-field-label="Consent">
            <span><span class="vectra-quiz__required" aria-hidden="true">*</span> {{ section.settings.consent_text }}</span>
          </label>
          <p class="vectra-quiz__required-note" id="VectraQuizMissing-{{ section.id }}" data-details-status aria-live="polite"></p>

          <div class="vectra-quiz__actions vectra-quiz__actions--end">
            <button class="vectra-quiz__button vectra-quiz__button--primary" type="button" data-start disabled aria-describedby="VectraQuizMissing-{{ section.id }}">
              <span data-start-copy>{{ section.settings.start_label | escape }}</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
            </button>
          </div>
        </div>

        {% if section.settings.question_source == 'custom' %}
        {% assign question_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'question' %}
            {% assign question_index = question_index | plus: 1 %}
            <fieldset
              class="vectra-quiz__panel vectra-quiz__question"
              data-panel="question"
              data-question-index="{{ question_index }}"
              data-question-id="{{ block.id }}"
              data-question-type="{% if block.settings.question_type == 'commercial' %}commercial{% else %}core{% endif %}"
              {{ block.shopify_attributes }}
            >
              <legend class="visually-hidden">Question {{ question_index }}: {{ block.settings.question | escape }}</legend>
              <div class="vectra-quiz__question-meta">
                <span>{{ block.settings.category | escape }}</span>
                <span>Question {{ question_index }} of {{ question_count }}</span>
              </div>
              <h3>{{ block.settings.question | escape }} <span class="vectra-quiz__required" aria-hidden="true">*</span></h3>
              {% if block.settings.helper != blank %}
                <p class="vectra-quiz__helper">{{ block.settings.helper | escape }}</p>
              {% endif %}

              <div class="vectra-quiz__options" role="radiogroup" aria-required="true" aria-label="{{ block.settings.question | escape }}">
                {% for option_number in (1..5) %}
                  {% capture option_key %}option_{{ option_number }}{% endcapture %}
                  {% capture score_key %}score_{{ option_number }}{% endcapture %}
                  {% assign option_text = block.settings[option_key] %}
                  {% assign option_score = block.settings[score_key] %}
                  {% if option_text != blank %}
                    <label class="vectra-quiz__option">
                      <input
                        type="radio"
                        name="vectra_question_{{ question_index }}"
                        value="{{ option_text | escape }}"
                        data-score="{{ option_score }}"
                        data-option-index="{{ option_number | minus: 1 }}"
                      >
                      <span class="vectra-quiz__option-marker" aria-hidden="true"></span>
                      <span class="vectra-quiz__option-copy">{{ option_text | escape }}</span>
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10 3.2 3.2L15 6.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg>
                    </label>
                  {% endif %}
                {% endfor %}
              </div>

              <p class="vectra-quiz__required-note" data-validation role="status">Please choose one answer to continue.</p>
              <div class="vectra-quiz__actions">
                <button class="vectra-quiz__button vectra-quiz__button--secondary" type="button" data-back>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H5m4-4-4 4 4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
                  Back
                </button>
                <button class="vectra-quiz__button vectra-quiz__button--primary" type="button" data-next disabled>
                  <span>{% if question_index == question_count %}Review answers{% else %}Next question{% endif %}</span>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
                </button>
              </div>
            </fieldset>
          {% endif %}
        {% endfor %}

        {% endif %}
        <div class="vectra-quiz__panel" data-panel="review">
          <h3 tabindex="-1">Review your assessment</h3>
          <p class="vectra-quiz__helper">Check your details and answers. You can change anything before submitting.</p>
          <details class="vectra-quiz__review-lead vectra-quiz__review-accordion">
            <summary>Your details — review or edit</summary>
            <dl data-review-details></dl>
            <button class="vectra-quiz__restart" type="button" data-edit-details>Edit details</button>
          </details>
          <details class="vectra-quiz__review-accordion">
            <summary>Your answers — review or edit</summary>
            <ol class="vectra-quiz__review-list" data-review-list></ol>
          </details>
          <p class="vectra-quiz__required-note" data-review-status role="status"></p>
          <div class="vectra-quiz__actions">
            <button type="button" class="vectra-quiz__button vectra-quiz__button--secondary" data-review-back>Back</button>
            <button type="button" class="vectra-quiz__button vectra-quiz__button--primary" data-review-continue disabled>See my summary</button>
          </div>
        </div>
        <div class="vectra-quiz__panel vectra-quiz__result" data-panel="result" aria-live="polite">
          <div class="vectra-quiz__result-badge">
            <span>Pre-assessment complete</span>
            <strong data-result-level>Self-reported baseline</strong>
          </div>

          <div class="vectra-quiz__baseline-copy">
            <p class="vectra-quiz__result-kicker">Simplified Level 1 assessment</p>
            <h3>Your self-reported assessment summary</h3>
            <div class="vectra-quiz__score-grid">
              <p><strong data-score-total>—</strong><span>Unweighted response total</span></p>
              <p><strong data-score-average>—</strong><span>Average response level</span></p>
            </div>
            <p>These scores summarize the answers you selected. They do not automatically recommend a service level or verify your supply chain risk.</p>
            <details class="vectra-quiz__review-accordion">
              <summary>How the full assessment builds on this</summary>
              <p><strong>Level 1:</strong> Assess your current position through self-reported answers.</p>
              <p><strong>Level 2:</strong> VECTRA reviews supporting evidence and may revise the same scores.</p>
              <p><strong>Level 3:</strong> Consultancy helps implement improvements identified through Level 1 or Level 2. It is not a scored assessment.</p>
            </details>
          </div>
          <div class="vectra-quiz__result-note">
            <span>Your scope and supply chain context are recorded separately and do not add points. VECTRA can use your responses to discuss the appropriate next step.</span>
          </div>

          <div class="vectra-quiz__actions vectra-quiz__actions--result">
            <button class="vectra-quiz__button vectra-quiz__button--secondary" type="button" data-result-back>Review answers</button>

            {% if integration_mode == 'shopify_forms' %}
              {% if section.settings.shopify_forms_url != blank %}
                <a
                  class="vectra-quiz__button vectra-quiz__button--primary"
                  href="{{ section.settings.shopify_forms_url }}"
                  data-forms-handoff
                  {% if section.settings.open_forms_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                >
                  {{ section.settings.forms_cta_label | escape }}
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
                </a>
              {% else %}
                <button class="vectra-quiz__button vectra-quiz__button--primary" type="button" disabled>
                  Add Shopify Forms URL
                </button>
              {% endif %}
            {% else %}
              <button class="vectra-quiz__button vectra-quiz__button--primary" type="submit" data-native-submit>
                {{ section.settings.native_cta_label | escape }}
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
              </button>
            {% endif %}
          </div>
        </div>
      {% endform %}


    </div>
  </div>
