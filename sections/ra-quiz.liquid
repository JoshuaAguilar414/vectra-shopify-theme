</script>
</section>

{% style %}
  #VectraQuiz-{{ section.id }} {
    --vq-navy: {{ section.settings.navy_color }};
    --vq-green: {{ section.settings.accent_color }};
    --vq-ink: {{ section.settings.text_color }};
    --vq-muted: {{ section.settings.muted_color }};
    --vq-line: {{ section.settings.border_color }};
    --vq-surface: {{ section.settings.card_color }};
    position: relative;
    overflow: hidden;
