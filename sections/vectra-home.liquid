  <section class="vh-faq" id="contact">
    <img class="vh-faq__glow" src="{{ img_faq_glow }}" alt="">
    <div class="vh-wrap vh-faq__grid">
      <aside class="vh-contact-card">
        <p>You Have Different Questions?</p>
        <p>
          Whether you’re here to build muscle, find balance, or boost you’re here to find balan your our state-of the-art equipment, expert muscle It’s the practice.
        </p>
        <a class="vh-btn vh-btn--white" href="mailto:info@vectra-intl.com">
          Contact Us
          <img src="{{ img_arrow_btn }}" alt="" style="filter: brightness(0)">
        </a>
        <div class="vh-contact-list">
          <div>
            <img src="{{ img_mail }}" alt="">
            <div><small>Have a question</small><strong>info@vectra-intl.com</strong></div>
          </div>
          <div>
            <img src="{{ img_phone }}" alt="">
            <div><small>Give Us A Call</small><strong>+32 495 239088</strong></div>
          </div>
          <div>
            <img src="{{ img_pin }}" alt="">
            <div><small>Our Address</small><strong>Chaussée de Wavre 1517B<br>1160 Brussels, Belgium</strong></div>
          </div>
        </div>
      </aside>

      <div class="vh-accordion">
        <p class="vh-kicker">Our FAQ</p>
        <h2 class="vh-h2">Frequently Asked Questions</h2>
        {% assign faqs = "What are the different types of trading?|What is the difference between trading and investing?|How do I deposit money into my trading account?|How do I protect my trading account?|What is the difference between trading and investing?" | split: '|' %}
        {% for question in faqs %}
          <div class="vh-acc{% if forloop.index == 3 %} is-open{% endif %}" data-vh-faq-item>
            <button type="button" data-vh-faq-btn>
              {{ question }}
              <img src="{{ img_caret }}" alt="">
            </button>
            <div class="vh-acc__body">
              Whether you’re here to build muscle, find balance, or boost you’re here to find balan your our state-of the-art equipment, expert muscle It’s the practice.
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="vh-portal">
    <div class="vh-wrap vh-portal__grid">
      <div>
        <h2>Everything your VECTRA relationship, in one place.</h2>
        <p>
          Access Marketplace purchases, active services, VSuites, current retainers, billing, documentation, and support from a single, secure account.
        </p>
      </div>
      {% form 'contact', class: 'vh-form' %}
        <div class="vh-form__grid">
          <input type="text" name="contact[first_name]" placeholder="First Name*" required>
          <input type="text" name="contact[last_name]" placeholder="Last Name*" required>
          <input type="email" name="contact[email]" placeholder="Email*" required>
          <input type="tel" name="contact[phone]" placeholder="Phone Number*">
          <input type="text" name="contact[company]" placeholder="Company*">
          <input type="text" name="contact[job_title]" placeholder="Job Title*">
        </div>
        <textarea name="contact[body]" placeholder="Message Here..."></textarea>
        <button class="vh-btn vh-btn--green" type="submit">
          Sign in
          <img src="{{ img_arrow }}" alt="">
        </button>
      {% endform %}
    </div>
