        <a class="vh-btn vh-btn--green" href="#cases">
          Explore Case Studies
          <img src="{{ img_arrow }}" alt="">
        </a>
      </div>
    </div>
  </section>

  <div class="vh-logos" aria-label="Trusted by">
    <div class="vh-logos__track">
