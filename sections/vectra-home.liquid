<div class="vectra-home" data-vectra-home>
  <header class="vh-header" data-vh-header>
    <div class="vh-util">
      <a href="{{ routes.account_register_url | default: '/account/register' }}">
        <img src="{{ img_case }}" alt="" width="18" height="18">
        Join us
      </a>
      <span>
        <img src="{{ img_globe }}" alt="" width="18" height="18">
        ENG
      </span>
      <a href="{{ routes.account_login_url }}">
        <img src="{{ img_user }}" alt="" width="18" height="18">
        Log In
      </a>
    </div>

    <nav class="vh-nav" aria-label="Primary">
      <a class="vh-logo" href="{{ routes.root_url }}">
        <img src="{{ img_logo }}" alt="{{ shop.name }}" width="220" height="38">
      </a>

      <div class="vh-menu">
        <a href="#why-vectra">Our DNA</a>
        <a href="#solutions">How We Help</a>
        <a href="#marketplace">Marketplace</a>
        <a href="#resources">Resources</a>
      </div>

      <div class="vh-nav-end">
        <button
          class="vh-search"
          type="button"
          on:click="#search-modal/showDialog"
          aria-label="Search"
        >
          <span class="svg-wrapper">{{ 'icon-search.svg' | inline_asset_content }}</span>
        </button>
        <a class="vh-btn vh-btn--green" href="#contact">
          Contact Us
          <img src="{{ img_arrow_btn }}" alt="" width="16" height="9">
        </a>
        <button class="vh-nav-toggle" type="button" data-vh-nav-toggle aria-expanded="false" aria-label="Menu">
          {{ 'icon-menu.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="vh-nav-panel" data-vh-nav-panel>
        <a href="#why-vectra">Our DNA</a>
        <a href="#solutions">How We Help</a>
        <a href="#marketplace">Marketplace</a>
        <a href="#resources">Resources</a>
        <a href="#contact">Contact Us</a>
      </div>
    </nav>
  </header>

  <section class="vh-hero" data-vh-carousel aria-label="Featured">
    <div class="vh-hero__track" data-vh-track>
      <article class="vh-hero__slide" data-vh-slide>
        <img src="{{ img_hero }}" alt="VECTRA team collaborating" width="1920" height="1080">
        <div class="vh-hero__copy">
          <h1>Who We Are</h1>
          <p>
            Driven by innovation and built on trust, we help businesses transform ideas into measurable impact.
            Discover our mission, meet the team behind our solutions, and see how our values shape every partnership.
          </p>
        </div>
      </article>
      <article class="vh-hero__slide" data-vh-slide>
        <img src="{{ img_hero_2 }}" alt="Responsible supply chains in motion" width="1920" height="1080">
        <div class="vh-hero__copy">
          <h1>Your Trusted ESG Partner</h1>
          <p>
            Our solutions are tailored to empower your organization to achieve ESG goals and build more resilient,
            responsible supply chains.
          </p>
        </div>
      </article>
    </div>
    <button class="vh-hero__arrow vh-hero__arrow--prev" type="button" data-vh-prev aria-label="Previous slide">
      <img src="{{ img_arrow }}" alt="">
    </button>
    <button class="vh-hero__arrow vh-hero__arrow--next" type="button" data-vh-next aria-label="Next slide">
      <img src="{{ img_arrow }}" alt="">
    </button>
    <a class="vh-float-cta" href="#solutions">
      Learn How We Can Help
      <img src="{{ img_arrow }}" alt="">
    </a>
  </section>

