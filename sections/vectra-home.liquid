              <span class="vh-price">$20.00</span>
              <a class="vh-btn vh-btn--outline" href="{{ routes.all_products_collection_url }}">Access This Course</a>
            </div>
          </div>
        </article>
        <article class="vh-course">
          <img src="{{ img_course_4 }}" alt="">
          <div class="vh-course__body">
            <h3>Disability Accommodation Training</h3>
            <div class="vh-course__meta">
              <span class="vh-price">$20.00</span>
              <a class="vh-btn vh-btn--outline" href="{{ routes.all_products_collection_url }}">Access This Course</a>
            </div>
          </div>
        </article>
      </div>

      <div class="vh-topics">
        <h2 class="vh-h2">Relevant Topics</h2>
        <div class="vh-pills">
          <span class="vh-pill">Most Popular →</span>
          <span class="vh-pill">By Regulation →</span>
          <span class="vh-pill">By Role →</span>
        </div>
        <article class="vh-featured">
          <img src="{{ img_course_2 }}" alt="">
          <div class="vh-featured__body">
            <span class="vh-featured__label">Certificate Course</span>
            <h3>Preventative and Corrective Measures</h3>
            <p>
              This course provides a comprehensive framework for managing supply chain due diligence in 2026. It focuses on the dual approach of using preventative measures as a “proactive shield” to avoid crises and corrective measures as a “surgical fix” to address and remediate existing violations.
            </p>
            <div class="vh-course__meta">
              <span class="vh-price">$20.00</span>
              <a class="vh-btn vh-btn--outline" href="{{ routes.all_products_collection_url }}">Access This Course</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="vh-cases" id="cases" data-vh-carousel>
    <div class="vh-wrap">
      <h2>Tested in real crises.</h2>
      <p class="vh-lead">Proven by industry leaders.</p>
      <div class="vh-dots" aria-hidden="true">
        <button type="button" data-vh-dot></button>
        <button type="button" class="is-active" data-vh-dot></button>
        <button type="button" data-vh-dot></button>
        <button type="button" data-vh-dot></button>
      </div>
      <a class="vh-btn vh-btn--green" href="#contact">Explore Case Studies →</a>
      <div class="vh-case-grid">
        <article class="vh-case">
          <img src="{{ img_logo_otto }}" alt="OTTO Group">
          <div class="vh-stars">★★★★★</div>
          <h3>OTTO Group</h3>
          <p>Hamburg, Germany</p>
          <p>Based on 500 reviews</p>
        </article>
        <article class="vh-case">
          <img src="{{ img_crh }}" alt="CRH">
          <div class="vh-stars">★★★★★</div>
