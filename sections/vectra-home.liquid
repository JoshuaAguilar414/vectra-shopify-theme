{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}
{% render 'vectra-page-shell', children: children %}

{% schema %}
{
  "name": "VECTRA homepage",
  "class": "vectra-home-section",
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "MEGA Navigation",
      "info": "Uses VECTRA Website Mega Menu (handle: vectra-website-mega-menu). Nested items render as header dropdowns."
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "VECTRA homepage",
      "blocks": [
        { "type": "vectra-header" },
        { "type": "vectra-hero" },
        { "type": "vectra-trust" },
        { "type": "vectra-logos" },
        { "type": "vectra-impact" },
        { "type": "vectra-why" },
        { "type": "vectra-esg" },
        { "type": "vectra-solutions" },
        { "type": "vectra-marketplace" },
        { "type": "vectra-cases" },
        { "type": "vectra-blog" },
        { "type": "vectra-faq" },
        { "type": "vectra-portal" },
        { "type": "vectra-careers" },
        { "type": "vectra-footer" }
      ]
    }
  ]
}
{% endschema %}
