      <img src="{{ img_logo_copper }}" alt="The Copper Mark">
      <img src="{{ img_logo_rba }}" alt="Responsible Business Alliance">
      <img src="{{ img_logo_otto }}" alt="OTTO">
      <img src="{{ img_logo_applied }}" alt="Applied Materials">
