        <div class="vh-stat"><b>500+</b><span>Satisfied Clients</span></div>
      </div>
    </div>
  </section>

  <section class="vh-solutions" id="solutions">
    <div class="vh-wrap">
      <div class="vh-solutions__head">
        <p class="vh-kicker">VECTRA Solutions</p>
        <h2 class="vh-h2">Find the right solution for you and your team, fast.</h2>
      </div>
      <div class="vh-solutions__scroller">
        <article class="vh-sol-card vh-sol-card--text">
          <div>
            <h3>Operational Resilience</h3>
            <p>Build operational control, continuity, and a stronger response to disruption.</p>
          </div>
          <a class="vh-btn vh-btn--green" href="#contact">Start a briefing</a>
        </article>
        <article class="vh-sol-card"><img src="{{ img_sol_1 }}" alt="ESG intelligence"></article>
        <article class="vh-sol-card"><img src="{{ img_sol_2 }}" alt="Team implementation"></article>
        <article class="vh-sol-card"><img src="{{ img_sol_3 }}" alt="Workspace collaboration"></article>
        <article class="vh-sol-card"><img src="{{ img_sol_4 }}" alt="Data-led decision making"></article>
