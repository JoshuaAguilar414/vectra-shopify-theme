<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<div class="vectra-home" data-vectra-home>
  {% content_for 'blocks' %}
  {% render 'vectra-contact-modal' %}
</div>

{% schema %}
{
  "name": "VECTRA homepage",
  "class": "vectra-home-section",
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "MEGA Navigation",
      "info": "Select the nested MEGA Nav menu from Online Store > Navigation."
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "VECTRA homepage",
      "blocks": [
        { "type": "vectra-header" },
        { "type": "vectra-hero" },
        { "type": "vectra-trust" },
        { "type": "vectra-logos" },
        { "type": "vectra-impact" },
        { "type": "vectra-why" },
        { "type": "vectra-esg" },
        { "type": "vectra-solutions" },
        { "type": "vectra-marketplace" },
        { "type": "vectra-cases" },
        { "type": "vectra-blog" },
        { "type": "vectra-faq" },
        { "type": "vectra-portal" },
        { "type": "vectra-careers" },
        { "type": "vectra-footer" }
      ]
    }
  ]
}
{% endschema %}
