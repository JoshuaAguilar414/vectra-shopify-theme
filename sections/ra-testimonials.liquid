<script>
  if (!customElements.get('vectra-testimonials')) {
    customElements.define('vectra-testimonials', class extends HTMLElement {
      connectedCallback() {
        this.frame = requestAnimationFrame(() => this.setup());
      }
      setup() {
        if (!this.isConnected || this.abort) return;
        this.root = this.querySelector('section');
        this.track = this.querySelector('[data-vts-track]');
        if (!this.root || !this.track) return;
        this.abort = new AbortController();
        const options = { signal: this.abort.signal };
        this.carousel = this.root.classList.contains('vts--carousel');
        this.reduced = matchMedia('(prefers-reduced-motion: reduce)');
        this.paused = this.reduced.matches;
        this.visible = true;
        this.hovered = false;
        this.focused = false;
        this.autoplay = this.carousel && this.root.dataset.autoplay === 'true';
        this.cards = [...this.track.querySelectorAll('.vts__card')];
        this.querySelector('[data-vts-next]')?.addEventListener('click', () => this.move(1), options);
        this.querySelector('[data-vts-prev]')?.addEventListener('click', () => this.move(-1), options);
        this.querySelector('[data-vts-pause]')?.addEventListener('click', () => {
          this.paused = !this.paused; this.applyState();
        }, options);
        this.addEventListener('mouseenter', () => { this.hovered = true; this.schedule(); }, options);
        this.addEventListener('mouseleave', () => { this.hovered = false; this.schedule(); }, options);
        this.addEventListener('focusin', () => { this.focused = true; this.schedule(); }, options);
        this.addEventListener('focusout', event => { this.focused = this.contains(event.relatedTarget); this.schedule(); }, options);
        this.track.addEventListener('scroll', () => this.updateCounter(), { ...options, passive: true });
        this.track.addEventListener('keydown', event => {
          if (event.target !== this.track || !this.carousel) return;
          if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
            event.preventDefault(); this.move(event.key === 'ArrowRight' ? 1 : -1);
          }
        }, options);
        document.addEventListener('visibilitychange', () => this.schedule(), options);
        this.reduced.addEventListener('change', () => {
          this.paused = this.reduced.matches; this.applyState();
        }, options);
        this.intersection = new IntersectionObserver(entries => {
          this.visible = entries[0].isIntersecting; this.schedule();
        });
        this.intersection.observe(this);
        this.resize = new ResizeObserver(() => this.updateCounter());
        this.resize.observe(this.track);
        this.applyState(); this.updateCounter();
      }
      currentIndex() {
        const left = this.track.getBoundingClientRect().left;
        let index = 0, distance = Infinity;
        this.cards.forEach((card, i) => {
          const next = Math.abs(card.getBoundingClientRect().left - left);
          if (next < distance) { index = i; distance = next; }
        });
        return index;
      }
      move(direction) {
        if (!this.carousel || !this.cards.length) return;
        const max = this.track.scrollWidth - this.track.clientWidth;
        if (max < 2) return;
        const index = this.currentIndex();
        const atEnd = this.track.scrollLeft >= max - 2;
        const atStart = this.track.scrollLeft <= 2;
        let target;
        if (direction > 0 && atEnd) target = 0;
        else if (direction < 0 && atStart) target = max;
        else {
          const next = this.cards[Math.max(0, Math.min(this.cards.length - 1, index + direction))];
          target = Math.max(0, Math.min(max, next.getBoundingClientRect().left - this.track.getBoundingClientRect().left + this.track.scrollLeft));
        }
        this.track.scrollTo({ left: target, behavior: this.reduced.matches ? 'instant' : 'smooth' });
        this.schedule();
      }
      updateCounter() {
        const counter = this.querySelector('[data-vts-counter]');
        if (!counter || !this.cards?.length) return;
        const box = this.track.getBoundingClientRect();
        const visible = this.cards.map((card, i) => ({ box: card.getBoundingClientRect(), index: i + 1 }))
          .filter(card => card.box.right > box.left + 8 && card.box.left < box.right - 8);
        const first = visible[0]?.index || 1;
        const last = visible.at(-1)?.index || first;
        counter.textContent = (first === last ? first : `${first}–${last}`) + ' / ' + this.cards.length;
      }
      applyState() {
        this.root.classList.toggle('vts--paused', this.paused);
        const button = this.querySelector('[data-vts-pause]');
        if (button) { button.textContent = this.paused ? 'Resume motion' : 'Pause motion'; button.setAttribute('aria-pressed', String(this.paused)); }
        this.schedule();
      }
      schedule() {
        clearTimeout(this.timer);
        if (!this.autoplay || this.paused || this.reduced?.matches || !this.visible || document.hidden || this.hovered || this.focused) return;
        const interval = Math.max(4, Number(this.root.dataset.interval) || 7) * 1000;
        this.timer = setTimeout(() => this.move(1), interval);
      }
      disconnectedCallback() {
        cancelAnimationFrame(this.frame); clearTimeout(this.timer);
        this.abort?.abort(); this.intersection?.disconnect(); this.resize?.disconnect();
        this.abort = null;
      }
    });
  }
</script>

