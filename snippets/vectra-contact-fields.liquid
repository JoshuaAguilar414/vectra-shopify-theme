{%- doc -%}
  Shared Get In Touch fields used by the page form and the header modal.
  Role is free-form. Company is required. Job Title dropdowns are not used.
{%- enddoc -%}
{%- liquid
  assign submit_label = submit_label | default: 'Send message'
  assign is_contact_page = false
  if variant == 'contact'
    assign is_contact_page = true
  endif
-%}

<div class="vh-form__grid">
  <label class="vh-form__field">
    <span class="visually-hidden">First name (required)</span>
    <input
      type="text"
      name="contact[first_name]"
      placeholder="First name*"
      value="{{ customer.first_name }}"
      required
      autocomplete="given-name"
    >
  </label>
  <label class="vh-form__field">
    <span class="visually-hidden">Last name</span>
    <input
      type="text"
      name="contact[last_name]"
      placeholder="Last name"
      value="{{ customer.last_name }}"
      autocomplete="family-name"
    >
  </label>
  <label class="vh-form__field">
    <span class="visually-hidden">Email (required)</span>
    <input
      type="email"
      name="contact[email]"
      placeholder="{% if is_contact_page %}Work email*{% else %}Email*{% endif %}"
      value="{{ customer.email }}"
      required
      autocomplete="email"
    >
  </label>
  <label class="vh-form__field">
    <span class="visually-hidden">Phone number</span>
    <input
      type="tel"
      name="contact[phone]"
      placeholder="Phone number"
      value="{{ customer.phone }}"
      autocomplete="tel"
    >
  </label>
  <label class="vh-form__field">
    <span class="visually-hidden">Company (required)</span>
    <input type="text" name="contact[company]" placeholder="Company*" autocomplete="organization" required>
  </label>
  <label class="vh-form__field">
    <span class="visually-hidden">Role</span>
    <input type="text" name="contact[role]" placeholder="Role" autocomplete="organization-title">
  </label>
</div>
{% if is_contact_page %}
  <label class="vh-form__select vh-form__select--wide">
    <span class="visually-hidden">What would you like to discuss?</span>
    <select name="contact[interest]" aria-label="What would you like to discuss?">
      <option value="" selected>What would you like to discuss?</option>
      <option value="Supplier finding or follow-up">Supplier finding or follow-up</option>
      <option value="ESG reporting gap">ESG reporting gap</option>
      <option value="Audit follow-up">Audit follow-up</option>
      <option value="Operational resilience">Operational resilience</option>
      <option value="Supply chain risk">Supply chain risk</option>
      <option value="Not sure yet">Not sure yet</option>
    </select>
  </label>
{% elsif solutions_form == false or solutions_form == nil %}
  <label class="vh-form__select vh-form__select--wide">
    <span class="visually-hidden">I am interested in</span>
    <select name="contact[interest]" aria-label="I am interested in">
      <option value="" disabled selected>I am interested in...</option>
      <option value="Solutions">Solutions</option>
      <option value="Marketplace and courses">Marketplace and courses</option>
      <option value="Partnership">Partnership</option>
      <option value="Careers">Careers</option>
      <option value="Other">Other</option>
    </select>
  </label>
{% endif %}
<label class="vh-form__field vh-form__field--wide">
  <span class="visually-hidden">Message</span>
  <textarea name="contact[body]" placeholder="{% if is_contact_page %}Tell us what is happening, what is getting in the way, and what you would like to improve.{% else %}Message here...{% endif %}"></textarea>
</label>
<button class="vh-btn vh-btn--green" type="submit">
  {{ submit_label }}
  <img src="{{ img_arrow }}" alt="">
</button>
