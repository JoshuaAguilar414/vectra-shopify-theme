{%- doc -%}
  Shared Get In Touch fields used by the page form and the header modal.
{%- enddoc -%}
{%- liquid
  assign submit_label = submit_label | default: 'Send message'
  assign is_contact_page = false
  if variant == 'contact'
    assign is_contact_page = true
  endif
-%}

<div class="vh-form__grid">
  <input
    type="text"
    name="contact[first_name]"
    placeholder="First Name*"
    value="{{ customer.first_name }}"
    required
    autocomplete="given-name"
  >
  <input
    type="text"
    name="contact[last_name]"
    placeholder="Last Name*"
    value="{{ customer.last_name }}"
    required
    autocomplete="family-name"
  >
  <input
    type="email"
    name="contact[email]"
    placeholder="{% if is_contact_page %}Work Email*{% else %}Email*{% endif %}"
    value="{{ customer.email }}"
    required
    autocomplete="email"
  >
  <input
    type="tel"
    name="contact[phone]"
    placeholder="Phone Number{% unless is_contact_page %}*{% endunless %}"
    value="{{ customer.phone }}"
    autocomplete="tel"
    {% if solutions_form %}required{% endif %}
  >
  <input type="text" name="contact[company]" placeholder="Company*" autocomplete="organization"{% if solutions_form or is_contact_page %} required{% endif %}>
  {% if is_contact_page %}
    <input type="text" name="contact[job_title]" placeholder="Job Title / Role" autocomplete="organization-title">
  {% elsif solutions_form %}
    <input type="text" name="contact[job_title]" placeholder="Job Title*" required autocomplete="organization-title">
  {% else %}
    <label class="vh-form__select">
      <span class="visually-hidden">Job Title</span>
      <select name="contact[job_title]" aria-label="Job Title" required>
        <option value="" disabled selected>Job Title*</option>
        <option value="Executive / C-level">Executive / C-level</option>
        <option value="Director">Director</option>
        <option value="Manager">Manager</option>
        <option value="Specialist">Specialist</option>
        <option value="Consultant">Consultant</option>
        <option value="Other">Other</option>
      </select>
    </label>
  {% endif %}
</div>
{% if is_contact_page %}
  <label class="vh-form__select vh-form__select--wide">
    <span class="visually-hidden">What would you like to discuss?</span>
    <select name="contact[interest]" aria-label="What would you like to discuss?" required>
      <option value="" disabled selected>What would you like to discuss?*</option>
      <option value="Supplier finding or follow-up">Supplier finding or follow-up</option>
      <option value="ESG reporting gap">ESG reporting gap</option>
      <option value="Audit follow-up">Audit follow-up</option>
      <option value="Operational resilience">Operational resilience</option>
      <option value="Supply chain risk">Supply chain risk</option>
      <option value="Not sure yet">Not sure yet</option>
    </select>
  </label>
{% elsif solutions_form == false or solutions_form == nil %}
  <label class="vh-form__select vh-form__select--wide">
    <span class="visually-hidden">I'm interested in</span>
    <select name="contact[interest]" aria-label="I'm interested in">
      <option value="" disabled selected>I'm interested in...</option>
      <option value="Solutions">Solutions</option>
      <option value="Marketplace & courses">Marketplace &amp; courses</option>
      <option value="VSuites">VSuites</option>
      <option value="Partnership">Partnership</option>
      <option value="Careers">Careers</option>
      <option value="Other">Other</option>
    </select>
  </label>
{% endif %}
<textarea name="contact[body]" placeholder="{% if is_contact_page %}Tell us what is happening, what is getting in the way, and what you would like to improve.{% else %}Message Here...{% endif %}"></textarea>
<button class="vh-btn vh-btn--green" type="submit">
  {{ submit_label }}
  <img src="{{ img_arrow }}" alt="">
</button>
