{%- doc -%}
  Renders Experts / Associates / Interns / Careers / FAQ / Contact / Risk Assessment when a Shopify page
  uses the Default template instead of the dedicated VECTRA template.
{%- enddoc -%}
{%- liquid
  assign handle = page.handle
  assign people = false
  assign course = false
  assign contact = false
  assign risk = false
  case handle
    when 'experts', 'associates', 'interns', 'careers', 'faq'
      assign people = true
    when 'marketplace', 'course-esg-acronyms', 'course-preventative-measures', 'course-purchasing-practices', 'course-disability-accommodation'
      assign course = true
    when 'contact', 'contact-us'
      assign contact = true
    when 'risk-assessment', 'services-risk-assessment'
      assign risk = true
  endcase
-%}
{%- if people -%}
  {% capture children %}
    {% render 'vectra-header' %}
    {% render 'vectra-people-modules', module: handle %}
  {% endcapture %}
  {% render 'vectra-page-shell', children: children, include_story: true %}
{%- elsif course -%}
  {% capture children %}
    {% render 'vectra-header' %}
    {% if handle == 'marketplace' %}
      {% render 'vectra-course-modules', module: 'catalog' %}
    {% else %}
      {% render 'vectra-course-modules', module: 'detail', course_key: handle %}
    {% endif %}
  {% endcapture %}
  {% render 'vectra-page-shell', children: children %}
{%- elsif contact -%}
  {% capture children %}
    {% render 'vectra-header' %}
    {% render 'vectra-contact-modules', module: 'hero' %}
    {% render 'vectra-contact-modules', module: 'challenges' %}
    {% render 'vectra-contact-modules', module: 'next' %}
    {% render 'vectra-contact-modules', module: 'direct' %}
  {% endcapture %}
  {% render 'vectra-page-shell', children: children, include_resources: true %}
{%- elsif risk -%}
  {% capture children %}
    {% render 'vectra-header' %}
    {% render 'vectra-risk-modules', module: 'hero' %}
    {% render 'vectra-risk-modules', module: 'why' %}
    {% render 'vectra-risk-modules', module: 'screening' %}
    {% render 'vectra-risk-modules', module: 'expect' %}
    {% render 'vectra-risk-modules', module: 'faq' %}
  {% endcapture %}
  {% render 'vectra-page-shell', children: children, include_resources: true %}
{%- endif -%}
