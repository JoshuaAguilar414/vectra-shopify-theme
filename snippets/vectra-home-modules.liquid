  {% when 'marketplace' %}
{% unless block.settings.hide_section %}
{% capture market_text_fallback %}Explore 100+ expert-led courses across ESG, sustainability, responsible business, compliance, due diligence, and supply chains.

Whether it's one person trying to get their head around a new requirement, or a whole team that needs to be speaking the same language, Marketplace gives people somewhere real to start.{% endcapture %}
{% liquid
  assign market_kicker = block.settings.kicker | default: 'VECTRA MARKETPLACE'
  assign market_heading = block.settings.heading | default: 'Learn What You Need. Apply It With Confidence.'
  assign market_text = block.settings.text | default: market_text_fallback
  assign market_btn = block.settings.button_label | default: 'Find the Right Course'
  if block.settings.button_link != blank
    assign market_cta = block.settings.button_link
  else
    assign market_cta = marketplace_href
  endif
  assign topics_heading = block.settings.topics_heading | default: 'Relevant Topics'
  assign topic_label = block.settings.topic_label | default: 'Certificate Course'
  assign price_label = block.settings.price_label | default: 'Coming to Marketplace'
  assign pill_1 = block.settings.pill_1 | default: 'Most Popular →'
  assign pill_2 = block.settings.pill_2 | default: 'By Regulation →'
  assign pill_3 = block.settings.pill_3 | default: 'By Role →'
  if block.settings.course_image_1 != blank
    assign img_course_1 = block.settings.course_image_1 | image_url: width: 640
  endif
  if block.settings.course_image_2 != blank
    assign img_course_2 = block.settings.course_image_2 | image_url: width: 640
  endif
  if block.settings.course_image_3 != blank
    assign img_course_3 = block.settings.course_image_3 | image_url: width: 640
  endif
  if block.settings.course_image_4 != blank
    assign img_course_4 = block.settings.course_image_4 | image_url: width: 640
  endif
%}
<section class="vh-market" id="marketplace" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-market__panel">
    <div class="vh-wrap">
      <div class="vh-market__head">
        <p class="vh-kicker">{{ market_kicker }}</p>
        <h2 class="vh-h2">{{ market_heading }}</h2>
        <div class="vh-lead">
          {% assign market_paras = market_text | newline_to_br | split: '<br />' %}
          {% for para in market_paras %}
            {% assign para_text = para | strip_html | strip %}
            {% if para_text != blank %}
              <p>{{ para_text }}</p>
            {% endif %}
          {% endfor %}
        </div>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ market_cta }}">{{ market_btn }}</a>
      </div>
      <form class="vh-searchbar" action="{{ routes.search_url }}" method="get" role="search">
        <label class="vh-searchbar__q">
          <span class="vh-searchbar__icon" aria-hidden="true">{{ 'icon-search.svg' | inline_asset_content }}</span>
          <input type="hidden" name="type" value="product">
          <input type="search" name="q" placeholder="Search courses, assessments and bundles" aria-label="Search courses">
        </label>
        <select aria-label="Role"><option>Role</option></select>
        <select aria-label="Regulation"><option>Regulation</option></select>
        <select aria-label="Stage"><option>Stage</option></select>
      </form>

      <h2 class="vh-h2">Featured Courses</h2>
      {% liquid
        assign course_products = collections['courses'].products
        if block.settings.collection != blank
          assign course_products = block.settings.collection.products
        endif
        if course_products.size == 0
          assign course_products = collections['frontpage'].products
        endif
        if course_products.size == 0
          assign course_products = collections.all.products
        endif
        assign explore_courses_label = block.settings.explore_courses_label | default: 'Explore All Courses'
        if block.settings.explore_courses_link != blank
          assign explore_courses_href = block.settings.explore_courses_link
        else
          assign explore_courses_href = market_cta
        endif
      %}
      <div class="vh-courses">
        {% if course_products.size > 0 %}
          {% for product in course_products limit: 4 %}
            <article class="vh-course">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', alt: product.title }}
              {% else %}
                <img src="{{ img_course_1 }}" alt="">
              {% endif %}
              <div class="vh-course__body">
                <h3>{{ product.title }}</h3>
                <div class="vh-course__meta">
                  <span class="vh-price">{% if product.price > 0 %}{{ product.price | money }}{% else %}{{ price_label }}{% endif %}</span>
                  <a class="vh-course__cta" href="{{ product.url }}">View Course</a>
                </div>
              </div>
            </article>
          {% endfor %}
        {% else %}
          <article class="vh-course">
            <img src="{{ img_course_1 }}" alt="">
            <div class="vh-course__body">
              <h3>Acronyms Used in ESG Area</h3>
              <div class="vh-course__meta">
                <span class="vh-price">{{ price_label }}</span>
                <a class="vh-course__cta" href="{{ course_esg_href }}">View Course</a>
              </div>
            </div>
          </article>
          <article class="vh-course">
            <img src="{{ img_course_2 }}" alt="">
            <div class="vh-course__body">
              <h3>Preventative and Corrective Measures</h3>
              <div class="vh-course__meta">
                <span class="vh-price">{{ price_label }}</span>
                <a class="vh-course__cta" href="{{ course_prev_href }}">View Course</a>
              </div>
            </div>
          </article>
          <article class="vh-course">
            <img src="{{ img_course_3 }}" alt="">
            <div class="vh-course__body">
              <h3>Optimizing Purchasing Practices</h3>
              <div class="vh-course__meta">
                <span class="vh-price">{{ price_label }}</span>
                <a class="vh-course__cta" href="{{ course_buy_href }}">View Course</a>
              </div>
            </div>
          </article>
          <article class="vh-course">
            <img src="{{ img_course_4 }}" alt="">
            <div class="vh-course__body">
              <h3>Disability Accommodation Training</h3>
              <div class="vh-course__meta">
                <span class="vh-price">{{ price_label }}</span>
                <a class="vh-course__cta" href="{{ course_dis_href }}">View Course</a>
              </div>
            </div>
          </article>
        {% endif %}
      </div>
      <div class="vh-courses__more">
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ explore_courses_href }}">{{ explore_courses_label }}</a>
      </div>

      {% unless block.settings.hide_topics %}
      <div class="vh-topics">
        <h2 class="vh-h2">{{ topics_heading }}</h2>
        <div class="vh-pills">
          {% if pill_1 != blank %}<span class="vh-pill">{{ pill_1 }}</span>{% endif %}
          {% if pill_2 != blank %}<span class="vh-pill">{{ pill_2 }}</span>{% endif %}
          {% if pill_3 != blank %}<span class="vh-pill">{{ pill_3 }}</span>{% endif %}
        </div>
        <div class="vh-topics__list">
          {% if course_products.size > 0 %}
            {% for product in course_products limit: 3 %}
              <article class="vh-topic-card">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', alt: product.title }}
                {% else %}
                  <img src="{{ img_course_2 }}" alt="">
                {% endif %}
                <div class="vh-topic-card__body">
                  <span class="vh-topic-card__label">{{ topic_label }}</span>
                  <h3>{{ product.title }}</h3>
                  <p>{{ product.description | strip_html | truncate: 220 }}</p>
                  <div class="vh-course__meta">
                    <span class="vh-price">{{ price_label }}</span>
                    <a class="vh-course__cta" href="{{ product.url }}">View Course</a>
                  </div>
                </div>
              </article>
            {% endfor %}
          {% else %}
          <article class="vh-topic-card">
            <img src="{{ img_course_2 }}" alt="">
            <div class="vh-topic-card__body">
              <span class="vh-topic-card__label">{{ topic_label }}</span>
              <h3>Preventative and Corrective Measures</h3>
              <p>
                This course provides a comprehensive framework for managing supply chain due diligence in 2026. It focuses on the dual approach of using preventative measures as a “proactive shield” to avoid crises and corrective measures as a “surgical fix” to address and remediate existing violations.
              </p>
              <div class="vh-course__meta">
                <span class="vh-price">{{ price_label }}</span>
                <a class="vh-course__cta" href="{{ course_prev_href }}">View course</a>
              </div>
            </div>
          </article>
          <article class="vh-topic-card">
            <img src="{{ img_course_3 }}" alt="">
            <div class="vh-topic-card__body">
              <span class="vh-topic-card__label">{{ topic_label }}</span>
              <h3>Optimizing Purchasing Practices</h3>
              <p>
                Learn how purchasing decisions shape supplier performance, cost, and ESG outcomes—and how to build practices that hold up under scrutiny.
              </p>
              <div class="vh-course__meta">
                <span class="vh-price">{{ price_label }}</span>
                <a class="vh-course__cta" href="{{ course_buy_href }}">View course</a>
              </div>
            </div>
          </article>
          <article class="vh-topic-card">
            <img src="{{ img_course_1 }}" alt="">
            <div class="vh-topic-card__body">
              <span class="vh-topic-card__label">{{ topic_label }}</span>
              <h3>Acronyms Used in ESG Area</h3>
              <p>
                Build a shared vocabulary for ESG, due diligence, and supply-chain reporting so teams can act faster and with less confusion.
              </p>
              <div class="vh-course__meta">
                <span class="vh-price">{{ price_label }}</span>
                <a class="vh-course__cta" href="{{ course_esg_href }}">View course</a>
              </div>
            </div>
          </article>
          {% endif %}
        </div>
      </div>
      {% endunless %}
    </div>
    </div>
  </section>
{% endunless %}

