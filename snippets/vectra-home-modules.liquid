  assign img_mail = 'vectra-9a4f80a5b924a881fc96b20219bb1f7c8ca734ab.svg' | asset_url
  assign img_phone = 'vectra-7c0e54b37d57d95df328b0e4ee1f7b87844a7372.svg' | asset_url
  assign img_pin = 'vectra-484bca36e3874bd30d1d6dd79807ed0314378e3d.svg' | asset_url
  assign img_chat = 'vectra-da137306dcbc6716d83295ef75678ab141a500e1.svg' | asset_url
  assign img_social = 'vectra-8edaf1fb1163eb6b857092f513083a6fc9fdc561.svg' | asset_url
  assign img_sol_1 = 'vectra-d7047ac7e66609406a0cb2e3fa6ac8ad2faf5cca.png' | asset_url
  assign img_sol_2 = 'vectra-add817f67c59297c528c5d57486a2794644fb47c.png' | asset_url
  assign img_sol_3 = 'vectra-d9fea5c48820c581c90942feb5bfc3997b28135f.png' | asset_url
  assign img_sol_4 = 'vectra-a22c67e8c858a4742869caed8035aebee50f5996.png' | asset_url
  assign img_course_1 = 'vectra-514da1e5ddd8e93543da62a9818e4183b5547b3a.png' | asset_url
  assign img_course_2 = 'vectra-01d26f601c057ccb6b54759c020d48ae5de18cf3.png' | asset_url
  assign img_course_3 = 'vectra-78626510a1ed0aa2ddc4170280cbb69d727b4968.png' | asset_url
  assign img_course_4 = 'vectra-ae8b362b8368e8b200e58c921e1c7c274608a975.png' | asset_url
  assign img_logo_ms = 'vectra-a4cdfe52a81d802c9aaf6b7bf6d694343cbedde4.png' | asset_url
  assign img_logo_copper = 'vectra-e1d133cc580029cb6b8074e5aae5a7dda46406b4.png' | asset_url
  assign img_logo_rba = 'vectra-b45406e535c5bbc9c26b808cd8cbca66f572f9e7.png' | asset_url
  assign img_logo_otto = 'vectra-f9891ea3bc104013ef4392a154f93dad123a8da6.png' | asset_url
  assign img_logo_applied = 'vectra-08b090be3b1f1972589bc05ef1d4cf3d74f30fca.png' | asset_url
  assign img_logo_adidas = 'vectra-cb8e65114981244bc1e02bd76e369c2e9275bc0b.png' | asset_url
  assign img_logo_better = 'vectra-ac45449dcc22ca95791fd9c0955f7d62850045d2.png' | asset_url
  assign img_logo_jysk = 'vectra-fc0d652f27cfacfaf98915d93a3a90bbb65771bf.png' | asset_url
  assign img_crh = 'vectra-28a1d7e111c00e8a7fc45b900983e7447e9874e4.png' | asset_url
  assign img_kodak = 'vectra-c581678ac8eabd45e9273d17ceb6fa657d364dc9.png' | asset_url
  assign img_careers = 'vectra-8dd632f9a55b50e7d1bc55dc9197d46aa4f6588a.png' | asset_url
  assign img_blog_1 = img_sol_1
  assign img_blog_2 = img_sol_4
  assign img_blog_3 = img_sol_2
  assign careers_url = pages['careers'].url | default: '/pages/careers'
  assign marketplace_url = pages['marketplace'].url | default: '/pages/marketplace'
  assign resources_base = pages['resources'].url | default: '/pages/resources'
  assign course_esg = pages['course-esg-acronyms'].url | default: '/pages/course-esg-acronyms'
  assign course_prev = pages['course-preventative-measures'].url | default: '/pages/course-preventative-measures'
  assign course_buy = pages['course-purchasing-practices'].url | default: '/pages/course-purchasing-practices'
  assign course_dis = pages['course-disability-accommodation'].url | default: '/pages/course-disability-accommodation'
  assign faq_base = pages['faq'].url | default: '/pages/faq'
%}
{% capture faq_href %}{% render 'vectra-preview-href', url: faq_base, view: 'faq' %}{% endcapture %}
{% capture marketplace_href %}{% render 'vectra-preview-href', url: marketplace_url, view: 'marketplace' %}{% endcapture %}
{% capture resources_href %}{% render 'vectra-preview-href', url: resources_base, view: 'resources' %}{% endcapture %}
{% capture course_esg_href %}{% render 'vectra-preview-href', url: course_esg, view: 'course' %}{% endcapture %}
{% capture course_prev_href %}{% render 'vectra-preview-href', url: course_prev, view: 'course' %}{% endcapture %}
{% capture course_buy_href %}{% render 'vectra-preview-href', url: course_buy, view: 'course' %}{% endcapture %}
{% capture course_dis_href %}{% render 'vectra-preview-href', url: course_dis, view: 'course' %}{% endcapture %}
{% assign faq_href = faq_href | strip %}
{% assign marketplace_href = marketplace_href | strip %}
{% assign resources_href = resources_href | strip %}
{% assign course_esg_href = course_esg_href | strip %}
{% assign course_prev_href = course_prev_href | strip %}
{% assign course_buy_href = course_buy_href | strip %}
{% assign course_dis_href = course_dis_href | strip %}
{% case module %}
  {% when 'hero' %}
{% render 'vectra-seo', page_key: 'home' %}
{% unless block.settings.hide_section %}
{% assign nested_slides = nested_slides | strip %}
<section class="vh-hero" data-vh-carousel aria-label="Featured" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-hero__track" data-vh-track>
      {% if nested_slides != blank %}
        {{ nested_slides }}
      {% else %}
      <article class="vh-hero__slide is-active" data-vh-slide>
        <img src="{{ img_hero }}" alt="VECTRA team collaborating" width="1920" height="1080">
        <div class="vh-hero__copy">
          <h1 data-vh-hero-el>Business Resilience Partner for Responsible Business &amp; Operational Resilience</h1>
          <p class="vh-hero__display" data-vh-hero-el>Turn Business Complexity Into Resilient Performance</p>
          <p data-vh-hero-el>
            Responsible business practices are the standards, controls, and decisions organizations use to manage supplier risk, environmental and social impact, and regulatory obligations across their operations. VECTRA International is a business resilience partner that turns those practices into clear ownership, practical action, and measurable performance, not just policy.
          </p>
        </div>
      </article>
      <article class="vh-hero__slide" data-vh-slide>
        <img src="{{ img_hero_2 }}" alt="Responsible supply chains in motion" width="1920" height="1080">
        <div class="vh-hero__copy">
          <p class="vh-hero__display">Business Resilience &amp; Operational Capability Building</p>
          <p>
            VECTRA helps organizations turn complex operational, supplier, and responsible business issues into clear ownership, practical action, and stronger control. From strategy through implementation, we stay accountable for moving the work forward.
          </p>
        </div>
      </article>
      {% endif %}
    </div>
    <button class="vh-hero__arrow vh-hero__arrow--prev" type="button" data-vh-prev aria-label="Previous slide">
      <img class="vh-hero__arrow-bg" src="{{ img_arrow_circle }}" alt="">
      <img class="vh-hero__arrow-icon" src="{{ img_arrow_white }}" alt="">
    </button>
    <button class="vh-hero__arrow vh-hero__arrow--next" type="button" data-vh-next aria-label="Next slide">
      <img class="vh-hero__arrow-bg" src="{{ img_arrow_circle }}" alt="">
      <img class="vh-hero__arrow-icon" src="{{ img_arrow_white }}" alt="">
    </button>
  </section>
{% endunless %}

  {% when 'trust' %}
{% unless block.settings.hide_section %}
{% liquid
  assign trust_heading = block.settings.heading | default: '20+ Years of Experience. 500+ Organizations Supported.'
  assign trust_btn = block.settings.button_label | default: 'Explore Case Studies'
  assign trust_link = block.settings.button_link | default: '#cases'
%}
<section class="vh-trust" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-wrap">
      <div class="vh-trust__row">
        <div class="vh-seal" aria-hidden="true">
          {% render 'vectra-image', image: block.settings.badge, fallback: img_seal, alt: '', width: 198, height: 193, image_width: 400 %}
        </div>
        <div class="vh-trust__copy">
          <h2 data-vh-reveal="left">{{ trust_heading }}</h2>
          <div class="vh-trust__actions">
            <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ trust_link }}" data-vh-reveal="scale">
              {{ trust_btn }}
            </a>
            {% if block.settings.button_2_label != blank %}
              <a class="vh-btn vh-btn--outline" href="{{ block.settings.button_2_link | default: '#' }}" data-vh-reveal="scale">
                {{ block.settings.button_2_label }}
              </a>
            {% endif %}
          </div>
          {% assign nested_extras = nested_extras | strip %}
          {% if nested_extras != blank %}
            <div class="vh-block-extras">{{ nested_extras }}</div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endunless %}

  {% when 'logos' %}
{% unless block.settings.hide_section %}
{% assign nested_logos = nested_logos | strip %}
<div class="vh-logos" aria-label="Trusted by" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-logos__track" data-vh-marquee>
      {% if nested_logos != blank %}
        {{ nested_logos }}
      {% else %}
      {% for i in (1..2) %}
        <img src="{{ img_logo_ms }}" alt="{% if i == 1 %}Marks & Spencer{% endif %}">
        <img src="{{ img_logo_copper }}" alt="{% if i == 1 %}The Copper Mark{% endif %}">
        <img src="{{ img_logo_rba }}" alt="{% if i == 1 %}Responsible Business Alliance{% endif %}">
        <img src="{{ img_logo_otto }}" alt="{% if i == 1 %}OTTO{% endif %}">
        <img src="{{ img_logo_applied }}" alt="{% if i == 1 %}Applied Materials{% endif %}">
        <img src="{{ img_logo_adidas }}" alt="{% if i == 1 %}adidas{% endif %}">
        <img src="{{ img_logo_better }}" alt="{% if i == 1 %}BetterWork{% endif %}">
        <img src="{{ img_logo_jysk }}" alt="{% if i == 1 %}JYSK{% endif %}">
      {% endfor %}
      {% endif %}
    </div>
  </div>
{% endunless %}

  {% when 'impact' %}
{% unless block.settings.hide_section %}
<section class="vh-impact" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-wrap">
      {% if block.settings.image != blank %}
        {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: 'Enabling Positive Business Impact' }}
      {% else %}
      <h2 data-vh-reveal="scale" aria-label="Enabling Positive Business Impact">
        <span class="vh-impact__word">Enabling</span>
        <span class="vh-impact__word vh-impact__positive">P<img class="vh-impact__mark" src="{{ img_mark }}" alt="" width="37" height="37">siti<img class="vh-impact__v" src="{{ img_check }}" alt="" width="40" height="49">e</span>
        <span class="vh-impact__word">Business Impact</span>
      </h2>
      {% endif %}
    </div>
  </section>
{% endunless %}

  {% when 'why' %}
{% unless block.settings.hide_section %}
{% liquid
  assign why_kicker = block.settings.kicker | default: 'WHY VECTRA'
  assign why_heading = block.settings.heading | default: 'Why Choose VECTRA as Your<br>Business Resilience Partner'
  assign why_text = block.settings.text | default: 'A report can tell you what needs to change. A dashboard can show you where the problem is showing up. The harder part is turning that information into clear ownership, practical action, and a change that holds. VECTRA works with your teams, suppliers, and existing systems as decisions move into practice.'
  assign why_btn = block.settings.button_label | default: 'See Why VECTRA'
  assign why_link = block.settings.button_link | default: '#solutions'
  assign nested_cards = nested_cards | strip
%}
<section class="vh-why" id="why-vectra" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-wrap vh-why__grid">
      <div class="vh-why__media">
        {% render 'vectra-image', image: block.settings.image, fallback: img_why, alt: 'VECTRA International facility', width: 980, height: 720, image_width: 1600 %}
      </div>
      <div class="vh-why__copy" data-vh-reveal>
        <p class="vh-kicker vh-kicker--arrows">
          <img src="{{ img_kicker_l }}" alt="" class="vh-kicker__arrow vh-kicker__arrow--l">
          {{ why_kicker }}
          <img src="{{ img_kicker_r }}" alt="" class="vh-kicker__arrow">
        </p>
        <h2>{{ why_heading }}</h2>
        <p>{{ why_text }}</p>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ why_link }}">
          {{ why_btn }}
          <img src="{{ img_arrow }}" alt="">
        </a>
        {% if block.settings.button_2_label != blank %}
          <a class="vh-btn vh-btn--outline" href="{{ block.settings.button_2_link | default: '#' }}" style="margin-top: 12px;">
            {{ block.settings.button_2_label }}
          </a>
        {% endif %}
      </div>
    </div>
    <div class="vh-wrap vh-why__list">
      {% if nested_cards != blank %}
        {{ nested_cards }}
      {% else %}
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_4 }}" alt="">
        <h3>Partnership With Accountability</h3>
        <p>We agree what needs to improve first, then keep the work tied to that outcome as it moves into practice.</p>
      </article>
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_3 }}" alt="">
        <h3>Human-Led.<br>AI-Enabled</h3>
        <p>Technology helps us work through large volumes of supplier information, identify patterns behind repeat findings, and keep evidence current. Experienced people remain accountable for judgment, context, and decisions.</p>
      </article>
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_2 }}" alt="">
        <h3>Expertise Built Around Your Challenge</h3>
        <p>Your problem should not have to fit our org chart. We bring together the specialists and capabilities the work requires.</p>
      </article>
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_1 }}" alt="">
        <h3>Progress You Can Measure</h3>
        <p>We agree what improvement should look like at the start, then track what changed and what still needs attention.</p>
      </article>
      {% endif %}
    </div>
  </section>
{% endunless %}

  {% when 'esg' %}
{% unless block.settings.hide_section %}
{% liquid
  assign esg_heading = block.settings.heading | default: 'Helping Organizations Build<br>Long-Term Business Resilience'
  assign esg_text = block.settings.text | default: 'Since 2005, VECTRA International has worked across responsible business, supply chains, and operational improvement. That experience now supports a broader role in business resilience and operational capability building.'
  assign esg_s1v = block.settings.stat_1_value | default: '100+'
  assign esg_s1l = block.settings.stat_1_label | default: 'Experts Worldwide'
  assign esg_s2v = block.settings.stat_2_value | default: '20+'
  assign esg_s2l = block.settings.stat_2_label | default: 'Years of Experience'
  assign esg_s3v = block.settings.stat_3_value | default: '500+'
  assign esg_s3l = block.settings.stat_3_label | default: 'Satisfied Clients'
%}
<section class="vh-esg" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-esg__stage">
      <div class="vh-esg__glow" aria-hidden="true"></div>
      <div class="vh-esg__copy" data-vh-reveal>
        <h2>{{ esg_heading }}</h2>
        <p class="vh-lead">{{ esg_text }}</p>
      </div>
      <div class="vh-stat vh-stat--100" data-vh-reveal="right"><b>{{ esg_s1v }}</b><span>{{ esg_s1l }}</span></div>
      <div class="vh-stat vh-stat--30" data-vh-reveal="left"><b>{{ esg_s2v }}</b><span>{{ esg_s2l }}</span></div>
      <div class="vh-stat vh-stat--500" data-vh-reveal="up"><b>{{ esg_s3v }}</b><span>{{ esg_s3l }}</span></div>
    </div>
  </section>
{% endunless %}

  {% when 'solutions' %}
{% unless block.settings.hide_section %}
{% liquid
  assign sol_kicker = block.settings.kicker | default: 'VECTRA Solutions'
  assign sol_heading = block.settings.heading | default: 'Responsible Business Transformation That Creates Value'
  assign sol_btn = block.settings.button_label | default: 'Talk to an Expert →'
  if block.settings.button_link != blank
    assign sol_cta = block.settings.button_link
  else
    assign sol_cta = '#VectraContactModal'
  endif
  assign nested_shots = nested_shots | strip
%}
<section class="vh-solutions" id="solutions" data-vh-solutions style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-solutions__canvas">
      <div class="vh-solutions__head" data-vh-reveal>
        <p class="vh-kicker">{{ sol_kicker }}</p>
        <h2>{{ sol_heading }}</h2>
      </div>
      <div class="vh-solutions__body">
        <div class="vh-solutions__copy" data-vh-sol-copy>
          <h3 data-vh-sol-title>Operational Resilience</h3>
          <p data-vh-sol-text>Build stronger operational control, continuity, and response capability so critical work keeps moving when conditions change.</p>
              <a class="vh-btn vh-btn--green vh-btn--rect" href="#VectraContactModal" data-vh-contact-open data-vh-sol-cta>Explore Operational Resilience</a>
        </div>
        <div class="vh-solutions__gallery">
          {% if nested_shots != blank %}
            {{ nested_shots }}
          {% else %}
          <button
            class="vh-sol-shot is-active"
            type="button"
            data-vh-sol-item
            data-title="Operational Resilience"
            data-text="Build stronger operational control, continuity, and response capability so critical work keeps moving when conditions change."
            data-cta="Explore Operational Resilience"
          >
            <img src="{{ img_sol_2 }}" alt="Operational resilience">
          </button>
          <button
            class="vh-sol-shot"
            type="button"
            data-vh-sol-item
            data-title="Value Chain Resilience &amp; Improvement"
            data-text="Identify where supplier and supply chain risk sits, prioritize what matters, and turn findings into practical improvement."
            data-cta="Explore Value Chain Resilience &amp; Improvement"
          >
            <img src="{{ img_hero_2 }}" alt="Governance and regulatory readiness">
          </button>
          <button
            class="vh-sol-shot"
            type="button"
            data-vh-sol-item
            data-title="Responsible Business Performance"
            data-text="Turn responsible-business requirements into clearer decisions, reliable evidence, and practical improvement."
            data-cta="Explore Responsible Business Performance"
          >
            <img src="{{ img_sol_3 }}" alt="Responsible business performance">
          </button>
          <button
            class="vh-sol-shot"
            type="button"
            data-vh-sol-item
            data-title="Governance &amp; Regulatory Readiness"
            data-text="Turn changing requirements into workable controls, clear ownership, and evidence your teams can defend."
            data-cta="Explore Governance &amp; Regulatory Readiness"
          >
            <img src="{{ img_sol_1 }}" alt="Governance and regulatory readiness">
          </button>
          <button
            class="vh-sol-shot"
            type="button"
            data-vh-sol-item
            data-title="Capability Building at Scale"
            data-text="Build the practical knowledge and capability teams and suppliers need to apply change and keep it working."
            data-cta="Explore Capability Building at Scale"
          >
            <img src="{{ img_course_4 }}" alt="Capability building at scale">
          </button>
          <button
            class="vh-sol-shot vh-sol-shot--plus"
            type="button"
            data-vh-sol-item
            data-title="Customized Business Solutions"
            data-text="Some issues span suppliers, systems, evidence, capability, and operations at once. Start with the problem. We'll help identify the right mix of expertise and support."
            data-cta="Talk to an Expert"
          >
            <img src="{{ img_sol_4 }}" alt="Customized business solutions">
          </button>
          {% endif %}
        </div>
      </div>
      <div class="vh-solutions__cta">
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ sol_cta }}"{% if sol_cta == '#VectraContactModal' %} data-vh-contact-open{% endif %}>
          {{ sol_btn }}
        </a>
      </div>
    </div>
  </section>
{% endunless %}

  {% when 'marketplace' %}
{% unless block.settings.hide_section %}
{% liquid
  assign market_heading = block.settings.heading | default: 'Learn What Matters. Build Capability That Lasts.'
  assign market_text = block.settings.text | default: 'Explore 100+ expert-led courses across ESG, sustainability, responsible business, compliance, due diligence, and supply chains'
  assign market_btn = block.settings.button_label | default: 'Find the Right Course'
  if block.settings.button_link != blank
    assign market_cta = block.settings.button_link
  else
    assign market_cta = marketplace_href
  endif
  assign topics_heading = block.settings.topics_heading | default: 'Relevant Topics'
  assign topic_label = block.settings.topic_label | default: 'Certificate Course'
  assign price_label = block.settings.price_label | default: 'Coming to Marketplace'
  assign pill_1 = block.settings.pill_1 | default: 'Most Popular →'
  assign pill_2 = block.settings.pill_2 | default: 'By Regulation →'
  assign pill_3 = block.settings.pill_3 | default: 'By Role →'
  if block.settings.course_image_1 != blank
    assign img_course_1 = block.settings.course_image_1 | image_url: width: 640
  endif
  if block.settings.course_image_2 != blank
    assign img_course_2 = block.settings.course_image_2 | image_url: width: 640
  endif
  if block.settings.course_image_3 != blank
    assign img_course_3 = block.settings.course_image_3 | image_url: width: 640
  endif
  if block.settings.course_image_4 != blank
