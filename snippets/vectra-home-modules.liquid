          assign resources_url = block.settings.button_link
        else
          assign resources_url = pages['resources'].url | default: '/pages/resources'
        endif
        if block.settings.image_1 != blank
          assign img_blog_1 = block.settings.image_1 | image_url: width: 800
        endif
        if block.settings.image_2 != blank
          assign img_blog_2 = block.settings.image_2 | image_url: width: 800
        endif
        if block.settings.image_3 != blank
          assign img_blog_3 = block.settings.image_3 | image_url: width: 800
        endif
      %}
      <div class="vh-blog__grid">
        {% if insight_blog != blank and insight_blog.articles_count > 0 %}
          {% for article in insight_blog.articles limit: 3 %}
            <article class="vh-article"{% if forloop.first %} data-vh-reveal="up"{% endif %}>
              {% if article.image %}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}
              {% else %}
                <img src="{{ img_blog_1 }}" alt="">
              {% endif %}
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
              <h3>{{ article.title }}</h3>
              <a class="vh-read" href="{{ article.url }}">Read More</a>
            </article>
          {% endfor %}
        {% else %}
        <article class="vh-article" data-vh-reveal="up">
          <img src="{{ img_blog_1 }}" alt="">
          <time datetime="2025-01-25">January 25, 2025</time>
          <h3>From insight to the decision that has to follow</h3>
          <a class="vh-read" href="{{ resources_url }}">Read More</a>
        </article>
        <article class="vh-article">
          <img src="{{ img_blog_2 }}" alt="">
          <time datetime="2025-01-25">January 25, 2025</time>
          <h3>Events that add context to a decision you are already making</h3>
          <a class="vh-read" href="{{ resources_url }}">Read More</a>
        </article>
        <article class="vh-article">
          <img src="{{ img_blog_3 }}" alt="">
          <time datetime="2025-01-25">January 25, 2025</time>
          <h3>What changed after the finding — and what still needs a team around it</h3>
          <a class="vh-read" href="{{ resources_url }}">Read More</a>
        </article>
        {% endif %}
      </div>
      <div class="vh-blog__more">
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ resources_url }}">{{ block.settings.button_label | default: 'See All Insights' }}</a>
      </div>
    </div>
  </section>
{% endunless %}

  {% when 'faq' %}
{% unless block.settings.hide_section %}
{% liquid
  assign faq_card_kicker = block.settings.card_kicker | default: 'TALK TO US'
  assign faq_card_title = block.settings.card_title | default: 'Tell Us What You Need Help With'
  assign faq_card_text = block.settings.card_text
  if faq_card_text == blank
    assign faq_card_text = "You may already know exactly what needs to change. Or you may simply know that something needs to work better.\n\nA supplier issue may be slowing progress. A new requirement may be creating uncertainty. Your team may need stronger evidence, better controls, or more support.\n\nTell us what is happening and what you are trying to improve. We'll listen, help make sense of the situation, and connect you with the right people."
  endif
  assign faq_kicker = block.settings.kicker | default: 'FAQ'
  assign faq_heading = block.settings.heading | default: 'Questions Business Leaders Ask Us'
  assign faq_lead = block.settings.lead | default: 'Clear answers about what VECTRA does, how we work, and where to start.'
  assign faq_btn = block.settings.button_label | default: 'Talk to a VECTRA Expert'
  if block.settings.button_link != blank
    assign faq_btn_href = block.settings.button_link
  else
    assign faq_btn_href = '#VectraContactModal'
  endif
  assign faq_more_heading = block.settings.more_heading | default: 'Have another question?'
  assign faq_more_text = block.settings.more_text | default: 'Find more answers about VECTRA International, how we work, our capabilities, and getting started.'
  assign faq_more_btn = block.settings.more_button_label | default: 'View All FAQs'
  if block.settings.more_button_link != blank
    assign faq_more_href = block.settings.more_button_link
  else
    assign faq_more_href = faq_href
  endif
  assign nested_items = nested_items | strip
%}
<section class="vh-faq" id="faq" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-wrap vh-faq__grid">
      <aside class="vh-contact-card" data-vh-reveal="left">
        <p class="vh-contact-card__kicker">{{ faq_card_kicker }}</p>
        <img class="vh-contact-card__icon" src="{{ img_chat }}" alt="">
        <p class="vh-contact-card__title">{{ faq_card_title }}</p>
        {% assign card_paras = faq_card_text | newline_to_br | split: '<br />' %}
        {% for para in card_paras %}
          {% assign para_text = para | strip_html | strip %}
          {% if para_text != blank %}
            <p>{{ para_text }}</p>
          {% endif %}
        {% endfor %}
        <a class="vh-btn vh-btn--white" href="{{ faq_btn_href }}"{% if faq_btn_href == '#VectraContactModal' %} data-vh-contact-open{% endif %}>
          {{ faq_btn }}
          <img src="{{ img_arrow }}" alt="">
        </a>
        {% render 'vectra-contact-details', variant: 'card', office_only: true, img_phone: img_phone, img_mail: img_mail, img_pin: img_pin %}
      </aside>

      <div class="vh-faq__right">
        <div class="vh-faq__glow" aria-hidden="true"></div>
        <div class="vh-accordion" data-vh-faq-accordion>
          <p class="vh-kicker">{{ faq_kicker }}</p>
          <h2 class="vh-h2">{{ faq_heading }}</h2>
          <p class="vh-lead">{{ faq_lead }}</p>
          {% if nested_items != blank %}
            {{ nested_items }}
          {% else %}
          <div class="vh-acc is-open" data-vh-faq-item>
            <button type="button" data-vh-faq-btn aria-expanded="true">What does VECTRA help organizations improve?</button>
            <div class="vh-acc__body">VECTRA helps organizations strengthen responsible business, operational resilience, supply chain resilience, and day to day business performance. Depending on the challenge, our support may include responsible business transformation, ESG consulting, sustainability consulting, supply chain consulting, technology, capability building, or implementation support. We start with the result that needs to improve, then bring the relevant expertise and support around it. Not the other way around.</div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn aria-expanded="false">We already have consultants, platforms, and dashboards. Where does VECTRA fit?</button>
            <div class="vh-acc__body" hidden>We work with what you already have. When the information, expertise, or system is already there, we focus on what's stopping it from producing the result you need. That may be ownership, process, supplier engagement, evidence, capability, or follow-through.</div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn aria-expanded="false">Can VECTRA work with the systems we already use?</button>
            <div class="vh-acc__body" hidden>Yes. VECTRA is platform-agnostic. We work with your existing systems, data, teams, consultants, and partners, then introduce additional technology only where it solves a clear problem.</div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn aria-expanded="false">Where do we start if we know the problem but not the solution?</button>
            <div class="vh-acc__body" hidden>Start by telling us what's happening and what you want to improve. We'll help clarify the issue, identify what needs attention first, and figure out the most practical next step, together.</div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn aria-expanded="false">How does VECTRA measure progress?</button>
            <div class="vh-acc__body" hidden>We agree at the start on what success should look like. Depending on the challenge, that may include clearer ownership, closed actions, stronger evidence, improved capability, fewer recurring problems, or better supplier performance.</div>
          </div>
          {% endif %}
          <div class="vh-faq__more">
            <h3>{{ faq_more_heading }}</h3>
            <p>{{ faq_more_text }}</p>
            <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ faq_more_href }}">{{ faq_more_btn }}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endunless %}

  {% when 'portal' %}
{% unless block.settings.hide_section %}
{% unless template.suffix == 'resources' %}
{% liquid
  assign is_solutions_portal = false
  if template.suffix == 'solutions'
    assign is_solutions_portal = true
  endif
  assign portal_heading = block.settings.heading
  if portal_heading == blank
    if is_solutions_portal
      assign portal_heading = 'Start with the <strong>challenge</strong> in front of you.'
    else
      assign portal_heading = 'Start a Conversation'
    endif
  endif
  assign portal_kicker = block.settings.kicker | default: "LET'S TALK"
  assign portal_text = block.settings.text
  if portal_text == blank
    if is_solutions_portal
      assign portal_text = 'We will help you determine the right combination of expert support, intelligence, and capability-building.'
    else
      assign portal_text = "You do not need a finished brief or the name of a VECTRA Service. Tell us what you are trying to improve, where you need support, or what you would like to understand better. We'll make sure the right person gets involved."
    endif
  endif
  assign portal_submit = 'Start the Conversation'
  assign portal_form_heading = 'Start a Conversation'
  if is_solutions_portal
    assign portal_submit = 'Start the Conversation'
    assign portal_form_heading = 'Talk to a VECTRA Expert'
  endif
%}
<section class="vh-portal{% if is_solutions_portal %} vh-portal--sol{% endif %}" id="{{ block.settings.anchor_id | default: 'get-in-touch' }}" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    {% if is_solutions_portal %}
      <canvas class="vh-portal__cells" data-vs-join-grid aria-hidden="true"></canvas>
    {% endif %}
    <div class="vh-wrap vh-portal__grid">
      <div class="vh-portal__copy">
        {% unless is_solutions_portal %}
          <p class="vh-kicker">{{ portal_kicker }}</p>
        {% endunless %}
        <h2>{{ portal_heading }}</h2>
        <p>{{ portal_text }}</p>
        {% unless is_solutions_portal %}
          <p class="vh-portal__tagline">Your success is our success.</p>
        {% endunless %}
      </div>
      {% if is_solutions_portal %}
        {% form 'contact', class: 'vh-form', data-vh-reveal: 'scale' %}
          <h3>{{ portal_form_heading }}</h3>
          {% render 'vectra-contact-fields', img_arrow: img_arrow, solutions_form: true, submit_label: portal_submit %}
        {% endform %}
      {% else %}
        {% form 'contact', class: 'vh-form' %}
          {% render 'vectra-contact-fields', img_arrow: img_arrow, home_form: true, submit_label: portal_submit, message_placeholder: 'Tell us what you need help with and what you would like to improve.' %}
        {% endform %}
      {% endif %}
      {% assign nested_extras = nested_extras | strip %}
      {% if nested_extras != blank %}
        <div class="vh-block-extras">{{ nested_extras }}</div>
      {% endif %}
    </div>
  </section>
{% endunless %}
{% endunless %}

  {% when 'careers' %}
{% unless block.settings.hide_section %}
{% liquid
  assign careers_kicker = block.settings.kicker | default: 'Careers'
  assign careers_heading = block.settings.heading | default: 'Join Our Team'
  assign careers_text = block.settings.text | default: 'At VECTRA International, we believe our greatest asset is our people. We are always looking for passionate, driven individuals eager to make an impact and grow their careers with us.'
  assign careers_btn = block.settings.button_label | default: 'Explore our open roles'
  if block.settings.button_link != blank
    assign careers_cta = block.settings.button_link
  else
    assign careers_cta = careers_url
  endif
%}
<section class="vh-careers" id="careers" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <canvas class="vh-careers__grid" data-vh-careers-grid aria-hidden="true"></canvas>
    <div class="vh-careers__inner">
      <p class="vh-kicker">{{ careers_kicker }}</p>
      <h2 class="vh-h2">{{ careers_heading }}</h2>
      <p class="vh-lead">{{ careers_text }}</p>
      <div class="vh-careers__actions">
        <a class="vh-btn vh-btn--green vh-careers__cta" href="{{ careers_cta }}">
          {{ careers_btn }}
        </a>
        {% if block.settings.button_2_label != blank %}
          <a class="vh-btn vh-btn--outline" href="{{ block.settings.button_2_link | default: '#' }}">
            {{ block.settings.button_2_label }}
          </a>
        {% endif %}
      </div>
      {% assign nested_extras = nested_extras | strip %}
      {% if nested_extras != blank %}
        <div class="vh-block-extras">{{ nested_extras }}</div>
      {% endif %}
    </div>
  </section>
{% endunless %}

{% endcase %}
