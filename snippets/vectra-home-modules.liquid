{% case module %}
  {% when 'hero' %}
<section class="vh-hero" data-vh-carousel aria-label="Featured" {{ block.shopify_attributes }}>
    <div class="vh-hero__track" data-vh-track>
      <article class="vh-hero__slide is-active" data-vh-slide>
        <img src="{{ img_hero }}" alt="VECTRA team collaborating" width="1920" height="1080">
        <div class="vh-hero__copy">
          <h1 data-vh-hero-el>Who We Are</h1>
          <p data-vh-hero-el>
            Driven by innovation and built on trust, we help businesses transform ideas into measurable impact.
            Discover our mission, meet the team behind our solutions, and see how our values shape every partnership.
          </p>
        </div>
      </article>
      <article class="vh-hero__slide" data-vh-slide>
        <img src="{{ img_hero_2 }}" alt="Responsible supply chains in motion" width="1920" height="1080">
        <div class="vh-hero__copy">
          <h1>Your Trusted ESG Partner</h1>
          <p>
            Our solutions are tailored to empower your organization to achieve ESG goals and build more resilient,
            responsible supply chains.
          </p>
        </div>
      </article>
    </div>
    <button class="vh-hero__arrow vh-hero__arrow--prev" type="button" data-vh-prev aria-label="Previous slide">
      <img class="vh-hero__arrow-bg" src="{{ img_arrow_circle }}" alt="">
      <img class="vh-hero__arrow-icon" src="{{ img_arrow_white }}" alt="">
    </button>
    <button class="vh-hero__arrow vh-hero__arrow--next" type="button" data-vh-next aria-label="Next slide">
      <img class="vh-hero__arrow-bg" src="{{ img_arrow_circle }}" alt="">
      <img class="vh-hero__arrow-icon" src="{{ img_arrow_white }}" alt="">
    </button>
  </section>

  {% when 'trust' %}
<section class="vh-trust" {{ block.shopify_attributes }}>
    <div class="vh-wrap">
      <div class="vh-trust__row">
        <div class="vh-seal" aria-hidden="true">
          <img src="{{ img_seal }}" alt="" width="198" height="193" data-vh-reveal="scale">
        </div>
        <div class="vh-trust__copy">
          <h2 data-vh-reveal="left">Trusted partnership. Practical implementation.</h2>
          <a class="vh-btn vh-btn--green vh-btn--rect" href="#cases" data-vh-reveal="scale">
            Explore the case study→
          </a>
        </div>
      </div>
    </div>
  </section>

  {% when 'logos' %}
<div class="vh-logos" aria-label="Trusted by" {{ block.shopify_attributes }}>
    <div class="vh-logos__track" data-vh-marquee>
      {% for i in (1..2) %}
        <img src="{{ img_logo_ms }}" alt="{% if i == 1 %}Marks & Spencer{% endif %}">
        <img src="{{ img_logo_copper }}" alt="{% if i == 1 %}The Copper Mark{% endif %}">
        <img src="{{ img_logo_rba }}" alt="{% if i == 1 %}Responsible Business Alliance{% endif %}">
        <img src="{{ img_logo_otto }}" alt="{% if i == 1 %}OTTO{% endif %}">
        <img src="{{ img_logo_applied }}" alt="{% if i == 1 %}Applied Materials{% endif %}">
        <img src="{{ img_logo_adidas }}" alt="{% if i == 1 %}adidas{% endif %}">
        <img src="{{ img_logo_better }}" alt="{% if i == 1 %}BetterWork{% endif %}">
        <img src="{{ img_logo_jysk }}" alt="{% if i == 1 %}JYSK{% endif %}">
      {% endfor %}
    </div>
  </div>

  {% when 'impact' %}
<section class="vh-impact" {{ block.shopify_attributes }}>
    <div class="vh-wrap">
      <h2 data-vh-reveal="scale">
        Enabling P<img class="vh-impact__mark" src="{{ img_mark }}" alt="" width="37" height="37">siti<img class="vh-impact__v" src="{{ img_check }}" alt="" width="40" height="49">e Business Impact
      </h2>
    </div>
  </section>

  {% when 'why' %}
<section class="vh-why" id="why-vectra" {{ block.shopify_attributes }}>
    <div class="vh-wrap vh-why__grid">
      <div class="vh-why__media">
        <img src="{{ img_why }}" alt="VECTRA International facility" width="980" height="720">
      </div>
      <div class="vh-why__copy" data-vh-reveal>
        <p class="vh-kicker vh-kicker--arrows">
          <img src="{{ img_kicker_l }}" alt="" class="vh-kicker__arrow vh-kicker__arrow--l">
          WHY VECTRA
          <img src="{{ img_kicker_r }}" alt="" class="vh-kicker__arrow">
        </p>
        <h2>Partnership with accountability.<br>Built for implementation.</h2>
        <p>
          We combine human expertise, an ecosystem of specialists, AI-enabled intelligence, and structured execution—then stay accountable for the outcomes that matter.
        </p>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="#solutions">
          Explore our approach
          <img src="{{ img_arrow }}" alt="">
        </a>
      </div>
    </div>
    <div class="vh-wrap vh-why__list">
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_4 }}" alt="">
        <h3>Your success is our success</h3>
        <p>We work toward business outcomes, not a list of deliverables.</p>
      </article>
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_3 }}" alt="">
        <h3>AI-enabled<br>Human-led</h3>
        <p>Technology makes expert judgment more timely and useful.</p>
      </article>
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_2 }}" alt="">
        <h3>Integrated expertise around the work</h3>
        <p>Curated specialists, tools, and learning shaped to your context.</p>
      </article>
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_1 }}" alt="">
        <h3>Progress you can measure</h3>
        <p>Practical implementation makes improvement visible and durable.</p>
      </article>
    </div>
  </section>

  {% when 'esg' %}
<section class="vh-esg" {{ block.shopify_attributes }}>
    <div class="vh-esg__stage">
      <div class="vh-esg__glow" aria-hidden="true"></div>
      <div class="vh-esg__copy" data-vh-reveal>
        <h2>Your Trusted<br>ESG Partner</h2>
        <p class="vh-lead">
          Our solutions are tailored to empower your organization to achieve ESG goals and build more resilient, responsible supply chains
        </p>
      </div>
      <div class="vh-stat vh-stat--100" data-vh-reveal="right"><b>100+</b><span>Experts Worldwide</span></div>
      <div class="vh-stat vh-stat--30" data-vh-reveal="left"><b>30+</b><span>Years Of Experience</span></div>
      <div class="vh-stat vh-stat--500" data-vh-reveal="up"><b>500+</b><span>Satisfied Clients</span></div>
    </div>
  </section>

  {% when 'solutions' %}
<section class="vh-solutions" id="solutions" data-vh-solutions {{ block.shopify_attributes }}>
    <div class="vh-solutions__canvas">
      <div class="vh-solutions__head" data-vh-reveal>
        <p class="vh-kicker">VECTRA Solutions</p>
        <h2>Find the right solution for you and your team, fast.</h2>
      </div>
      <div class="vh-solutions__body">
        <div class="vh-solutions__copy" data-vh-sol-copy>
          <h3 data-vh-sol-title>Responsible Business Performance</h3>
          <p data-vh-sol-text>Turn stakeholder expectations into clearer decisions, stronger governance, and durable operating practice.</p>
              <a class="vh-btn vh-btn--green vh-btn--rect" href="#VectraContactModal" data-vh-contact-open data-vh-sol-cta>Build capability</a>
        </div>
        <div class="vh-solutions__gallery">
          <button
            class="vh-sol-shot is-active"
            type="button"
            data-vh-sol-item
            data-title="Responsible Business Performance"
            data-text="Turn stakeholder expectations into clearer decisions, stronger governance, and durable operating practice."
            data-cta="Build capability"
          >
            <img src="{{ img_sol_3 }}" alt="Responsible business performance">
          </button>
          <button
            class="vh-sol-shot"
            type="button"
            data-vh-sol-item
            data-title="Governance &amp; Regulatory Readiness"
            data-text="Translate shifting requirements into accountable controls, reliable evidence, and implementation plans."
            data-cta="Strengthen visibility"
          >
            <img src="{{ img_hero_2 }}" alt="Governance and regulatory readiness">
          </button>
          <button
            class="vh-sol-shot vh-sol-shot--plus"
            type="button"
            data-vh-sol-item
            data-title="Let's Connect: We're Here To Help"
            data-text="We build custom solutions designed to meet your specific objectives and drive measurable results."
            data-cta="Customize Your Solution"
          >
            <img src="{{ img_sol_4 }}" alt="Let's connect">
          </button>
          <button
            class="vh-sol-shot"
            type="button"
            data-vh-sol-item
            data-title="Operational Resilience"
            data-text="Build operational control, continuity, and a stronger response to disruption."
            data-cta="Start a briefing."
          >
            <img src="{{ img_sol_2 }}" alt="Operational resilience">
          </button>
          <button
            class="vh-sol-shot"
            type="button"
            data-vh-sol-item
            data-title="Value Chain Resilience &amp; Improvement"
            data-text="Connect due diligence, supplier improvement, risk visibility, and practical follow-through."
            data-cta="Explore delivery"
          >
            <img src="{{ img_sol_1 }}" alt="Value chain resilience">
          </button>
        </div>
      </div>
      <div class="vh-solutions__cta">
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ routes.all_products_collection_url }}">
          Explore All Solutions →
        </a>
      </div>
    </div>
  </section>

  {% when 'marketplace' %}
<section class="vh-market" id="marketplace" {{ block.shopify_attributes }}>
    <div class="vh-market__panel">
    <div class="vh-wrap">
      <div class="vh-market__head">
        <h2 class="vh-h2">Don’t Know Where To Start?</h2>
      </div>
      <div>
      
      </div>
      <form class="vh-searchbar" action="{{ routes.search_url }}" method="get" role="search">
        <label class="vh-searchbar__q">
          <span class="vh-searchbar__icon" aria-hidden="true">{{ 'icon-search.svg' | inline_asset_content }}</span>
          <input type="hidden" name="type" value="product">
          <input type="search" name="q" placeholder="Search courses, assessments and bundles" aria-label="Search courses">
        </label>
        <select aria-label="Role"><option>Role</option></select>
        <select aria-label="Regulation"><option>Regulation</option></select>
        <select aria-label="Stage"><option>Stage</option></select>
      </form>

      <div class="vh-courses">
        <article class="vh-course">
          <img src="{{ img_course_1 }}" alt="">
          <div class="vh-course__body">
            <h3>Acronyms Used in ESG Area</h3>
            <div class="vh-course__meta">
              <span class="vh-price">$20.00</span>
              <a class="vh-course__cta" href="{{ routes.all_products_collection_url }}">Access this course</a>
            </div>
          </div>
        </article>
        <article class="vh-course">
          <img src="{{ img_course_2 }}" alt="">
          <div class="vh-course__body">
            <h3>Preventative and Corrective Measures</h3>
            <div class="vh-course__meta">
              <span class="vh-price">$20.00</span>
              <a class="vh-course__cta" href="{{ routes.all_products_collection_url }}">Access this course</a>
            </div>
          </div>
        </article>
        <article class="vh-course">
          <img src="{{ img_course_3 }}" alt="">
          <div class="vh-course__body">
            <h3>Optimizing Purchasing Practices</h3>
            <div class="vh-course__meta">
              <span class="vh-price">$20.00</span>
              <a class="vh-course__cta" href="{{ routes.all_products_collection_url }}">Access this course</a>
            </div>
          </div>
        </article>
        <article class="vh-course">
          <img src="{{ img_course_4 }}" alt="">
          <div class="vh-course__body">
            <h3>Disability Accommodation Training</h3>
            <div class="vh-course__meta">
              <span class="vh-price">$20.00</span>
              <a class="vh-course__cta" href="{{ routes.all_products_collection_url }}">Access this course</a>
            </div>
          </div>
        </article>
      </div>

      <div class="vh-topics">
        <h2 class="vh-h2">Relevant Topics</h2>
        <div class="vh-pills">
          <span class="vh-pill">Most Popular →</span>
          <span class="vh-pill">By Regulation →</span>
          <span class="vh-pill">By Role →</span>
        </div>
        <div class="vh-topics__list">
          <article class="vh-topic-card">
            <img src="{{ img_course_2 }}" alt="">
            <div class="vh-topic-card__body">
              <span class="vh-topic-card__label">Certificate Course</span>
              <h3>Preventative and Corrective Measures</h3>
              <p>
                This course provides a comprehensive framework for managing supply chain due diligence in 2026. It focuses on the dual approach of using preventative measures as a “proactive shield” to avoid crises and corrective measures as a “surgical fix” to address and remediate existing violations.
              </p>
              <div class="vh-course__meta">
                <span class="vh-price">$20.00</span>
                <a class="vh-course__cta" href="{{ routes.all_products_collection_url }}">Access this course</a>
              </div>
            </div>
          </article>
          <article class="vh-topic-card">
            <img src="{{ img_course_3 }}" alt="">
            <div class="vh-topic-card__body">
              <span class="vh-topic-card__label">Certificate Course</span>
              <h3>Optimizing Purchasing Practices</h3>
              <p>
                Learn how purchasing decisions shape supplier performance, cost, and ESG outcomes—and how to build practices that hold up under scrutiny.
              </p>
              <div class="vh-course__meta">
                <span class="vh-price">$20.00</span>
                <a class="vh-course__cta" href="{{ routes.all_products_collection_url }}">Access this course</a>
              </div>
            </div>
          </article>
          <article class="vh-topic-card">
            <img src="{{ img_course_1 }}" alt="">
            <div class="vh-topic-card__body">
              <span class="vh-topic-card__label">Certificate Course</span>
              <h3>Acronyms Used in ESG Area</h3>
              <p>
                Build a shared vocabulary for ESG, due diligence, and supply-chain reporting so teams can act faster and with less confusion.
              </p>
              <div class="vh-course__meta">
                <span class="vh-price">$20.00</span>
                <a class="vh-course__cta" href="{{ routes.all_products_collection_url }}">Access this course</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </div>
    </div>
  </section>

  {% when 'cases' %}
<section class="vh-cases" id="cases" {{ block.shopify_attributes }}>
    <canvas class="vh-cases__grid" data-vh-cases-grid aria-hidden="true"></canvas>
    <div class="vh-wrap">
      <h2 data-vh-reveal>Tested in real crises.<br>Proven by industry leaders.</h2>
      <span class="vh-reviews">Based on 500 reviews</span>
      <div class="vh-case-grid">
        <article class="vh-case" data-vh-reveal>
          <div class="vh-case__main">
            <div class="vh-case__photo"><img src="{{ img_logo_otto }}" alt=""></div>
            <div class="vh-case__caption">
              <p class="vh-case__name">OTTO Group</p>
              <p class="vh-case__loc">Hamburg, Germany</p>
            </div>
          </div>
          <div class="vh-case__quote">
            <div class="vh-case__stars" aria-label="5 stars">
              <svg width="20" height="19" viewBox="0 0 20 19" aria-hidden="true"><path fill="currentColor" d="M10 0l2.47 6.28H19.4l-5.44 3.88 2.08 6.4L10 12.68 3.96 16.56l2.08-6.4L.6 6.28h6.93z"/></svg>
              <svg width="20" height="19" viewBox="0 0 20 19" aria-hidden="true"><path fill="currentColor" d="M10 0l2.47 6.28H19.4l-5.44 3.88 2.08 6.4L10 12.68 3.96 16.56l2.08-6.4L.6 6.28h6.93z"/></svg>
              <svg width="20" height="19" viewBox="0 0 20 19" aria-hidden="true"><path fill="currentColor" d="M10 0l2.47 6.28H19.4l-5.44 3.88 2.08 6.4L10 12.68 3.96 16.56l2.08-6.4L.6 6.28h6.93z"/></svg>
              <svg width="20" height="19" viewBox="0 0 20 19" aria-hidden="true"><path fill="currentColor" d="M10 0l2.47 6.28H19.4l-5.44 3.88 2.08 6.4L10 12.68 3.96 16.56l2.08-6.4L.6 6.28h6.93z"/></svg>
              <svg width="20" height="19" viewBox="0 0 20 19" aria-hidden="true"><path fill="currentColor" d="M10 0l2.47 6.28H19.4l-5.44 3.88 2.08 6.4L10 12.68 3.96 16.56l2.08-6.4L.6 6.28h6.93z"/></svg>
            </div>
            <blockquote>
              “Working together transformed our ESG compliance framework. The team simplified complex EU CSRD reporting into a clear roadmap, cutting our data collection timeline by 40% and delivering our annual sustainability report six weeks ahead of schedule.”
            </blockquote>
          </div>
        </article>
        <article class="vh-case" data-vh-reveal>
          <div class="vh-case__main">
            <div class="vh-case__photo"><img src="{{ img_crh }}" alt=""></div>
            <div class="vh-case__caption">
              <p class="vh-case__name">CRH</p>
              <p class="vh-case__loc">Hamburg, Germany</p>
            </div>
          </div>
          <div class="vh-case__quote">
            <div class="vh-case__stars" aria-label="5 stars">
