  {% when 'blog' %}
<section class="vh-blog" id="resources" {{ block.shopify_attributes }}>
    <div class="vh-wrap">
      <p class="vh-kicker" data-vh-reveal="scale">Insights</p>
      <h2 class="vh-h2" data-vh-reveal="scale">Latest Insights</h2>
      {% liquid
        assign insight_blog = blogs['insights']
        if insight_blog == blank or insight_blog.articles_count == 0
          assign insight_blog = blogs['news']
        endif
        assign resources_url = pages['resources'].url | default: '/pages/resources'
      %}
      <div class="vh-blog__grid">
        {% if insight_blog != blank and insight_blog.articles_count > 0 %}
          {% for article in insight_blog.articles limit: 3 %}
            <article class="vh-article"{% if forloop.first %} data-vh-reveal="up"{% endif %}>
              {% if article.image %}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}
              {% else %}
                <img src="{{ img_blog_1 }}" alt="">
              {% endif %}
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
              <h3>{{ article.title }}</h3>
              <a class="vh-read" href="{{ article.url }}">Read More</a>
            </article>
          {% endfor %}
        {% else %}
        <article class="vh-article" data-vh-reveal="up">
          <img src="{{ img_blog_1 }}" alt="">
          <time datetime="2025-01-25">January 25, 2025</time>
          <h3>From insight to the decision that has to follow</h3>
          <a class="vh-read" href="{{ resources_url }}">Read More</a>
        </article>
        <article class="vh-article">
          <img src="{{ img_blog_2 }}" alt="">
          <time datetime="2025-01-25">January 25, 2025</time>
          <h3>Events that add context to a decision you are already making</h3>
          <a class="vh-read" href="{{ resources_url }}">Read More</a>
        </article>
        <article class="vh-article">
          <img src="{{ img_blog_3 }}" alt="">
          <time datetime="2025-01-25">January 25, 2025</time>
          <h3>What changed after the finding — and what still needs a team around it</h3>
          <a class="vh-read" href="{{ resources_url }}">Read More</a>
        </article>
        {% endif %}
      </div>
      <div class="vh-blog__more">
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ resources_url }}">See All Insights →</a>
      </div>
    </div>
  </section>

  {% when 'faq' %}
<section class="vh-faq" id="faq" {{ block.shopify_attributes }}>
    <div class="vh-wrap vh-faq__grid">
      <aside class="vh-contact-card" data-vh-reveal="left">
        <img class="vh-contact-card__icon" src="{{ img_chat }}" alt="">
        <p class="vh-contact-card__title">Bring Us the Problem That Keeps Coming Back</p>
        <p>
          Maybe actions keep stalling. Evidence is scattered. A supplier issue stays open. Or your systems produce information, but the next step is still unclear. Tell us where the work gets stuck. We'll help you identify the gap and the next step.
        </p>
        <a class="vh-btn vh-btn--white" href="{{ faq_href }}">
          More questions?
          <img src="{{ img_arrow }}" alt="">
        </a>
        {% render 'vectra-contact-details', variant: 'card', img_phone: img_phone, img_mail: img_mail, img_pin: img_pin %}
      </aside>

      <div class="vh-faq__right">
        <div class="vh-faq__glow" aria-hidden="true"></div>
        <div class="vh-accordion">
          <p class="vh-kicker">Our FAQ</p>
          <h2 class="vh-h2">Questions Business Leaders Ask Us</h2>
          <p class="vh-lead">
            Straight answers about where VECTRA fits, how we work, and what happens next.
          </p>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn>What does VECTRA help organizations improve?</button>
            <div class="vh-acc__body">
              VECTRA helps organizations reduce business risk, strengthen operational and supply chain resilience, improve ESG and sustainability performance, and build the evidence and capability needed to drive measurable results across operations and value chains. We start with the outcome that needs to improve, then bring the relevant expertise and implementation support around it.
            </div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn>We already have consultants, platforms, and dashboards. Where does VECTRA fit?</button>
            <div class="vh-acc__body">
              Often, the gap appears after the information already exists. VECTRA works with the systems, expertise, and partners you already have, then focuses on ownership, workflows, evidence, supplier engagement, and follow-through where the work is getting stuck.
            </div>
          </div>
          <div class="vh-acc is-open" data-vh-faq-item>
            <button type="button" data-vh-faq-btn>Can VECTRA work with the systems we already use?</button>
            <div class="vh-acc__body">
              Yes. VECTRA is platform-agnostic. We work with existing systems, data, teams, and partners, then introduce additional technology only where it solves a clear problem.
            </div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn>Where do we start if we know the problem but not the solution?</button>
            <div class="vh-acc__body">
              Start with the problem. Tell us what keeps recurring, stalling, or becoming difficult to prove. We’ll help clarify what needs attention and the most practical way forward.
            </div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn>How does VECTRA measure progress?</button>
            <div class="vh-acc__body">
              We agree what improvement should look like at the start. Depending on the issue, that may include clearer ownership, closed actions, stronger evidence, improved capability, fewer recurring problems, or better supplier performance.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {% when 'portal' %}
{% unless template.suffix == 'resources' %}
{% liquid
  assign is_solutions_portal = false
  if template.suffix == 'solutions'
    assign is_solutions_portal = true
  endif
  assign portal_heading = block.settings.heading
  if portal_heading == blank
    if is_solutions_portal
      assign portal_heading = 'Start with the <strong>challenge</strong> in front of you.'
    else
      assign portal_heading = 'Get in Touch'
    endif
  endif
  assign portal_text = block.settings.text
  if portal_text == blank
    if is_solutions_portal
      assign portal_text = 'We will help you determine the right combination of expert support, intelligence, and capability-building.'
    else
      assign portal_text = 'Tell us where the work gets stuck. We’ll help you identify the gap and the next step.'
    endif
  endif
  assign portal_submit = 'Send message'
  assign portal_form_heading = 'Get In Touch'
  if is_solutions_portal
    assign portal_submit = 'Start the Conversation'
    assign portal_form_heading = 'Talk to a VECTRA Expert'
  endif
%}
<section class="vh-portal{% if is_solutions_portal %} vh-portal--sol{% endif %}" id="{{ block.settings.anchor_id | default: 'get-in-touch' }}" {{ block.shopify_attributes }}>
    {% if is_solutions_portal %}
      <canvas class="vh-portal__cells" data-vs-join-grid aria-hidden="true"></canvas>
    {% endif %}
    <div class="vh-wrap vh-portal__grid">
      <div class="vh-portal__copy">
        <h2>{{ portal_heading }}</h2>
        <p>{{ portal_text }}</p>
      </div>
      {% if is_solutions_portal %}
        {% form 'contact', class: 'vh-form', data-vh-reveal: 'scale' %}
          <h3>{{ portal_form_heading }}</h3>
          {% render 'vectra-contact-fields', img_arrow: img_arrow, solutions_form: true, submit_label: portal_submit %}
        {% endform %}
      {% else %}
        {% form 'contact', class: 'vh-form' %}
          <h3>Get In Touch</h3>
          {% render 'vectra-contact-fields', img_arrow: img_arrow %}
        {% endform %}
      {% endif %}
    </div>
  </section>
{% endunless %}

  {% when 'careers' %}
<section class="vh-careers" id="careers" {{ block.shopify_attributes }}>
    <canvas class="vh-careers__grid" data-vh-careers-grid aria-hidden="true"></canvas>
    <div class="vh-careers__inner">
      <p class="vh-kicker">Careers</p>
