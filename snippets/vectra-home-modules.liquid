{% capture faq_href %}{% render 'vectra-preview-href', url: faq_base, view: 'faq' %}{% endcapture %}
{% capture marketplace_href %}{% render 'vectra-preview-href', url: marketplace_url, view: 'marketplace' %}{% endcapture %}
{% capture resources_href %}{% render 'vectra-preview-href', url: resources_base, view: 'resources' %}{% endcapture %}
{% capture course_esg_href %}{% render 'vectra-preview-href', url: course_esg, view: 'course' %}{% endcapture %}
{% capture course_prev_href %}{% render 'vectra-preview-href', url: course_prev, view: 'course' %}{% endcapture %}
{% capture course_buy_href %}{% render 'vectra-preview-href', url: course_buy, view: 'course' %}{% endcapture %}
{% capture course_dis_href %}{% render 'vectra-preview-href', url: course_dis, view: 'course' %}{% endcapture %}
{% assign faq_href = faq_href | strip %}
{% assign marketplace_href = marketplace_href | strip %}
{% assign resources_href = resources_href | strip %}
{% assign course_esg_href = course_esg_href | strip %}
{% assign course_prev_href = course_prev_href | strip %}
{% assign course_buy_href = course_buy_href | strip %}
{% assign course_dis_href = course_dis_href | strip %}
{% case module %}
  {% when 'hero' %}
{% render 'vectra-seo', page_key: 'home' %}
{% unless block.settings.hide_section %}
<section class="vh-hero vh-hero--home" data-vh-carousel aria-label="Featured" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-hero__track" data-vh-track>
    <article class="vh-hero__slide is-active" data-vh-slide>
      <img class="vh-hero__bg" src="{{ img_hero }}" alt="VECTRA team collaborating" width="1920" height="1080" loading="eager" fetchpriority="high">
      <div class="vh-hero__shade" aria-hidden="true"></div>
      <div class="vh-hero__copy">
        <h1 class="vh-hero__h1">Business Resilience Partner for Responsible Business &amp; Operational Resilience</h1>
        <p class="vh-hero__display">Your Success Is Our Success.</p>
        <div class="vh-hero__body">
          <p>There's a version of your week that doesn't include the same problem showing up again. Where a supplier issue gets fixed and actually stays fixed. Where the requirement everyone's been worried about becomes something your team can just handle. Where you're not the only person holding it all together.</p>
          <p>That's the work we do together.</p>
          <p>Whatever brought you here today, you don't have to carry it alone. Our people sit down with your people, learn what's really going on, bring in exactly the expertise the moment calls for, and stay until the next step is something you can actually see happening, not just something written in a report.</p>
          <p>We're not here to hand you a deliverable and disappear. We're here because your success is genuinely, personally, ours too.</p>
        </div>
        <div class="vh-hero__actions">
          <a class="vh-btn vh-btn--green" href="#solutions">Explore How We Help</a>
          <a class="vh-btn vh-btn--outline-light" href="#VectraContactModal" data-vh-contact-open>Talk to an Expert</a>
        </div>
        <p class="vh-hero__aeo">Responsible business means managing supplier risk, environmental and social impact, and regulatory responsibility in ways that protect people, performance, and long-term value. VECTRA helps organizations turn those responsibilities into clear ownership, practical action, stronger operational resilience, and measurable improvement across teams, suppliers, and systems.</p>
      </div>
    </article>

    <article class="vh-hero__slide" data-vh-slide>
      <img class="vh-hero__bg" src="{{ img_hero_2 }}" alt="Business resilience and operational capability building" width="1920" height="1080" loading="lazy">
      <div class="vh-hero__shade" aria-hidden="true"></div>
      <div class="vh-hero__copy">
        <p class="vh-hero__h1">Turn Business Complexity Into Resilient Performance</p>
        <p class="vh-hero__display">Business Resilience &amp; Operational Capability Building</p>
        <div class="vh-hero__body">
          <p>Responsible business practices are the standards, controls, and decisions organizations use to manage supplier risk, environmental and social impact, and regulatory obligations across their operations. VECTRA International is a business resilience partner that turns those practices into clear ownership, practical action, and measurable performance, not just policy.</p>
          <p>VECTRA helps organizations turn complex operational, supplier, and responsible business issues into clear ownership, practical action, and stronger control. From strategy through implementation, we stay accountable for moving the work forward.</p>
        </div>
        <div class="vh-hero__actions">
          <a class="vh-btn vh-btn--green" href="#solutions">Explore How We Help</a>
          <a class="vh-btn vh-btn--outline-light" href="#VectraContactModal" data-vh-contact-open>Talk to an Expert</a>
        </div>
      </div>
    </article>
  </div>

  <button class="vh-hero__arrow vh-hero__arrow--prev" type="button" data-vh-prev aria-label="Previous slide">
    <img class="vh-hero__arrow-bg" src="{{ img_arrow_circle }}" alt="">
    <img class="vh-hero__arrow-icon" src="{{ img_arrow_white }}" alt="">
  </button>
  <button class="vh-hero__arrow vh-hero__arrow--next" type="button" data-vh-next aria-label="Next slide">
    <img class="vh-hero__arrow-bg" src="{{ img_arrow_circle }}" alt="">
    <img class="vh-hero__arrow-icon" src="{{ img_arrow_white }}" alt="">
  </button>
</section>
{% endunless %}

  {% when 'trust' %}
{% unless block.settings.hide_section %}
{% liquid
  assign trust_heading = block.settings.heading | default: '20+ Years of Experience. 500+ Organizations Supported.'
  assign trust_btn = block.settings.button_label | default: 'Explore Case Studies'
  assign trust_link = block.settings.button_link | default: '#cases'
%}
<section class="vh-trust" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-wrap">
      <div class="vh-trust__row">
        <div class="vh-seal" aria-hidden="true">
          {% render 'vectra-image', image: block.settings.badge, fallback: img_seal, alt: '', width: 198, height: 193, image_width: 400 %}
        </div>
        <div class="vh-trust__copy">
          <h2 data-vh-reveal="left">{{ trust_heading }}</h2>
          <div class="vh-trust__actions">
            <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ trust_link }}" data-vh-reveal="scale">
              {{ trust_btn }}
            </a>
            {% if block.settings.button_2_label != blank %}
              <a class="vh-btn vh-btn--outline" href="{{ block.settings.button_2_link | default: '#' }}" data-vh-reveal="scale">
                {{ block.settings.button_2_label }}
              </a>
            {% endif %}
          </div>
          {% assign nested_extras = nested_extras | strip %}
          {% if nested_extras != blank %}
            <div class="vh-block-extras">{{ nested_extras }}</div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endunless %}

  {% when 'logos' %}
{% unless block.settings.hide_section %}
{% assign nested_logos = nested_logos | strip %}
<div class="vh-logos" aria-label="Trusted by" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-logos__track" data-vh-marquee>
      {% if nested_logos != blank %}
        {{ nested_logos }}
      {% else %}
      {% for i in (1..2) %}
        <img src="{{ img_logo_ms }}" alt="{% if i == 1 %}Marks & Spencer{% endif %}">
        <img src="{{ img_logo_copper }}" alt="{% if i == 1 %}The Copper Mark{% endif %}">
        <img src="{{ img_logo_rba }}" alt="{% if i == 1 %}Responsible Business Alliance{% endif %}">
        <img src="{{ img_logo_otto }}" alt="{% if i == 1 %}OTTO{% endif %}">
        <img src="{{ img_logo_applied }}" alt="{% if i == 1 %}Applied Materials{% endif %}">
        <img src="{{ img_logo_adidas }}" alt="{% if i == 1 %}adidas{% endif %}">
        <img src="{{ img_logo_better }}" alt="{% if i == 1 %}BetterWork{% endif %}">
        <img src="{{ img_logo_jysk }}" alt="{% if i == 1 %}JYSK{% endif %}">
      {% endfor %}
      {% endif %}
    </div>
  </div>
{% endunless %}

  {% when 'impact' %}
{% unless block.settings.hide_section %}
<section class="vh-impact" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-wrap">
      {% if block.settings.image != blank %}
        {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: 'Enabling Positive Business Impact' }}
      {% else %}
      <h2 data-vh-reveal="scale" aria-label="Enabling Positive Business Impact">
        <span class="vh-impact__word">Enabling</span>
        <span class="vh-impact__word vh-impact__positive">P<img class="vh-impact__mark" src="{{ img_mark }}" alt="" width="37" height="37">siti<img class="vh-impact__v" src="{{ img_check }}" alt="" width="40" height="49">e</span>
        <span class="vh-impact__word">Business Impact</span>
      </h2>
      {% endif %}
    </div>
  </section>
{% endunless %}

  {% when 'why' %}
{% unless block.settings.hide_section %}
{% capture why_text_fallback %}Behind every supplier issue, every audit finding, every new requirement your team is trying to get ahead of, there's a person trying to make it work. Usually more than one.

That's who we're really talking to. Not a department. Not a system. You.

We start by listening, not presenting. We sit with the people closest to the problem, learn what's actually getting in the way, and bring in exactly the expertise that moment needs, without ever taking the wheel away from your team.

Technology helps us move fast. It spots patterns, flags what needs attention, and keeps the evidence honest. But the judgment calls, the hard conversations, and the follow-through when things get complicated? That stays human. That stays with us, working alongside you.

And when we hand over a recommendation, we don't disappear. We stay while it becomes real. While your team adapts. While the improvement actually sticks.

Your success is our success. We mean that literally, not as a tagline.{% endcapture %}
{% capture ceo_note_fallback %}I started VECTRA because I watched too many good plans fall apart the moment they left the boardroom. Not because the thinking was wrong, but because nobody stayed close enough to see it through.

That's still what drives us today. Whatever you're working through, I want you to feel like there's a real person on the other end of this. Because there is.

Welcome to VECTRA.{% endcapture %}
{% liquid
  assign why_kicker = block.settings.kicker | default: 'WHY VECTRA'
  assign why_heading = block.settings.heading | default: 'We Serve People With People.'
  assign why_text = block.settings.text | default: why_text_fallback
  assign why_btn = block.settings.button_label | default: 'See Why VECTRA'
  assign why_link = block.settings.button_link | default: '#why-cards'
  assign why_bridge = block.settings.bridge_text | default: "Here's what that actually looks like:"
  assign ceo_note_kicker = block.settings.ceo_note_kicker | default: 'A Note From Our CEO'
  assign ceo_note_label = block.settings.ceo_note_label | default: 'A note from Patrick Neyts, CEO'
  assign ceo_note_text = block.settings.ceo_note_text | default: ceo_note_fallback
  assign nested_cards = nested_cards | strip
%}
<section class="vh-why" id="why-vectra" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-wrap vh-why__grid">
      <div class="vh-why__media">
        {% render 'vectra-image', image: block.settings.image, fallback: img_why, alt: 'VECTRA International facility', width: 980, height: 720, image_width: 1600 %}
      </div>
      <div class="vh-why__copy" data-vh-reveal>
        <p class="vh-kicker vh-kicker--arrows">
          <img src="{{ img_kicker_l }}" alt="" class="vh-kicker__arrow vh-kicker__arrow--l">
          {{ why_kicker }}
          <img src="{{ img_kicker_r }}" alt="" class="vh-kicker__arrow">
        </p>
        <h2>{{ why_heading }}</h2>
        <div class="vh-why__body">
          {% assign why_paras = why_text | newline_to_br | split: '<br />' %}
          {% for para in why_paras %}
            {% assign para_text = para | strip_html | strip %}
            {% if para_text != blank %}
              <p>{{ para_text }}</p>
            {% endif %}
          {% endfor %}
        </div>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ why_link }}">
          {{ why_btn }}
          <img src="{{ img_arrow }}" alt="">
        </a>
        {% if block.settings.button_2_label != blank %}
          <a class="vh-btn vh-btn--outline" href="{{ block.settings.button_2_link | default: '#' }}" style="margin-top: 12px;">
            {{ block.settings.button_2_label }}
          </a>
        {% endif %}
      </div>
    </div>
    {% unless block.settings.hide_ceo_note %}
    <div class="vh-wrap vh-why__ceo" data-vh-reveal>
      <p class="vh-why__ceo-kicker">{{ ceo_note_kicker }}</p>
      <p class="vh-why__ceo-label">{{ ceo_note_label }}</p>
      <blockquote class="vh-why__ceo-quote">
        {% assign ceo_paras = ceo_note_text | newline_to_br | split: '<br />' %}
        {% for para in ceo_paras %}
          {% assign para_text = para | strip_html | strip %}
          {% if para_text != blank %}
            <p>{{ para_text }}</p>
          {% endif %}
        {% endfor %}
      </blockquote>
    </div>
    {% endunless %}
    {% if why_bridge != blank %}
      <div class="vh-wrap">
        <p class="vh-why__bridge" data-vh-reveal>{{ why_bridge }}</p>
      </div>
    {% endif %}
    <div class="vh-wrap vh-why__list" id="why-cards">
      {% if nested_cards != blank %}
        {{ nested_cards }}
      {% else %}
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_4 }}" alt="">
        <h3>We Sit on Your Side of the Table</h3>
        <p>We work alongside your people, learn how your business actually runs, and bring in support without taking ownership away from your team.</p>
      </article>
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_3 }}" alt="">
        <h3>A Person Is Always Accountable</h3>
        <p>Technology helps us move faster. A person is still the one who owns the judgment call, the decision, and the follow-through.</p>
      </article>
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_2 }}" alt="">
        <h3>The Right Expert, Not a Fixed Package</h3>
        <p>Your challenge doesn't come with a pre-built solution. We bring in whoever the problem actually needs, exactly when you need them.</p>
      </article>
      <article class="vh-why__item" data-vh-reveal>
        <img src="{{ img_icon_1 }}" alt="">
        <h3>You'll See What Changed</h3>
        <p>We agree on what success looks like before we start. Then we show you what moved, what's still in motion, and what's next.</p>
      </article>
      {% endif %}
    </div>
  </section>
{% endunless %}

  {% when 'esg' %}
{% unless block.settings.hide_section %}
{% capture esg_text_fallback %}VECTRA International was founded in 2005. But the experience behind our work goes back further than that, because the people doing it had already spent years, in some cases decades, in these exact situations before they ever became a team.

VECTRA International has worked with organizations across responsible business, supply chains, workplace standards, and operational improvement. That's not a number on a slide. It's why we already know where change tends to stall, what actually helps people move it forward, and why even a good plan still has to survive contact with a Monday morning.

Today, we bring that experience to a broader role in business resilience and operational capability building, helping organizations make stronger decisions, build stronger teams, and create improvements they can sustain.{% endcapture %}
{% liquid
  assign esg_kicker = block.settings.kicker | default: 'OUR EXPERIENCE'
  assign esg_heading = block.settings.heading | default: '20+ Years of Experience You Can Rely On'
  assign esg_text = block.settings.text | default: esg_text_fallback
  assign esg_s1v = block.settings.stat_1_value | default: '20+'
  assign esg_s1l = block.settings.stat_1_label | default: 'Years of Experience'
  assign esg_s2v = block.settings.stat_2_value | default: '50+'
  assign esg_s2l = block.settings.stat_2_label | default: 'Global Experts'
  assign esg_s3v = block.settings.stat_3_value | default: '500+'
  assign esg_s3l = block.settings.stat_3_label | default: 'Organizations Supported'
  assign esg_btn = block.settings.button_label | default: 'About VECTRA International'
  if block.settings.button_link != blank
    assign esg_cta = block.settings.button_link
  else
    assign esg_cta = pages['about-us'].url | default: pages['our-story'].url | default: '/pages/about-us'
  endif
%}
<section class="vh-esg" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vh-esg__stage">
      <div class="vh-esg__glow" aria-hidden="true"></div>
      <div class="vh-esg__copy" data-vh-reveal>
        <p class="vh-kicker">{{ esg_kicker }}</p>
        <h2>{{ esg_heading }}</h2>
        <div class="vh-lead">
          {% assign esg_paras = esg_text | newline_to_br | split: '<br />' %}
          {% for para in esg_paras %}
            {% assign para_text = para | strip_html | strip %}
            {% if para_text != blank %}
              <p>{{ para_text }}</p>
            {% endif %}
          {% endfor %}
        </div>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ esg_cta }}">{{ esg_btn }}</a>
      </div>
      <div class="vh-stat vh-stat--100" data-vh-reveal="right"><b>{{ esg_s1v }}</b><span>{{ esg_s1l }}</span></div>
      <div class="vh-stat vh-stat--30" data-vh-reveal="left"><b>{{ esg_s2v }}</b><span>{{ esg_s2l }}</span></div>
      <div class="vh-stat vh-stat--500" data-vh-reveal="up"><b>{{ esg_s3v }}</b><span>{{ esg_s3l }}</span></div>
    </div>
  </section>
{% endunless %}

  {% when 'solutions' %}
{% unless block.settings.hide_section %}
{% liquid
  assign sol_kicker = block.settings.kicker | default: 'HOW WE HELP'
  assign sol_heading = block.settings.heading | default: 'Solutions for the Results Your Business Needs'
