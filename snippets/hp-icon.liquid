{%- doc -%}
  Simple line icons for homepage feature rows.

  @param {string} name - Icon key
{%- enddoc -%}

{%- case name -%}
  {%- when 'leaf' -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <path d="M8 24c8-1 14-8 16-18-10 2-17 8-18 16 4-1 8 0 11 3-4 1-7 1-9-1Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M12 20c3-4 7-7 13-9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  {%- when 'globe' -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.7"/>
      <path d="M6 16h20M16 6c3 3.5 4.5 7 4.5 10S19 22.5 16 26c-3-3.5-4.5-7-4.5-10S13 9.5 16 6Z" stroke="currentColor" stroke-width="1.7"/>
    </svg>
  {%- when 'chart' -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <path d="M6 24V8M6 24h20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      <path d="M11 18v6M16 13v11M21 9v15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  {%- when 'users' -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/>
      <path d="M6 24c.8-3.5 3.2-5.5 6-5.5s5.2 2 6 5.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      <circle cx="21" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/>
      <path d="M19 18.6c2.4.4 4.3 2 5 5.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <path d="M16 6 8 9v8c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V9l-8-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="m12.5 16 2.5 2.5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'building' -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <path d="M8 26V10l8-4 8 4v16H8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M14 26v-6h4v6M12 14h2M18 14h2M12 18h2M18 18h2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  {%- when 'energy' -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <path d="m17 5-8 13h6l-1 9 9-13h-6l1-9Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
    </svg>
  {%- when 'report' -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <path d="M10 7h9l5 5v13H10V7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M19 7v5h5M13 17h8M13 21h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  {%- when 'handshake' -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <path d="m6 16 5-5 4 3 3-2 8 7-4 4-5-3-3 3-8-7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
      <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.7"/>
      <path d="M16 10v6l4 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
