{%- doc -%}
  Renders one top-level MEGA Nav item from VECTRA Website Mega Menu.
  Two-level children become a dropdown list; a third level becomes columns.

  @param {object} link - Shopify linklist link
  @param {string} mode - 'desktop' or 'mobile'
{%- enddoc -%}

{% liquid
  assign has_kids = false
  if link.links.size > 0
    assign has_kids = true
  endif
  assign has_grand = false
  if has_kids
    for child in link.links
      if child.links.size > 0
        assign has_grand = true
        break
      endif
    endfor
  endif
  assign nav_title = link.title
  if nav_title == 'Our DNA' or nav_title == 'OUR DNA' or nav_title contains 'Our DNA'
    assign nav_title = 'About Us'
  endif
  # Always expose a Resources submenu for the five listing pages.
  if nav_title == 'Resources'
    assign has_kids = true
    assign has_grand = false
  endif
%}
{% capture href %}{% render 'vectra-preview-href', url: link.url, title: link.title %}{% endcapture %}
{% assign href = href | strip %}

{% if mode == 'mobile' %}
  <div class="vh-nav-panel__item{% if has_kids %} has-children{% endif %}">
    {% if has_kids %}
      <button type="button" data-vh-mobile-sub aria-expanded="false">
        {{ nav_title }}
      </button>
      <div class="vh-nav-panel__sub">
        {% unless link.url == blank or link.url == '#' %}
          <a href="{{ href }}">{{ nav_title }}</a>
        {% endunless %}
        {% unless nav_title == 'Resources' %}
          {% for child in link.links %}
            <a href="{% render 'vectra-preview-href', url: child.url, title: child.title %}">{{ child.title }}</a>
            {% if child.links.size > 0 %}
              {% for grandchild in child.links %}
                <a class="vh-nav-panel__grand" href="{% render 'vectra-preview-href', url: grandchild.url, title: grandchild.title %}">{{ grandchild.title }}</a>
              {% endfor %}
            {% endif %}
          {% endfor %}
        {% endunless %}
        {% if nav_title == 'About Us' %}
          {% liquid
            assign child_blob = ''
            for child in link.links
              assign child_blob = child_blob | append: child.title | append: '|'
            endfor
            assign child_blob = child_blob | downcase
            assign leadership_url = pages['our-leadership-team'].url | default: pages['leadership'].url
            assign experts_url = pages['experts'].url
            assign associates_url = pages['associates'].url
            assign interns_url = pages['interns'].url
            assign careers_url = pages['careers'].url
          %}
          {% unless child_blob contains 'leader' %}
            <a href="{% render 'vectra-preview-href', url: leadership_url, view: 'leadership' %}">Our Leadership Team</a>
          {% endunless %}
          {% unless child_blob contains 'expert' %}
            <a href="{% render 'vectra-preview-href', url: experts_url, view: 'experts' %}">Our Experts</a>
          {% endunless %}
          {% unless child_blob contains 'associate' %}
            <a href="{% render 'vectra-preview-href', url: associates_url, view: 'associates' %}">Associates</a>
          {% endunless %}
          {% unless child_blob contains 'intern' %}
            <a href="{% render 'vectra-preview-href', url: interns_url, view: 'interns' %}">Our Interns</a>
          {% endunless %}
          {% unless child_blob contains 'career' %}
            <a href="{% render 'vectra-preview-href', url: careers_url, view: 'careers' %}">Careers</a>
          {% endunless %}
        {% endif %}
        {% if nav_title == 'Resources' %}
          {% liquid
            assign resources_fallback = pages['resources'].url | default: '/pages/resources'
            assign insights_url = pages['insights-page'].url | default: pages['insights'].url | default: pages['blogs'].url | default: resources_fallback
            assign ebooks_url = pages['ebooks-and-playbooks'].url | default: pages['e-books-playbooks'].url | default: resources_fallback
            assign events_url = pages['events-and-webinars'].url | default: pages['event-webinars'].url | default: pages['events'].url | default: resources_fallback
            assign podcasts_url = pages['podcasts'].url | default: resources_fallback
            assign press_url = pages['press-releases'].url | default: resources_fallback
            unless insights_url contains 'view='
              assign insights_url = insights_url | append: '?view=blogs'
            endunless
            unless ebooks_url contains 'view='
              assign ebooks_url = ebooks_url | append: '?view=e-books-playbooks'
            endunless
            unless events_url contains 'view='
              assign events_url = events_url | append: '?view=event-webinars'
            endunless
            unless podcasts_url contains 'view='
              assign podcasts_url = podcasts_url | append: '?view=podcasts'
            endunless
            unless press_url contains 'view='
              assign press_url = press_url | append: '?view=press-releases'
            endunless
          %}
          <a href="{{ insights_url }}">Insights</a>
          <a href="{{ ebooks_url }}">Ebooks &amp; Playbooks</a>
          <a href="{{ events_url }}">Events &amp; Webinars</a>
          <a href="{{ podcasts_url }}">Podcasts</a>
          <a href="{{ press_url }}">Press Releases</a>
        {% endif %}
      </div>
    {% else %}
      <a href="{{ href }}">{{ nav_title }}</a>
    {% endif %}
  </div>
{% else %}
  <div class="vh-menu__item{% if has_kids %} has-children{% endif %}" {% if has_kids %}data-vh-mega-item{% endif %}>
    <div class="vh-menu__anchor">
      <a
        href="{{ href }}"
        {% if link.current %}
          aria-current="page"
        {% endif %}
        {% if has_kids %}
          aria-haspopup="true"
          aria-expanded="false"
        {% endif %}
      >
        {{ nav_title }}
      </a>
      {% if has_kids %}
        <div class="vh-mega vh-dropdown{% if has_grand %} vh-mega--cols{% else %} vh-mega--list{% endif %}" role="menu">
          {% if has_grand %}
            {% for child in link.links %}
              <div class="vh-mega__col">
                <a class="vh-mega__parent" href="{% render 'vectra-preview-href', url: child.url, title: child.title %}" role="menuitem">{{ child.title }}</a>
                {% if child.links.size > 0 %}
                  <ul class="vh-mega__list">
                    {% for grandchild in child.links %}
                      <li>
                        <a href="{% render 'vectra-preview-href', url: grandchild.url, title: grandchild.title %}" role="menuitem">{{ grandchild.title }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            <ul class="vh-mega__list">
              {% unless nav_title == 'Resources' %}
                {% for child in link.links %}
                  <li>
                    <a href="{% render 'vectra-preview-href', url: child.url, title: child.title %}" role="menuitem">{{ child.title }}</a>
                  </li>
                {% endfor %}
              {% endunless %}
              {% if nav_title == 'About Us' %}
                {% liquid
                  assign child_blob = ''
                  for child in link.links
                    assign child_blob = child_blob | append: child.title | append: '|'
                  endfor
                  assign child_blob = child_blob | downcase
                  assign leadership_url = pages['our-leadership-team'].url | default: pages['leadership'].url
                  assign experts_url = pages['experts'].url
                  assign associates_url = pages['associates'].url
                  assign interns_url = pages['interns'].url
                  assign careers_url = pages['careers'].url
                %}
                {% unless child_blob contains 'leader' %}
                  <li><a href="{% render 'vectra-preview-href', url: leadership_url, view: 'leadership' %}" role="menuitem">Our Leadership Team</a></li>
                {% endunless %}
                {% unless child_blob contains 'expert' %}
                  <li><a href="{% render 'vectra-preview-href', url: experts_url, view: 'experts' %}" role="menuitem">Our Experts</a></li>
                {% endunless %}
                {% unless child_blob contains 'associate' %}
                  <li><a href="{% render 'vectra-preview-href', url: associates_url, view: 'associates' %}" role="menuitem">Associates</a></li>
                {% endunless %}
                {% unless child_blob contains 'intern' %}
                  <li><a href="{% render 'vectra-preview-href', url: interns_url, view: 'interns' %}" role="menuitem">Our Interns</a></li>
                {% endunless %}
                {% unless child_blob contains 'career' %}
                  <li><a href="{% render 'vectra-preview-href', url: careers_url, view: 'careers' %}" role="menuitem">Careers</a></li>
                {% endunless %}
              {% endif %}
              {% if nav_title == 'Resources' %}
                {% liquid
                  assign resources_fallback = pages['resources'].url | default: '/pages/resources'
                  assign insights_url = pages['insights-page'].url | default: pages['insights'].url | default: pages['blogs'].url | default: resources_fallback
                  assign ebooks_url = pages['ebooks-and-playbooks'].url | default: pages['e-books-playbooks'].url | default: resources_fallback
                  assign events_url = pages['events-and-webinars'].url | default: pages['event-webinars'].url | default: pages['events'].url | default: resources_fallback
                  assign podcasts_url = pages['podcasts'].url | default: resources_fallback
                  assign press_url = pages['press-releases'].url | default: resources_fallback
                  unless insights_url contains 'view='
                    assign insights_url = insights_url | append: '?view=blogs'
                  endunless
                  unless ebooks_url contains 'view='
                    assign ebooks_url = ebooks_url | append: '?view=e-books-playbooks'
                  endunless
                  unless events_url contains 'view='
                    assign events_url = events_url | append: '?view=event-webinars'
                  endunless
                  unless podcasts_url contains 'view='
                    assign podcasts_url = podcasts_url | append: '?view=podcasts'
                  endunless
                  unless press_url contains 'view='
                    assign press_url = press_url | append: '?view=press-releases'
                  endunless
                %}
                <li><a href="{{ insights_url }}" role="menuitem">Insights</a></li>
                <li><a href="{{ ebooks_url }}" role="menuitem">Ebooks &amp; Playbooks</a></li>
                <li><a href="{{ events_url }}" role="menuitem">Events &amp; Webinars</a></li>
                <li><a href="{{ podcasts_url }}" role="menuitem">Podcasts</a></li>
                <li><a href="{{ press_url }}" role="menuitem">Press Releases</a></li>
              {% endif %}
            </ul>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}
