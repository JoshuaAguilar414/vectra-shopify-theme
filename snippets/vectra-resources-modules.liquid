{%- doc -%}
  VECTRA Resources page modules.
{%- enddoc -%}

{% render 'vectra-assets' %}
{% liquid
  assign img_mark = 'vectra-6fbd7c62e521082467b9d6192e09d91235f198a5.png' | asset_url
  assign img_arrow = 'vectra-54db3b2d66b85bf4c6ca264ed1363beb759e512d.svg' | asset_url
  assign img_dot = 'vectra-8d2852491309a3c401402b92709c6dbc1ad06451.svg' | asset_url
  assign img_rule = 'vectra-8de942ae22a0127f8e87d300c70bae29095e63f7.svg' | asset_url
  assign img_feature = 'vectra-add817f67c59297c528c5d57486a2794644fb47c.png' | asset_url
  assign img_events = 'vectra-78626510a1ed0aa2ddc4170280cbb69d727b4968.png' | asset_url
  assign img_ebook_1 = 'vectra-ebook-1.png' | asset_url
  assign img_ebook_2 = 'vectra-ebook-2.png' | asset_url
  assign img_ebook_3 = 'vectra-ebook-3.png' | asset_url
  assign img_mail = 'vectra-9a4f80a5b924a881fc96b20219bb1f7c8ca734ab.svg' | asset_url
  assign img_phone = 'vectra-7c0e54b37d57d95df328b0e4ee1f7b87844a7372.svg' | asset_url
  assign img_pin = 'vectra-484bca36e3874bd30d1d6dd79807ed0314378e3d.svg' | asset_url
  assign faq_base = pages['faq'].url | default: '/pages/faq'
%}
{% capture faq_href %}{% render 'vectra-preview-href', url: faq_base, view: 'faq' %}{% endcapture %}
{% assign faq_href = faq_href | strip %}
{% case module %}
  {% when 'hero' %}
{% render 'vectra-seo', page_key: 'resources' %}
<section class="vres-hero" aria-label="Resources" {{ block.shopify_attributes }}>
    {% render 'vectra-image', image: block.settings.watermark, fallback: img_mark, alt: '', class: 'vres-hero__mark', width: 901, height: 909, image_width: 900 %}
    <div class="vres-hero__copy" data-vh-reveal="up">
      <p class="vres-hero__kicker">{{ block.settings.kicker | default: 'VECTRA Resources' }}</p>
      <h1>{{ block.settings.heading | default: 'Responsible Business Resources &amp; Insights' }}</h1>
      <h2>{{ block.settings.subheading | default: 'Better Insight. Clearer Decisions.' }}</h2>
      <p class="vres-hero__lead">
        {{ block.settings.text | default: 'VECTRA Resources helps you work out what matters, what it means for your organization, and what to do next. There is already enough information available. The harder part is separating what is relevant from what is not, understanding what it means for your operations, and knowing where your attention needs to go.' }}
      </p>
    </div>
    <nav class="vres-cats" aria-label="Resource types" data-vh-reveal="up">
      <a class="vres-cat" href="{{ block.settings.cat_1_link | default: '#insights' }}">
        {{ block.settings.cat_1_label | default: 'Insights' }}
        <img src="{{ img_arrow }}" alt="" width="16" height="10">
      </a>
      <a class="vres-cat" href="{{ block.settings.cat_2_link | default: '#ebooks' }}">
        {{ block.settings.cat_2_label | default: 'Ebooks &amp; Playbooks' }}
        <img src="{{ img_arrow }}" alt="" width="16" height="10">
      </a>
      <a class="vres-cat" href="{{ block.settings.cat_3_link | default: '#events' }}">
        {{ block.settings.cat_3_label | default: 'Events &amp; Webinars' }}
        <img src="{{ img_arrow }}" alt="" width="16" height="10">
      </a>
      <a class="vres-cat" href="{{ block.settings.cat_4_link | default: '#podcasts' }}">
        {{ block.settings.cat_4_label | default: 'VCASTs' }}
        <img src="{{ img_arrow }}" alt="" width="16" height="10">
      </a>
    </nav>
  </section>

  {% when 'feed' %}
        <header class="vres-label" id="insights">
          <img class="vres-label__dot" src="{{ img_dot }}" alt="" width="6" height="6">
          <h2>{{ block.settings.insights_heading | default: 'Insights' }}</h2>
          <img class="vres-label__rule" src="{{ img_rule }}" alt="" width="693" height="2">
        </header>

        <article class="vres-feature" data-vres-item data-vres-tags="performance management solutions">
          <h3>{{ block.settings.feature_heading | default: 'From insight to the decision that has to follow' }}</h3>
          {% render 'vectra-image', image: block.settings.feature_image, fallback: img_feature, alt: 'Teams reviewing operational performance', width: 932, height: 301, image_width: 1400 %}
          <div class="vres-prose">
            {% if block.settings.feature_text != blank %}
              {{ block.settings.feature_text }}
            {% else %}
            <p>
              There is already enough information available. The harder part is separating what is relevant from what is not, understanding what it means for your operations, and knowing where your attention needs to go.
            </p>
            <p>
              VECTRA Insights help procurement, operations, risk, and sustainability leaders make sense of changing requirements before they become a stalled action or an evidence gap.
            </p>
            {% endif %}
          </div>
        </article>

        <header class="vres-label" id="events">
          <img class="vres-label__dot" src="{{ img_dot }}" alt="" width="6" height="6">
          <h2>{{ block.settings.events_heading | default: 'Events &amp; webinars' }}</h2>
          <img class="vres-label__rule" src="{{ img_rule }}" alt="" width="693" height="2">
        </header>

        <article class="vres-split" data-vres-item data-vres-tags="experience development">
          <div class="vres-split__copy">
            <h3>{{ block.settings.events_title | default: 'Events that add context to a decision you are already making' }}</h3>
            <div class="vres-prose vres-prose--muted">
              {% if block.settings.events_text != blank %}
                {{ block.settings.events_text }}
              {% else %}
              <p>
                Live and on-demand conversations with experts working through the issues shaping responsible business, supply chain resilience, and operational performance.
              </p>
              <p>
                Join to hear how teams are turning requirements, supplier findings, and operational gaps into a practical next step.
              </p>
              {% endif %}
            </div>
          </div>
          {% render 'vectra-image', image: block.settings.events_image, fallback: img_events, alt: 'Teams mapping sustainability actions', width: 460, height: 301, image_width: 920 %}
        </article>

        <article class="vres-follow" data-vres-item data-vres-tags="support recruitment">
          <h3>{{ block.settings.follow_heading | default: 'What changed after the finding — and what still needs a team around it' }}</h3>
          <div class="vres-prose vres-prose--muted">
            {% if block.settings.follow_text != blank %}
              {{ block.settings.follow_text }}
            {% else %}
            <p>
              Case studies show how VECTRA works through operational resilience, supply chain, and responsible-business challenges, from the starting problem to the work that followed.
            </p>
            <p>
              Press and VCASTs add the company context behind partnerships, leadership news, and the issues practitioners work on every day.
            </p>
            {% endif %}
          </div>
        </article>

  {% when 'ebooks' %}
<section class="vres-ebooks" id="ebooks" {{ block.shopify_attributes }}>
    <header class="vres-label">
      <img class="vres-label__dot" src="{{ img_dot }}" alt="" width="6" height="6">
      <h2>{{ block.settings.heading | default: 'Ebooks &amp; playbooks' }}</h2>
      <img class="vres-label__rule" src="{{ img_rule }}" alt="" width="693" height="2">
    </header>
    {% liquid
      assign ebook_1 = block.settings.image_1
      assign ebook_2 = block.settings.image_2
      assign ebook_3 = block.settings.image_3
      assign ebook_4 = block.settings.image_4
      assign ebook_5 = block.settings.image_5
    %}
    <div class="vres-ebooks__grid">
      <a class="vres-ebooks__card" href="{{ block.settings.link_1 | default: '#' }}">
        {% if ebook_1 != blank %}
          {{ ebook_1 | image_url: width: 960 | image_tag: loading: 'lazy', alt: 'Risk Management & Supply Chain Due Diligence in a Complex Legal Landscape', width: 480, height: 472 }}
        {% else %}
          <img src="{{ img_ebook_1 }}" alt="Risk Management &amp; Supply Chain Due Diligence in a Complex Legal Landscape" width="480" height="472">
        {% endif %}
      </a>
      <a class="vres-ebooks__card" href="{{ block.settings.link_2 | default: '#' }}">
        {% if ebook_2 != blank %}
          {{ ebook_2 | image_url: width: 960 | image_tag: loading: 'lazy', alt: "A Guide to EU's Corporate Sustainability Due Diligence Directive", width: 450, height: 472 }}
        {% else %}
          <img src="{{ img_ebook_2 }}" alt="A Guide to EU's Corporate Sustainability Due Diligence Directive" width="450" height="472">
        {% endif %}
      </a>
      <a class="vres-ebooks__card" href="{{ block.settings.link_3 | default: '#' }}">
        {% if ebook_3 != blank %}
          {{ ebook_3 | image_url: width: 960 | image_tag: loading: 'lazy', alt: 'ESG Due Diligence Insights and Actionable Steps for Businesses', width: 451, height: 472 }}
        {% else %}
          <img src="{{ img_ebook_3 }}" alt="ESG Due Diligence Insights and Actionable Steps for Businesses" width="451" height="472">
        {% endif %}
      </a>
      <a class="vres-ebooks__card" href="{{ block.settings.link_4 | default: '#' }}">
        {% if ebook_4 != blank %}
          {{ ebook_4 | image_url: width: 960 | image_tag: loading: 'lazy', alt: "A Guide to EU's Corporate Sustainability Due Diligence Directive", width: 450, height: 472 }}
        {% else %}
          <img src="{{ img_ebook_2 }}" alt="A Guide to EU's Corporate Sustainability Due Diligence Directive" width="450" height="472">
        {% endif %}
      </a>
      <a class="vres-ebooks__card" href="{{ block.settings.link_5 | default: '#' }}">
        {% if ebook_5 != blank %}
          {{ ebook_5 | image_url: width: 960 | image_tag: loading: 'lazy', alt: 'Risk Management & Supply Chain Due Diligence in a Complex Legal Landscape', width: 480, height: 472 }}
        {% else %}
          <img src="{{ img_ebook_1 }}" alt="Risk Management &amp; Supply Chain Due Diligence in a Complex Legal Landscape" width="480" height="472">
        {% endif %}
      </a>
    </div>
    <span id="podcasts"></span>
  </section>

  {% when 'faq' %}
{% assign nested_items = nested_items | strip %}
<section class="vh-faq" id="resources-faq" {{ block.shopify_attributes }}>
  <div class="vh-wrap vh-faq__grid">
    <aside class="vh-contact-card" data-vh-reveal="left">
      <img class="vh-contact-card__icon" src="{{ 'vectra-da137306dcbc6716d83295ef75678ab141a500e1.svg' | asset_url }}" alt="">
      <p class="vh-contact-card__title">{{ block.settings.card_title | default: 'More questions?' }}</p>
      <p>{{ block.settings.card_text | default: 'Find more answers about VECTRA International, how we work, our capabilities, and getting started.' }}</p>
      <a class="vh-btn vh-btn--white" href="{{ block.settings.button_link | default: faq_href }}">
        {{ block.settings.button_label | default: 'More questions?' }}
        <img src="{{ 'vectra-33469c114cd0dac188b171519c338a0fcdfa79a7.svg' | asset_url }}" alt="">
      </a>
      {% render 'vectra-contact-details', variant: 'card', img_phone: img_phone, img_mail: img_mail, img_pin: img_pin %}
    </aside>
    <div class="vh-faq__right">
      <div class="vh-faq__glow" aria-hidden="true"></div>
      <div class="vh-accordion">
        <p class="vh-kicker">{{ block.settings.kicker | default: 'Our FAQ' }}</p>
        <h2 class="vh-h2">{{ block.settings.heading | default: 'Frequently Asked Questions' }}</h2>
        <p class="vh-lead">{{ block.settings.lead | default: 'Answers about VECTRA Resources and how to find the right material.' }}</p>
        {% if nested_items != blank %}
          {{ nested_items }}
        {% else %}
        <div class="vh-acc is-open" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>What are responsible business resources?</button>
          <div class="vh-acc__body">Responsible business resources are insights, guides, evidence, and expert analysis that help organizations understand ESG, supply chain, compliance, risk management, business resilience, and operational resilience issues and decide what action to take.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>Who are VECTRA Resources written for?</button>
          <div class="vh-acc__body">VECTRA Resources are written for procurement, operations, supply chain, risk, compliance, sustainability, and transformation leaders who need to understand an issue before making or defending a decision.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>What types of resources does VECTRA International offer?</button>
          <div class="vh-acc__body">VECTRA International offers Insights, Ebooks and Playbooks, Events and Webinars, VCASTs, Case Studies, and Press Releases. Across these formats, you can explore ESG resources, supply chain resources, business resilience resources, risk management resources, and operational resilience resources.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>Are VECTRA Resources free to access?</button>
          <div class="vh-acc__body">Yes. VECTRA Resources are free to explore. Some Ebooks, Playbooks, and Events may require registration.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>How do I find the right resource for my question?</button>
          <div class="vh-acc__body">Use the search bar to find resources by topic, regulation, risk, or keyword. You can also browse by format if you already know whether you need a quick Insight, a deeper guide, an expert conversation, or a real-world Case Study.</div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% endcase %}
