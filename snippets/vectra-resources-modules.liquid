  {% when 'why' %}
{% unless block.settings.hide_section %}
{% liquid
  assign why_kicker = block.settings.kicker | default: 'WHY CHOOSE VECTRA INTERNATIONAL'
  assign why_heading = block.settings.heading | default: 'Why Choose VECTRA International'
%}
<section class="vres-why" id="why-vectra" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap">
    <p class="vh-kicker">{{ why_kicker }}</p>
    <h2 class="vh-h2">{{ why_heading }}</h2>
    <div class="vres-why__copy">
      {% if block.settings.text != blank %}
        {% assign why_paras = block.settings.text | newline_to_br | split: '<br />' %}
        {% for para in why_paras %}
          {% assign para_text = para | strip_html | strip %}
          {% if para_text != blank %}
            <p{% if forloop.last %} class="vres-why__close"{% endif %}>{{ para_text }}</p>
          {% endif %}
        {% endfor %}
      {% else %}
        <p>VECTRA International brings more than 20 years of work across responsible business, supply chains, risk, and operational improvement to the resources published here.</p>
        <p>Our responsible business resources draw on the same specialist expertise behind VECTRA’s client work, connecting ESG, supply chain, audit, risk management, and operational resilience topics with the decisions and practical work behind them.</p>
        <p class="vres-why__close">What you read here reflects what we work on in practice.</p>
      {% endif %}
    </div>
  </div>
</section>
{% endunless %}

  {% when 'faq' %}
{% unless block.settings.hide_section %}
{% assign nested_items = nested_items | strip %}
<section class="vh-faq" id="resources-faq" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap vh-faq__grid">
    <aside class="vh-contact-card" data-vh-reveal="left">
      <img class="vh-contact-card__icon" src="{{ img_chat }}" alt="">
      <p class="vh-contact-card__title">{{ block.settings.card_title | default: 'Still looking for clarity?' }}</p>
      <p>{{ block.settings.card_text | default: 'If what you have learned needs to become a decision, a plan, or a change to how your team works, talk to a VECTRA expert.' }}</p>
      <a class="vh-btn vh-btn--white" href="{{ block.settings.button_link | default: '#what-comes-next' }}">
        {{ block.settings.button_label | default: 'Talk to a VECTRA Expert' }}
        <img src="{{ 'vectra-33469c114cd0dac188b171519c338a0fcdfa79a7.svg' | asset_url }}" alt="">
      </a>
      {% render 'vectra-contact-details', variant: 'card', img_phone: img_phone, img_mail: img_mail, img_pin: img_pin %}
    </aside>
    <div class="vh-faq__right">
      <div class="vh-faq__glow" aria-hidden="true"></div>
      <div class="vh-accordion" data-vh-faq-accordion>
        {% if block.settings.kicker != blank %}
          <p class="vh-kicker">{{ block.settings.kicker }}</p>
        {% endif %}
        <h2 class="vh-h2">{{ block.settings.heading | default: 'Frequently Asked Questions' }}</h2>
        {% if nested_items != blank %}
          {{ nested_items }}
        {% else %}
          <div class="vh-acc is-open" data-vh-faq-item>
            <button type="button" data-vh-faq-btn aria-expanded="true">What are responsible business resources?</button>
            <div class="vh-acc__body">Responsible business resources are insights, guides, evidence, and expert analysis that help organizations understand ESG, supply chain, compliance, risk management, business resilience, and operational resilience issues and decide what action to take.</div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn aria-expanded="false">Who are VECTRA Resources written for?</button>
            <div class="vh-acc__body" hidden>VECTRA Resources are written for procurement, operations, supply chain, risk, compliance, sustainability, and transformation leaders who need to understand an issue before making or defending a decision.</div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn aria-expanded="false">What types of resources does VECTRA International offer?</button>
            <div class="vh-acc__body" hidden>
              <p>VECTRA International offers Insights, Ebooks and Playbooks, Events and Webinars, VCASTs, Case Studies, and Press Releases.</p>
              <p>Across these formats, you can explore ESG resources, supply chain resources, business resilience resources, risk management resources, and operational resilience resources.</p>
            </div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn aria-expanded="false">Are VECTRA Resources free to access?</button>
            <div class="vh-acc__body" hidden>Yes. VECTRA Resources are free to explore. Some Ebooks, Playbooks, and Events may require registration.</div>
          </div>
          <div class="vh-acc" data-vh-faq-item>
            <button type="button" data-vh-faq-btn aria-expanded="false">How do I find the right resource for my question?</button>
            <div class="vh-acc__body" hidden>Use the search bar to find resources by topic, regulation, risk, or keyword. You can also browse by format if you already know whether you need a quick Insight, a deeper guide, an expert conversation, or a real-world Case Study.</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endunless %}

  {% when 'closing' %}
{% unless block.settings.hide_section %}
{% liquid
  assign close_kicker = block.settings.kicker | default: 'WHAT COMES NEXT'
  assign close_heading = block.settings.heading | default: 'Better insight should lead somewhere.'
  assign close_text = block.settings.text | default: 'If what you have learned needs to become a decision, a plan, or a change to how your team works, VECTRA International can help you move it forward.'
  assign form_heading = block.settings.form_heading | default: 'Talk to a VECTRA Expert'
%}
<section class="vres-closing vh-portal" id="what-comes-next" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap vh-portal__grid">
    <div class="vh-portal__copy">
      <p class="vh-kicker">{{ close_kicker }}</p>
      <h2>{{ close_heading }}</h2>
      <p>{{ close_text }}</p>
    </div>
    {% form 'contact', class: 'vh-form' %}
      <h2 class="vres-closing__form-title">{{ form_heading }}</h2>
      {% if form.posted_successfully? %}
        <p class="vh-contact-modal__success">Thanks — we received your message and will be in touch shortly.</p>
      {% endif %}
      {% if form.errors %}
        <p class="vh-contact-modal__error">{{ form.errors | default_errors }}</p>
      {% endif %}
      {% render 'vectra-contact-fields', img_arrow: img_arrow, home_form: true, submit_label: 'Start the Conversation', message_placeholder: 'Tell us what you are working through and where you need clarity or support.' %}
    {% endform %}
  </div>
</section>
{% endunless %}

{% endcase %}
