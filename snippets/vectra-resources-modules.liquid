{%- doc -%}
  VECTRA Resources page modules.
{%- enddoc -%}

{% render 'vectra-assets' %}
{% liquid
  assign img_mark = 'vectra-6fbd7c62e521082467b9d6192e09d91235f198a5.png' | asset_url
  assign img_arrow = 'vectra-54db3b2d66b85bf4c6ca264ed1363beb759e512d.svg' | asset_url
  assign img_dot = 'vectra-8d2852491309a3c401402b92709c6dbc1ad06451.svg' | asset_url
  assign img_rule = 'vectra-8de942ae22a0127f8e87d300c70bae29095e63f7.svg' | asset_url
  assign img_feature = 'vectra-add817f67c59297c528c5d57486a2794644fb47c.png' | asset_url
  assign img_events = 'vectra-78626510a1ed0aa2ddc4170280cbb69d727b4968.png' | asset_url
  assign img_ebook_1 = 'vectra-ebook-1.png' | asset_url
  assign img_ebook_2 = 'vectra-ebook-2.png' | asset_url
  assign img_ebook_3 = 'vectra-ebook-3.png' | asset_url
  assign img_mail = 'vectra-9a4f80a5b924a881fc96b20219bb1f7c8ca734ab.svg' | asset_url
  assign img_phone = 'vectra-7c0e54b37d57d95df328b0e4ee1f7b87844a7372.svg' | asset_url
  assign img_pin = 'vectra-484bca36e3874bd30d1d6dd79807ed0314378e3d.svg' | asset_url
  assign img_chat = 'vectra-da137306dcbc6716d83295ef75678ab141a500e1.svg' | asset_url
  assign faq_base = pages['faq'].url | default: '/pages/faq'
  assign resources_url = pages['resources'].url | default: '/pages/resources'
%}
{% capture faq_href %}{% render 'vectra-preview-href', url: faq_base, view: 'faq' %}{% endcapture %}
{% assign faq_href = faq_href | strip %}

{% liquid
  assign blog_insights = blogs['insights']
  if blog_insights == blank or blog_insights.articles_count == 0
    assign blog_insights = blogs['news']
  endif
  assign blog_ebooks = blogs['ebooks']
  if blog_ebooks == blank or blog_ebooks.articles_count == 0
    assign blog_ebooks = blogs['playbooks']
  endif
  assign blog_events = blogs['events']
  if blog_events == blank or blog_events.articles_count == 0
    assign blog_events = blogs['webinars']
  endif
  assign blog_vcasts = blogs['vcasts']
  if blog_vcasts == blank or blog_vcasts.articles_count == 0
    assign blog_vcasts = blogs['podcasts']
  endif
  assign blog_cases = blogs['case-studies']
  if blog_cases == blank or blog_cases.articles_count == 0
    assign blog_cases = blogs['cases']
  endif
  assign blog_press = blogs['press-releases']
  if blog_press == blank or blog_press.articles_count == 0
    assign blog_press = blogs['press']
  endif
%}

{% case module %}
  {% when 'hero' %}
{% render 'vectra-seo', page_key: 'resources' %}
{% unless block.settings.hide_section %}
{% liquid
  assign hero_kicker = block.settings.kicker | default: 'VECTRA RESOURCES'
  assign hero_h1 = block.settings.heading | default: 'Responsible Business Resources & Insights'
  assign hero_display = block.settings.subheading | default: 'Better Insight. Clearer Decisions.'
  assign hero_aeo = block.settings.aeo_text | default: 'Responsible business resources help organizations understand ESG, supply chain, sustainability, compliance, risk, and operational resilience issues and decide what to do about them. VECTRA International brings together ESG resources, supply chain resources, Insights, Ebooks and Playbooks, Events and Webinars, VCASTs, Case Studies, and Press Releases, organized by the kind of answer you need.'
%}
<section
  class="vres-hero vres-hero--align-{{ block.settings.text_align | default: 'left' }}"
  aria-label="Resources"
  style="{% render 'vectra-block-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {% render 'vectra-image', image: block.settings.watermark, fallback: img_mark, alt: '', class: 'vres-hero__mark', width: 901, height: 909, image_width: 900 %}
  <div class="vres-hero__copy" data-vh-reveal="up">
    <p class="vres-hero__kicker">{{ hero_kicker }}</p>
    <h1>{{ hero_h1 }}</h1>
    <h2 class="vres-hero__display">{{ hero_display }}</h2>
    <div class="vres-hero__lead">
      {% if block.settings.text != blank %}
        {% assign hero_paras = block.settings.text | newline_to_br | split: '<br />' %}
        {% for para in hero_paras %}
          {% assign para_text = para | strip_html | strip %}
          {% if para_text != blank %}
            <p>{{ para_text }}</p>
          {% endif %}
        {% endfor %}
      {% else %}
        <p>VECTRA Resources helps you work out what matters, what it means for your organization, and what to do next.</p>
        <p>There is already enough information available. The harder part is separating what is relevant from what is not, understanding what it means for your operations, and knowing where your attention needs to go.</p>
      {% endif %}
    </div>
    {% if hero_aeo != blank %}
      <p class="vres-hero__aeo">{{ hero_aeo }}</p>
    {% endif %}
  </div>
</section>
{% endunless %}

  {% when 'explore' %}
{% unless block.settings.hide_section %}
{% liquid
  assign ex_kicker = block.settings.kicker | default: 'EXPLORE VECTRA RESOURCES'
  assign ex_heading = block.settings.heading | default: 'Find the Right Resource for What You Need'
  assign ex_text = block.settings.text | default: 'Not every question needs the same kind of answer. Sometimes you need a clear expert’s take on a changing requirement. Sometimes you need a deeper guide, evidence from a real case, or a conversation that adds context to a decision you are already making.'
  assign ex_close = block.settings.close_text | default: 'Choose the format that fits the question in front of you.'
%}
<section class="vres-explore" id="explore" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap">
    <p class="vh-kicker">{{ ex_kicker }}</p>
    <h2 class="vh-h2">{{ ex_heading }}</h2>
    <p class="vh-lead">{{ ex_text }}</p>
    <p class="vres-explore__close">{{ ex_close }}</p>
    <div class="vres-explore__grid">
      <article class="vres-explore__card" data-vh-reveal>
        <h3>{{ block.settings.card_1_title | default: 'Insights' }}</h3>
        <p>{{ block.settings.card_1_text | default: 'Expert analysis that helps you make sense of changing regulations, supply chain risk, business resilience, and operational resilience issues as they develop.' }}</p>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ block.settings.card_1_link | default: '#insights' }}">{{ block.settings.card_1_cta | default: 'Explore Insights' }}</a>
      </article>
      <article class="vres-explore__card" data-vh-reveal>
        <h3>{{ block.settings.card_2_title | default: 'Ebooks & Playbooks' }}</h3>
        <p>{{ block.settings.card_2_text | default: 'Structured guides and frameworks that help you organize a complex issue and plan the work required to address it.' }}</p>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ block.settings.card_2_link | default: '#ebooks' }}">{{ block.settings.card_2_cta | default: 'Browse Ebooks & Playbooks' }}</a>
      </article>
      <article class="vres-explore__card" data-vh-reveal>
        <h3>{{ block.settings.card_3_title | default: 'Events & Webinars' }}</h3>
        <p>{{ block.settings.card_3_text | default: 'Live and on-demand conversations with experts working through the issues shaping responsible business, supply chain resilience, risk management, and operational performance.' }}</p>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ block.settings.card_3_link | default: '#events' }}">{{ block.settings.card_3_cta | default: 'Explore Events & Webinars' }}</a>
      </article>
      <article class="vres-explore__card" data-vh-reveal>
        <h3>{{ block.settings.card_4_title | default: 'VCASTs' }}</h3>
        <p>{{ block.settings.card_4_text | default: 'Hear the experience, thinking, and perspective behind the issues VECTRA experts, partners, and practitioners work on every day.' }}</p>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ block.settings.card_4_link | default: '#vcasts' }}">{{ block.settings.card_4_cta | default: 'Listen to VCASTs' }}</a>
      </article>
      <article class="vres-explore__card" data-vh-reveal>
        <h3>{{ block.settings.card_5_title | default: 'Case Studies' }}</h3>
        <p>{{ block.settings.card_5_text | default: 'See how VECTRA works through operational resilience, supply chain, compliance, and responsible-business challenges, from the starting problem to the work that followed and what changed.' }}</p>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ block.settings.card_5_link | default: '#case-studies' }}">{{ block.settings.card_5_cta | default: 'Explore Case Studies' }}</a>
      </article>
      <article class="vres-explore__card" data-vh-reveal>
        <h3>{{ block.settings.card_6_title | default: 'Press Releases' }}</h3>
        <p>{{ block.settings.card_6_text | default: 'Official VECTRA announcements, partnerships, leadership news, and company developments.' }}</p>
        <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ block.settings.card_6_link | default: '#press' }}">{{ block.settings.card_6_cta | default: 'View Press Releases' }}</a>
      </article>
    </div>
  </div>
</section>
{% endunless %}

  {% when 'feed' %}
{% unless block.settings.hide_section %}
{% liquid
  assign insights_heading = block.settings.insights_heading | default: 'INSIGHTS'
  assign featured_heading = block.settings.feature_heading | default: 'Featured Insights'
  assign search_placeholder = block.settings.search_placeholder | default: 'Search by topic, regulation, risk, or keyword'
  assign view_all_label = block.settings.view_all_label | default: 'View All Insights'
  if block.settings.view_all_link != blank
    assign view_all_href = block.settings.view_all_link
  elsif blog_insights != blank
    assign view_all_href = blog_insights.url
  else
    assign view_all_href = resources_url
  endif
%}
<section class="vres-library" id="insights" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap">
    <header class="vres-label">
      <img class="vres-label__dot" src="{{ img_dot }}" alt="" width="6" height="6">
      <h2>{{ insights_heading }}</h2>
      <img class="vres-label__rule" src="{{ img_rule }}" alt="" width="693" height="2">
    </header>
    <form class="vres-searchbar" action="{{ routes.search_url }}" method="get" role="search">
      <label class="vres-searchbar__field">
        <span class="visually-hidden">Search insights</span>
        <input type="search" name="q" placeholder="{{ search_placeholder }}" autocomplete="off">
      </label>
      <input type="hidden" name="type" value="article">
      <button class="vh-btn vh-btn--green vh-btn--rect" type="submit">Search</button>
    </form>
    <h2 class="vres-library__subhead">{{ featured_heading }}</h2>
    <div class="vres-library__grid">
      {% if blog_insights != blank and blog_insights.articles_count > 0 %}
        {% for article in blog_insights.articles limit: 3 %}
          <article class="vres-library__card" data-vh-reveal>
            {% if article.image %}
              {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}
            {% else %}
              <img src="{{ img_feature }}" alt="" width="800" height="450">
            {% endif %}
            <h4>{{ article.title }}</h4>
            <p>{{ article.excerpt | default: article.content | strip_html | truncate: 140 }}</p>
            <a class="vres-library__cta" href="{{ article.url }}">Read Insight</a>
          </article>
        {% endfor %}
      {% else %}
        <article class="vres-library__card" data-vh-reveal>
          <img src="{{ img_feature }}" alt="" width="800" height="450">
          <h4>From insight to the decision that has to follow</h4>
          <p>Make sense of changing requirements before they become a stalled action or an evidence gap.</p>
          <a class="vres-library__cta" href="{{ view_all_href }}">Read Insight</a>
        </article>
        <article class="vres-library__card" data-vh-reveal>
          <img src="{{ img_events }}" alt="" width="800" height="450">
          <h4>What changed after the finding</h4>
          <p>See how teams turn supplier findings and operational gaps into a practical next step.</p>
          <a class="vres-library__cta" href="{{ view_all_href }}">Read Insight</a>
        </article>
        <article class="vres-library__card" data-vh-reveal>
          <img src="{{ img_feature }}" alt="" width="800" height="450">
          <h4>Separating signal from noise</h4>
          <p>Work out what is relevant for your operations, and where your attention needs to go next.</p>
          <a class="vres-library__cta" href="{{ view_all_href }}">Read Insight</a>
        </article>
      {% endif %}
    </div>
    <div class="vres-library__more">
      <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ view_all_href }}">{{ view_all_label }}</a>
    </div>
  </div>
</section>
{% endunless %}

  {% when 'ebooks' %}
{% unless block.settings.hide_section %}
{% liquid
  assign ebooks_heading = block.settings.heading | default: 'EBOOKS & PLAYBOOKS'
  assign ebooks_cta = block.settings.button_label | default: 'Explore All Ebooks & Playbooks'
  if block.settings.button_link != blank
    assign ebooks_href = block.settings.button_link
  elsif blog_ebooks != blank
    assign ebooks_href = blog_ebooks.url
  else
    assign ebooks_href = '#ebooks'
  endif
%}
<section class="vres-library vres-library--ebooks" id="ebooks" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap">
    <header class="vres-label">
      <img class="vres-label__dot" src="{{ img_dot }}" alt="" width="6" height="6">
      <h2>{{ ebooks_heading }}</h2>
      <img class="vres-label__rule" src="{{ img_rule }}" alt="" width="693" height="2">
    </header>
    <div class="vres-library__grid vres-library__grid--ebooks">
      {% if blog_ebooks != blank and blog_ebooks.articles_count > 0 %}
        {% for article in blog_ebooks.articles limit: 4 %}
          <article class="vres-library__card" data-vh-reveal>
            {% if article.image %}
              {{ article.image | image_url: width: 640 | image_tag: loading: 'lazy', alt: article.title }}
            {% endif %}
            <h4>{{ article.title }}</h4>
            <p>{{ article.excerpt | default: article.content | strip_html | truncate: 120 }}</p>
            <a class="vres-library__cta" href="{{ article.url }}">Download / Read</a>
          </article>
        {% endfor %}
      {% else %}
        <article class="vres-library__card" data-vh-reveal>
          <img src="{{ img_ebook_1 }}" alt="" width="480" height="472">
          <h4>Risk Management & Supply Chain Due Diligence</h4>
          <p>A structured guide to organizing due diligence work across complex supply chains.</p>
          <a class="vres-library__cta" href="{{ block.settings.link_1 | default: '#' }}">Download / Read</a>
        </article>
        <article class="vres-library__card" data-vh-reveal>
          <img src="{{ img_ebook_2 }}" alt="" width="450" height="472">
          <h4>A Guide to EU Corporate Sustainability Due Diligence</h4>
          <p>Frameworks that help you plan the work required to address CSDDD requirements.</p>
          <a class="vres-library__cta" href="{{ block.settings.link_2 | default: '#' }}">Download / Read</a>
        </article>
        <article class="vres-library__card" data-vh-reveal>
          <img src="{{ img_ebook_3 }}" alt="" width="451" height="472">
          <h4>ESG Due Diligence Insights and Actionable Steps</h4>
          <p>Practical steps for turning ESG requirements into clearer ownership and action.</p>
          <a class="vres-library__cta" href="{{ block.settings.link_3 | default: '#' }}">Download / Read</a>
        </article>
      {% endif %}
    </div>
    <div class="vres-library__more">
      <a class="vh-btn vh-btn--green vh-btn--rect" href="{{ ebooks_href }}">{{ ebooks_cta }}</a>
    </div>
  </div>
</section>

{% comment %} Events & Webinars {% endcomment %}
<section class="vres-library" id="events">
  <div class="vh-wrap">
    <header class="vres-label">
      <img class="vres-label__dot" src="{{ img_dot }}" alt="" width="6" height="6">
      <h2>EVENTS & WEBINARS</h2>
      <img class="vres-label__rule" src="{{ img_rule }}" alt="" width="693" height="2">
    </header>
    <h3 class="vres-library__subhead">Upcoming</h3>
    <div class="vres-library__grid">
      {% if blog_events != blank and blog_events.articles_count > 0 %}
        {% for article in blog_events.articles limit: 2 %}
          <article class="vres-library__card" data-vh-reveal>
            <h4>{{ article.title }}</h4>
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
            <p>{{ article.excerpt | default: article.content | strip_html | truncate: 140 }}</p>
            <a class="vres-library__cta" href="{{ article.url }}">Register</a>
          </article>
        {% endfor %}
      {% else %}
        <article class="vres-library__card" data-vh-reveal>
          <h4>Events that add context to a decision you are already making</h4>
          <time>Upcoming</time>
          <p>Live conversations with experts working through responsible business, supply chain resilience, and operational performance.</p>
          <a class="vres-library__cta" href="#events">Register</a>
        </article>
      {% endif %}
    </div>
    <h3 class="vres-library__subhead">On Demand</h3>
    <div class="vres-library__grid">
      {% if blog_events != blank and blog_events.articles_count > 2 %}
        {% for article in blog_events.articles offset: 2 limit: 2 %}
          <article class="vres-library__card" data-vh-reveal>
            <h4>{{ article.title }}</h4>
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
            <a class="vres-library__cta" href="{{ article.url }}">Watch Now</a>
          </article>
        {% endfor %}
      {% else %}
        <article class="vres-library__card" data-vh-reveal>
          <h4>Recorded sessions on operational resilience and supplier risk</h4>
          <time>On demand</time>
          <a class="vres-library__cta" href="#events">Watch Now</a>
        </article>
      {% endif %}
    </div>
    <div class="vres-library__more">
      <a class="vh-btn vh-btn--green vh-btn--rect" href="{% if blog_events != blank %}{{ blog_events.url }}{% else %}#events{% endif %}">Explore All Events & Webinars</a>
    </div>
  </div>
</section>

