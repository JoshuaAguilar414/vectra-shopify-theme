{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign vectra_meta_locked = false

  if template.name == 'index'
    assign og_title = 'Responsible Business Partner| Risk Assessment & Supply Chain Risk Consulting'
    assign og_description = 'Drive responsible business transformation with VECTRA’s ESG consulting, business resilience, operational resilience, supply chain consulting expertise, and resources.'
    assign vectra_meta_locked = true
  elsif template.suffix == 'our-story' or template.suffix == 'vectra'
    assign og_title = 'About VECTRA International | Our DNA & Values'
    assign og_description = "Discover VECTRA International's DNA, values and global expertise in ESG, responsible business, supply chain resilience and business transformation."
    assign vectra_meta_locked = true
  elsif template.suffix == 'resources'
    assign og_title = 'Responsible Business Resources | VECTRA International'
    assign og_description = "Explore VECTRA International's resources and insights on responsible business, supply chain, ESG, operational resilience, and risk management."
    assign vectra_meta_locked = true
  elsif template.suffix == 'contact-us' or template.suffix == 'contact'
    assign og_title = 'Contact VECTRA International | Get in Touch'
    assign og_description = 'Contact VECTRA International for ESG, supply chain, and operational resilience expertise. Reach our consultants by form, email, or phone.'
    assign vectra_meta_locked = true
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ og_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless vectra_meta_locked or og_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if page_description or vectra_meta_locked %}
  <meta
    name="description"
    content="{{ og_description | escape }}"
  >
{% endif %}
