{%- doc -%}
  Shared VECTRA footer.
{%- enddoc -%}

{% render 'vectra-assets' %}

{% liquid
  assign img_logo = 'vectra-f1f1bad320cc916c9d3f257211cb366de698a572.png' | asset_url
  assign img_social = 'vectra-8edaf1fb1163eb6b857092f513083a6fc9fdc561.svg' | asset_url
  assign home = home_url | default: routes.root_url
  assign story = story_url | default: pages['our-story'].url | default: '/pages/our-story'
%}

<footer class="vh-footer">
  <div class="vh-wrap">
    <div class="vh-footer__top">
      <div class="vh-footer__brand">
        <img src="{{ img_logo }}" alt="{{ shop.name }}">
        <p>Your partner for business resilience and operational capability building through an ecosystem of integrated solutions.</p>
        <p><a href="tel:+3226206118">+32 26206118</a><br><a href="mailto:info@vectra-intl.com">info@vectra-intl.com</a></p>
        <p>Chaussée de Wavre 1517B<br>1160 Brussels, Belgium</p>
      </div>
      <div class="vh-footer__nav">
        <nav class="vh-footer__col">
          <h3>Explore</h3>
          <div class="vh-footer__links">
            <a href="{{ home }}#solutions">Solutions</a>
            <a href="{{ home }}#marketplace">Marketplace</a>
            <a href="{{ home }}#resources">Resources</a>
            <a href="{{ home }}#cases">Case studies</a>
            <a href="{{ home }}#solutions">VSuites</a>
          </div>
        </nav>
        <nav class="vh-footer__col vh-footer__col--wide">
          <h3>Start here</h3>
          <div class="vh-footer__links">
            <a href="#VectraContactModal" data-vh-contact-open>Talk to an expert</a>
            <a href="#VectraContactModal" data-vh-contact-open>Request a demo</a>
            <a href="#VectraContactModal" data-vh-contact-open>Readiness assessment</a>
            <a href="#VectraContactModal" data-vh-contact-open>Build a capability path</a>
            <a href="{{ routes.account_url }}">Client Portal</a>
          </div>
        </nav>
        <nav class="vh-footer__col vh-footer__col--wide">
          <h3>Company</h3>
          <div class="vh-footer__links">
            <a href="{{ story }}">About VECTRA</a>
            <a href="{{ story }}#experts">Associates and Experts</a>
            <a href="{{ home }}#careers">Careers</a>
            <a href="{{ story }}#values">Our values and pledges</a>
            <a href="#VectraContactModal" data-vh-contact-open>Contact us</a>
          </div>
        </nav>
        <div class="vh-footer__col vh-footer__col--follow">
          <h3>Follow Us</h3>
          <div class="vh-social"><img src="{{ img_social }}" alt="Social links"></div>
          <h3 class="vh-footer__subscribe">Subscribe to our newsletter</h3>
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="vh-news">
              <input type="email" name="contact[email]" placeholder="Email Address" required>
              <button type="submit">Send</button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
    <div class="vh-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} VECTRA International | All Rights Reserved.</span>
      <span>
        <a href="https://vectra-intl.com/cookie-policy/">Cookie Policy</a>
        <a href="https://vectra-intl.com/privacy-policy/">Privacy Policy</a>
      </span>
    </div>
  </div>
</footer>
