{% case module %}
  {% when 'experts' %}
{% unless block.settings.hide_section %}
{% liquid
  assign contact_url = pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us'
  assign people_cards = people_cards | strip
%}
<section class="vs-experts vh-people-page" id="experts" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  {% render 'vectra-seo', page_key: 'experts' %}
  <div class="vh-wrap vp-hero">
    <p class="vh-kicker">{{ block.settings.kicker | default: 'OUR PEOPLE' }}</p>
    <h1 class="vp-seo-title">{{ block.settings.heading | default: 'VECTRA International Experts | Subject Matter Experts & Associates' }}</h1>
    <p class="vp-display">The Right Expertise for Your Business Challenge</p>
    <div class="vp-hero__body">
      <p>The right support starts with people who understand the issue.</p>
      <p>VECTRA brings together specialists in sustainability, responsible business, social compliance, environmental impact, carbon accounting, standards, due diligence, and supply chains. They bring the technical knowledge, practical experience, and understanding of the industries and markets they work in to help clients make informed decisions and move forward with confidence.</p>
    </div>
    <p class="vp-aeo">VECTRA International experts are subject matter specialists in sustainability standards, social compliance, environmental impact, carbon accounting, and supply chain due diligence, with hands-on experience in industries such as textiles, agriculture, and industrial operations. They work alongside VECTRA's teams and Associates to help clients understand complex issues, make informed decisions, and turn specialist insight into practical action.</p>
  </div>
  <div class="vh-wrap vp-intro">
    <p class="vh-kicker">OUR EXPERTS</p>
    <h2>Meet Our VECTRA International Experts</h2>
    <div class="vp-intro__body">
      <p>Different challenges call for different experiences.</p>
      <p>A supplier issue in one market can look very different in another. Standards, local conditions, industries, and supply-chain realities all shape what the right response looks like.</p>
      <p>Our subject matter experts bring experience from the environments they know firsthand, so VECTRA can give clients specialist support that reflects both the technical issue and the context around it.</p>
    </div>
  </div>
  <div class="vs-experts__grid">
    {% if people_cards != blank %}
      {{ people_cards }}
    {% else %}
      <article class="vs-expert"><img src="{{ img_exp_1 }}" alt="Beat Grüninger, Senior Technical Advisor and Lecturer, VECTRA International expert."><h3>Beat Grüninger</h3><p class="vs-expert__role">Senior Technical Advisor and Lecturer</p><p>Sustainability management and standards</p></article>
      <article class="vs-expert"><img src="{{ img_exp_2 }}" alt="Berçin Doğan Öztürk, Sustainability, Social Compliance &amp; Responsible Business, VECTRA International expert."><h3>Berçin Doğan Öztürk</h3><p class="vs-expert__role">Sustainability, Social Compliance &amp; Responsible Business</p><p>13+ years of experience</p></article>
      <article class="vs-expert"><img src="{{ img_exp_3 }}" alt="Daniel Ndiwa, Sustainability Standards Consultant, VECTRA International expert."><h3>Daniel Ndiwa</h3><p class="vs-expert__role">Sustainability Standards Consultant</p><p>5 years auditing voluntary sustainability standards in coffee, tea, avocado, and horticulture across Eastern Africa</p></article>
      <article class="vs-expert"><img src="{{ img_exp_4 }}" alt="Iddah Ooko, Environmental and Social Impact Consultant, VECTRA International expert."><h3>Iddah Ooko</h3><p class="vs-expert__role">Environmental and Social Impact Consultant</p><p>15+ years leading environmental impact assessments, audits, ESG, and multidisciplinary development projects</p></article>
      <article class="vs-expert"><img src="{{ img_face_1 }}" alt="Mary Shamla, GHG Accounting, Carbon Disclosure &amp; Life Cycle Assessment, VECTRA International expert."><h3>Mary Shamla</h3><p class="vs-expert__role">GHG Accounting, Carbon Disclosure &amp; Life Cycle Assessment</p><p>Expert</p></article>
      <article class="vs-expert"><img src="{{ img_face_2 }}" alt="Marcel Hatlapa, Textile Quality &amp; Social Compliance Specialist, VECTRA International expert."><h3>Marcel Hatlapa</h3><p class="vs-expert__role">Textile Quality &amp; Social Compliance Specialist</p><p>15+ years in the textile industry</p></article>
      <article class="vs-expert"><img src="{{ img_face_3 }}" alt="Mei Zhou, EHS, Supply Chain, Due Diligence &amp; Risk Assessment, VECTRA International expert."><h3>Mei Zhou</h3><p class="vs-expert__role">EHS, Supply Chain, Due Diligence &amp; Risk Assessment</p><p>20+ years of industrial and supply chain experience</p></article>
      <article class="vs-expert"><img src="{{ img_face_4 }}" alt="Najmeen Akther, CSR Management &amp; Social Compliance Auditing, VECTRA International expert."><h3>Najmeen Akther</h3><p class="vs-expert__role">CSR Management &amp; Social Compliance Auditing</p><p>20+ years, including supply chain improvement</p></article>
      <article class="vs-expert"><img src="{{ img_face_1 }}" alt="Wei Chen, Responsible Business &amp; Corporate Sustainability, VECTRA International expert."><h3>Wei Chen</h3><p class="vs-expert__role">Responsible Business &amp; Corporate Sustainability</p><p>20+ years of experience</p></article>
    {% endif %}
  </div>
  <div class="vh-wrap vp-cta">
    <h2>Not Sure Which Expert You Need?</h2>
    <p>You do not need to know which specialist you need before getting in touch. Tell us what you are dealing with, and VECTRA will help connect the challenge with the expertise needed to move it forward.</p>
    <div class="vs-experts__more">
      <a class="vs-cta-btn" href="{{ block.settings.cta_link | default: contact_url }}">
        {{ block.settings.cta_label | default: 'Talk to an Expert' }}
        <img src="{{ img_arrow_btn }}" alt="">
      </a>
    </div>
  </div>
</section>
{% endunless %}

  {% when 'associates' %}
{% unless block.settings.hide_section %}
{% liquid
  assign contact_url = pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us'
  assign people_cards = people_cards | strip
%}
<section class="vs-experts vh-people-page" id="associates" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  {% render 'vectra-seo', page_key: 'associates' %}
  <div class="vh-wrap vp-hero">
    <p class="vh-kicker">{{ block.settings.kicker | default: 'OUR PEOPLE' }}</p>
    <h1 class="vp-seo-title">{{ block.settings.heading | default: 'VECTRA International Associates | Specialist Expertise & Network' }}</h1>
    <p class="vp-display">Different Expertise. One VECTRA Team.</p>
    <div class="vp-hero__body">
      <p>VECTRA brings together people with different skills, experiences, and perspectives. Our Associates add specialist expertise to the wider VECTRA team, helping us see challenges from more than one angle and bring the right capability to the organizations we support.</p>
    </div>
    <p class="vp-aeo">VECTRA International Associates are a global group of specialists in analytics and automation, instructional design, marketing, digital systems, business development, and operations who work alongside VECTRA's leaders and experts. They design training, build tools, reach new clients, and keep delivery running, so client solutions move from idea to practical action.</p>
  </div>
  <div class="vh-wrap vp-intro">
    <p class="vh-kicker">OUR ASSOCIATES</p>
    <h2>Meet the VECTRA International Associates</h2>
    <div class="vp-intro__body">
      <p>Every Associate brings a different skill set. Together, VECTRA Associates strengthen how we serve clients: designing training, building analytics and automation, growing our marketplace, and keeping delivery running.</p>
