<section class="vs-experts vh-people-page" id="experts" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  {% render 'vectra-seo', page_key: 'experts' %}
  <div class="vh-wrap vp-hero" data-vh-reveal="up">
    <p class="vh-kicker">OUR PEOPLE</p>
    <h1 class="vp-seo-title">VECTRA International Experts | Subject Matter Experts &amp; Associates</h1>
    <p class="vp-display">The Right Expertise for Your Business Challenge</p>
    <div class="vp-hero__body">
      <p>The right support starts with people who understand the issue.</p>
      <p>Our experts bring technical knowledge, practical experience, and a real understanding of the industries and markets they work in, so clients can move forward with confidence.</p>
    </div>
    <p class="vp-aeo">VECTRA International experts are subject matter specialists in sustainability standards, social compliance, environmental impact, carbon accounting, and supply chain due diligence, with hands-on experience in industries such as textiles, agriculture, and industrial operations. They work alongside VECTRA's teams and Associates to help clients understand complex issues, make informed decisions, and turn specialist insight into practical action.</p>
  </div>
  <div class="vh-wrap vp-intro" data-vh-reveal="up">
    <p class="vh-kicker">OUR EXPERTS</p>
    <h2>Meet Our VECTRA International Experts</h2>
    <div class="vp-intro__body">
      <p>Different challenges call for different experiences.</p>
      <p>Our subject matter experts bring experience from the environments they know firsthand, so VECTRA International can give clients specialist support that reflects both the technical issue and the context around it.</p>
    </div>
  </div>
  <div class="vs-experts__grid">
    <article class="vs-expert" data-vh-reveal="up"><img src="{{ img_exp_1 }}" alt="Beat Grüninger, Senior Technical Advisor and Lecturer, VECTRA International expert."><h3>Beat Grüninger</h3><p class="vs-expert__role">Senior Technical Advisor and Lecturer</p><p>Sustainability management and standards</p></article>
    <article class="vs-expert" data-vh-reveal="up"><img src="{{ img_exp_2 }}" alt="Berçin Doğan Öztürk, Sustainability, Social Compliance &amp; Responsible Business, VECTRA International expert."><h3>Berçin Doğan Öztürk</h3><p class="vs-expert__role">Sustainability, Social Compliance &amp; Responsible Business</p><p>13+ years of experience</p></article>
    <article class="vs-expert" data-vh-reveal="up"><img src="{{ img_exp_3 }}" alt="Daniel Ndiwa, Sustainability Standards Consultant, VECTRA International expert."><h3>Daniel Ndiwa</h3><p class="vs-expert__role">Sustainability Standards Consultant</p><p>5 years auditing voluntary sustainability standards in coffee, tea, avocado, and horticulture across Eastern Africa</p></article>
    <article class="vs-expert" data-vh-reveal="up"><img src="{{ img_exp_4 }}" alt="Iddah Ooko, Environmental and Social Impact Consultant, VECTRA International expert."><h3>Iddah Ooko</h3><p class="vs-expert__role">Environmental and Social Impact Consultant</p><p>15+ years leading environmental impact assessments, audits, ESG, and multidisciplinary development projects</p></article>
    <article class="vs-expert" data-vh-reveal="up"><img src="{{ img_face_1 }}" alt="Mary Shamla, GHG Accounting, Carbon Disclosure &amp; Life Cycle Assessment, VECTRA International expert."><h3>Mary Shamla</h3><p class="vs-expert__role">GHG Accounting, Carbon Disclosure &amp; Life Cycle Assessment</p><p>Expert</p></article>
    <article class="vs-expert" data-vh-reveal="up"><img src="{{ img_face_2 }}" alt="Marcel Hatlapa, Textile Quality &amp; Social Compliance Specialist, VECTRA International expert."><h3>Marcel Hatlapa</h3><p class="vs-expert__role">Textile Quality &amp; Social Compliance Specialist</p><p>15+ years in the textile industry</p></article>
    <article class="vs-expert" data-vh-reveal="up"><img src="{{ img_face_3 }}" alt="Mei Zhou, EHS, Supply Chain, Due Diligence &amp; Risk Assessment, VECTRA International expert."><h3>Mei Zhou</h3><p class="vs-expert__role">EHS, Supply Chain, Due Diligence &amp; Risk Assessment</p><p>20+ years of industrial and supply chain experience</p></article>
    <article class="vs-expert" data-vh-reveal="up"><img src="{{ img_face_4 }}" alt="Najmeen Akther, CSR Management &amp; Social Compliance Auditing, VECTRA International expert."><h3>Najmeen Akther</h3><p class="vs-expert__role">CSR Management &amp; Social Compliance Auditing</p><p>20+ years, including supply chain improvement</p></article>
    <article class="vs-expert" data-vh-reveal="up"><img src="{{ img_face_1 }}" alt="Wei Chen, Responsible Business &amp; Corporate Sustainability, VECTRA International expert."><h3>Wei Chen</h3><p class="vs-expert__role">Responsible Business &amp; Corporate Sustainability</p><p>20+ years of experience</p></article>
  </div>
  <div class="vh-wrap vp-cta" data-vh-reveal="up">
    <h2>Not Sure Which Expert You Need?</h2>
    <p>You do not need to know which specialist you need before getting in touch.</p>
    <p>Tell us what you are dealing with, and VECTRA will help connect the challenge with the expertise needed to move it forward.</p>
    <div class="vs-experts__more">
      <a class="vs-cta-btn" href="{{ contact_href }}">
        Talk to an Expert
        <img src="{{ img_arrow_btn }}" alt="">
      </a>
    </div>
    <p class="vp-cta__aside"><a href="{{ associates_href }}">Associates</a> · <a href="{{ leadership_href }}">Leadership Team</a></p>
  </div>
</section>
