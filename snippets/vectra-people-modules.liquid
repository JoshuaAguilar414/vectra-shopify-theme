  {% when 'leadership' %}
{% unless block.settings.hide_section %}
{% comment %} Leadership Version 2 final copy — hardcoded so theme-editor settings cannot drift. {% endcomment %}
{% liquid
  assign contact_url = pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us'
  assign about_url = pages['about-us'].url | default: pages['our-story'].url | default: '/pages/about-us'
  assign solutions_url = pages['solutions'].url | default: pages['how-we-help'].url | default: '/pages/solutions'
  assign leadership_jobs = pages['job-openings'].url | default: careers_url
  assign img_patrick = 'vectra-4a782677c9907a899d2e84025df9fda627b7fbf8.png' | asset_url
  assign img_shelly = 'vectra-5a45cef3c985f7964fd6f04020f73a021850f52c.png' | asset_url
  assign img_lorenz = 'vectra-dc0daa0599cf1e7890ac477b6fd8c91f8bc1743a.png' | asset_url
  assign img_alana = 'vectra-dd46b740bdec4d3fe0852fbab0c2855306beb4e4.png' | asset_url
  assign img_elizabeth = 'vectra-8606670d35448bf9a7c0b601a64c49b9be7e86de.png' | asset_url
%}
{% capture experts_href %}{% render 'vectra-preview-href', url: experts_url, view: 'experts' %}{% endcapture %}
{% capture about_href %}{% render 'vectra-preview-href', url: about_url, view: 'our-story' %}{% endcapture %}
{% capture contact_href %}{% render 'vectra-preview-href', url: contact_url, view: 'contact-us' %}{% endcapture %}
{% assign experts_href = experts_href | strip %}
{% assign about_href = about_href | strip %}
{% assign contact_href = contact_href | strip %}
<section class="vs-experts vh-people-page" id="leadership" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  {% render 'vectra-seo', page_key: 'leadership' %}
  <div class="vh-wrap vp-hero" data-vh-reveal="up">
    <p class="vh-kicker">OUR LEADERSHIP</p>
    <h1 class="vp-seo-title">VECTRA International Leadership Team | Our Leaders &amp; Management</h1>
    <p class="vp-display">Leading With Purpose. Accountable for What Gets Done.</p>
    <div class="vp-hero__body">
      <p>VECTRA has grown because people kept believing there is a better way to support clients and create positive impact.</p>
      <p>Our leaders carry that belief forward.</p>
      <p>From different backgrounds, they share one responsibility: turning good ideas into work that actually helps our clients.</p>
    </div>
    <p class="vp-aeo">The VECTRA International leadership team brings together five leaders across executive management, sales and communications, operations, applied AI, and organizational enablement, with over 100 years of combined experience. VECTRA International leaders set the direction, guide client work, and stay accountable for measurable improvement.</p>
  </div>
  <div class="vh-wrap vp-intro" data-vh-reveal="up">
    <p class="vh-kicker">MEET OUR LEADERS</p>
    <h2>Meet the VECTRA International Leadership Team</h2>
    <div class="vp-intro__body">
      <p>Every leader here brings something different: experience, judgment, and their own view of what is possible.</p>
      <p>Leadership at VECTRA International is not about having every answer in one room. Together, the VECTRA International management team sets a clear direction, listens to the people closest to the work, and gives expertise room to move.</p>
    </div>
  </div>
  <div class="vs-experts__grid">
    <article class="vs-expert" data-vh-reveal="up">
      <a class="vs-expert__photo-link" href="https://www.linkedin.com/in/patrick-neyts-enabling-positive-responsible-business-change/" target="_blank" rel="noopener noreferrer">
        <img src="{{ img_patrick }}" alt="Patrick Neyts, Chief Executive Officer, VECTRA International">
      </a>
      <h3>Patrick Neyts</h3>
      <p class="vs-expert__role">Chief Executive Officer</p>
      <p>Patrick has more than 30 years of experience in responsible business, ESG programs, and corporate codes, across 11 industry sectors and 40 countries.</p>
      <p class="vs-expert__focus">Focus: Company direction and growth</p>
    </article>
    <article class="vs-expert" data-vh-reveal="up">
      <a class="vs-expert__photo-link" href="https://www.linkedin.com/in/michelesanders/" target="_blank" rel="noopener noreferrer">
        <img src="{{ img_shelly }}" alt="Shelly Sanders, SVP, Global Sales, Marketing &amp; Communications, VECTRA International">
      </a>
      <h3>Shelly Sanders</h3>
      <p class="vs-expert__role">SVP, Global Sales, Marketing &amp; Communications</p>
      <p>Shelly has more than 30 years of leadership experience in consultative, solution-based sales and operations. She has worked across healthcare, finance, and IT, driving global growth, strategic partnerships, and ESG-aligned outcomes.</p>
      <p class="vs-expert__focus">Focus: Global sales, marketing, and communications</p>
    </article>
    <article class="vs-expert" data-vh-reveal="up">
      <a class="vs-expert__photo-link" href="https://www.linkedin.com/in/lorenz-berzau-futurefitsme/" target="_blank" rel="noopener noreferrer">
        <img src="{{ img_lorenz }}" alt="Lorenz Berzau, VP Operations, VECTRA International">
      </a>
      <h3>Lorenz Berzau</h3>
      <p class="vs-expert__role">VP Operations</p>
      <p>Lorenz brings 20 years of consultancy experience and a background in law, with a focus on sustainability strategy, human rights, and social compliance.</p>
      <p class="vs-expert__focus">Focus: Operations</p>
    </article>
    <article class="vs-expert" data-vh-reveal="up">
      <a class="vs-expert__photo-link" href="https://www.linkedin.com/in/alana-van-wouw-717511233/" target="_blank" rel="noopener noreferrer">
        <img src="{{ img_alana }}" alt="Alana van Wouw, AI Architect, VECTRA International">
      </a>
      <h3>Alana van Wouw</h3>
      <p class="vs-expert__role">AI Architect</p>
      <p>Alana has more than 20 years of experience in project management, ESG, financial modeling, and AI, leading high-impact initiatives across emerging markets with strong sustainability and data-driven expertise.</p>
      <p class="vs-expert__focus">Focus: Applied AI</p>
    </article>
    <article class="vs-expert" data-vh-reveal="up">
      <a class="vs-expert__photo-link" href="https://www.linkedin.com/in/elizabeth-korban-0690625/" target="_blank" rel="noopener noreferrer">
        <img src="{{ img_elizabeth }}" alt="Elizabeth Korban, Director of Organizational Enablement, VECTRA International">
      </a>
      <h3>Elizabeth Korban</h3>
      <p class="vs-expert__role">Director of Organizational Enablement</p>
      <p>Elizabeth has 15+ years of experience leading work to embed ESG principles into organizational culture, governance, and operations.</p>
      <p class="vs-expert__focus">Focus: Organizational enablement</p>
    </article>
  </div>
  <div class="vh-wrap vp-intro vp-closing" data-vh-reveal="up">
    <p class="vh-kicker">ONE VECTRA</p>
    <h2>What We Build, We Build Together</h2>
    <div class="vp-intro__body">
      <p>VECTRA’s future will not be shaped by leadership alone. It will be shaped by our people, the clients who trust us with important challenges, and the relationships we build across markets.</p>
      <p>Our leaders set the direction. Our people bring it to life.</p>
      <p>As we grow, the goal stays simple: create more value for our people, our clients, and the communities our work touches.</p>
      <p>See how we work day to day: explore <a href="{{ solutions_url }}">How We Help</a>, <a href="{{ experts_href }}">Our Experts</a>, and <a href="{{ why_href }}">why organizations partner with VECTRA</a>.</p>
    </div>
  </div>
  <div class="vp-section-divider" aria-hidden="true"></div>
  <div class="vh-wrap vp-cta" data-vh-reveal="up">
    <h2>Where Could We Go From Here?</h2>
    <p>Whether you are exploring a partnership, bringing us a business challenge, or simply want to understand VECTRA International better, we would be glad to hear from you. You do not need a finished brief. Tell us what you are working on.</p>
    <div class="vs-experts__more">
      <a class="vs-cta-btn" href="{{ contact_href }}">
        Start the Conversation
        <img src="{{ img_arrow_send }}" alt="">
      </a>
    </div>
    <p class="vp-cta__aside">Interested in joining the team? <a href="{{ leadership_jobs }}">Explore careers at VECTRA</a>. · <a href="{{ about_href }}">About Us</a></p>
  </div>
</section>
{% endunless %}

  {% when 'careers' %}
{% unless block.settings.hide_section %}
<section class="vh-people-page vh-page-copy" id="careers" data-vh-reveal="up" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap">
    <p class="vh-kicker">{{ block.settings.kicker | default: 'Join the team' }}</p>
    <h1 class="vh-h2">{{ block.settings.heading | default: 'Careers at VECTRA International' }}</h1>
    <p class="vh-lead">{{ block.settings.text | default: 'Responsible business begins with responsible people. VECTRA is a family of experts — thinkers, listeners, practitioners, and problem-solvers who care deeply about the impact businesses leave behind.' }}</p>
    <div class="vh-page-copy__grid">
      <article data-vh-reveal="up">
        <h2>{{ block.settings.col_1_heading | default: 'How we work' }}</h2>
        <p>{{ block.settings.col_1_text | default: 'We listen first, learn together, and act with clarity. You will be trusted with space to work with integrity, supported by a team that spans countries and disciplines, and measured on mastery rather than hustle.' }}</p>
      </article>
      <article data-vh-reveal="up">
        <h2>{{ block.settings.col_2_heading | default: 'Who we welcome' }}</h2>
        <p>{{ block.settings.col_2_text | default: 'People who see complexity as an invitation to learn, choose empathy over ego, treat clients as partners, and feel at ease in multicultural teams. If that sounds like you, you will find belonging here.' }}</p>
      </article>
      <article data-vh-reveal="up">
        <h2>{{ block.settings.col_3_heading | default: 'Become a consultant' }}</h2>
        <p>{{ block.settings.col_3_text | default: 'If you feel aligned with the mission, write to info@vectra-intl.com with the subject Become a Consultant and a brief on your past work.' }}</p>
      </article>
    </div>
    <div class="vh-people-cta-row" data-vh-reveal="up">
      <a class="vs-cta-btn" href="{{ jobs_url }}" rel="noopener noreferrer" target="_blank">
        {{ block.settings.cta_label | default: 'View open positions' }}
        <img src="{{ img_arrow_send }}" alt="">
      </a>
      <a class="vh-btn vh-btn--outline" href="{{ block.settings.cta_secondary_link | default: interns_url }}">{{ block.settings.cta_secondary_label | default: 'Explore internships' }}</a>
    </div>
    {% render 'vectra-contact-details' %}
  </div>
</section>
{% endunless %}

{% when 'faq' %}
{% unless block.settings.hide_section %}
{% render 'vectra-faq-page-modules', block: block %}
{% endunless %}

{% endcase %}
