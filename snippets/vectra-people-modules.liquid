      <article class="vs-expert"><img src="{{ img_face_2 }}" alt="Pamela Ramos, Instructional Designer, VECTRA International Associate."><h3>Pamela Ramos</h3><p class="vs-expert__role">Instructional Designer</p></article>
      <article class="vs-expert"><img src="{{ img_face_3 }}" alt="Pol Benliro, Instructional Designer, VECTRA International Associate."><h3>Pol Benliro</h3><p class="vs-expert__role">Instructional Designer</p></article>
