      <article class="vs-expert"><img src="{{ img_face_2 }}" alt="Bhupender Singh, Business Solutions Consultant, VECTRA International Associate."><h3>Bhupender Singh</h3><p class="vs-expert__role">Business Solutions Consultant</p></article>
      <article class="vs-expert"><img src="{{ img_face_3 }}" alt="Sheila Akpaso, Chief HR Officer Consultant, VECTRA International Associate."><h3>Sheila Akpaso</h3><p class="vs-expert__role">Chief HR Officer Consultant</p></article>
