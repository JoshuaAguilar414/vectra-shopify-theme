  {% when 'interns' %}
{% unless block.settings.hide_section %}
{% liquid
  assign people_cards = people_cards | strip
%}
<section class="vs-experts vh-people-page" id="interns" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  {% render 'vectra-seo', page_key: 'interns' %}
  <div class="vh-wrap vp-hero">
    <p class="vh-kicker">{{ block.settings.kicker | default: 'OUR PEOPLE' }}</p>
    <h1 class="vp-seo-title">{{ block.settings.heading | default: 'VECTRA International Interns | Internship & Learning Opportunities' }}</h1>
    <p class="vp-display">Learn. Contribute. Grow.</p>
    <div class="vp-hero__body">
      <p>An internship should give you more than something to add to your resume.</p>
      <p>At VECTRA, interns learn from experienced people, contribute to real business needs, and build practical skills that prepare them for what comes next.</p>
    </div>
    <p class="vp-aeo">VECTRA International Interns are students and recent graduates who join VECTRA to learn from experienced professionals, contribute to real business needs, and build practical skills. From projects and research to marketing, systems, and operations, interns work alongside VECTRA's teams while developing confidence, judgment, and workplace capability.</p>
  </div>
  <div class="vh-wrap vp-intro">
    <p class="vh-kicker">OUR INTERNS</p>
    <h2>Meet the VECTRA International Interns</h2>
    <div class="vp-intro__body">
      <p>You do not need to arrive knowing everything.</p>
      <p>Our internships give emerging professionals the chance to apply what they already know, learn through experience, ask questions, share ideas, and see how the different parts of a business come together.</p>
      <p>The exact experience depends on the internship, but the aim stays the same: learn something useful, make a meaningful contribution, and leave with stronger practical skills.</p>
    </div>
  </div>
  <div class="vs-experts__grid">
    {% if people_cards != blank %}
      {{ people_cards }}
    {% else %}
      <article class="vs-expert"><img src="{{ img_face_1 }}" alt="Systems Intern, VECTRA International Intern."><p class="vs-expert__name">Systems Intern</p><p class="vs-expert__role">Internship</p><p>Supports Zoho, process documentation, and operational work across VECTRA teams.</p></article>
      <article class="vs-expert"><img src="{{ img_face_2 }}" alt="Sales Operations Intern, VECTRA International Intern."><p class="vs-expert__name">Sales Operations Intern</p><p class="vs-expert__role">Internship</p><p>Helps with pipeline hygiene, enquiry follow-through, and the admin that keeps client work moving.</p></article>
      <article class="vs-expert"><img src="{{ img_face_3 }}" alt="Business Intelligence Intern, VECTRA International Intern."><p class="vs-expert__name">Business Intelligence Intern</p><p class="vs-expert__role">Internship</p><p>Works on research, evidence packing, and turning scattered information into something a team can use.</p></article>
      <article class="vs-expert"><img src="{{ img_face_4 }}" alt="Marketing Intern, VECTRA International Intern."><p class="vs-expert__name">Marketing Intern</p><p class="vs-expert__role">Internship</p><p>Supports stories, events, and resources that help the right people find VECTRA without the noise.</p></article>
    {% endif %}
  </div>
  <div class="vh-wrap vp-intro">
    <p class="vh-kicker">WHERE OUR INTERNS STUDY</p>
    <h2>Universities Our Interns Come From</h2>
    <div class="vp-intro__body">
      <p>Our interns join VECTRA from universities around the world, studying fields that connect to business, sustainability, technology, and communications. Each one brings a different perspective to the work.</p>
    </div>
  </div>
  <div class="vh-wrap vp-intro">
    <h2>In Their Words</h2>
    <blockquote class="vp-quote">
      <p>“At VECTRA I contributed to real work, learned from experienced people, and left with practical skills I still use every day.”</p>
      <cite>VECTRA Intern</cite>
    </blockquote>
  </div>
  <div class="vh-wrap vp-cta">
    <h2>Start Building Your Experience at VECTRA</h2>
    <p>You are still learning, and that is the point. We do not expect you to arrive with every answer. Bring your curiosity, ideas, willingness to learn, and readiness to contribute. We will show you where your skills can be applied and where there is more to discover.</p>
    <div class="vs-experts__more">
      <a class="vs-cta-btn" href="{{ block.settings.cta_link | default: 'mailto:info@vectra-intl.com?subject=Internship%20Opportunities' }}">
        {{ block.settings.cta_label | default: 'Apply for an Internship' }}
        <img src="{{ img_arrow_btn }}" alt="">
      </a>
    </div>
  </div>
</section>
{% endunless %}

  {% when 'leadership' %}
{% unless block.settings.hide_section %}
{% liquid
  assign contact_url = pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us'
  assign about_url = pages['about-us'].url | default: pages['our-story'].url | default: '/pages/about-us'
  assign solutions_url = pages['solutions'].url | default: '/pages/solutions'
  assign people_cards = people_cards | strip
  assign img_patrick = 'vectra-4a782677c9907a899d2e84025df9fda627b7fbf8.png' | asset_url
  assign img_shelly = 'vectra-5a45cef3c985f7964fd6f04020f73a021850f52c.png' | asset_url
  assign img_lorenz = 'vectra-dc0daa0599cf1e7890ac477b6fd8c91f8bc1743a.png' | asset_url
  assign img_alana = 'vectra-dd46b740bdec4d3fe0852fbab0c2855306beb4e4.png' | asset_url
  assign img_elizabeth = 'vectra-8606670d35448bf9a7c0b601a64c49b9be7e86de.png' | asset_url
%}
<section class="vs-experts vh-people-page" id="leadership" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  {% render 'vectra-seo', page_key: 'leadership' %}
  <div class="vh-wrap vp-hero">
    <p class="vh-kicker">{{ block.settings.kicker | default: 'OUR LEADERSHIP' }}</p>
    <h1 class="vp-seo-title">{{ block.settings.heading | default: 'VECTRA International Leadership Team | Our Leaders & Management' }}</h1>
    <p class="vp-display">Leading With Purpose. Accountable for What Gets Done.</p>
    <div class="vp-hero__body">
      <p>VECTRA has grown because people kept believing there is a better way to solve business problems, support clients, and create positive impact.</p>
      <p>Our leaders carry that belief forward.</p>
      <p>They come from different backgrounds across responsible business, operations, sales, communications, and AI. They share one responsibility: making sure good ideas turn into work that actually helps our clients.</p>
    </div>
    <p class="vp-aeo">VECTRA International leadership team brings together five leaders across executive management, sales and communications, operations, applied AI, and organizational enablement, with more than 100 years of combined experience. Together, VECTRA International leaders set the company’s direction, guide client work, and stay accountable for turning decisions into practical, measurable improvement.</p>
  </div>
  <div class="vh-wrap vp-intro">
    <p class="vh-kicker">MEET OUR LEADERS</p>
    <h2>Meet the VECTRA International Leadership Team</h2>
    <div class="vp-intro__body">
      <p>Every leader here brings something different: experience, judgment, and their own view of what is possible.</p>
      <p>Together, the VECTRA International management team sets the direction, backs the people doing the work, and stays connected to what has always mattered: our clients, our people, and the belief that better business should create better outcomes.</p>
      <p>Leadership at VECTRA is not about having every answer in one room. It is about setting a clear direction, listening to the people closest to the work, making thoughtful decisions, and giving expertise room to move.</p>
    </div>
  </div>
  <div class="vs-experts__grid">
    {% if people_cards != blank %}
      {{ people_cards }}
    {% else %}
      <article class="vs-expert">
        <a class="vs-expert__photo-link" href="https://www.linkedin.com/in/patrick-neyts-enabling-positive-responsible-business-change/" target="_blank" rel="noopener noreferrer">
          <img src="{{ img_patrick }}" alt="Patrick Neyts, Chief Executive Officer, VECTRA International">
        </a>
        <h3>Patrick Neyts</h3>
        <p class="vs-expert__role">Chief Executive Officer</p>
        <p>Patrick has more than 30 years of experience in responsible business, ESG programs, and corporate codes, across 11 industry sectors and 40 countries. Focus: Company direction and growth.</p>
      </article>
      <article class="vs-expert">
        <a class="vs-expert__photo-link" href="https://www.linkedin.com/in/michelesanders/" target="_blank" rel="noopener noreferrer">
          <img src="{{ img_shelly }}" alt="Shelly Sanders, SVP, Global Sales, Marketing &amp; Communications, VECTRA International">
        </a>
        <h3>Shelly Sanders</h3>
        <p class="vs-expert__role">SVP, Global Sales, Marketing &amp; Communications</p>
        <p>Shelly has more than 30 years of leadership experience in consultative, solution-based sales and operations across healthcare, finance, and IT. Focus: Global sales, marketing, and communications.</p>
      </article>
      <article class="vs-expert">
        <a class="vs-expert__photo-link" href="https://www.linkedin.com/in/lorenz-berzau-futurefitsme/" target="_blank" rel="noopener noreferrer">
          <img src="{{ img_lorenz }}" alt="Lorenz Berzau, VP Operations, VECTRA International">
        </a>
        <h3>Lorenz Berzau</h3>
        <p class="vs-expert__role">VP Operations</p>
        <p>Lorenz brings 20 years of consultancy experience and a background in law, with a focus on sustainability strategy, human rights, and social compliance. Focus: Operations.</p>
      </article>
      <article class="vs-expert">
        <a class="vs-expert__photo-link" href="https://www.linkedin.com/in/alana-van-wouw-717511233/" target="_blank" rel="noopener noreferrer">
          <img src="{{ img_alana }}" alt="Alana van Wouw, AI Architect, VECTRA International">
        </a>
        <h3>Alana van Wouw</h3>
        <p class="vs-expert__role">AI Architect</p>
        <p>Alana has more than 20 years of experience in project management, ESG, financial modeling, and AI across emerging markets. Focus: Applied AI.</p>
      </article>
      <article class="vs-expert">
        <a class="vs-expert__photo-link" href="https://www.linkedin.com/in/elizabeth-korban-0690625/" target="_blank" rel="noopener noreferrer">
          <img src="{{ img_elizabeth }}" alt="Elizabeth Korban, Director of Organizational Enablement, VECTRA International">
        </a>
        <h3>Elizabeth Korban</h3>
        <p class="vs-expert__role">Director of Organizational Enablement</p>
        <p>Elizabeth has 15+ years of experience leading work to embed ESG principles into organizational culture, governance, and operations. Focus: Organizational enablement.</p>
      </article>
    {% endif %}
  </div>
  <div class="vh-wrap vp-intro">
    <p class="vh-kicker">ONE VECTRA</p>
    <h2>What We Build, We Build Together</h2>
    <div class="vp-intro__body">
      <p>VECTRA’s future will not be shaped by leadership alone.</p>
      <p>It will be shaped by the people who bring their expertise, the clients who trust us with important challenges, the ideas we are willing to test, and the relationships we build across markets and disciplines.</p>
      <p>Our leaders set the direction. Our people bring it to life.</p>
      <p>As VECTRA grows, the goal stays simple: become a company that creates more value for the people who work here, the organizations we support, and the communities our work touches. To see how our experts and leaders work with clients day to day, explore <a href="{{ solutions_url }}">How We Help</a> and <a href="{{ experts_url }}">Our Experts</a>.</p>
    </div>
  </div>
  <div class="vh-wrap vp-cta">
    <h2>Where Could We Go From Here?</h2>
    <p>Whether you are exploring a partnership, bringing us a business challenge, or simply want to understand VECTRA better, we would be glad to hear from you. You do not need a finished brief. Tell us what you are working on.</p>
    <div class="vs-experts__more">
      <a class="vs-cta-btn" href="{{ contact_url }}">
        Start the Conversation
        <img src="{{ img_arrow_send }}" alt="">
      </a>
    </div>
    <p class="vp-cta__aside">Interested in joining the team? <a href="{{ careers_url }}">Explore careers at VECTRA</a>. · <a href="{{ about_url }}">About Us</a></p>
  </div>
</section>
{% endunless %}

  {% when 'careers' %}
{% unless block.settings.hide_section %}
<section class="vh-people-page vh-page-copy" id="careers" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap">
    <p class="vh-kicker">{{ block.settings.kicker | default: 'Join the team' }}</p>
    <h1 class="vh-h2">{{ block.settings.heading | default: 'Careers at VECTRA International' }}</h1>
    <p class="vh-lead">{{ block.settings.text | default: 'Responsible business begins with responsible people. VECTRA is a family of experts — thinkers, listeners, practitioners, and problem-solvers who care deeply about the impact businesses leave behind.' }}</p>
    <div class="vh-page-copy__grid">
      <article>
        <h2>{{ block.settings.col_1_heading | default: 'How we work' }}</h2>
        <p>{{ block.settings.col_1_text | default: 'We listen first, learn together, and act with clarity. You will be trusted with space to work with integrity, supported by a team that spans countries and disciplines, and measured on mastery rather than hustle.' }}</p>
      </article>
      <article>
        <h2>{{ block.settings.col_2_heading | default: 'Who we welcome' }}</h2>
        <p>{{ block.settings.col_2_text | default: 'People who see complexity as an invitation to learn, choose empathy over ego, treat clients as partners, and feel at ease in multicultural teams. If that sounds like you, you will find belonging here.' }}</p>
      </article>
      <article>
        <h2>{{ block.settings.col_3_heading | default: 'Become a consultant' }}</h2>
        <p>{{ block.settings.col_3_text | default: 'If you feel aligned with the mission, write to info@vectra-intl.com with the subject Become a Consultant and a brief on your past work.' }}</p>
      </article>
    </div>
    <div class="vh-people-cta-row">
      <a class="vs-cta-btn" href="{{ jobs_url }}" rel="noopener noreferrer" target="_blank">
        {{ block.settings.cta_label | default: 'View open positions' }}
        <img src="{{ img_arrow_send }}" alt="">
      </a>
      <a class="vh-btn vh-btn--outline" href="{{ block.settings.cta_secondary_link | default: interns_url }}">{{ block.settings.cta_secondary_label | default: 'Explore internships' }}</a>
    </div>
    {% render 'vectra-contact-details' %}
  </div>
</section>
{% endunless %}

{% when 'faq' %}
{% unless block.settings.hide_section %}
<section class="vh-faq vh-people-page" id="faq" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap vh-faq__grid">
    <aside class="vh-contact-card">
      <img class="vh-contact-card__icon" src="{{ img_chat }}" alt="">
      <p class="vh-contact-card__title">{{ block.settings.card_title | default: 'Still need a person?' }}</p>
      <p>{{ block.settings.card_text | default: 'If these answers do not cover what you need, talk with the team. We will help you name the gap and the next step.' }}</p>
      <a class="vh-btn vh-btn--white" href="#VectraContactModal" data-vh-contact-open>
        Talk to an expert
        <img src="{{ img_arrow }}" alt="">
      </a>
      {% render 'vectra-contact-details', variant: 'card', img_phone: img_phone, img_mail: img_mail, img_pin: img_pin %}
    </aside>
    <div class="vh-faq__right">
      <div class="vh-faq__glow" aria-hidden="true"></div>
      <div class="vh-accordion">
        <p class="vh-kicker">{{ block.settings.kicker | default: 'FAQ' }}</p>
        <h1 class="vh-h2">{{ block.settings.heading | default: 'Frequently asked questions' }}</h1>
        <p class="vh-lead">{{ block.settings.text | default: 'Straight answers about VECTRA, our resources, and how to get started.' }}</p>
        {% assign nested_items = people_cards | strip %}
        {% if nested_items != blank %}
          {{ nested_items }}
        {% else %}
        <div class="vh-acc is-open" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>What does VECTRA help organisations improve?</button>
          <div class="vh-acc__body">VECTRA helps organisations reduce business risk, strengthen operational and supply chain resilience, improve ESG and sustainability performance, and build the evidence and capability needed to drive measurable results.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>We already have consultants, platforms, and dashboards. Where does VECTRA fit?</button>
          <div class="vh-acc__body">Often the gap appears after the information already exists. VECTRA works with the systems, expertise, and partners you already have, then focuses on ownership, workflows, evidence, supplier engagement, and follow-through.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>Can VECTRA work with the systems we already use?</button>
          <div class="vh-acc__body">Yes. VECTRA is platform-agnostic. We work with existing systems, data, teams, and partners, then introduce additional technology only where it solves a clear problem.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>Who is VECTRA International?</button>
          <div class="vh-acc__body">VECTRA International is a business resilience and operational capability-building partner founded in 2005. We help organisations manage ESG requirements, supplier risk, and operational complexity through expert teams and practical, technology-enabled delivery.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>Are VECTRA Resources free to access?</button>
          <div class="vh-acc__body">Yes. VECTRA Resources are free to explore. Some ebooks, playbooks, and events may require registration.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>Where do we start if we know the problem but not the solution?</button>
          <div class="vh-acc__body">Start with the problem. Tell us what keeps recurring, stalling, or becoming difficult to prove. We'll help clarify what needs attention and the most practical way forward.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>How does VECTRA measure progress?</button>
          <div class="vh-acc__body">We agree what improvement should look like at the start. Depending on the issue, that may include clearer ownership, closed actions, stronger evidence, improved capability, fewer recurring problems, or better supplier performance.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>When was VECTRA International founded?</button>
          <div class="vh-acc__body">VECTRA International was founded in 2005 and has since worked with organizations across industries to strengthen governance, supplier accountability, and operational resilience.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>Where does VECTRA International operate?</button>
          <div class="vh-acc__body">VECTRA International operates globally, with associates and specialist experts delivering local market context across regions including Africa, Europe, Asia, and beyond.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>What are responsible business resources?</button>
          <div class="vh-acc__body">Responsible business resources are insights, guides, evidence, and expert analysis that help organizations understand ESG, supply chain, compliance, risk management, business resilience, and operational resilience issues and decide what action to take.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>How do I find the right resource for my question?</button>
          <div class="vh-acc__body">Use the search bar on the Resources page to find material by topic, regulation, risk, or keyword. You can also browse by format if you already know whether you need a quick Insight, a deeper guide, an expert conversation, or a real-world Case Study.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>How do I apply for a career or internship?</button>
          <div class="vh-acc__body">Open roles are listed on the Careers page. For internships, email <a href="mailto:info@vectra-intl.com?subject=Internship%20Opportunities">info@vectra-intl.com</a> with the subject Internship Opportunities. To join as a consultant, use the subject Become a Consultant.</div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endunless %}

{% endcase %}
