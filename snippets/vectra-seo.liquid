{%- doc -%}
  JSON-LD for VECTRA pages. page_key: home | about | resources | contact
{%- enddoc -%}
{%- liquid
  assign key = page_key | default: 'home'
-%}
{%- if key == 'home' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Business Resilience Partner for Responsible Business & Operational Resilience",
      "description": "Drive responsible business transformation with VECTRA’s ESG consulting, business resilience, operational resilience, supply chain consulting expertise, and resources.",
      "author": { "@type": "Organization", "name": "VECTRA International" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"What does VECTRA help organizations improve?","acceptedAnswer":{"@type":"Answer","text":"VECTRA helps organizations reduce business risk, strengthen operational and supply chain resilience, improve ESG and sustainability performance, and build the evidence and capability needed to drive measurable results across operations and value chains."}},
        {"@type":"Question","name":"We already have consultants, platforms, and dashboards. Where does VECTRA fit?","acceptedAnswer":{"@type":"Answer","text":"Often, the gap appears after the information already exists. VECTRA works with the systems, expertise, and partners you already have, then focuses on ownership, workflows, evidence, supplier engagement, and follow-through where the work is getting stuck."}},
        {"@type":"Question","name":"Can VECTRA work with the systems we already use?","acceptedAnswer":{"@type":"Answer","text":"Yes. VECTRA is platform-agnostic. We work with existing systems, data, teams, and partners, then introduce additional technology only where it solves a clear problem."}},
        {"@type":"Question","name":"Where do we start if we know the problem but not the solution?","acceptedAnswer":{"@type":"Answer","text":"Start with the problem. Tell us what keeps recurring, stalling, or becoming difficult to prove. We'll help clarify what needs attention and the most practical way forward."}},
        {"@type":"Question","name":"How does VECTRA measure progress?","acceptedAnswer":{"@type":"Answer","text":"We agree what improvement should look like at the start. Depending on the issue, that may include clearer ownership, closed actions, stronger evidence, improved capability, fewer recurring problems, or better supplier performance."}}
      ]
    }
  ]
}
</script>
{%- elsif key == 'about' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "About VECTRA International – Our DNA, Values & Global Expertise",
      "description": "Discover VECTRA International's DNA, values and global expertise in ESG, responsible business, supply chain resilience and business transformation.",
      "author": { "@type": "Organization", "name": "VECTRA International" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"Who is VECTRA International?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International is a business resilience and operational capability-building partner that helps organizations manage ESG requirements, supplier risk, and operational complexity through expert teams and practical, technology-enabled delivery."}},
        {"@type":"Question","name":"When was VECTRA International founded?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International was founded in 2005 and has since worked with organizations across industries to strengthen governance, supplier accountability, and operational resilience."}},
        {"@type":"Question","name":"What does VECTRA International do?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International turns responsible business requirements — supplier issues, audit findings, weak controls, and changing regulations — into clear priorities, accountable action, and measurable performance improvement."}},
        {"@type":"Question","name":"Where does VECTRA International operate?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International operates globally, with associates and specialist experts delivering local market context across regions including Africa, Europe, Asia, and beyond."}},
        {"@type":"Question","name":"Who leads VECTRA International?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International is led by CEO Patrick Neyts, alongside a global leadership team spanning operations, sales and marketing, and applied AI."}}
      ]
    }
  ]
}
</script>
{%- elsif key == 'resources' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Responsible Business Resources & Insights",
      "description": "Explore VECTRA International's resources and insights on responsible business, supply chain, ESG, operational resilience, and risk management.",
      "author": { "@type": "Organization", "name": "VECTRA International" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"What are responsible business resources?","acceptedAnswer":{"@type":"Answer","text":"Responsible business resources are insights, guides, evidence, and expert analysis that help organizations understand ESG, supply chain, compliance, risk management, business resilience, and operational resilience issues and decide what action to take."}},
        {"@type":"Question","name":"Who are VECTRA Resources written for?","acceptedAnswer":{"@type":"Answer","text":"VECTRA Resources are written for procurement, operations, supply chain, risk, compliance, sustainability, and transformation leaders who need to understand an issue before making or defending a decision."}},
        {"@type":"Question","name":"What types of resources does VECTRA International offer?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International offers Insights, Ebooks and Playbooks, Events and Webinars, VCASTs, Case Studies, and Press Releases."}},
        {"@type":"Question","name":"Are VECTRA Resources free to access?","acceptedAnswer":{"@type":"Answer","text":"Yes. VECTRA Resources are free to explore. Some Ebooks, Playbooks, and Events may require registration."}},
        {"@type":"Question","name":"How do I find the right resource for my question?","acceptedAnswer":{"@type":"Answer","text":"Use the search bar to find resources by topic, regulation, risk, or keyword. You can also browse by format if you already know whether you need a quick Insight, a deeper guide, an expert conversation, or a real-world Case Study."}}
      ]
    }
  ]
}
</script>
