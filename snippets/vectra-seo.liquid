{%- doc -%}
  JSON-LD for VECTRA pages. page_key: home | about | resources | contact | leadership
{%- enddoc -%}
{%- liquid
  assign key = page_key | default: 'home'
-%}
{%- if key == 'home' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Responsible Business Partner | Risk Assessment & Supply Chain Risk Consulting",
      "description": "Drive responsible business transformation with VECTRA’s ESG consulting, business resilience, operational resilience, supply chain consulting expertise, and resources.",
      "author": { "@type": "Organization", "name": "VECTRA International" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"What does VECTRA help organizations improve?","acceptedAnswer":{"@type":"Answer","text":"VECTRA helps organizations strengthen responsible business, operational resilience, supply chain resilience, and day to day business performance. Depending on the challenge, our support may include responsible business transformation, ESG consulting, sustainability consulting, supply chain consulting, technology, capability building, or implementation support. We start with the result that needs to improve, then bring the relevant expertise and support around it. Not the other way around."}},
        {"@type":"Question","name":"We already have consultants, platforms, and dashboards. Where does VECTRA fit?","acceptedAnswer":{"@type":"Answer","text":"We work with what you already have. When the information, expertise, or system is already there, we focus on what's stopping it from producing the result you need. That may be ownership, process, supplier engagement, evidence, capability, or follow-through."}},
        {"@type":"Question","name":"Can VECTRA work with the systems we already use?","acceptedAnswer":{"@type":"Answer","text":"Yes. VECTRA is platform-agnostic. We work with your existing systems, data, teams, consultants, and partners, then introduce additional technology only where it solves a clear problem."}},
        {"@type":"Question","name":"Where do we start if we know the problem but not the solution?","acceptedAnswer":{"@type":"Answer","text":"Start by telling us what's happening and what you want to improve. We'll help clarify the issue, identify what needs attention first, and figure out the most practical next step, together."}},
        {"@type":"Question","name":"How does VECTRA measure progress?","acceptedAnswer":{"@type":"Answer","text":"We agree at the start on what success should look like. Depending on the challenge, that may include clearer ownership, closed actions, stronger evidence, improved capability, fewer recurring problems, or better supplier performance."}}
      ]
    }
  ]
}
</script>
{%- elsif key == 'about' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "About VECTRA International | Our DNA & Values",
      "description": "Discover VECTRA International's DNA, values and global expertise in ESG, responsible business, supply chain resilience and business transformation.",
      "author": { "@type": "Organization", "name": "VECTRA International" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"Who is VECTRA International?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International is a business resilience and operational capability-building partner. We help organizations manage responsible business, supplier, and operational challenges by combining experienced people, practical implementation support, and technology where it adds value."}},
        {"@type":"Question","name":"When was VECTRA International founded?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International was founded in 2005. Since then, our work has grown from responsible business and supply-chain challenges into a broader role supporting business resilience, operational capability, governance, and performance."}},
        {"@type":"Question","name":"What does VECTRA International do?","acceptedAnswer":{"@type":"Answer","text":"We help organizations turn complex requirements and operational challenges into clear priorities and practical action. Depending on the issue, that may involve supplier risk, governance, evidence, technology, capability building, responsible business, or operational improvement."}},
        {"@type":"Question","name":"How is VECTRA different from a traditional consulting company?","acceptedAnswer":{"@type":"Answer","text":"VECTRA consulting support is built around partnership, implementation, and follow-through. Organizations may come to us while looking for an operational resilience consulting company, but our role is broader. We bring together specialist expertise, capability building, practical implementation, and technology where it adds value, then stay involved as decisions move into practice and progress is measured."}},
        {"@type":"Question","name":"Where does VECTRA International operate?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International works globally, supported by associates and specialist experts who bring local context and experience across regions, markets, and industries."}},
        {"@type":"Question","name":"Who leads VECTRA International?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International is led by CEO Patrick Neyts alongside a global leadership team spanning operations, sales and marketing, and applied AI."}}
      ]
    }
  ]
}
</script>
{%- elsif key == 'resources' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Responsible Business Resources & Insights",
      "description": "Explore VECTRA International's resources and insights on responsible business, supply chain, ESG, operational resilience, and risk management.",
      "author": { "@type": "Organization", "name": "VECTRA International" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"What are responsible business resources?","acceptedAnswer":{"@type":"Answer","text":"Responsible business resources are insights, guides, evidence, and expert analysis that help organizations understand ESG, supply chain, compliance, risk management, business resilience, and operational resilience issues and decide what action to take."}},
        {"@type":"Question","name":"Who are VECTRA Resources written for?","acceptedAnswer":{"@type":"Answer","text":"VECTRA Resources are written for procurement, operations, supply chain, risk, compliance, sustainability, and transformation leaders who need to understand an issue before making or defending a decision."}},
        {"@type":"Question","name":"What types of resources does VECTRA International offer?","acceptedAnswer":{"@type":"Answer","text":"VECTRA International offers Insights, Ebooks and Playbooks, Events and Webinars, VCASTs, Case Studies, and Press Releases. Across these formats, you can explore ESG resources, supply chain resources, business resilience resources, risk management resources, and operational resilience resources."}},
        {"@type":"Question","name":"Are VECTRA Resources free to access?","acceptedAnswer":{"@type":"Answer","text":"Yes. VECTRA Resources are free to explore. Some Ebooks, Playbooks, and Events may require registration."}},
        {"@type":"Question","name":"How do I find the right resource for my question?","acceptedAnswer":{"@type":"Answer","text":"Use the search bar to find resources by topic, regulation, risk, or keyword. You can also browse by format if you already know whether you need a quick Insight, a deeper guide, an expert conversation, or a real-world Case Study."}}
      ]
    }
  ]
}
</script>
