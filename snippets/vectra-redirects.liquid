{%- doc -%}
  Client-side fallback for WordPress → Shopify pretty paths.
  Import the same map in Shopify Admin > Navigation > URL redirects for 301s.
{%- enddoc -%}
{%- liquid
  if pages['marketplace'].url != blank
    assign marketplace_redirect = pages['marketplace'].url
  elsif pages['vsuites'].url != blank
    assign marketplace_redirect = pages['vsuites'].url | append: '?view=marketplace'
  elsif pages['courses'].url != blank
    assign marketplace_redirect = pages['courses'].url | append: '?view=marketplace'
  elsif pages['solutions'].url != blank
    assign marketplace_redirect = pages['solutions'].url | append: '?view=marketplace'
  elsif pages['resources'].url != blank
    assign marketplace_redirect = pages['resources'].url | append: '?view=marketplace'
  elsif pages['about-us'].url != blank
    assign marketplace_redirect = pages['about-us'].url | append: '?view=marketplace'
  elsif pages['our-story'].url != blank
    assign marketplace_redirect = pages['our-story'].url | append: '?view=marketplace'
  else
    assign marketplace_redirect = '/pages/marketplace'
  endif
-%}

<script>
  (function () {
    if (window.__vectraRedirects) return;
    window.__vectraRedirects = true;

    var path = (location.pathname || '/').replace(/\/+$/, '') || '/';
    var marketplaceDest = {{ marketplace_redirect | json }};
    var exact = {
      '/careers': '/pages/careers',
      '/job-openings': '/pages/careers',
      '/jobs': '/pages/careers',
      '/interns': '/pages/interns',
      '/internships': '/pages/interns',
      '/our-interns': '/pages/interns',
      '/our-experts': '/pages/experts',
      '/experts': '/pages/experts',
      '/associates': '/pages/associates',
      '/our-associates': '/pages/associates',
      '/our-leadership-team': '/pages/our-leadership-team',
      '/leadership': '/pages/our-leadership-team',
      '/our-leadership': '/pages/our-leadership-team',
      '/our-story': '/pages/our-story',
      '/about': '/pages/about-us',
      '/about-us': '/pages/about-us',
      '/our-dna': '/pages/about-us',
      '/contact': '/pages/contact?view=contact-us',
      '/contact-us': '/pages/contact?view=contact-us',
      '/pages/contact-us': '/pages/contact?view=contact-us',
      '/resources': '/pages/resources',
      '/resources/blogs': '/pages/insights-page?view=blogs',
      '/resources/e-books-playbooks': '/pages/ebooks-and-playbooks?view=e-books-playbooks',
      '/resources/press-releases': '/pages/press-releases?view=press-releases',
      '/resources/podcasts': '/pages/podcasts?view=podcasts',
      '/resources/event-webinars': '/pages/events-and-webinars?view=event-webinars',
      '/insights': '/pages/insights-page?view=blogs',
      '/services/risk-assessment': '/pages/risk-assessment?view=risk-assessment',
      '/risk-assessment': '/pages/risk-assessment?view=risk-assessment',
      '/scdd': '/pages/risk-assessment?view=risk-assessment',
      '/scdd-maturity-risk-assessment': '/pages/risk-assessment?view=risk-assessment',
      '/solutions': '/pages/solutions',
      '/how-we-help': '/pages/solutions',
      '/why-partner-with-us': '/pages/why-partner-with-us',
      '/why-partner': '/pages/why-partner-with-us',
      '/why-vectra': '/pages/why-partner-with-us',
      '/faq': '/pages/faq',
      '/faqs': '/pages/faq',
      '/marketplace': marketplaceDest,
      '/courses': marketplaceDest,
      '/course': marketplaceDest,
      '/vsuites': marketplaceDest,
      '/blog': '/blogs/news'
    };

    var dest = exact[path];
    if (!dest) {
      var blog = path.match(/^\/(?:blog|blogs|uncategorised|uncategorized|insights)\/([^/]+)\/?$/i);
      if (blog) dest = '/blogs/news/' + blog[1].toLowerCase();
    }
    if (dest && dest !== path && dest !== path + '/') {
      if (dest.indexOf('?') !== -1) {
        location.replace(dest + (location.hash || ''));
      } else {
        location.replace(dest + location.search + location.hash);
      }
    }
  })();
</script>
