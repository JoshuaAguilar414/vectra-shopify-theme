{%- doc -%}
  VECTRA contact popup used by the header Contact Us action.
{%- enddoc -%}

{% liquid
  assign img_arrow = 'vectra-33469c114cd0dac188b171519c338a0fcdfa79a7.svg' | asset_url
  assign form_id = 'VectraContact-' | append: section.id
%}

<dialog
  id="VectraContactModal"
  class="vh-contact-modal"
  data-vh-contact-modal
  aria-labelledby="{{ form_id }}-title"
>
  <div class="vh-contact-modal__dialog" data-vh-contact-dialog>
    <button class="vh-contact-modal__close" type="button" data-vh-contact-close aria-label="Close contact form">
      <span aria-hidden="true">&times;</span>
    </button>
    {% form 'contact', id: form_id, class: 'vh-form vh-form--modal' %}
      <h3 id="{{ form_id }}-title">Get In Touch</h3>
      {% if form.posted_successfully? %}
        <p class="vh-contact-modal__success" data-vh-contact-success>
          Thanks — we received your message and will be in touch shortly.
        </p>
      {% endif %}
      {% if form.errors %}
        <p class="vh-contact-modal__error">
          {{ form.errors | default_errors }}
        </p>
      {% endif %}
      <div class="vh-form__grid">
        <input type="text" name="contact[first_name]" placeholder="First Name*" value="{{ customer.first_name }}" required>
        <input type="text" name="contact[last_name]" placeholder="Last Name*" value="{{ customer.last_name }}" required>
        <input type="email" name="contact[email]" placeholder="Email*" value="{{ customer.email }}" required>
        <input type="tel" name="contact[phone]" placeholder="Phone Number*" value="{{ customer.phone }}">
        <input type="text" name="contact[company]" placeholder="Company*">
        <input type="text" name="contact[job_title]" placeholder="Job Title*">
      </div>
      <textarea name="contact[body]" placeholder="Message Here..."></textarea>
      <button class="vh-btn vh-btn--green" type="submit">
        Send message
        <img src="{{ img_arrow }}" alt="">
      </button>
    {% endform %}
  </div>
</dialog>

<script>
  (function () {
    if (window.__vectraContactInit) return;
    window.__vectraContactInit = true;

    var bind = function () {
      var modal = document.getElementById('VectraContactModal');
      if (!modal) return;
      if (modal.parentElement !== document.body) document.body.appendChild(modal);

      var isOpen = function () {
        return modal.open === true || modal.hasAttribute('open');
      };
      var openModal = function () {
        if (isOpen()) return;
        if (typeof modal.showModal === 'function') modal.showModal();
        else modal.setAttribute('open', '');
        document.body.classList.add('vh-contact-open');
      };
      var closeModal = function () {
        if (typeof modal.close === 'function' && isOpen()) modal.close();
        else modal.removeAttribute('open');
        document.body.classList.remove('vh-contact-open');
        if (location.hash === '#VectraContactModal') {
          history.replaceState(null, '', location.pathname + location.search);
        }
      };

      document.addEventListener(
        'click',
        function (event) {
          var opener = event.target.closest('[data-vh-contact-open], a[href="#VectraContactModal"], a[href="#contact"]');
          if (opener) {
            event.preventDefault();
            event.stopPropagation();
            openModal();
            return;
          }
          if (event.target.closest('[data-vh-contact-close]')) {
            event.preventDefault();
            closeModal();
          }
        },
        true
      );

      modal.addEventListener('click', function (event) {
        if (event.target === modal) closeModal();
      });
      modal.addEventListener('close', function () {
        document.body.classList.remove('vh-contact-open');
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && isOpen()) closeModal();
      });

      if (modal.querySelector('[data-vh-contact-success]') || location.hash === '#VectraContactModal') {
        openModal();
      }
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
    else bind();
  })();
</script>
