{%- doc -%}
  Shared VECTRA header: guest Join us / Log In, logged-in avatar menu,
  Shopify native language + currency, optional MEGA nav, Contact Us modal.
{%- enddoc -%}

{% render 'vectra-assets' %}

<script src="{{ 'localization.js' | asset_url }}" type="module" fetchpriority="high"></script>

{% liquid
  assign img_logo = 'vectra-f1f1bad320cc916c9d3f257211cb366de698a572.png' | asset_url
  assign img_globe = 'vectra-e75326688c7e0ce3e0b991e45c67a26e49052254.png' | asset_url
  assign img_user = 'vectra-f07515ab5f0a8f7807c77ab21d02c5eb476eb902.png' | asset_url
  assign img_case = 'vectra-bc13c1ac5973c68a13ce0a8ee907baaf2e4e4828.png' | asset_url
  if block != blank and block.settings.logo != blank
    assign img_logo = block.settings.logo | image_url: width: 440
  endif
  if block != blank and block.settings.join_icon != blank
    assign img_case = block.settings.join_icon | image_url: width: 80
  endif
  assign img_arrow_white = 'vectra-d640d7e5d10a7b2543900785147430e0c5cd06a1.svg' | asset_url
  assign home = routes.root_url
  assign story_base = pages['about-us'].url | default: pages['our-story'].url | default: '/pages/about-us'
  assign solutions_base = pages['solutions'].url | default: '/pages/solutions'
  assign resources_base = pages['resources'].url | default: '/pages/resources'
  assign faq_base = pages['faq'].url | default: '/pages/faq'
  assign marketplace_base = pages['marketplace'].url | default: '/pages/marketplace'
  assign experts_base = pages['experts'].url | default: '/pages/experts'
  assign associates_base = pages['associates'].url | default: '/pages/associates'
  assign interns_base = pages['interns'].url | default: '/pages/interns'
  assign careers_base = pages['careers'].url | default: '/pages/careers'
  assign login_url = routes.account_login_url
  assign register_url = routes.account_register_url | default: routes.account_login_url

  assign mega = linklists['vectra-website-mega-menu']
  if mega == blank or mega.links.size == 0
    assign mega = menu
  endif
  if mega == blank or mega.links.size == 0
    assign mega = section.settings.menu
  endif
  if mega != blank and mega.handle == blank and mega.links.size == 0
    assign mega = linklists[mega]
  endif

  assign locale_form_id = 'vectra-header'
  if block != blank
    assign locale_form_id = block.id
  endif

  assign show_country = true
  if localization.available_countries.size < 1
    assign show_country = false
  endif
  assign show_language = true
  if localization.available_languages.size < 1
    assign show_language = false
  endif

  assign account_root = routes.account_url | split: '?' | first
  if account_root contains 'shopify.com'
    assign profile_url = account_root | append: '/profile'
    assign orders_url = account_root | append: '/orders'
  else
    assign profile_url = routes.account_url
    assign orders_url = routes.account_url
  endif
  assign courses_url = pages['my-courses'].url | default: pages['courses'].url | default: routes.account_url
  assign customer_initial = customer.first_name | default: customer.email | slice: 0 | upcase
  assign customer_hello = customer.first_name | default: 'there'
%}
{% capture story %}{% render 'vectra-preview-href', url: story_base, view: 'our-story' %}{% endcapture %}
{% capture solutions %}{% render 'vectra-preview-href', url: solutions_base, view: 'solutions' %}{% endcapture %}
{% capture resources %}{% render 'vectra-preview-href', url: resources_base, view: 'resources' %}{% endcapture %}
{% capture faq %}{% render 'vectra-preview-href', url: faq_base, view: 'faq' %}{% endcapture %}
{% capture marketplace %}{% render 'vectra-preview-href', url: marketplace_base, view: 'marketplace' %}{% endcapture %}
{% capture experts %}{% render 'vectra-preview-href', url: experts_base, view: 'experts' %}{% endcapture %}
{% capture associates %}{% render 'vectra-preview-href', url: associates_base, view: 'associates' %}{% endcapture %}
{% capture interns %}{% render 'vectra-preview-href', url: interns_base, view: 'interns' %}{% endcapture %}
{% capture careers %}{% render 'vectra-preview-href', url: careers_base, view: 'careers' %}{% endcapture %}
{% assign story = story | strip %}
{% assign solutions = solutions | strip %}
{% assign resources = resources | strip %}
{% assign faq = faq | strip %}
{% assign marketplace = marketplace | strip %}
{% assign experts = experts | strip %}
{% assign associates = associates | strip %}
{% assign interns = interns | strip %}
{% assign careers = careers | strip %}

<header class="vh-header" data-vh-header>
  <div class="vh-util">
    {% unless customer %}
      <a class="vh-util__link" href="{{ careers }}">
        <img src="{{ img_case }}" alt="" width="34" height="34">
        Join us
      </a>
    {% endunless %}

    <div class="vh-locale">
      <dropdown-localization-component class="vh-locale__native">
        <button
          type="button"
          class="vh-locale__summary"
          ref="button"
          on:click="/toggleSelector"
          aria-expanded="false"
          aria-controls="LocalizationPanel-{{ locale_form_id }}"
          aria-label="{{ 'accessibility.localization_region_and_language' | t }}"
        >
          <img src="{{ img_globe }}" alt="" width="38" height="38">
          <span class="vh-locale__code">{{ localization.language.iso_code | upcase }}</span>
        </button>
        <div
          id="LocalizationPanel-{{ locale_form_id }}"
          class="vh-locale__panel vh-dropdown localization-wrapper right-bound"
          hidden
          ref="panel"
        >
          {% render 'localization-form',
            show_country: show_country,
            show_language: show_language,
            localization_style: 'vectra',
            form_id: locale_form_id,
            back: request.path
          %}
        </div>
      </dropdown-localization-component>
    </div>

    {% if customer %}
      <div class="vh-account" data-vh-account-root>
        <div class="vh-account__session" data-vh-account>
          <button
            class="vh-account__avatar"
            type="button"
            data-vh-account-toggle
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="Account"
          >
            <img src="{{ img_user }}" alt="" width="32" height="36">
          </button>
          <div class="vh-account__menu vh-dropdown" data-vh-account-menu hidden>
            <div class="vh-account__head">
              <p class="vh-account__hi">Hi {{ customer_hello }}</p>
              <p class="vh-account__email">{{ customer.email }}</p>
            </div>
            <div class="vh-account__grid">
              <a class="vh-account__chip" href="{{ orders_url }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M4 8.5h16l-1.2 10.2H5.2L4 8.5Zm3.2-3.3h9.6L18 8.5H6l1.2-3.3Z"/></svg>
                Orders
              </a>
              <a class="vh-account__chip" href="{{ profile_url }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="M5.5 19c.7-3.2 3.2-5 6.5-5s5.8 1.8 6.5 5"/></svg>
                Profile
              </a>
              <a class="vh-account__chip vh-account__chip--wide" href="{{ courses_url }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M4 6.5c3.2-1.4 6.2.2 8 1.8 1.8-1.6 4.8-3.2 8-1.8v11c-3.2-1.4-6.2.2-8 1.8-1.8-1.6-4.8-3.2-8-1.8v-11Z"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="M12 8.3v11"/></svg>
                My Courses
              </a>
              <a class="vh-account__chip" href="{{ routes.account_logout_url }}">Log out</a>
            </div>
          </div>
        </div>
      </div>
    {% else %}
      <a class="vh-util__link" href="{{ login_url }}">
        <img src="{{ img_user }}" alt="" width="32" height="36">
        Log In
      </a>
    {% endif %}
  </div>

  <nav class="vh-nav" aria-label="Primary">
    <a class="vh-logo" href="{{ home }}">
      <img src="{{ img_logo }}" alt="{{ shop.name }}" width="220" height="38">
    </a>

    <div class="vh-menu">
      {% render 'vectra-nav-primary',
        mode: 'desktop',
        mega: mega,
        home: home,
        story: story,
        solutions: solutions,
        marketplace: marketplace,
        resources: resources,
        faq: faq,
        experts: experts,
        associates: associates,
        interns: interns,
        careers: careers
      %}
    </div>

    <div class="vh-nav-end">
      <button
        class="vh-search"
        type="button"
        on:click="#search-modal/showDialog"
        aria-label="Search"
      >
        <span class="vh-search__icon" aria-hidden="true"></span>
      </button>
      <button class="vh-contact-link" type="button" data-vh-contact-open>
        Contact Us
        <img src="{{ img_arrow_white }}" alt="" width="16" height="9">
      </button>
      <button class="vh-nav-toggle" type="button" data-vh-nav-toggle aria-expanded="false" aria-label="Menu">
        {{ 'icon-menu.svg' | inline_asset_content }}
      </button>
    </div>

    <div class="vh-nav-panel" data-vh-nav-panel>
      {% render 'vectra-nav-primary',
        mode: 'mobile',
        mega: mega,
        home: home,
        story: story,
        solutions: solutions,
        marketplace: marketplace,
        resources: resources,
        faq: faq,
        experts: experts,
        associates: associates,
        interns: interns,
        careers: careers
      %}
      <button type="button" data-vh-contact-open>Contact Us</button>
    </div>
  </nav>
</header>

{% render 'vectra-contact-modal' %}
