{%- doc -%}
  Shared VECTRA header with MEGA nav, native Shopify localization, and an account dropdown.
{%- enddoc -%}

{% render 'vectra-assets' %}

{% liquid
  assign img_logo = 'vectra-f1f1bad320cc916c9d3f257211cb366de698a572.png' | asset_url
  assign img_arrow_white = 'vectra-d640d7e5d10a7b2543900785147430e0c5cd06a1.svg' | asset_url
  assign home = routes.root_url
  assign story = pages['our-story'].url | default: '/pages/our-story'
  assign login_url = routes.account_login_url
  assign register_url = routes.account_register_url | default: routes.account_login_url

  assign mega = menu
  if mega == blank or mega.links.size == 0
    assign mega = section.settings.menu
  endif
  if mega == blank or mega.links.size == 0
    assign mega = linklists['vectra-website-mega-menu']
  endif

  assign has_nested = false
  if mega != blank
    for link in mega.links
      if link.links.size > 0
        assign has_nested = true
        break
      endif
    endfor
  endif

  unless has_nested
    assign mega_handles = 'vectra-website-mega-menu,mega-nav,mega-menu,mega-navigation,vectra-mega-nav,main-menu' | split: ','
    for handle in mega_handles
      assign candidate = linklists[handle]
      if candidate != blank and candidate.links.size > 0
        for link in candidate.links
          if link.links.size > 0
            assign mega = candidate
            assign has_nested = true
            break
          endif
        endfor
      endif
      if has_nested
        break
      endif
    endfor
  endunless

  assign account_root = routes.account_url | split: '?' | first
  if account_root contains 'shopify.com'
    assign profile_url = account_root | append: '/profile'
    assign orders_url = account_root | append: '/orders'
  else
    assign profile_url = routes.account_url
    assign orders_url = routes.account_url
  endif
  assign courses_url = pages['my-courses'].url | default: pages['courses'].url | default: routes.account_url
  assign customer_initial = customer.first_name | default: customer.email | slice: 0 | upcase
%}

<header class="vh-header" data-vh-header>
  <div class="vh-util">
    <details class="vh-locale vh-locale--native">
      <summary class="vh-locale__summary">
        {% if localization.country %}
          <span
            class="vh-locale__flag"
            style="background-image: url({{ localization.country | image_url: width: 64 }});"
          ></span>
        {% endif %}
        <span class="vh-locale__code">{{ localization.country.currency.iso_code | default: localization.language.iso_code | upcase }}</span>
        <span class="vh-locale__caret" aria-hidden="true"></span>
      </summary>
      <div class="vh-locale__panel">
        {% form 'localization', class: 'vh-locale__form', return_to: request.path %}
          <label class="vh-locale__field">
            Country / Currency
            <select name="country_code" onchange="this.form.submit()" aria-label="Country and currency">
              {% for country in localization.available_countries %}
                <option
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ country.name }} ({{ country.currency.iso_code }})
                </option>
              {% endfor %}
            </select>
          </label>
          <label class="vh-locale__field">
            Language
            <select name="language_code" onchange="this.form.submit()" aria-label="Language">
              {% for language in localization.available_languages %}
                <option
                  value="{{ language.iso_code }}"
                  lang="{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ language.endonym_name | default: language.iso_code | capitalize }}
                </option>
              {% endfor %}
            </select>
          </label>
          <button class="vh-locale__submit" type="submit">Apply</button>
        {% endform %}
      </div>
    </details>

    <div class="vh-account" data-vh-account-root>
      {% if customer %}
        <div class="vh-account__session" data-vh-account>
          <button
            class="vh-account__avatar"
            type="button"
            data-vh-account-toggle
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="Account"
          >
            {{ customer_initial }}
          </button>
          <div class="vh-account__menu" data-vh-account-menu hidden>
            <p class="vh-account__hi">Hi {{ customer.first_name | default: 'there' }}</p>
            <p class="vh-account__email">{{ customer.email }}</p>
            <div class="vh-account__grid">
              <a class="vh-account__chip" href="{{ orders_url }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M4 8.5h16l-1.2 10.2H5.2L4 8.5Zm3.2-3.3h9.6L18 8.5H6l1.2-3.3Z"/></svg>
                Orders
              </a>
              <a class="vh-account__chip" href="{{ profile_url }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="M5.5 19c.7-3.2 3.2-5 6.5-5s5.8 1.8 6.5 5"/></svg>
                Profile
              </a>
              <a class="vh-account__chip vh-account__chip--wide" href="{{ courses_url }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M4 6.5c3.2-1.4 6.2.2 8 1.8 1.8-1.6 4.8-3.2 8-1.8v11c-3.2-1.4-6.2.2-8 1.8-1.8-1.6-4.8-3.2-8-1.8v-11Z"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="M12 8.3v11"/></svg>
                My Courses
              </a>
            </div>
            <a class="vh-account__logout" href="{{ routes.account_logout_url }}">Log out</a>
          </div>
        </div>
      {% else %}
        <div class="vh-account__session" data-vh-account>
          <button
            class="vh-account__icon"
            type="button"
            data-vh-account-toggle
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="Log in or sign up"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="8" r="3.4" fill="none" stroke="currentColor" stroke-width="1.7"/>
              <path fill="none" stroke="currentColor" stroke-width="1.7" d="M5.2 19.2c.8-3.4 3.4-5.2 6.8-5.2s6 1.8 6.8 5.2"/>
            </svg>
          </button>
          <div class="vh-account__menu vh-account__menu--guest" data-vh-account-menu hidden>
            <div class="vh-account__grid">
              <a class="vh-account__chip vh-account__chip--wide" href="{{ register_url }}">Sign Up</a>
              <a class="vh-account__chip vh-account__chip--wide" href="{{ login_url }}">Log In</a>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <nav class="vh-nav" aria-label="Primary">
    <a class="vh-logo" href="{{ home }}">
      <img src="{{ img_logo }}" alt="{{ shop.name }}" width="220" height="38">
    </a>

    <div class="vh-menu">
      {% if mega != blank and mega.links.size > 0 %}
        {% for link in mega.links %}
          {% assign has_kids = false %}
          {% if link.links.size > 0 %}
            {% assign has_kids = true %}
          {% endif %}
          <div class="vh-menu__item{% if has_kids %} has-children{% endif %}">
            <a
              href="{{ link.url }}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
              {% if has_kids %}
                aria-haspopup="true"
              {% endif %}
            >
              {{ link.title }}
            </a>
            {% if has_kids %}
              <div class="vh-mega" role="list">
                {% for child in link.links %}
                  <div class="vh-mega__col" role="listitem">
                    <a class="vh-mega__parent" href="{{ child.url }}">{{ child.title }}</a>
                    {% if child.links.size > 0 %}
                      <ul class="vh-mega__list">
                        {% for grandchild in child.links %}
                          <li>
                            <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <a href="{{ story }}">Our DNA</a>
        <a href="{{ home }}#solutions">How We Help</a>
        <a href="{{ home }}#marketplace">Marketplace</a>
        <a href="{{ home }}#resources">Discover VECTRA</a>
      {% endif %}
    </div>

    <div class="vh-nav-end">
      <button
        class="vh-search"
        type="button"
        on:click="#search-modal/showDialog"
        aria-label="Search"
      >
        <span class="vh-search__icon" aria-hidden="true"></span>
      </button>
      <a class="vh-contact-link" href="#VectraContactModal" data-vh-contact-open>
        Contact Us
        <img src="{{ img_arrow_white }}" alt="" width="16" height="9">
      </a>
      <button class="vh-nav-toggle" type="button" data-vh-nav-toggle aria-expanded="false" aria-label="Menu">
        {{ 'icon-menu.svg' | inline_asset_content }}
      </button>
    </div>

    <div class="vh-nav-panel" data-vh-nav-panel>
      {% if mega != blank and mega.links.size > 0 %}
        {% for link in mega.links %}
          <div class="vh-nav-panel__item{% if link.links.size > 0 %} has-children{% endif %}">
            {% if link.links.size > 0 %}
              <button type="button" data-vh-mobile-sub aria-expanded="false">
                {{ link.title }}
              </button>
              <div class="vh-nav-panel__sub">
                <a href="{{ link.url }}">View {{ link.title }}</a>
                {% for child in link.links %}
                  <a href="{{ child.url }}">{{ child.title }}</a>
                  {% if child.links.size > 0 %}
                    {% for grandchild in child.links %}
                      <a class="vh-nav-panel__grand" href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                    {% endfor %}
                  {% endif %}
                {% endfor %}
              </div>
            {% else %}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <a href="{{ story }}">Our DNA</a>
        <a href="{{ home }}#solutions">How We Help</a>
        <a href="{{ home }}#marketplace">Marketplace</a>
        <a href="{{ home }}#resources">Discover VECTRA</a>
      {% endif %}
      <a href="#VectraContactModal" data-vh-contact-open>Contact Us</a>
    </div>
  </nav>
</header>

{% render 'vectra-contact-modal' %}
