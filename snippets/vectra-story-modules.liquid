  assign home = routes.root_url
  assign story = pages['about-us'].url | default: pages['our-story'].url | default: '/pages/about-us'
  assign experts_url = pages['experts'].url | default: '/pages/experts'
  assign leadership_url = pages['our-leadership-team'].url | default: pages['leadership'].url | default: pages['about-us'].url | default: pages['our-story'].url | default: '/pages/about-us'
  assign associates_url = pages['associates'].url | default: '/pages/associates'
  assign interns_url = pages['interns'].url | default: '/pages/interns'
  assign careers_url = pages['careers'].url | default: '/pages/careers'
  assign faq_url = pages['faq'].url | default: '/pages/faq'
  assign mv_mission = 'We enable positive business impact by partnering with organizations to transform end-to-end operational complexity into resilient, well-governed performance through expert teams, and human led state of the art technology—creating measurable value for people, operations, and sustainable growth.'
  assign mv_vision = 'To be the trusted partner in building operational control and resilience and achieving sustainable competitive advantage by transforming business complexity into strategic clarity, human-centered AI capability, and measurable value.'
  assign mv_solutions = 'We bring together deep expertise, a trusted network of partners, and technology that actually earns its place, then put all of it to work helping you design what needs to change, govern how it runs, and execute it in the real world.'
  assign mv_solutions_2 = "The result isn't just a plan. It's clarity you can act on, control you can trust, and capability that stays with your team long after we're done."
  assign jobs_url = pages['job-openings'].url | default: pages['careers'].url | default: careers_url
  assign solutions_page = pages['solutions'].url | default: '/pages/solutions'
  assign why_base = pages['why-partner-with-us'].url | default: '/pages/why-partner-with-us'
  assign contact_base = pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us'
%}
{% capture faq_href %}{% render 'vectra-preview-href', url: faq_url, view: 'faq' %}{% endcapture %}
{% capture leadership_href %}{% render 'vectra-preview-href', url: leadership_url, view: 'leadership' %}{% endcapture %}
{% capture experts_href %}{% render 'vectra-preview-href', url: experts_url, view: 'experts' %}{% endcapture %}
{% capture associates_href %}{% render 'vectra-preview-href', url: associates_url, view: 'associates' %}{% endcapture %}
{% capture interns_href %}{% render 'vectra-preview-href', url: interns_url, view: 'interns' %}{% endcapture %}
{% capture why_href %}{% render 'vectra-preview-href', url: why_base, view: 'why-partner' %}{% endcapture %}
{% capture contact_href %}{% render 'vectra-preview-href', url: contact_base, view: 'contact-us' %}{% endcapture %}
{% assign faq_href = faq_href | strip %}
{% assign leadership_href = leadership_href | strip %}
{% assign experts_href = experts_href | strip %}
{% assign associates_href = associates_href | strip %}
{% assign interns_href = interns_href | strip %}
{% assign why_href = why_href | strip %}
{% assign contact_href = contact_href | strip %}
{% case module %}
  {% when 'hero' %}
{% render 'vectra-seo', page_key: 'about' %}
{% unless block.settings.hide_section %}
{% comment %} About Us Version 2 final hero copy — hardcoded so theme-editor settings cannot drift. {% endcomment %}
{% liquid
  assign story_poster = img_ceo
  if block.settings.poster != blank
    assign story_poster = block.settings.poster | image_url: width: 1920
  endif
  assign story_align = block.settings.text_align | default: 'left'
%}
<section
  class="vs-hero vs-hero--align-{{ story_align }}"
  aria-label="About VECTRA International"
  style="{% render 'vectra-block-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
    {% if block.settings.video != blank %}
      {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1920x', class: 'vs-hero__video' }}
    {% else %}
    <video class="vs-hero__video" muted loop playsinline poster="{{ story_poster }}" data-vh-video>
      <source src="{{ vid_hero }}" type="video/mp4">
    </video>
    {% endif %}
    <img class="vs-hero__glow" src="{{ img_glow }}" alt="">
    <div class="vs-hero__shade" style="opacity: calc(var(--vh-overlay, 35) / 100);"></div>
    <div class="vs-hero__copy">
      <p class="vs-hero__kicker" data-vh-reveal="up">INSIDE VECTRA</p>
      <h1 data-vh-reveal="up">VECTRA International DNA, Values &amp; Global Leadership</h1>
      <p class="vs-hero__display" data-vh-reveal="up">We Believe Better Business Starts With People.</p>
      <div class="vs-hero__body" data-vh-reveal="up">
        <p>For over 20 years, VECTRA has worked with people who want their businesses to do better for their teams, customers, partners, and communities.</p>
        <p>That belief has shaped who we are from the beginning.</p>
        <p>We listen, bring the right people together, and stay close as ideas become decisions, decisions become action, and progress begins to show.</p>
      </div>
      <div class="vs-hero__actions" data-vh-reveal="up">
        <a class="vh-btn vh-btn--green" href="{{ solutions_page }}">Explore How We Help</a>
        <a class="vh-btn vh-btn--outline vh-btn--outline-light" href="{{ contact_href }}">Talk to an Expert</a>
      </div>
    </div>
  </section>
{% endunless %}

  {% when 'ceo' %}
{% unless block.settings.hide_section %}
{% comment %} About Us Version 2 CEO message — hardcoded. {% endcomment %}
<div class="vs-sheet" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <section class="vs-ceo" id="founder">
      <div class="vs-ceo__photo">
        {% render 'vectra-image', image: block.settings.image, fallback: img_ceo, alt: 'Patrick Neyts', class: 'vs-ceo__arch', width: 620, height: 574, image_width: 1240 %}
        <div class="vs-ceo__tag" data-vh-reveal="left">
          <span>Patrick Neyts</span>
        </div>
        <img class="vs-ceo__line" src="{{ img_ceo_line }}" alt="" data-vh-reveal="left">
      </div>
      <div class="vs-ceo__copy" data-vh-reveal="pop">
        <img class="vs-ceo__mark" src="{{ img_mark }}" alt="" aria-hidden="true">
        <p class="vs-ceo__kicker">MEET THE FOUNDER</p>
        <h2>A Message From Our CEO</h2>
        <div class="vs-ceo__body">
          <p class="vs-ceo__lede">Complexity doesn't hold businesses back. Not knowing what to do about it does.</p>
          <p>Most organizations do not struggle because of a lack of ambition. They struggle because operational complexity outpaces their ability to act.</p>
          <p>At VECTRA International, we partner with organizations to transform that complexity into clarity, control, and competitive advantage. From small and mid-sized businesses to global enterprises, we deliver integrated solutions that strengthen operational capability, reduce risk, and drive measurable results.</p>
          <p>We believe business is a force for good when better performance creates better outcomes for your organization, your customers, people, and society.</p>
          <p class="vs-ceo__signoff"><strong>Patrick Neyts</strong><br>Chief Executive Officer</p>
        </div>
      </div>
    </section>
  </div>
{% endunless %}

  {% when 'main' %}
{% unless block.settings.hide_section %}
<div class="vs-main" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vs-grid-bg">
      <canvas class="vs-grid-bg__canvas" data-vs-cell-grid aria-hidden="true"></canvas>

    <section class="vs-who" id="who-we-are">
      <div class="vs-who__copy">
        <p class="vs-who__kicker">OUR STORY</p>
        <h2>The VECTRA International Story</h2>
        <h3>Enabling Positive Business Impact Since 2005</h3>
        <div class="vs-who__body">
          <p>VECTRA began with a belief that still guides us today: business has the power to make a positive difference in people’s lives.</p>
          <p>Our early years brought us close to workers, brands, communities, and consumers. We saw how decisions made inside a business reach far beyond it. Good intentions matter, but what happens after the promise is made matters more.</p>
          <p>As our clients’ needs grew, we grew with them, across responsible business, supply chains, governance, operations, technology, and capability building. Our approach stayed deeply human. We listen before we recommend, and we stay involved until the change makes the difference it was meant to make.</p>
          <p>The challenges have changed. Our belief has not: better business should create better outcomes for people.</p>
          <p><strong>Better business should create better outcomes for people.</strong></p>
        </div>
      </div>
      <figure class="vs-who__media">
        <iframe
          src="{{ block.settings.video_url | default: 'https://www.youtube-nocookie.com/embed/C4JHZ69N9Sg?rel=0' }}"
          title="{{ block.settings.video_title | default: 'Patrick Neyts, CEO of VECTRA International: How to manage supply chain risks and build resilience' }}"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
        <figcaption class="vs-who__caption">{{ block.settings.video_caption | default: 'Temporary company film: Patrick Neyts on supply-chain risk and resilience, used while a new VECTRA film is produced.' }}</figcaption>
      </figure>
    </section>

    <section class="vs-mv">
      <article class="vs-card">
        <img class="vs-card__watermark" src="{{ img_mission }}" alt="">
        <div class="vs-card__head">
          <img src="{{ img_mission }}" alt="" width="69" height="69">
          <h2>Our Mission</h2>
        </div>
        <img class="vs-card__rule" src="{{ img_rule }}" alt="">
        <p>{{ mv_mission }}</p>
      </article>
      <article class="vs-card">
        <img class="vs-card__watermark" src="{{ img_vision }}" alt="">
        <div class="vs-card__head">
          <img src="{{ img_vision }}" alt="" width="79" height="79">
          <h2>Our Vision</h2>
        </div>
        <img class="vs-card__rule" src="{{ img_rule }}" alt="">
        <p>{{ mv_vision }}</p>
      </article>
    </section>

    <section class="vs-solutions" id="solutions">
      <h2>Our Solutions</h2>
      <p>{{ mv_solutions }}</p>
      <p>{{ mv_solutions_2 }}</p>
    </section>

    <section class="vs-values" id="values">
      <p class="vs-values__kicker">VECTRA VALUES</p>
      <h2>The Values Behind How We Show Up</h2>
      <p>Values matter most when people can feel them in the way you treat them. At VECTRA International, they shape how we listen, make decisions, support one another, and show up for our clients and their communities.</p>
      <p>They are not words we display. They are standards we live by.</p>
      <div class="vs-values__row">
        <img class="vs-values__line" src="{{ img_values_line }}" alt="">
        <article class="vs-value">
          <div class="vs-value__letter">v</div>
          <h3>V — VALUES</h3>
          <p>We are guided by respect, innovation, integrity, and accountability.</p>
        </article>
        <article class="vs-value">
          <div class="vs-value__letter">e</div>
          <h3>E — ETHICS</h3>
          <p>We prioritize ethically sourcing goods, empowering others, and creating positive impact</p>
        </article>
        <article class="vs-value">
          <div class="vs-value__letter">c</div>
          <h3>C — COMMUNITY</h3>
          <p>We actively build strong, supportive communities, fostering connections that uplift</p>
        </article>
        <article class="vs-value">
          <div class="vs-value__letter">t</div>
          <h3>T — TRANSPARENCY</h3>
          <p>We are honest, clear, and open, so you can trust us and know where you stand.</p>
        </article>
        <article class="vs-value">
          <div class="vs-value__letter">r</div>
          <h3>R — RIGHTS</h3>
          <p>We defend human rights and champion fair treatment for all.</p>
        </article>
        <article class="vs-value">
          <div class="vs-value__letter">a</div>
          <h3>A — ACTION</h3>
          <p>We turn words into real actions that drive meaningful change.</p>
        </article>
      </div>
    </section>
    </div>

    <section class="vs-experts vs-experts--teaser" id="leadership">
      <p class="vs-experts__kicker">OUR LEADERSHIP</p>
      <h2>Meet the People Who Guide VECTRA</h2>
      <div class="vs-experts__intro">
        <p>VECTRA is shaped by people with different experiences and expertise, but a shared belief in what good partnership should feel like.</p>
        <p>Across responsible business, operations, supply chains, sales, marketing, and applied AI, our leadership team sets the direction, supports our people, and keeps us true to the values we started with.</p>
      </div>
      <div class="vs-experts__grid">
        <article class="vs-expert">
          <img src="{{ img_lead_1 }}" alt="Patrick Neyts, CEO, VECTRA International">
          <h3>Patrick Neyts</h3>
          <p class="vs-expert__role">CEO</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_lead_2 }}" alt="Shelly Sanders, SVP, Global Sales, Marketing &amp; Communications, VECTRA International">
          <h3>Shelly Sanders</h3>
          <p class="vs-expert__role">SVP, Global Sales, Marketing &amp; Communications</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_lead_3 }}" alt="Lorenz Berzau, VP Operations, VECTRA International">
          <h3>Lorenz Berzau</h3>
          <p class="vs-expert__role">VP Operations</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_lead_4 }}" alt="Alana van Wouw, AI Architect, VECTRA International">
          <h3>Alana van Wouw</h3>
          <p class="vs-expert__role">AI Architect</p>
        </article>
      </div>
      <div class="vs-experts__more">
        <div class="vs-faces" data-vh-reveal="fade">
          <img src="{{ img_lead_1 }}" alt="">
          <img src="{{ img_lead_2 }}" alt="">
          <img src="{{ img_lead_3 }}" alt="">
          <img src="{{ img_lead_5 }}" alt="">
        </div>
        <a class="vs-cta-btn" href="{{ leadership_href }}" data-vh-reveal="scale">
          Meet Our Leadership
          <img src="{{ img_arrow_btn }}" alt="">
        </a>
      </div>
    </section>

    <section class="vs-experts vs-experts--teaser" id="experts">
      <p class="vs-experts__kicker">OUR EXPERTS</p>
      <h2>Our Team of Experts</h2>
      <div class="vs-experts__intro">
        <p>The people our clients meet matter.</p>
        <p>Our specialists know their fields and markets, and have spent years seeing how challenges play out in real businesses. They bring judgment, local understanding, and the ability to listen first, so clients get support that fits their situation, not a standard playbook.</p>
      </div>
      <div class="vs-experts__grid">
        <article class="vs-expert">
          <img src="{{ img_exp_1 }}" alt="Beat Grüninger">
          <h3>Beat Grüninger</h3>
          <p>Senior Technical Advisor and Lecturer in Sustainability Management and Standards</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_exp_2 }}" alt="Berçin Doğan Öztürk">
          <h3>Berçin Doğan Öztürk</h3>
          <p>13+ years of experience in sustainability, social compliance, and responsible business</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_exp_3 }}" alt="Daniel Ndiwa">
          <h3>Daniel Ndiwa</h3>
          <p>Sustainability Standards Consultant with 5 years of experience auditing voluntary sustainability standards in coffee, tea, avocado, and horticulture across Eastern Africa</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_exp_4 }}" alt="Iddah Ooko">
          <h3>Iddah Ooko</h3>
          <p>Environmental and Social Impact Consultant with 15+ years leading environmental impact assessments, audits, ESG, and multidisciplinary development projects</p>
        </article>
      </div>
      <div class="vs-experts__more">
        <div class="vs-faces" data-vh-reveal="fade">
          <img src="{{ img_face_1 }}" alt="">
          <img src="{{ img_face_2 }}" alt="">
          <img src="{{ img_face_3 }}" alt="">
          <img src="{{ img_face_4 }}" alt="">
        </div>
        <a class="vs-cta-btn" href="{{ experts_href }}" data-vh-reveal="scale">
          Meet All Experts
          <img src="{{ img_arrow_btn }}" alt="">
        </a>
      </div>
    </section>

    <section class="vs-people">
      <p class="vs-people__kicker">OUR GLOBAL NETWORK</p>
      <h2>Global Expertise. Local Understanding. One VECTRA Team.</h2>
      <div class="vs-people__body">
        <p>Every market has its own people, culture, regulations, and realities. That is why being global means more to us than having people in different places.</p>
        <p>Our associates and experts know their markets firsthand. A supplier challenge in Eastern Africa may call for a different perspective from a question in Brussels, and we bring together the people who understand both.</p>
        <p>Wherever our clients are, they have a global network with local understanding, and one VECTRA team committed to their success.</p>
      </div>
      <a class="vs-cta-btn" href="{{ associates_href }}">Meet Our People<img src="{{ img_arrow_btn }}" alt=""></a>
      {% liquid
        assign map_base = 'vectra-story-map-base.png' | asset_url
        assign map_pin_icon = 'vectra-map-pin.svg' | asset_url
        if block.settings.map_poster != blank
          assign map_base = block.settings.map_poster | image_url: width: 1600
        endif
      %}
      <div class="vs-people__map" data-vs-map data-map-pin="{{ map_pin_icon }}">
        <img
          class="vs-people__map-poster"
          src="{{ map_base }}"
          alt="VECTRA International global associate network map"
          width="1024"
          height="509"
          loading="lazy"
          decoding="async"
        >
        <script type="application/json" data-vs-map-locations>{% render 'vectra-associate-locations', mode: 'json' %}</script>
        <ul class="vs-people__pins" data-vs-map-pins aria-label="Associate locations">
          {% render 'vectra-associate-locations', mode: 'pins', img_pin: map_pin_icon %}
        </ul>
      </div>
    </section>

  </div>
</div>
{% endunless %}

  {% when 'faq' %}
{% unless block.settings.hide_section %}
{% comment %} About Us Version 2 FAQ + AEO supporting copy — hardcoded. {% endcomment %}
<section
  class="vh-faq vh-faq--story vh-faq--story-full vs-faq-full"
  id="about-faq"
  style="margin-left: clamp(24px, 5vw, 80px); margin-right: clamp(24px, 5vw, 80px); padding-left: clamp(20px, 3vw, 48px); padding-right: clamp(20px, 3vw, 48px); box-sizing: border-box; {% render 'vectra-block-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <div class="vs-faq-full__inner">
    <div class="vh-faq__glow" aria-hidden="true"></div>
    <div class="vh-accordion" data-vh-faq-accordion>
      <p class="vh-kicker">FAQ</p>
      <h2 class="vh-h2">Questions About VECTRA International</h2>
      <p class="vs-aeo">VECTRA International is a business resilience and operational capability building partner founded in 2005. We combine expert people and technology to turn responsible business, supply chain, and operational challenges into clearer decisions and lasting capability.</p>
      <div class="vh-acc is-open" data-vh-faq-item>
        <button type="button" data-vh-faq-btn aria-expanded="true">Who is VECTRA International?</button>
        <div class="vh-acc__body">VECTRA International is a business resilience and operational capability building partner founded in 2005. We combine expert people and technology to turn responsible business, supply chain, and operational challenges into clearer decisions and lasting capability.</div>
      </div>
      <div class="vh-acc" data-vh-faq-item>
        <button type="button" data-vh-faq-btn aria-expanded="false">When was VECTRA International founded?</button>
        <div class="vh-acc__body" hidden>VECTRA International was founded in 2005. Since then, our work has grown from responsible business and supply-chain challenges into a broader role supporting business resilience, operational capability, governance, and performance.</div>
      </div>
      <div class="vh-acc" data-vh-faq-item>
        <button type="button" data-vh-faq-btn aria-expanded="false">What does VECTRA International do?</button>
        <div class="vh-acc__body" hidden>We help organizations turn complex requirements and operational challenges into clear priorities and practical action. Depending on the issue, that may involve supplier risk, governance, evidence, technology, capability building, responsible business, or operational improvement.</div>
      </div>
      <div class="vh-acc" data-vh-faq-item>
        <button type="button" data-vh-faq-btn aria-expanded="false">How is VECTRA different from a traditional consulting company?</button>
        <div class="vh-acc__body" hidden>VECTRA consulting support is built around partnership, implementation, and follow-through. Organizations may come to us while looking for an operational resilience consulting company, but our role is broader. We bring together specialist expertise, capability building, practical implementation, and technology where it adds value, then stay involved as decisions move into practice and progress is measured.</div>
      </div>
      <div class="vh-acc" data-vh-faq-item>
        <button type="button" data-vh-faq-btn aria-expanded="false">Where does VECTRA International operate?</button>
        <div class="vh-acc__body" hidden>VECTRA International works globally, supported by associates and specialist experts who bring local context and experience across regions, markets, and industries.</div>
      </div>
      <div class="vh-acc" data-vh-faq-item>
        <button type="button" data-vh-faq-btn aria-expanded="false">Who leads VECTRA International?</button>
        <div class="vh-acc__body" hidden>VECTRA International is led by CEO Patrick Neyts alongside a global leadership team spanning operations, sales and marketing, and applied AI.</div>
      </div>
    </div>
  </div>
</section>
{% endunless %}

