%}
{% capture faq_href %}{% render 'vectra-preview-href', url: faq_url, view: 'faq' %}{% endcapture %}
{% capture experts_href %}{% render 'vectra-preview-href', url: experts_url, view: 'experts' %}{% endcapture %}
{% capture associates_href %}{% render 'vectra-preview-href', url: associates_url, view: 'associates' %}{% endcapture %}
{% capture interns_href %}{% render 'vectra-preview-href', url: interns_url, view: 'interns' %}{% endcapture %}
{% assign faq_href = faq_href | strip %}
{% assign experts_href = experts_href | strip %}
{% assign associates_href = associates_href | strip %}
{% assign interns_href = interns_href | strip %}
{% case module %}
  {% when 'hero' %}
{% render 'vectra-seo', page_key: 'about' %}
{% unless block.settings.hide_section %}
{% liquid
  assign story_kicker = block.settings.kicker | default: 'Inside VECTRA'
  assign story_heading = block.settings.heading | default: 'About VECTRA International – Our DNA, Values &amp; Global Expertise'
  assign story_poster = img_ceo
  if block.settings.poster != blank
    assign story_poster = block.settings.poster | image_url: width: 1920
  endif
  assign story_align = block.settings.text_align | default: 'left'
%}
<section
  class="vs-hero vs-hero--align-{{ story_align }}"
  aria-label="Our VECTRA Story"
  style="{% render 'vectra-block-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
    {% if block.settings.video != blank %}
      {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1920x', class: 'vs-hero__video' }}
    {% else %}
    <video class="vs-hero__video" muted loop playsinline poster="{{ story_poster }}" data-vh-video>
      <source src="{{ vid_hero }}" type="video/mp4">
    </video>
    {% endif %}
    <img class="vs-hero__glow" src="{{ img_glow }}" alt="">
    <div class="vs-hero__shade" style="opacity: calc(var(--vh-overlay, 35) / 100);"></div>
    <div class="vs-hero__copy">
      <p class="vs-hero__kicker" data-vh-reveal="up">{{ story_kicker }}</p>
      <h1 data-vh-reveal="up">{{ story_heading }}</h1>
      <div class="vs-hero__body" data-vh-reveal="up">
        {% if block.settings.text != blank %}
          {{ block.settings.text }}
        {% else %}
        <p>
          VECTRA International is a business resilience and operational capability-building partner that helps organizations turn ESG, supply chain, and operational requirements into accountable action. Since 2005, VECTRA International has partnered with global brands to strengthen governance, resolve supplier risk, and build operational resilience — combining expert teams with practical, technology-enabled delivery.
        </p>
        <p>
          We help organizations turn requirements, supplier issues, weak controls, scattered evidence, and changing operations into clear priorities, accountable action, and stronger performance. VECTRA started with a simple belief: business can be a force for good, but commitments have to survive contact with real operations.
        </p>
        {% endif %}
      </div>
      {% if block.settings.button_label != blank or block.settings.button_2_label != blank %}
        <div class="vs-hero__actions" data-vh-reveal="up">
          {% if block.settings.button_label != blank %}
            <a class="vh-btn vh-btn--green" href="{{ block.settings.button_link | default: '#VectraContactModal' }}" {% if block.settings.button_link == blank or block.settings.button_link == '#VectraContactModal' %}data-vh-contact-open{% endif %}>{{ block.settings.button_label }}</a>
          {% endif %}
          {% if block.settings.button_2_label != blank %}
            <a class="vh-btn vh-btn--outline vh-btn--outline-light" href="{{ block.settings.button_2_link | default: '#' }}">{{ block.settings.button_2_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </section>
{% endunless %}

  {% when 'ceo' %}
{% unless block.settings.hide_section %}
{% liquid
  assign ceo_name = block.settings.name | default: 'Patrick Neyts'
  assign ceo_kicker = block.settings.kicker | default: 'Meet the Founder'
  assign ceo_heading = block.settings.heading | default: 'A Message from Our CEO'
%}
<div class="vs-sheet" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <section class="vs-ceo" id="founder">
      <img class="vs-ceo__mark" src="{{ img_mark }}" alt="">
      <div class="vs-ceo__photo">
        {% render 'vectra-image', image: block.settings.image, fallback: img_ceo, alt: ceo_name, class: 'vs-ceo__arch', width: 620, height: 574, image_width: 1240 %}
        <div class="vs-ceo__tag" data-vh-reveal="left">
          <span>{{ ceo_name }}</span>
        </div>
        <img class="vs-ceo__line" src="{{ img_ceo_line }}" alt="" data-vh-reveal="left">
      </div>
      <div class="vs-ceo__copy" data-vh-reveal="pop">
        <p class="vs-ceo__kicker">{{ ceo_kicker }}</p>
        <h2>{{ ceo_heading }}</h2>
        <div class="vs-ceo__body">
          {% if block.settings.text != blank %}
            {{ block.settings.text }}
          {% else %}
          <p>Most organizations do not struggle because of a lack of ambition. They struggle because operational complexity outpaces their ability to act.</p>
          <p>At VECTRA International, we partner with organizations to transform that complexity into clarity, control, and competitive advantage. From small and mid-sized businesses to global enterprises, we deliver integrated solutions that strengthen operational capability, reduce risk, and drive measurable results.</p>
          <p>We believe business is a force for good when better performance creates better outcomes for your organization, your customers, people, and society.</p>
          {% endif %}
        </div>
      </div>
    </section>
  </div>
{% endunless %}

  {% when 'main' %}
{% unless block.settings.hide_section %}
<div class="vs-main" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <div class="vs-grid-bg">
      <canvas class="vs-grid-bg__canvas" data-vs-cell-grid aria-hidden="true"></canvas>

    <section class="vs-who" id="who-we-are">
      <div class="vs-who__copy">
        <p class="vs-who__kicker">{{ block.settings.kicker | default: 'The VECTRA Story' }}</p>
        <h2>{{ block.settings.heading | default: 'Enabling Positive Business Impact' }}</h2>
      </div>
      <figure class="vs-who__media">
        <iframe
          src="{{ block.settings.video_url | default: 'https://www.youtube-nocookie.com/embed/C4JHZ69N9Sg?rel=0' }}"
          title="{{ block.settings.video_title | default: 'Patrick Neyts, CEO of VECTRA International: How to manage supply chain risks and build resilience' }}"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
        <figcaption class="vs-who__caption">{{ block.settings.video_caption | default: 'Temporary company film: Patrick Neyts on supply-chain risk and resilience, used while a new VECTRA film is produced.' }}</figcaption>
      </figure>
    </section>

    <section class="vs-mv">
      <article class="vs-card">
        <img class="vs-card__watermark" src="{{ img_mission }}" alt="">
        <div class="vs-card__head">
          <img src="{{ img_mission }}" alt="" width="69" height="69">
          <h3>{{ block.settings.mission_heading | default: 'Our Mission' }}</h3>
        </div>
        <img class="vs-card__rule" src="{{ img_rule }}" alt="">
        <p>{{ block.settings.mission | default: mv_mission }}</p>
      </article>
      <article class="vs-card">
        <img class="vs-card__watermark" src="{{ img_vision }}" alt="">
        <div class="vs-card__head">
          <img src="{{ img_vision }}" alt="" width="79" height="79">
          <h3>{{ block.settings.vision_heading | default: 'Our Vision' }}</h3>
        </div>
        <img class="vs-card__rule" src="{{ img_rule }}" alt="">
        <p>{{ block.settings.vision | default: mv_vision }}</p>
      </article>
    </section>

    <section class="vs-values" id="values">
      <h2>{{ block.settings.values_heading | default: 'VECTRA Values' }}</h2>
      <p>{{ block.settings.values_text | default: 'These values guide the decisions we make, the relationships we build, and the way we turn our commitments into action.' }}</p>
      <div class="vs-values__row">
        <img class="vs-values__line" src="{{ img_values_line }}" alt="">
        <article class="vs-value">
          <div class="vs-value__letter">{{ block.settings.value_1_letter | default: 'v' }}</div>
          <h3>{{ block.settings.value_1_heading | default: 'Values' }}</h3>
          <p>{{ block.settings.value_1_text | default: 'We are guided by respect, innovation, integrity, and accountability.' }}</p>
        </article>
        <article class="vs-value">
          <div class="vs-value__letter">{{ block.settings.value_2_letter | default: 'e' }}</div>
          <h3>{{ block.settings.value_2_heading | default: 'Ethics' }}</h3>
          <p>{{ block.settings.value_2_text | default: 'We prioritize ethically sourcing goods, empowering others, and creating positive impact.' }}</p>
        </article>
        <article class="vs-value">
          <div class="vs-value__letter">{{ block.settings.value_3_letter | default: 'c' }}</div>
          <h3>{{ block.settings.value_3_heading | default: 'Community' }}</h3>
          <p>{{ block.settings.value_3_text | default: 'We actively build strong, supportive communities, fostering connections that uplift.' }}</p>
        </article>
        <article class="vs-value">
          <div class="vs-value__letter">{{ block.settings.value_4_letter | default: 't' }}</div>
          <h3>{{ block.settings.value_4_heading | default: 'Transparency' }}</h3>
          <p>{{ block.settings.value_4_text | default: 'We are honest, clear, and open, so you can trust us and know where you stand.' }}</p>
        </article>
        <article class="vs-value">
          <div class="vs-value__letter">{{ block.settings.value_5_letter | default: 'r' }}</div>
          <h3>{{ block.settings.value_5_heading | default: 'Rights' }}</h3>
          <p>{{ block.settings.value_5_text | default: 'We defend human rights and champion fair treatment for all.' }}</p>
        </article>
        <article class="vs-value">
          <div class="vs-value__letter">{{ block.settings.value_6_letter | default: 'a' }}</div>
          <h3>{{ block.settings.value_6_heading | default: 'Action' }}</h3>
          <p>{{ block.settings.value_6_text | default: 'We turn words into real actions that drive meaningful change.' }}</p>
        </article>
      </div>
    </section>
    </div>

    <section class="vs-leaders" id="leadership" data-vs-reveal-group>
      <h2>{{ block.settings.leaders_heading | default: 'Our Leadership Team' }}</h2>
      <div class="vs-leaders__viewport">
        <div class="vs-leaders__track" data-vs-leaders-track>
          {% assign nested_leaders = nested_leaders | strip %}
          {% if nested_leaders != blank %}
            {{ nested_leaders }}
          {% else %}
          <article class="vs-leader" data-vs-leader data-vh-reveal="right">
            <div class="vs-leader__frame">
              <div class="vs-leader__media">
                <img src="{{ img_lead_1 }}" alt="Patrick Neyts">
                <div class="vs-leader__shade"></div>
              </div>
              <div class="vs-leader__id">
                <h3>Patrick Neyts</h3>
                <p class="vs-leader__role vs-leader__role--lg">CEO</p>
                <p class="vs-leader__bio">With over 30 years of experience in ESG programs, Corporate Codes, and Responsible Business practices across 11 industry sectors and 40 countries.</p>
              </div>
            </div>
          </article>
          <article class="vs-leader" data-vs-leader data-vh-reveal="right">
            <div class="vs-leader__frame">
              <div class="vs-leader__media">
                <img src="{{ img_lead_2 }}" alt="Shelly Sanders">
                <div class="vs-leader__shade"></div>
              </div>
              <div class="vs-leader__id">
                <h3>Shelly Sanders</h3>
                <p class="vs-leader__role">SVP, Global Sales, Marketing &amp; Communications</p>
                <p class="vs-leader__bio">With over 30 years of leadership experience in consultative and solution-based sales &amp; operations. She has worked across healthcare, finance, and IT, driving global growth, strategic partnerships, and ESG-aligned outcome.</p>
              </div>
            </div>
          </article>
          <article class="vs-leader" data-vs-leader data-vh-reveal="right">
            <div class="vs-leader__frame">
              <div class="vs-leader__media">
                <img src="{{ img_lead_3 }}" alt="Lorenz Berzau">
                <div class="vs-leader__shade"></div>
              </div>
              <div class="vs-leader__id">
                <h3>Lorenz Berzau</h3>
                <p class="vs-leader__role">VP Operations</p>
                <p class="vs-leader__bio">With a focus on sustainability strategy, human rights, and social compliance, backed by 20 years of consultancy experience and a background in law.</p>
              </div>
            </div>
          </article>
          <article class="vs-leader" data-vs-leader data-vh-reveal="right">
            <div class="vs-leader__frame">
              <div class="vs-leader__media">
                <img src="{{ img_lead_4 }}" alt="Alana van Wouw">
                <div class="vs-leader__shade"></div>
              </div>
              <div class="vs-leader__id">
                <h3>Alana van Wouw</h3>
                <p class="vs-leader__role">AI Architect</p>
                <p class="vs-leader__bio">With over 20 years of experience in project management, ESG, financial modeling, and AI, leading high-impact initiatives across emerging markets with strong sustainability and data-driven expertise.</p>
              </div>
            </div>
          </article>
          <article class="vs-leader" data-vs-leader data-vh-reveal="right">
            <div class="vs-leader__frame">
              <div class="vs-leader__media">
                <img src="{{ img_lead_5 }}" alt="Elizabeth Korban">
                <div class="vs-leader__shade"></div>
              </div>
              <div class="vs-leader__id">
                <h3>Elizabeth Korban</h3>
                <p class="vs-leader__role">Director of Organizational Enablement</p>
                <p class="vs-leader__bio">Elizabeth has 15+ years of experience as a leader responsible for embedding ESG principles into organisational culture, governance and operations.</p>
              </div>
            </div>
          </article>
          {% endif %}
        </div>
      </div>
      <div class="vs-arrows" data-vh-reveal="right">
        <button type="button" data-vs-prev aria-label="Previous">
          <img class="vs-arrows__bg" src="{{ img_arrow_circle }}" alt="">
          <img class="vs-arrows__icon" src="{{ img_arrow_white }}" alt="">
        </button>
        <button type="button" data-vs-next aria-label="Next">
          <img class="vs-arrows__bg" src="{{ img_arrow_circle }}" alt="">
          <img class="vs-arrows__icon" src="{{ img_arrow_white }}" alt="">
        </button>
      </div>
      <a class="vs-cta-btn" href="{{ block.settings.leaders_button_link | default: '#experts' }}" data-vh-reveal="scale">
        {{ block.settings.leaders_button_label | default: 'Meet Our Leadership' }}
        <img src="{{ img_arrow_btn }}" alt="">
      </a>
    </section>

    <section class="vs-experts" id="experts">
      <h2>{{ block.settings.experts_heading | default: 'Our Team of Experts' }}</h2>
      <div class="vs-experts__grid">
        <article class="vs-expert">
          <img src="{{ img_exp_1 }}" alt="Beat Grüninger">
          <h3>Beat Grüninger</h3>
          <p>Senior Technical Advisor and Lecturer in Sustainability Management and Standards</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_exp_2 }}" alt="Berçin Doğan Öztürk">
          <h3>Berçin Doğan Öztürk</h3>
          <p>13+ years of experience in sustainability, social compliance, and responsible business</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_exp_3 }}" alt="Daniel Ndiwa">
          <h3>Daniel Ndiwa</h3>
          <p>Sustainability Standards Consultant with 5 years of experience auditing voluntary sustainability standards in coffee, tea, avocado, and horticulture across Eastern Africa</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_exp_4 }}" alt="Iddah Ooko">
          <h3>Iddah Ooko</h3>
          <p>Environmental and Social Impact Consultant with 15+ years leading environmental impact assessments, audits, ESG, and multidisciplinary development projects</p>
        </article>
      </div>
      <div class="vs-experts__more">
        <div class="vs-faces" data-vh-reveal="fade">
          <img src="{{ img_face_1 }}" alt="">
          <img src="{{ img_face_2 }}" alt="">
          <img src="{{ img_face_3 }}" alt="">
          <img src="{{ img_face_4 }}" alt="">
        </div>
        <a class="vs-cta-btn" href="{{ block.settings.experts_button_link | default: experts_href }}" data-vh-reveal="scale">
          {{ block.settings.experts_button_label | default: 'Meet All Experts' }}
          <img src="{{ img_arrow_btn }}" alt="">
        </a>
      </div>
    </section>

    <section class="vs-experts" id="associates">
      <h2>{{ block.settings.associates_heading | default: 'Our Associates' }}</h2>
      <div class="vs-experts__grid">
        <article class="vs-expert">
          <img src="{{ img_face_1 }}" alt="Regional associate, Africa">
          <h3>Regional Associate — Africa</h3>
          <p>Local market context for supplier engagement, social compliance, and operational follow-through across African supply chains.</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_face_2 }}" alt="Regional associate, Europe">
          <h3>Regional Associate — Europe</h3>
          <p>Hands-on support for ESG reporting, due diligence, and capability building with European brands and their supplier networks.</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_face_3 }}" alt="Regional associate, Asia">
          <h3>Regional Associate — Asia</h3>
          <p>Factory, farm, and mill experience that helps teams turn audit findings into practical, locally workable action.</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_face_4 }}" alt="Regional associate, Americas">
          <h3>Regional Associate — Americas</h3>
          <p>Specialist support for responsible sourcing, labour standards, and operational resilience programmes across the Americas.</p>
        </article>
      </div>
      <div class="vs-experts__more">
        <div class="vs-faces" data-vh-reveal="fade">
          <img src="{{ img_face_1 }}" alt="">
          <img src="{{ img_face_2 }}" alt="">
          <img src="{{ img_face_3 }}" alt="">
          <img src="{{ img_face_4 }}" alt="">
        </div>
        <a class="vs-cta-btn" href="{{ block.settings.associates_button_link | default: associates_href }}" data-vh-reveal="scale">
          {{ block.settings.associates_button_label | default: 'Meet our associates' }}
          <img src="{{ img_arrow_btn }}" alt="">
        </a>
      </div>
    </section>

    <section class="vs-experts" id="interns">
      <h2>{{ block.settings.interns_heading | default: 'Our Interns' }}</h2>
      <div class="vs-experts__grid">
        <article class="vs-expert">
          <img src="{{ img_face_1 }}" alt="Systems intern">
          <h3>Systems intern</h3>
          <p>Zoho, process documentation, and operational support across VECTRA teams.</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_face_2 }}" alt="Sales operations intern">
          <h3>Sales operations intern</h3>
          <p>Pipeline hygiene, enquiry follow-through, and the admin that keeps client work moving.</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_face_3 }}" alt="Business intelligence intern">
          <h3>Business intelligence intern</h3>
          <p>Research, evidence packing, and turning scattered information into something a team can use.</p>
        </article>
        <article class="vs-expert">
          <img src="{{ img_face_4 }}" alt="Marketing intern">
          <h3>Marketing intern</h3>
          <p>Stories, events, and resources that help the right people find VECTRA without the noise.</p>
        </article>
      </div>
      <div class="vs-experts__more">
        <div class="vs-faces" data-vh-reveal="fade">
          <img src="{{ img_face_1 }}" alt="">
          <img src="{{ img_face_2 }}" alt="">
          <img src="{{ img_face_3 }}" alt="">
          <img src="{{ img_face_4 }}" alt="">
        </div>
        <a class="vs-cta-btn" href="{{ block.settings.interns_button_link | default: interns_href }}" data-vh-reveal="scale">
          {{ block.settings.interns_button_label | default: 'Meet our interns' }}
          <img src="{{ img_arrow_btn }}" alt="">
        </a>
      </div>
    </section>

    <section class="vs-people" data-vh-reveal="scale">
      <h2>{{ block.settings.people_heading | default: 'The People Behind VECTRA, Across the World' }}</h2>
      <p>{{ block.settings.people_text | default: 'A supplier issue in Eastern Africa and a reporting problem in Brussels do not need the same person. VECTRA International’s associates and experts bring local context and specialist experience across markets and industries so we build the right team around the work, instead of pushing every problem through the same generalist lens.' }}</p>
      <div class="vs-people__map">
        {% if block.settings.map_video != blank %}
          {{ block.settings.map_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1600x' }}
        {% else %}
        <video muted loop playsinline poster="{% if block.settings.map_poster != blank %}{{ block.settings.map_poster | image_url: width: 1600 }}{% else %}{{ img_ceo }}{% endif %}" data-vh-video>
          <source src="{{ vid_map }}" type="video/mp4">
        </video>
        {% endif %}
      </div>
    </section>

  </div>
</div>
{% endunless %}

  {% when 'faq' %}
{% unless block.settings.hide_section %}
{% liquid
  assign faq_card_title = block.settings.card_title | default: 'More questions?'
  assign faq_card_text = block.settings.card_text | default: 'Find more answers about VECTRA International, how we work, our capabilities, and getting started.'
  assign faq_btn = block.settings.button_label | default: 'More questions?'
  if block.settings.button_link != blank
    assign faq_btn_href = block.settings.button_link
  else
    assign faq_btn_href = faq_href
  endif
  assign nested_items = nested_items | strip
%}
<section class="vh-faq" id="about-faq" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap vh-faq__grid">
    <aside class="vh-contact-card" data-vh-reveal="left">
      <img class="vh-contact-card__icon" src="{{ img_chat }}" alt="">
      <p class="vh-contact-card__title">{{ faq_card_title }}</p>
      <p>{{ faq_card_text }}</p>
      <a class="vh-btn vh-btn--white" href="{{ faq_btn_href }}">
        {{ faq_btn }}
        <img src="{{ img_arrow }}" alt="">
      </a>
      {% render 'vectra-contact-details', variant: 'card', img_phone: img_phone, img_mail: img_mail, img_pin: img_pin %}
    </aside>
    <div class="vh-faq__right">
      <div class="vh-faq__glow" aria-hidden="true"></div>
      <div class="vh-accordion">
        <p class="vh-kicker">{{ block.settings.kicker | default: 'Our FAQ' }}</p>
        <h2 class="vh-h2">{{ block.settings.heading | default: 'Frequently Asked Questions' }}</h2>
        <p class="vh-lead">{{ block.settings.lead | default: 'Answers about who we are, how we work, and where we operate.' }}</p>
        {% if nested_items != blank %}
          {{ nested_items }}
        {% else %}
        <div class="vh-acc is-open" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>Who is VECTRA International?</button>
          <div class="vh-acc__body">VECTRA International is a business resilience and operational capability-building partner that helps organizations manage ESG requirements, supplier risk, and operational complexity through expert teams and practical, technology-enabled delivery.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>When was VECTRA International founded?</button>
          <div class="vh-acc__body">VECTRA International was founded in 2005 and has since worked with organizations across industries to strengthen governance, supplier accountability, and operational resilience.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>What does VECTRA International do?</button>
          <div class="vh-acc__body">VECTRA International turns responsible business requirements — supplier issues, audit findings, weak controls, and changing regulations — into clear priorities, accountable action, and measurable performance improvement.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>Where does VECTRA International operate?</button>
          <div class="vh-acc__body">VECTRA International operates globally, with associates and specialist experts delivering local market context across regions including Africa, Europe, Asia, and beyond.</div>
        </div>
        <div class="vh-acc" data-vh-faq-item>
          <button type="button" data-vh-faq-btn>Who leads VECTRA International?</button>
          <div class="vh-acc__body">VECTRA International is led by CEO Patrick Neyts, alongside a global leadership team spanning operations, sales and marketing, and applied AI.</div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endunless %}

  {% when 'join' %}
{% unless block.settings.hide_section %}
{% liquid
  assign join_kicker = block.settings.kicker | default: 'Be part of a global team'
  assign join_heading = block.settings.heading | default: 'Bring What Only You Can Contribute'
  assign join_text = block.settings.text | default: 'We value people who take ownership, stay curious, challenge ideas respectfully, and care whether the work actually changes something. You will work with colleagues and specialists across markets, disciplines, and time zones.'
  assign join_btn = block.settings.button_label | default: 'View Open Positions'
  if block.settings.button_link != blank
    assign join_cta = block.settings.button_link
  else
    assign join_cta = careers_url
  endif
%}
<section class="vs-join" id="careers" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    <canvas class="vs-join__grid" data-vs-join-grid aria-hidden="true"></canvas>
    <div class="vs-join__inner">
      <div>
        <p class="vs-join__kicker">{{ join_kicker }}</p>
        <h2>{{ join_heading }}</h2>
        <p>{{ join_text }}</p>
      </div>
      <a class="vs-cta-btn" href="{{ join_cta }}">
        {{ join_btn }}
        <img src="{{ img_arrow_send }}" alt="">
      </a>
      {% assign nested_extras = nested_extras | strip %}
      {% if nested_extras != blank %}
        <div class="vh-block-extras">{{ nested_extras }}</div>
      {% endif %}
    </div>
  </section>
{% endunless %}

{% endcase %}
