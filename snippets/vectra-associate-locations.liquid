{%- doc -%}
  Approved unique locations from Associates Locations.xlsx (one pin per place).
  Muhammad Noman omitted — no location provided.
  @param {string} [mode] - "json" (default) or "pins"
  @param {string} [img_pin] - Pin icon URL when mode is pins
{%- enddoc -%}
{% liquid
  assign mode = mode | default: 'json'
  assign pin_icon = img_pin | default: ''
  assign labels = 'Bangladesh|Belgium|Brazil|Canada|China|Dubai|Germany|India|Indonesia|Kenya|Nigeria|Pakistan|Philippines|Portugal|South Africa|Thailand|Turkey|USA|Vietnam' | split: '|'
  assign xs = '75.1|51.2|36.7|20.6|78.9|65.4|52.9|71.9|81.6|60.5|52.4|69.3|83.8|47.7|57.0|77.9|59.8|22.6|80.1' | split: '|'
  assign ys = '36.8|21.7|58.8|18.9|30.6|36.0|21.6|38.6|50.4|50.7|44.9|33.1|42.8|28.1|66.1|41.2|28.3|27.9|42.2' | split: '|'
%}
{% if mode == 'pins' %}
  {% for label in labels %}
    {% assign idx = forloop.index0 %}
    <li class="vs-people__pin" style="left:{{ xs[idx] }}%;top:{{ ys[idx] }}%;" title="{{ label | escape }}">
      <img src="{{ pin_icon }}" alt="" width="18" height="18" decoding="async">
      <span>{{ label }}</span>
    </li>
  {% endfor %}
{% else %}
[
  {% for label in labels %}
    {% assign idx = forloop.index0 %}
    {"label":{{ label | json }},"x":{{ xs[idx] }},"y":{{ ys[idx] }}}{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
{% endif %}
