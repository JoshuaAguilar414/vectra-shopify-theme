{%- doc -%}
  Approved unique locations from Associates Locations.xlsx (one blue pin per place).
  Muhammad Noman omitted — no location provided.
  Coordinates are % of the dotted map asset (vectra-story-map-base.png).
  @param {string} [mode] - "json" (default) or "pins"
  @param {string} [img_pin] - Pin icon URL when mode is pins
{%- enddoc -%}
{% liquid
  assign mode = mode | default: 'json'
  assign pin_icon = img_pin | default: ''
  assign labels = 'Canada|USA|Brazil|Portugal|Belgium|Germany|Turkey|Nigeria|Kenya|South Africa|Dubai|Pakistan|India|Bangladesh|China|Thailand|Vietnam|Philippines|Indonesia' | split: '|'
  assign xs = '20.5|23.5|34.2|45.2|49.8|51.6|57.4|50.6|57.2|54.0|61.8|65.8|68.6|72.8|76.8|74.8|77.2|80.6|78.8' | split: '|'
  assign ys = '21.0|33.5|58.5|32.0|24.2|24.0|30.8|46.2|52.2|66.0|38.2|35.2|42.0|39.0|32.8|45.0|43.2|45.8|55.0' | split: '|'
%}
{% if mode == 'pins' %}
  {% for label in labels %}
    {% assign idx = forloop.index0 %}
    <li class="vs-people__pin" style="left:{{ xs[idx] }}%;top:{{ ys[idx] }}%;" title="{{ label | escape }}">
      <img src="{{ pin_icon }}" alt="" width="18" height="24" decoding="async">
      <span>{{ label }}</span>
    </li>
  {% endfor %}
{% else %}
[
  {% for label in labels %}
    {% assign idx = forloop.index0 %}
    {"label":{{ label | json }},"x":{{ xs[idx] }},"y":{{ ys[idx] }}}{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
{% endif %}
