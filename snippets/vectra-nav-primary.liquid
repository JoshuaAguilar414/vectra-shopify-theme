{%- doc -%}
  Homepage V2 nav: INSIDE VECTRA, How We Help, Marketplace, Resources, FAQ.
  Uses Shopify mega-menu children when those top-level links exist.
{%- enddoc -%}

{% liquid
  assign nav_about = blank
  assign nav_help = blank
  assign nav_market = blank
  assign nav_res = blank
  assign nav_faq = blank
  if mega != blank and mega.links.size > 0
    for link in mega.links
      assign nav_t = link.title | downcase
      if nav_t contains 'inside' or nav_t contains 'about' or nav_t contains 'dna' or nav_t contains 'company'
        assign nav_about = link
      elsif nav_t contains 'help'
        assign nav_help = link
      elsif nav_t contains 'market'
        assign nav_market = link
      elsif nav_t contains 'resource'
        assign nav_res = link
      elsif nav_t contains 'faq'
        assign nav_faq = link
      endif
    endfor
  endif
%}

{% if nav_about != blank %}
  {% render 'vectra-mega-item', link: nav_about, mode: mode %}
{% elsif mode == 'mobile' %}
  <div class="vh-nav-panel__item has-children">
    <button type="button" data-vh-mobile-sub aria-expanded="false">INSIDE VECTRA</button>
    <div class="vh-nav-panel__sub">
      <a href="{{ story }}">Our Company</a>
      <a href="{{ story }}#leadership">Our Leadership Team</a>
      <a href="{{ experts }}">Our Experts</a>
      <a href="{{ associates }}">Associates</a>
      <a href="{{ interns }}">Our Interns</a>
    </div>
  </div>
{% else %}
  <div class="vh-menu__item has-children" data-vh-mega-item>
    <div class="vh-menu__anchor">
      <a href="{{ story }}" aria-haspopup="true" aria-expanded="false">INSIDE VECTRA</a>
      <div class="vh-mega vh-mega--list vh-dropdown" role="menu">
        <ul class="vh-mega__list">
          <li><a href="{{ story }}" role="menuitem">Our Company</a></li>
          <li><a href="{{ story }}#leadership" role="menuitem">Our Leadership Team</a></li>
          <li><a href="{{ experts }}" role="menuitem">Our Experts</a></li>
          <li><a href="{{ associates }}" role="menuitem">Associates</a></li>
          <li><a href="{{ interns }}" role="menuitem">Our Interns</a></li>
        </ul>
      </div>
    </div>
  </div>
{% endif %}

{% if nav_help != blank %}
  {% render 'vectra-mega-item', link: nav_help, mode: mode %}
{% elsif mode == 'mobile' %}
  <a href="{{ solutions }}">How We Help</a>
{% else %}
  <div class="vh-menu__item">
    <a href="{{ solutions }}">How We Help</a>
  </div>
{% endif %}

{% if nav_market != blank %}
  {% render 'vectra-mega-item', link: nav_market, mode: mode %}
{% elsif mode == 'mobile' %}
  <a href="{{ marketplace }}">Marketplace</a>
{% else %}
  <div class="vh-menu__item">
    <a href="{{ marketplace }}">Marketplace</a>
  </div>
{% endif %}

{% if nav_res != blank %}
  {% render 'vectra-mega-item', link: nav_res, mode: mode %}
{% elsif mode == 'mobile' %}
  <div class="vh-nav-panel__item has-children">
    <button type="button" data-vh-mobile-sub aria-expanded="false">Resources</button>
    <div class="vh-nav-panel__sub">
      <a href="{{ resources }}#insights">Insights</a>
      <a href="{{ resources }}#ebooks">Ebooks &amp; Playbooks</a>
      <a href="{{ resources }}#events">Events &amp; Webinars</a>
      <a href="{{ resources }}#vcasts">VCASTs</a>
      <a href="{{ resources }}#case-studies">Case Studies</a>
      <a href="{{ resources }}#press">Press Releases</a>
    </div>
  </div>
{% else %}
  <div class="vh-menu__item has-children" data-vh-mega-item>
    <div class="vh-menu__anchor">
      <a href="{{ resources }}" aria-haspopup="true" aria-expanded="false">Resources</a>
      <div class="vh-mega vh-mega--list vh-dropdown" role="menu">
        <ul class="vh-mega__list">
          <li><a href="{{ resources }}#insights" role="menuitem">Insights</a></li>
          <li><a href="{{ resources }}#ebooks" role="menuitem">Ebooks &amp; Playbooks</a></li>
          <li><a href="{{ resources }}#events" role="menuitem">Events &amp; Webinars</a></li>
          <li><a href="{{ resources }}#vcasts" role="menuitem">VCASTs</a></li>
          <li><a href="{{ resources }}#case-studies" role="menuitem">Case Studies</a></li>
          <li><a href="{{ resources }}#press" role="menuitem">Press Releases</a></li>
        </ul>
      </div>
    </div>
  </div>
{% endif %}

{% if nav_faq != blank %}
  {% render 'vectra-mega-item', link: nav_faq, mode: mode %}
{% elsif mode == 'mobile' %}
  <a href="{{ faq }}">FAQ</a>
{% else %}
  <div class="vh-menu__item">
    <a href="{{ faq }}">FAQ</a>
  </div>
{% endif %}
