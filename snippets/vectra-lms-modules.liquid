{%- doc -%}
  VECTRA Academy LMS screens (Shopify theme).
  @param {string} module - overview | participants | users | courses | reports | settings | dashboard | my-courses | profile
  @param {object} block - theme block settings
{%- enddoc -%}

{% render 'vectra-lms-access' %}

{% liquid
  assign screen = module | default: block.settings.screen | default: 'overview'
  assign require_staff = false
  if screen == 'overview' or screen == 'participants' or screen == 'users' or screen == 'courses' or screen == 'reports' or screen == 'settings'
    assign require_staff = true
  endif
  assign show_gate = false
  assign show_content = true
  if require_staff and vlms_is_staff == false and block.settings.preview_without_gate == false
    assign show_gate = true
    assign show_content = false
  endif
  if require_staff == false and vlms_logged_in == false and block.settings.preview_without_gate == false
    assign show_gate = true
    assign show_content = false
  endif
  assign vlms_api_base = block.settings.api_base | default: '/apps/lms/api'
  assign vlms_tags = customer.tags | join: ','
%}

<section
  class="vectra-lms"
  data-vectra-lms
  data-vlms-screen="{{ screen }}"
  data-vlms-api-base="{{ vlms_api_base | escape }}"
  data-vlms-shop="{{ shop.permanent_domain | escape }}"
  data-vlms-customer-id="{{ customer.id | escape }}"
  data-vlms-customer-tags="{{ vlms_tags | escape }}"
  data-vlms-staff="{% if vlms_is_staff %}true{% else %}false{% endif %}"
  {{ block.shopify_attributes }}
>
  {% if require_staff %}
    {% render 'vectra-lms-nav', active: screen, staff: true %}
  {% else %}
    {% render 'vectra-lms-nav', active: screen, staff: false %}
  {% endif %}

  <div class="vlms-wrap vlms-main">
    <p class="vlms-note" data-vlms-note hidden></p>

    {% if show_gate %}
      <div class="vlms-card vlms-gate">
        {% if require_staff %}
          <h1 class="vlms-title">Staff access required</h1>
          <p class="vlms-lead">
            Sign in with a Shopify customer account tagged <code>lms-admin</code> or <code>lms-coordinator</code> to manage VECTRA Academy.
          </p>
        {% else %}
          <h1 class="vlms-title">Sign in to learn</h1>
          <p class="vlms-lead">Use your Shopify customer account to open your VECTRA Academy dashboard and courses.</p>
        {% endif %}
        <div class="vlms-actions" style="justify-content: center;">
          {% if vlms_logged_in %}
            <a class="vlms-btn vlms-btn--ghost" href="{{ routes.account_url }}">Account</a>
          {% else %}
            <a class="vlms-btn" href="{{ routes.account_login_url }}">Log in with Shopify</a>
          {% endif %}
        </div>
        {% if request.design_mode %}
          <p class="vlms-note">Theme editor: enable “Preview without gate” on this block to edit the screen layout while logged out.</p>
        {% endif %}
      </div>
    {% endif %}

    {% if show_content or block.settings.preview_without_gate %}
      {% case screen %}
        {% when 'overview' %}
          <h1 class="vlms-title">{{ block.settings.heading | default: 'Training overview' }}</h1>
          <p class="vlms-lead">{{ block.settings.text | default: 'Program health across learners, assignments, and completions.' }}</p>

          <div class="vlms-pills" data-vlms-period>
            <button type="button" class="vlms-pill is-active" data-period="all">All time</button>
            <button type="button" class="vlms-pill" data-period="week">This week</button>
            <button type="button" class="vlms-pill" data-period="month">This month</button>
            <button type="button" class="vlms-pill" data-period="year">This year</button>
          </div>

          <div class="vlms-grid">
            <article class="vlms-card vlms-stat">
              <span class="vlms-stat__value" data-vlms-stat="learners">0</span>
              <span class="vlms-stat__label" data-vlms-stat="learners-detail">Learners</span>
            </article>
            <article class="vlms-card vlms-stat">
              <span class="vlms-stat__value" data-vlms-stat="assignments">0</span>
              <span class="vlms-stat__label" data-vlms-stat="assignments-detail">Assignments</span>
            </article>
            <article class="vlms-card vlms-stat">
              <span class="vlms-stat__value" data-vlms-stat="started">0</span>
              <span class="vlms-stat__label" data-vlms-stat="started-detail">Started</span>
            </article>
            <article class="vlms-card vlms-stat">
              <span class="vlms-stat__value" data-vlms-stat="completed">0</span>
              <span class="vlms-stat__label" data-vlms-stat="completed-detail">Completed</span>
            </article>
          </div>

          <div class="vlms-grid vlms-grid--2">
            <article class="vlms-card">
              <h2>Course progress</h2>
              <p>Current status across every active assignment.</p>
              <div class="vlms-actions">
                <a class="vlms-btn vlms-btn--ghost" href="/marketplace/lms/reports">Open reports</a>
              </div>
            </article>
            <article class="vlms-card">
              <h2>Recommended onboarding</h2>
              <p>1. Import participant roster · 2. Publish courses · 3. Invite learners · 4. Assign training · 5. Export CSV</p>
              <div class="vlms-actions">
                <a class="vlms-btn" href="/marketplace/lms/participants">Open participant roster</a>
                <a class="vlms-btn vlms-btn--ghost" href="/marketplace/lms/users">Manage learners</a>
                <a class="vlms-btn vlms-btn--ghost" href="/marketplace/lms/courses">Manage courses</a>
              </div>
            </article>
          </div>

        {% when 'participants' %}
          <h1 class="vlms-title">{{ block.settings.heading | default: 'Participant roster' }}</h1>
          <p class="vlms-lead">{{ block.settings.text | default: 'Approved Facilities and Business Partners. Learners can only be invited when their Company ID matches this roster.' }}</p>

          <div class="vlms-grid vlms-grid--3">
            <article class="vlms-card vlms-stat"><span class="vlms-stat__value" data-vlms-count="orgs">0</span><span class="vlms-stat__label">Approved organizations</span></article>
            <article class="vlms-card vlms-stat"><span class="vlms-stat__value" data-vlms-count="facilities">0</span><span class="vlms-stat__label">Facilities</span></article>
            <article class="vlms-card vlms-stat"><span class="vlms-stat__value" data-vlms-count="partners">0</span><span class="vlms-stat__label">Business Partners</span></article>
          </div>

          <div class="vlms-split">
            <article class="vlms-card">
              <h2>Add organization</h2>
              <form class="vlms-form" data-vlms-participant-form>
                <div class="vlms-field">
                  <label for="vlms-stakeholder">Stakeholder group *</label>
                  <select id="vlms-stakeholder" name="stakeholderGroup" required>
                    <option value="Facility">Facility</option>
                    <option value="Business Partner">Business Partner</option>
                  </select>
                </div>
                <div class="vlms-field">
                  <label for="vlms-company">Company ID *</label>
                  <input id="vlms-company" name="companyId" required autocomplete="off">
                </div>
                <div class="vlms-field">
                  <label for="vlms-name">Organization name *</label>
                  <input id="vlms-name" name="name" required autocomplete="organization">
                </div>
                <div class="vlms-field">
                  <label for="vlms-belongs">Belongs to BP</label>
                  <input id="vlms-belongs" name="belongsToBp" autocomplete="off">
                </div>
                <div class="vlms-field">
                  <label for="vlms-country">Country</label>
                  <input id="vlms-country" name="country" autocomplete="country-name">
                </div>
                <div class="vlms-field">
                  <label for="vlms-topic">Topic</label>
                  <input id="vlms-topic" name="topic" value="Freely Chosen Employment">
                </div>
                <div class="vlms-field">
                  <label for="vlms-provider">Nominated provider</label>
                  <input id="vlms-provider" name="nominatedProvider" value="VECTRA">
                </div>
                <button class="vlms-btn" type="submit">Add to roster</button>
              </form>
            </article>
            <article class="vlms-card">
              <h2>Import roster</h2>
              <p>CSV / XLSX. Required columns: Stakeholder, ID, Name, Belongs to BP, Country, Topic, Nominated Provider.</p>
              <div class="vlms-actions">
                <label class="vlms-btn vlms-btn--ghost">
                  Import CSV / XLSX
                  <input type="file" accept=".csv,.xlsx" data-vlms-participant-import hidden>
                </label>
              </div>
            </article>
          </div>

          <article class="vlms-card">
            <h2>Roster</h2>
            <div class="vlms-table-wrap">
              <table class="vlms-table" data-vlms-participant-table>
                <thead>
                  <tr>
                    <th>Stakeholder</th>
                    <th>Company ID</th>
                    <th>Organization</th>
                    <th>Country</th>
                    <th>Topic</th>
                    <th>Provider</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="vlms-empty-row"><td colspan="7" class="vlms-empty">Loading…</td></tr>
                </tbody>
              </table>
            </div>
          </article>

        {% when 'users' %}
          <h1 class="vlms-title">{{ block.settings.heading | default: 'Users' }}</h1>
          <p class="vlms-lead">{{ block.settings.text | default: 'Invite learners linked to the participant roster. Staff use lms-admin / lms-coordinator tags plus staffProfiles.' }}</p>

          <div class="vlms-split">
            <article class="vlms-card">
              <h2>Invite learner</h2>
              <form class="vlms-form" data-vlms-user-form>
                <div class="vlms-field">
                  <label for="vlms-user-name">Full name *</label>
                  <input id="vlms-user-name" name="name" required>
                </div>
                <div class="vlms-field">
                  <label for="vlms-user-email">Corporate email *</label>
                  <input id="vlms-user-email" name="email" type="email" required>
                </div>
                <div class="vlms-field">
                  <label for="vlms-user-company">Company ID *</label>
                  <input id="vlms-user-company" name="companyId" required>
                </div>
                <div class="vlms-field">
                  <label for="vlms-user-stakeholder">Stakeholder group *</label>
                  <select id="vlms-user-stakeholder" name="stakeholderGroup" required>
                    <option value="Facility">Facility</option>
                    <option value="Business Partner">Business Partner</option>
                  </select>
                </div>
                <div class="vlms-field">
                  <label for="vlms-user-org">Organizational name *</label>
                  <input id="vlms-user-org" name="facilityTraining" required>
                </div>
                <button class="vlms-btn" type="submit">Invite learner</button>
              </form>
            </article>
            <article class="vlms-card">
              <h2>Assign course</h2>
              <form class="vlms-form" data-vlms-assign-form>
                <div class="vlms-field">
                  <label for="vlms-assign-user">Learner profile ID *</label>
                  <input id="vlms-assign-user" name="userId" required placeholder="Mongo ObjectId from table">
                </div>
                <div class="vlms-field">
                  <label for="vlms-assign-course">Course *</label>
                  <select id="vlms-assign-course" name="courseId" data-vlms-assign-course required>
                    <option value="">Select course</option>
                  </select>
                </div>
                <button class="vlms-btn" type="submit">Assign</button>
              </form>
            </article>
          </div>

          <article class="vlms-card">
            <h2>Learners</h2>
            <div class="vlms-table-wrap">
              <table class="vlms-table" data-vlms-user-table>
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Organization</th>
                    <th>Status</th>
                    <th>Courses</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td colspan="7" class="vlms-empty">Loading…</td></tr>
                </tbody>
              </table>
            </div>
          </article>

        {% when 'courses' %}
          <h1 class="vlms-title">{{ block.settings.heading | default: 'Courses' }}</h1>
          <p class="vlms-lead">{{ block.settings.text | default: 'Upload SCORM 1.2 packages. Optional product metafield lms.course_id for Marketplace linking.' }}</p>

          <article class="vlms-card">
            <h2>Upload SCORM package</h2>
            <form class="vlms-form" data-vlms-course-form enctype="multipart/form-data">
              <div class="vlms-field">
                <label for="vlms-course-title">Title *</label>
                <input id="vlms-course-title" name="title" required>
              </div>
              <div class="vlms-field">
                <label for="vlms-course-desc">Description</label>
                <textarea id="vlms-course-desc" name="description" rows="3"></textarea>
              </div>
              <div class="vlms-field">
                <label for="vlms-course-file">SCORM ZIP *</label>
                <input id="vlms-course-file" name="file" type="file" accept=".zip,application/zip" required>
              </div>
              <button class="vlms-btn" type="submit">Upload course</button>
            </form>
          </article>

          <article class="vlms-card">
            <h2>Published courses</h2>
            <div class="vlms-table-wrap">
              <table class="vlms-table" data-vlms-course-table>
                <thead>
                  <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Package</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td colspan="4" class="vlms-empty">Loading…</td></tr>
                </tbody>
              </table>
            </div>
          </article>

        {% when 'reports' %}
          <h1 class="vlms-title">{{ block.settings.heading | default: 'Reports' }}</h1>
          <p class="vlms-lead">{{ block.settings.text | default: 'Progress table and CSV export from assignment data.' }}</p>
          <div class="vlms-actions">
            <button type="button" class="vlms-btn" data-vlms-export-csv>Export CSV</button>
          </div>
          <article class="vlms-card">
            <div class="vlms-table-wrap">
              <table class="vlms-table" data-vlms-report-table>
                <thead>
                  <tr>
                    <th>Learner</th>
                    <th>Organization</th>
                    <th>Course</th>
                    <th>Status</th>
                    <th>Progress</th>
                    <th>Completed</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td colspan="6" class="vlms-empty">Loading…</td></tr>
                </tbody>
              </table>
            </div>
          </article>

        {% when 'settings' %}
          <h1 class="vlms-title">{{ block.settings.heading | default: 'Settings' }}</h1>
          <p class="vlms-lead">{{ block.settings.text | default: 'Field definitions and roles for this shop.' }}</p>
          <div class="vlms-grid vlms-grid--2">
            <article class="vlms-card">
              <h2>Field definitions</h2>
              <ul data-vlms-fields-list><li class="vlms-empty">Loading…</li></ul>
            </article>
            <article class="vlms-card">
              <h2>Roles</h2>
              <ul data-vlms-roles-list><li class="vlms-empty">Loading…</li></ul>
            </article>
          </div>

        {% when 'dashboard' %}
          <h1 class="vlms-title">{{ block.settings.heading | default: 'Your learning' }}</h1>
          <p class="vlms-lead">{{ block.settings.text | default: 'Assigned, in progress, and completed counts for your account.' }}</p>
          <div class="vlms-grid vlms-grid--3">
            <article class="vlms-card vlms-stat"><span class="vlms-stat__value" data-vlms-learner-stat="assigned">0</span><span class="vlms-stat__label">Assigned</span></article>
            <article class="vlms-card vlms-stat"><span class="vlms-stat__value" data-vlms-learner-stat="progress">0</span><span class="vlms-stat__label">In progress</span></article>
            <article class="vlms-card vlms-stat"><span class="vlms-stat__value" data-vlms-learner-stat="completed">0</span><span class="vlms-stat__label">Completed</span></article>
          </div>
          <div class="vlms-actions">
            <a class="vlms-btn" href="/marketplace/lms/my-courses">Go to My courses</a>
          </div>

        {% when 'my-courses' %}
          <h1 class="vlms-title">{{ block.settings.heading | default: 'My courses' }}</h1>
          <p class="vlms-lead">{{ block.settings.text | default: 'Start, continue, or review assigned training.' }}</p>
          <div data-vlms-my-courses>
            <article class="vlms-card"><div class="vlms-empty">Loading…</div></article>
          </div>

        {% when 'profile' %}
          <h1 class="vlms-title">{{ block.settings.heading | default: 'Profile' }}</h1>
          <p class="vlms-lead">Password and email changes stay in Shopify Customer Accounts.</p>
          <article class="vlms-card">
            <p><strong>Email:</strong> {{ customer.email | default: '—' }}</p>
            <p><strong>Name:</strong> {{ customer.name | default: customer.first_name | default: '—' }}</p>
            <div class="vlms-actions">
              <a class="vlms-btn vlms-btn--ghost" href="{{ routes.account_url }}">Shopify account settings</a>
            </div>
          </article>

        {% when 'learn' %}
          <div class="vlms-player" data-vlms-player>
            <div class="vlms-player__toolbar">
              <div>
                <strong data-vlms-player-title>Loading course…</strong>
                <span class="vlms-player__status" data-vlms-player-status>Preparing</span>
              </div>
              <div class="vlms-actions">
                <button type="button" class="vlms-btn vlms-btn--ghost" data-vlms-player-save>Save now</button>
                <a class="vlms-btn vlms-btn--ghost" href="/marketplace/lms/my-courses">Exit course</a>
              </div>
            </div>
            <div class="vlms-player__frame-wrap">
              <div class="vlms-player__loading" data-vlms-player-loading>Loading course package…</div>
              <iframe class="vlms-player__frame" data-vlms-player-frame title="SCORM course" allow="fullscreen"></iframe>
            </div>
          </div>
          <script src="{{ 'vectra-scorm-progress-bridge.js' | asset_url }}" defer></script>
          <script src="{{ 'vectra-lms-player.js' | asset_url }}" defer></script>
      {% endcase %}
    {% endif %}
  </div>
</section>
