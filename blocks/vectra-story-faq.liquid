{% liquid
  assign join_eyebrow = 'Join a Team That Values What You Bring'
  assign join_title = 'Be part of a global team'
  assign join_btn = block.settings.join_button_label | default: 'View Open Positions'
  if block.settings.join_button_link != blank
    assign join_cta = block.settings.join_button_link
  else
    assign join_cta = pages['job-openings'].url | default: pages['careers'].url | default: '/pages/job-openings'
  endif
  assign img_arrow = 'vectra-33469c114cd0dac188b171519c338a0fcdfa79a7.svg' | asset_url
  assign img_team = 'vectra-team-icon.svg' | asset_url
%}
{% unless block.settings.hide_section %}
<section class="vh-faq vh-faq--story" id="about-faq" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap vh-faq__grid">
    <aside class="vh-contact-card vh-contact-card--join" id="careers">
      <p class="vh-contact-card__kicker">{{ join_eyebrow }}</p>
      <img class="vh-contact-card__icon" src="{{ img_team }}" alt="" width="64" height="64">
      <p class="vh-contact-card__title vh-contact-card__title--accent">{{ join_title }}</p>
      <p>We look for people who care about doing meaningful work well, who bring their own perspective, and who are willing to listen to someone else’s.</p>
      <p>You will work with colleagues and specialists across countries, cultures, disciplines, and time zones. You will learn from them, challenge them, and bring something of your own to the team.</p>
      <p>We value people who take ownership, stay curious, speak up respectfully, and care whether what we do makes a positive difference.</p>
      <p>Bring your judgment, your experience, and the questions you think we should be asking.</p>
      <a class="vh-btn vh-btn--white" href="{{ join_cta }}">
        {{ join_btn }}
        <img src="{{ img_arrow }}" alt="">
      </a>
    </aside>
    <div class="vh-faq__right">
      <div class="vh-faq__glow" aria-hidden="true"></div>
      <div class="vh-accordion" data-vh-faq-accordion>
        <p class="vh-kicker">{{ block.settings.kicker | default: 'FAQ' }}</p>
        <h2 class="vh-h2">{{ block.settings.heading | default: 'Questions About VECTRA International' }}</h2>
        <p class="vh-lead">{{ block.settings.lead | default: 'Answers about who we are, how we work, and where we operate.' }}</p>
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</section>
{% endunless %}

{% schema %}
{
  "name": "VECTRA: Story FAQ",
  "tag": null,
  "blocks": [
    {
      "type": "_vectra-faq-item"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Join team card (left)"
    },
    {
      "type": "text",
      "id": "join_button_label",
      "label": "Join button label",
      "default": "View Open Positions"
    },
    {
      "type": "url",
      "id": "join_button_link",
      "label": "Join button link"
    },
    {
      "type": "header",
      "content": "FAQ"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions About VECTRA International"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Answers about who we are, how we work, and where we operate."
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "select",
      "id": "background_attachment",
      "label": "Background attachment",
      "options": [
        { "value": "scroll", "label": "Scroll" },
        { "value": "fixed", "label": "Fixed" }
      ],
      "default": "scroll"
    }
  ],
  "presets": [
    {
      "name": "VECTRA: Story FAQ",
      "category": "VECTRA",
      "blocks": [
        { "type": "_vectra-faq-item" },
        { "type": "_vectra-faq-item" },
        { "type": "_vectra-faq-item" }
      ]
    }
  ]
}
{% endschema %}
