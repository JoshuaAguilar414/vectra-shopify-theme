{% unless block.settings.hide_section %}
<section class="vh-faq vh-faq--story vh-faq--story-full" id="about-faq" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap vh-faq__grid">
    <div class="vh-faq__right">
      <div class="vh-faq__glow" aria-hidden="true"></div>
      <div class="vh-accordion" data-vh-faq-accordion>
        <p class="vh-kicker">{{ block.settings.kicker | default: 'FAQ' }}</p>
        <h2 class="vh-h2">{{ block.settings.heading | default: 'Questions About VECTRA International' }}</h2>
        <p class="vh-lead">{{ block.settings.lead | default: 'Answers about who we are, how we work, and where we operate.' }}</p>
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</section>
{% endunless %}

{% schema %}
{
  "name": "VECTRA: Story FAQ",
  "tag": null,
  "blocks": [
    {
      "type": "_vectra-faq-item"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "FAQ"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions About VECTRA International"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Answers about who we are, how we work, and where we operate."
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "select",
      "id": "background_attachment",
      "label": "Background attachment",
      "options": [
        { "value": "scroll", "label": "Scroll" },
        { "value": "fixed", "label": "Fixed" }
      ],
      "default": "scroll"
    }
  ],
  "presets": [
    {
      "name": "VECTRA: Story FAQ",
      "category": "VECTRA",
      "blocks": [
        { "type": "_vectra-faq-item" },
        { "type": "_vectra-faq-item" },
        { "type": "_vectra-faq-item" }
      ]
    }
  ]
}
{% endschema %}
