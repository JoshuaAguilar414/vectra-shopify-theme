{% liquid
  assign join_kicker = block.settings.join_kicker | default: 'BE PART OF A GLOBAL TEAM'
  assign join_heading = block.settings.join_heading | default: 'Join a Team That Values What You Bring'
  assign join_text = block.settings.join_text
  if join_text == blank
    assign join_text = "We look for people who care about doing meaningful work well, who bring their own perspective, and who are willing to listen to someone else’s.\n\nYou will work with colleagues and specialists across countries, cultures, disciplines, and time zones. You will learn from them, challenge them, and bring something of your own to the team.\n\nWe value people who take ownership, stay curious, speak up respectfully, and care whether what we do makes a positive difference.\n\nBring your judgment, your experience, and the questions you think we should be asking."
  endif
  assign join_btn = block.settings.join_button_label | default: 'View Open Positions'
  if block.settings.join_button_link != blank
    assign join_cta = block.settings.join_button_link
  else
    assign join_cta = pages['job-openings'].url | default: pages['careers'].url | default: '/pages/job-openings'
  endif
  assign img_arrow = 'vectra-33469c114cd0dac188b171519c338a0fcdfa79a7.svg' | asset_url
  assign img_chat = 'vectra-da137306dcbc6716d83295ef75678ab141a500e1.svg' | asset_url
%}
{% unless block.settings.hide_section %}
<section class="vh-faq vh-faq--story" id="about-faq" style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-wrap vh-faq__grid">
    <aside class="vh-contact-card" id="careers">
      <p class="vh-contact-card__kicker">{{ join_kicker }}</p>
      <img class="vh-contact-card__icon" src="{{ img_chat }}" alt="">
      <p class="vh-contact-card__title">{{ join_heading }}</p>
      {% assign join_paras = join_text | newline_to_br | split: '<br />' %}
      {% for para in join_paras %}
        {% assign para_text = para | strip_html | strip %}
        {% if para_text != blank %}
          <p>{{ para_text }}</p>
        {% endif %}
      {% endfor %}
      <a class="vh-btn vh-btn--white" href="{{ join_cta }}">
        {{ join_btn }}
        <img src="{{ img_arrow }}" alt="">
      </a>
    </aside>
    <div class="vh-faq__right">
      <div class="vh-faq__glow" aria-hidden="true"></div>
      <div class="vh-accordion" data-vh-faq-accordion>
        <p class="vh-kicker">{{ block.settings.kicker | default: 'FAQ' }}</p>
        <h2 class="vh-h2">{{ block.settings.heading | default: 'Questions About VECTRA International' }}</h2>
        <p class="vh-lead">{{ block.settings.lead | default: 'Answers about who we are, how we work, and where we operate.' }}</p>
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</section>
{% endunless %}

