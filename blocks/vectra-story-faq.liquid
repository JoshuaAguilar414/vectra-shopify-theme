{% render 'vectra-story-modules', module: 'faq', block: block %}

{% schema %}
{
  "name": "VECTRA: Story FAQ",
  "tag": null,
  "blocks": [
    {
      "type": "_vectra-faq-item"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "FAQ"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions About VECTRA International"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Answers about who we are, how we work, and where we operate."
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "select",
      "id": "background_attachment",
      "label": "Background attachment",
      "options": [
        { "value": "scroll", "label": "Scroll" },
        { "value": "fixed", "label": "Fixed" }
      ],
      "default": "scroll"
    }
  ],
  "presets": [
    {
      "name": "VECTRA: Story FAQ",
      "category": "VECTRA",
      "blocks": [
        { "type": "_vectra-faq-item" },
        { "type": "_vectra-faq-item" },
        { "type": "_vectra-faq-item" }
      ]
    }
  ]
}
{% endschema %}
