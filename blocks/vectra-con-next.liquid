{% capture nested_cards %}
  {% content_for 'blocks' %}
{% endcapture %}
{% render 'vectra-contact-modules', module: 'next', block: block, nested_cards: nested_cards %}

{% schema %}
{
  "name": "VECTRA: Contact next",
  "tag": null,
  "blocks": [
    {
      "type": "_vectra-why-card"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "WHAT HAPPENS NEXT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You Send the Context. We Work Out the Next Move Together."
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "VECTRA: Contact next",
      "blocks": [
        {
          "type": "_vectra-why-card",
          "settings": {
            "heading": "01 — Tell Us What's Happening",
            "text": "Share what you already know — a recurring issue, an audit finding, a customer or regulatory requirement, supplier data, an internal process, or something that simply isn’t working as expected. You don’t need to turn it into a formal brief first."
          }
        },
        {
          "type": "_vectra-why-card",
          "settings": {
            "heading": "02 — We Bring in the Relevant Expertise",
            "text": "We review what you’ve shared and bring in the VECTRA International specialists whose experience best fits the issue — in ESG, supply chain resilience, audit, or operational capability building. You won’t have to re-explain the problem through several layers before reaching someone who understands the work."
          }
        },
        {
          "type": "_vectra-why-card",
          "settings": {
            "heading": "03 — Agree on the Most Useful Next Step",
            "text": "The first useful step might be a focused assessment, specialist support, implementation work, capability building, or simply a clearer direction. We agree on that together, rather than assuming the answer before we understand the situation."
          }
        }
      ]
    }
  ]
}
{% endschema %}
