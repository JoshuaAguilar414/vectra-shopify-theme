{% capture people_cards %}
  {% content_for 'blocks' %}
{% endcapture %}
{% render 'vectra-people-modules', module: block.settings.page_type, block: block, people_cards: people_cards %}

{% schema %}
{
  "name": "VECTRA: People page",
  "tag": null,
  "blocks": [
    { "type": "_vectra-person" },
    { "type": "_vectra-faq-item" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "page_type",
      "label": "Page",
      "options": [
        { "value": "experts", "label": "Experts" },
        { "value": "associates", "label": "Associates" },
        { "value": "interns", "label": "Interns" },
        { "value": "careers", "label": "Careers" },
        { "value": "faq", "label": "FAQ" }
      ],
      "default": "experts"
    },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Lead" },
    {
      "type": "url",
      "id": "jobs_url",
      "label": "External careers / jobs URL",
      "info": "Used on the Careers page until a Shopify jobs board is available."
    },
    { "type": "header", "content": "Careers columns" },
    { "type": "text", "id": "col_1_heading", "label": "Column 1 heading", "default": "How we work" },
    { "type": "textarea", "id": "col_1_text", "label": "Column 1 text" },
    { "type": "text", "id": "col_2_heading", "label": "Column 2 heading", "default": "Who we welcome" },
    { "type": "textarea", "id": "col_2_text", "label": "Column 2 text" },
    { "type": "text", "id": "col_3_heading", "label": "Column 3 heading", "default": "Become a consultant" },
    { "type": "textarea", "id": "col_3_text", "label": "Column 3 text" },
    { "type": "header", "content": "FAQ side card" },
    { "type": "text", "id": "card_title", "label": "Side card title", "default": "Still need a person?" },
    { "type": "textarea", "id": "card_text", "label": "Side card text" },
    { "type": "header", "content": "Page CTAs" },
    { "type": "text", "id": "cta_label", "label": "Primary button label" },
    { "type": "url", "id": "cta_link", "label": "Primary button link", "info": "Leave blank to use the mailto / jobs defaults for this page type." },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary button label", "default": "Explore internships" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary button link" },
    { "type": "header", "content": "Experts face stack" },
    { "type": "image_picker", "id": "face_1", "label": "Face 1" },
    { "type": "image_picker", "id": "face_2", "label": "Face 2" },
    { "type": "image_picker", "id": "face_3", "label": "Face 3" },
    { "type": "image_picker", "id": "face_4", "label": "Face 4" },
    { "type": "header", "content": "Fallback profiles (used if no Person blocks are added)" },
    { "type": "text", "id": "name_1", "label": "Profile 1 name" },
    { "type": "textarea", "id": "bio_1", "label": "Profile 1 bio" },
    { "type": "image_picker", "id": "image_1", "label": "Profile 1 photo" },
    { "type": "text", "id": "name_2", "label": "Profile 2 name" },
    { "type": "textarea", "id": "bio_2", "label": "Profile 2 bio" },
    { "type": "image_picker", "id": "image_2", "label": "Profile 2 photo" },
    { "type": "text", "id": "name_3", "label": "Profile 3 name" },
    { "type": "textarea", "id": "bio_3", "label": "Profile 3 bio" },
    { "type": "image_picker", "id": "image_3", "label": "Profile 3 photo" },
    { "type": "text", "id": "name_4", "label": "Profile 4 name" },
    { "type": "textarea", "id": "bio_4", "label": "Profile 4 bio" },
    { "type": "image_picker", "id": "image_4", "label": "Profile 4 photo" }
  ],
  "presets": [{ "name": "VECTRA: People page" }]
}
{% endschema %}
