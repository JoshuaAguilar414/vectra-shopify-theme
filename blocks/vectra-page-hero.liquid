{%- doc -%}
  Interior page hero shared by VECTRA subpages (green gradient, not the homepage carousel).
{%- enddoc -%}

{% liquid
  assign heading = block.settings.heading
  if heading == blank
    assign heading = page.title | default: shop.name
  endif
%}

<section class="vh-page-hero{% if block.settings.image != blank %} has-image{% endif %}" {{ block.shopify_attributes }}>
  {% if block.settings.image != blank %}
    {{
      block.settings.image
      | image_url: width: 2400
      | image_tag: class: 'vh-page-hero__bg', loading: 'eager', alt: ''
    }}
  {% endif %}
  <div class="vh-wrap vh-page-hero__inner">
    {% if block.settings.kicker != blank %}
      <p class="vh-page-hero__kicker">{{ block.settings.kicker }}</p>
    {% endif %}
    <h1>{{ heading }}</h1>
    {% if block.settings.text != blank %}
      <div class="vh-page-hero__text">{{ block.settings.text }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "VECTRA: Page hero",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Optional. Sits over the green gradient."
    }
  ],
  "presets": [{ "name": "VECTRA: Page hero" }]
}
{% endschema %}
