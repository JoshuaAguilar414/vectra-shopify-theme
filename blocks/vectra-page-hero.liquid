{%- doc -%}
  Interior page hero shared by VECTRA subpages (green gradient, not the homepage carousel).
{%- enddoc -%}

{% liquid
  assign heading = block.settings.heading
  if heading == blank
    assign heading = page.title | default: shop.name
  endif
%}

<section class="vh-page-hero" {{ block.shopify_attributes }}>
  <div class="vh-wrap vh-page-hero__inner">
    {% if block.settings.kicker != blank %}
      <p class="vh-page-hero__kicker">{{ block.settings.kicker }}</p>
    {% endif %}
    <h1>{{ heading }}</h1>
    {% if block.settings.text != blank %}
      <div class="vh-page-hero__text">{{ block.settings.text }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "VECTRA: Page hero",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [{ "name": "VECTRA: Page hero" }]
}
{% endschema %}
