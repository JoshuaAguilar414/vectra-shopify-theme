{%- doc -%}
  Interior page hero shared by VECTRA subpages (green gradient, not the homepage carousel).
{%- enddoc -%}

{% liquid
  assign heading = block.settings.heading
  if heading == blank
    assign heading = page.title | default: shop.name
  endif
  assign align = block.settings.text_align | default: 'left'
  assign btn_style = block.settings.button_style | default: 'green'
  assign btn2_style = block.settings.button_2_style | default: 'outline'
%}

{% unless block.settings.hide_section %}
{% capture nested_extras %}
  {% content_for 'blocks' %}
{% endcapture %}
<section
  class="vh-page-hero{% if block.settings.image != blank %} has-image{% endif %}{% if block.settings.background_color != blank %} has-custom-bg{% endif %} vh-page-hero--align-{{ align }}"
  id="{{ block.settings.anchor_id }}"
  style="{% render 'vectra-block-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.image != blank %}
    {{
      block.settings.image
      | image_url: width: 2400
      | image_tag: class: 'vh-page-hero__bg', loading: 'eager', alt: block.settings.image_alt | default: ''
    }}
  {% endif %}
  {% if block.settings.toggle_overlay or block.settings.overlay_opacity != blank %}
    <span
      class="vh-page-hero__overlay{% if block.settings.overlay_style == 'gradient' %} vh-page-hero__overlay--gradient vh-page-hero__overlay--{{ block.settings.gradient_direction | default: 'to-bottom' }}{% endif %}"
      aria-hidden="true"
    ></span>
  {% endif %}
  <div class="vh-wrap vh-page-hero__inner">
    {% if block.settings.kicker != blank %}
      <p class="vh-page-hero__kicker">{{ block.settings.kicker }}</p>
    {% endif %}
    <h1>{{ heading }}</h1>
    {% if block.settings.text != blank %}
      <div class="vh-page-hero__text">{{ block.settings.text }}</div>
    {% endif %}
    {% if block.settings.button_label != blank or block.settings.button_2_label != blank %}
      <div class="vh-page-hero__actions">
        {% if block.settings.button_label != blank %}
          <a
            class="vh-btn vh-btn--{{ btn_style }}"
            href="{{ block.settings.button_link | default: '#VectraContactModal' }}"
            {% if block.settings.button_link == blank or block.settings.button_link == '#VectraContactModal' %}data-vh-contact-open{% endif %}
          >
            {{ block.settings.button_label }}
          </a>
        {% endif %}
        {% if block.settings.button_2_label != blank %}
          <a class="vh-btn vh-btn--{{ btn2_style }}" href="{{ block.settings.button_2_link | default: '#' }}">
            {{ block.settings.button_2_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
    {% assign nested_extras = nested_extras | strip %}
    {% if nested_extras != blank %}
      <div class="vh-page-hero__extras">{{ nested_extras }}</div>
    {% endif %}
  </div>
</section>
{% endunless %}

{% schema %}
