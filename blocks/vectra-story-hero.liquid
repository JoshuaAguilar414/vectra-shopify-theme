{% render 'vectra-story-modules', module: 'hero', block: block %}

{% schema %}
{
  "name": "VECTRA: Story hero",
  "tag": null,
  "settings": [
    { "type": "video", "id": "video", "label": "Background video" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Inside VECTRA" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "VECTRA: Story hero" }]
}
{% endschema %}
