{% render 'vectra-home-modules', module: 'blog', block: block %}

{% schema %}
{
  "name": "VECTRA: Blog",
  "tag": null,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Insights" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest Insights" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See All Insights →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Placeholder cards (used until the blog has posts)" },
    { "type": "image_picker", "id": "image_1", "label": "Card 1 image" },
    { "type": "image_picker", "id": "image_2", "label": "Card 2 image" },
    { "type": "image_picker", "id": "image_3", "label": "Card 3 image" }
  ],
  "presets": [{ "name": "VECTRA: Blog" }]
}
{% endschema %}
