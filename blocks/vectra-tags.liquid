{% render 'vectra-tags', block: block %}

{% schema %}
{
  "name": "VECTRA: Tags",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tags"
    },
    {
      "type": "textarea",
      "id": "tags",
      "label": "Tags",
      "default": "Performance, Development, Solutions, Support, Recruitment, Management, Experience",
      "info": "Comma-separated list."
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "VECTRA: Tags"
    }
  ]
}
{% endschema %}
