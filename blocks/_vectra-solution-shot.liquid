{% liquid
  assign shot_href = block.settings.cta_link
  if shot_href == blank
    assign cta_down = block.settings.cta_label | downcase
    if block.settings.plus_overlay or cta_down contains 'talk'
      assign shot_href = '#VectraContactModal'
    endif
  endif
%}
<button
  class="vh-sol-shot{% if block.settings.plus_overlay %} vh-sol-shot--plus{% endif %}{% if block.settings.is_active %} is-active{% endif %}"
  type="button"
  data-vh-sol-item
  data-title="{{ block.settings.title | escape }}"
  data-text="{{ block.settings.text | escape }}"
  data-cta="{{ block.settings.cta_label | escape }}"
  {% if shot_href != blank %}data-href="{{ shot_href | escape }}"{% endif %}
  {{ block.shopify_attributes }}
>
  {% render 'vectra-image',
    image: block.settings.image,
    fallback: block.settings.fallback_asset,
    alt: block.settings.title,
    image_width: 800
  %}
</button>

{% schema %}
{
  "name": "Solution shot",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "plus_overlay", "label": "Show plus overlay", "default": false },
    { "type": "checkbox", "id": "is_active", "label": "Start as the featured shot", "default": false },
    {
      "type": "text",
      "id": "fallback_asset",
      "label": "Theme fallback image",
      "info": "Filename in the theme assets folder. Used until you upload an image."
    }
  ]
}
{% endschema %}
