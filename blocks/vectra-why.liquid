{% capture nested_cards %}
  {% content_for 'blocks' %}
{% endcapture %}
{% render 'vectra-home-modules', module: 'why', block: block, nested_cards: nested_cards %}

{% schema %}
{
  "name": "VECTRA: Why VECTRA",
  "tag": null,
  "blocks": [
    {
      "type": "_vectra-why-card"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "WHY VECTRA"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "We Serve People With People."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Behind every supplier issue, every audit finding, every new requirement your team is trying to get ahead of, there's a person trying to make it work. Usually more than one.\n\nThat's who we're really talking to. Not a department. Not a system. You.\n\nWe start by listening, not presenting. We sit with the people closest to the problem, learn what's actually getting in the way, and bring in exactly the expertise that moment needs, without ever taking the wheel away from your team.\n\nTechnology helps us move fast. It spots patterns, flags what needs attention, and keeps the evidence honest. But the judgment calls, the hard conversations, and the follow-through when things get complicated? That stays human. That stays with us, working alongside you.\n\nAnd when we hand over a recommendation, we don't disappear. We stay while it becomes real. While your team adapts. While the improvement actually sticks.\n\nYour success is our success. We mean that literally, not as a tagline."
    },
    {
      "type": "header",
      "content": "CEO note"
    },
    {
      "type": "image_picker",
      "id": "ceo_image",
      "label": "CEO photo"
    },
    {
      "type": "checkbox",
      "id": "hide_ceo_note",
      "label": "Hide CEO note",
      "default": false
    },
    {
      "type": "text",
      "id": "ceo_note_kicker",
      "label": "CEO note kicker",
      "default": "A Note From Our CEO"
    },
    {
      "type": "text",
      "id": "ceo_note_label",
      "label": "CEO note label",
      "default": "A note from Patrick Neyts, CEO"
    },
    {
      "type": "textarea",
      "id": "ceo_note_text",
      "label": "CEO note text",
      "default": "I started VECTRA because I watched too many good plans fall apart the moment they left the boardroom. Not because the thinking was wrong, but because nobody stayed close enough to see it through.\n\nThat's still what drives us today. Whatever you're working through, I want you to feel like there's a real person on the other end of this. Because there is.\n\nWelcome to VECTRA."
    },
    {
      "type": "text",
      "id": "bridge_text",
      "label": "Bridge into cards",
      "default": "Here's what that actually looks like:"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "See Why VECTRA"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
