{% capture nested_cards %}
  {% content_for 'blocks' %}
{% endcapture %}
{% render 'vectra-home-modules', module: 'why', block: block, nested_cards: nested_cards %}

{% schema %}
{
  "name": "VECTRA: Why VECTRA",
  "tag": null,
  "blocks": [{ "type": "_vectra-why-card" }],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Side image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "WHY VECTRA" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Why Choose VECTRA as Your<br>Business Resilience Partner" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See Why VECTRA" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    {
      "name": "VECTRA: Why VECTRA",
      "blocks": [
        { "type": "_vectra-why-card", "settings": { "heading": "Partnership With Accountability", "text": "We agree what needs to improve first, then keep the work tied to that outcome as it moves into practice.", "fallback_asset": "vectra-why-icon-partnership.png" } },
        { "type": "_vectra-why-card", "settings": { "heading": "Human-Led.<br>AI-Enabled", "text": "Technology helps us work through large volumes of supplier information, identify patterns behind repeat findings, and keep evidence current. Experienced people remain accountable for judgment, context, and decisions.", "fallback_asset": "vectra-why-icon-ai.png" } },
        { "type": "_vectra-why-card", "settings": { "heading": "Expertise Built Around Your Challenge", "text": "Your problem should not have to fit our org chart. We bring together the specialists and capabilities the work requires.", "fallback_asset": "vectra-why-icon-expertise.png" } },
        { "type": "_vectra-why-card", "settings": { "heading": "Progress You Can Measure", "text": "We agree what improvement should look like at the start, then track what changed and what still needs attention.", "fallback_asset": "vectra-why-icon-progress.png" } }
      ]
    }
  ]
}
{% endschema %}
