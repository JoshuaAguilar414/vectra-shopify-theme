{% liquid
  assign mega_menu = linklists['vectra-website-mega-menu']
  if mega_menu == blank or mega_menu.links.size == 0
    assign mega_menu = block.settings.menu
  endif
  if mega_menu == blank or mega_menu.links.size == 0
    assign mega_menu = section.settings.menu
  endif
%}
{% render 'vectra-header', menu: mega_menu, block: block %}

{% stylesheet %}
  .vh-header .vh-util {
    z-index: 40;
  }

  .vh-header .vh-nav {
    z-index: 1;
  }

  .vh-header .vh-mega,
  .vh-header .vh-menu__item.has-children .vh-mega,
  .vh-header .vh-menu__item.has-children:last-child .vh-mega {
    left: 50% !important;
    right: auto !important;
    transform: translateX(-50%) !important;
    translate: none !important;
    background: rgba(255, 255, 255, 0.45) !important;
    background-color: rgba(255, 255, 255, 0.45) !important;
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border: 1px solid rgba(255, 255, 255, 0.55) !important;
    z-index: 60 !important;
  }

  .vh-header dropdown-localization-component .localization-wrapper,
  .vh-header .localization-wrapper,
  .vh-header .color-custom-popover,
  .vh-header .vh-locale__panel,
  .vh-header .vh-account__menu {
    --color-background: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.45) !important;
    background-color: rgba(255, 255, 255, 0.45) !important;
    backdrop-filter: blur(20px) saturate(1.2) !important;
    -webkit-backdrop-filter: blur(20px) saturate(1.2) !important;
    border: 1px solid rgba(255, 255, 255, 0.55) !important;
    color: #fff !important;
    z-index: 80 !important;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22) !important;
  }

  .vh-header dropdown-localization-component .localization-wrapper,
  .vh-header .vh-locale__panel {
    position: absolute !important;
    top: calc(100% + 8px) !important;
    right: 0 !important;
    left: auto !important;
  }

  .vh-header dropdown-localization-component .localization-form__list-item .country,
  .vh-header dropdown-localization-component .language-selector__label,
  .vh-header .vh-account__hi,
  .vh-header .vh-account__chip {
    color: #fff !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "VECTRA: Header",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "MEGA Navigation",
      "info": "Select VECTRA Website Mega Menu. Nested items under Our DNA, How We Help, and Resources appear as dropdowns."
    }
  ],
  "presets": [{ "name": "VECTRA: Header" }]
}
{% endschema %}
