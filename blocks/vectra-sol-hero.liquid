{% render 'vectra-solutions-modules', module: 'hero', block: block %}

{% schema %}
{
  "name": "VECTRA: Sol hero",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "watermark", "label": "Watermark" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request a Quote" }
