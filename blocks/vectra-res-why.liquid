{% unless block.settings.hide_section %}
<section
  class="vres-panel vres-panel--why"
  style="{% render 'vectra-block-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <div class="vh-wrap">
    {% if block.settings.kicker != blank %}
      <p class="vh-kicker">{{ block.settings.kicker }}</p>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h2 class="vh-h2">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.text != blank %}
      <div class="vh-lead">{{ block.settings.text }}</div>
    {% endif %}
    {% if block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: 1600
        | image_tag: class: 'vres-panel__image', loading: 'lazy', alt: block.settings.image_alt | default: ''
      }}
    {% endif %}
    {% if block.settings.button_label != blank %}
      <a class="vh-btn vh-btn--green" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>
    {% endif %}
  </div>
</section>
{% endunless %}

{% schema %}
{
  "name": "VECTRA: Res why",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Optional resources section. Add it to the Resources page if you want a ‘why this library’ band."
    },
    { "type": "checkbox", "id": "hide_section", "label": "Hide this section", "default": false },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why VECTRA Resources" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Built for decisions, not just reading lists" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Each piece is meant to help you work out what matters for your organization, what it means in practice, and where attention needs to go next." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [{ "name": "VECTRA: Res why" }]
}
{% endschema %}
