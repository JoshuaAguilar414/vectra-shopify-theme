{% render 'vectra-contact-modules', module: 'hero', block: block %}

{% schema %}
{
  "name": "VECTRA: Contact hero",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "watermark", "label": "Watermark" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Contact VECTRA International" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring Us the Problem." },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "VECTRA: Contact hero" }]
}
{% endschema %}
