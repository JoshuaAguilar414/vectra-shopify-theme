{% render 'vectra-assets' %}
{% liquid
  assign img_side = 'vectra-8ee652fcc300949bf9c1387dbcc9e04238d48321.svg' | asset_url
  assign img_search = 'vectra-ddefc620c4f82140acfa9b8253e156e88360289b.svg' | asset_url
%}
{% capture nested_sidebar %}
  {% content_for 'blocks' %}
{% endcapture %}
<section class="vres-feed" {{ block.shopify_attributes }}>
  <div class="vres-feed__layout">
    <div class="vres-feed__main">
      {% render 'vectra-resources-modules', module: 'feed', block: block %}
    </div>
    <aside class="vres-side" aria-label="Resource filters">
      <img class="vres-side__panel" src="{{ img_side }}" alt="" width="420" height="1228">
      <div class="vres-side__inner">
        <label class="vres-search">
          <span class="visually-hidden">Search resources</span>
          <input type="search" placeholder="Search Keyword" data-vres-search autocomplete="off">
          <img src="{{ img_search }}" alt="" width="20" height="20">
        </label>
        {{ nested_sidebar }}
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "VECTRA: Res feed",
  "tag": null,
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "text", "id": "insights_heading", "label": "Insights heading", "default": "Insights" },
    { "type": "text", "id": "feature_heading", "label": "Featured heading" },
    { "type": "image_picker", "id": "feature_image", "label": "Featured image" },
    { "type": "richtext", "id": "feature_text", "label": "Featured text" },
    { "type": "text", "id": "events_heading", "label": "Events heading", "default": "Events & webinars" },
    { "type": "text", "id": "events_title", "label": "Events title" },
    { "type": "image_picker", "id": "events_image", "label": "Events image" },
    { "type": "richtext", "id": "events_text", "label": "Events text" },
    { "type": "text", "id": "follow_heading", "label": "Follow-on heading" },
    { "type": "richtext", "id": "follow_text", "label": "Follow-on text" }
  ],
  "presets": [
    {
      "name": "VECTRA: Res feed",
      "blocks": [
        { "type": "vectra-recent-posts" },
        { "type": "vectra-tags" },
        { "type": "vectra-instagram" }
      ]
    }
  ]
}
{% endschema %}
