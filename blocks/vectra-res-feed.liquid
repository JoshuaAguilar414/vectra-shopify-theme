{% render 'vectra-resources-modules', module: 'feed', block: block %}

{% schema %}
{
  "name": "VECTRA: Res insights",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "insights_heading",
      "label": "Section heading",
      "default": "INSIGHTS"
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "Featured heading",
      "default": "Featured Insights"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search by topic, regulation, risk, or keyword"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View All Insights"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "VECTRA: Res insights"
    }
  ]
}
{% endschema %}
