{% capture nested_items %}
  {% content_for 'blocks' %}
{% endcapture %}
{% render 'vectra-home-modules', module: 'faq', block: block, nested_items: nested_items %}

{% schema %}
{
  "name": "VECTRA: FAQ",
  "tag": null,
  "blocks": [
    {
      "type": "_vectra-faq-item"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "card_title",
      "label": "Side card title",
      "default": "Bring Us the Problem That Keeps Coming Back"
    },
    {
      "type": "textarea",
      "id": "card_text",
      "label": "Side card text"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Our FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions Business Leaders Ask Us"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Side card button",
      "default": "More questions?"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Side card button link"
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        },
        {
          "value": "1.25rem",
          "label": "20px"
        },
        {
          "value": "1.5rem",
          "label": "24px"
        },
        {
