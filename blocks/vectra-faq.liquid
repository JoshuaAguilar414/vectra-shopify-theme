{% comment %}
  Homepage FAQ final copy lives in vectra-home-modules (module: faq).
{% endcomment %}
{% capture nested_items %}
  {% content_for 'blocks' %}
{% endcapture %}
{% render 'vectra-home-modules', module: 'faq', block: block, nested_items: nested_items %}

{% schema %}
{
  "name": "VECTRA: FAQ",
  "tag": null,
  "blocks": [
    {
      "type": "_vectra-faq-item"
    },
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "card_kicker",
      "label": "Side card kicker",
      "default": "TALK TO US"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Side card title",
      "default": "Tell Us What You Need Help With"
    },
    {
      "type": "textarea",
      "id": "card_text",
      "label": "Side card text",
      "default": "You may already know exactly what needs to change. Or you may simply know that something needs to work better.\n\nA supplier issue may be slowing progress. A new requirement may be creating uncertainty. Your team may need stronger evidence, better controls, or more support.\n\nTell us what is happening and what you are trying to improve. We'll listen, help make sense of the situation, and connect you with the right people."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions Business Leaders Ask Us"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Clear answers about what VECTRA does, how we work, and where to start."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Side card button",
      "default": "Talk to a VECTRA Expert"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Side card button link"
    },
    {
      "type": "text",
      "id": "more_heading",
      "label": "More questions heading",
      "default": "Have another question?"
    },
    {
      "type": "textarea",
      "id": "more_text",
      "label": "More questions text",
      "default": "Find more answers about VECTRA International, how we work, our capabilities, and getting started."
    },
    {
      "type": "text",
      "id": "more_button_label",
      "label": "More questions button",
      "default": "View All FAQs"
    },
    {
      "type": "url",
      "id": "more_button_link",
      "label": "More questions button link"
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" },
        { "value": "1.25rem", "label": "20px" },
        { "value": "1.5rem", "label": "24px" },
        { "value": "2rem", "label": "32px" },
        { "value": "2.5rem", "label": "40px" },
        { "value": "3rem", "label": "48px" },
        { "value": "4rem", "label": "64px" },
        { "value": "4.5rem", "label": "72px" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Body text size",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" },
        { "value": "1.25rem", "label": "20px" },
        { "value": "1.5rem", "label": "24px" },
        { "value": "2rem", "label": "32px" },
        { "value": "2.5rem", "label": "40px" },
        { "value": "3rem", "label": "48px" },
        { "value": "4rem", "label": "64px" },
        { "value": "4.5rem", "label": "72px" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Heading weight",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line height",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "normal", "label": "Normal" },
        { "value": "loose", "label": "Loose" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "tight", "label": "Tight" },
        { "value": "normal", "label": "Normal" },
        { "value": "loose", "label": "Loose" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Border",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border thickness",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Item spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the design default gap between cards/items."
    }
  ],
  "presets": [
    {
      "name": "VECTRA: FAQ",
      "blocks": [
        {
          "type": "_vectra-faq-item",
          "settings": {
            "open": true,
            "question": "What does VECTRA help organizations improve?",
            "answer": "VECTRA helps organizations strengthen responsible business, operational resilience, supply chain resilience, and day to day business performance. Depending on the challenge, our support may include responsible business transformation, ESG consulting, sustainability consulting, supply chain consulting, technology, capability building, or implementation support. We start with the result that needs to improve, then bring the relevant expertise and support around it. Not the other way around."
          }
        },
        {
          "type": "_vectra-faq-item",
          "settings": {
            "question": "We already have consultants, platforms, and dashboards. Where does VECTRA fit?",
            "answer": "We work with what you already have. When the information, expertise, or system is already there, we focus on what's stopping it from producing the result you need. That may be ownership, process, supplier engagement, evidence, capability, or follow-through."
          }
        },
        {
          "type": "_vectra-faq-item",
          "settings": {
            "question": "Can VECTRA work with the systems we already use?",
            "answer": "Yes. VECTRA is platform-agnostic. We work with your existing systems, data, teams, consultants, and partners, then introduce additional technology only where it solves a clear problem."
          }
        },
        {
          "type": "_vectra-faq-item",
          "settings": {
            "question": "Where do we start if we know the problem but not the solution?",
            "answer": "Start by telling us what's happening and what you want to improve. We'll help clarify the issue, identify what needs attention first, and figure out the most practical next step, together."
          }
        },
        {
          "type": "_vectra-faq-item",
          "settings": {
            "question": "How does VECTRA measure progress?",
            "answer": "We agree at the start on what success should look like. Depending on the challenge, that may include clearer ownership, closed actions, stronger evidence, improved capability, fewer recurring problems, or better supplier performance."
          }
        }
      ],
      "settings": {
        "kicker": "FAQ",
        "heading": "Questions Business Leaders Ask Us",
        "lead": "Clear answers about what VECTRA does, how we work, and where to start.",
        "more_heading": "Have another question?",
        "more_text": "Find more answers about VECTRA International, how we work, our capabilities, and getting started.",
        "more_button_label": "View All FAQs"
      }
    }
  ]
}
{% endschema %}
