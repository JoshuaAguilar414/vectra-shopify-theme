          "label": "40px"
        },
        {
          "value": "3rem",
          "label": "48px"
        },
        {
          "value": "4rem",
          "label": "64px"
        },
        {
          "value": "4.5rem",
          "label": "72px"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Body text size",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        },
        {
          "value": "1.25rem",
          "label": "20px"
        },
        {
          "value": "1.5rem",
          "label": "24px"
        },
        {
          "value": "2rem",
          "label": "32px"
        },
        {
          "value": "2.5rem",
          "label": "40px"
        },
        {
          "value": "3rem",
          "label": "48px"
        },
        {
          "value": "4rem",
          "label": "64px"
        },
        {
          "value": "4.5rem",
          "label": "72px"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Heading weight",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line height",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "loose",
          "label": "Loose"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "tight",
          "label": "Tight"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "loose",
          "label": "Loose"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Text case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Border",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border thickness",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Item spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the design default gap between cards/items."
    }
  ],
  "presets": [
    {
      "name": "VECTRA: Case studies",
      "blocks": [
        {
          "type": "_vectra-case-card",
          "settings": {
            "name": "OTTO Group",
            "location": "Hamburg, Germany",
            "quote": "“Working together transformed our ESG compliance framework. The team simplified complex EU CSRD reporting into a clear roadmap, cutting our data collection timeline by 40% and delivering our annual sustainability report six weeks ahead of schedule.”",
            "fallback_asset": "vectra-f9891ea3bc104013ef4392a154f93dad123a8da6.png"
          }
        },
        {
          "type": "_vectra-case-card",
          "settings": {
            "name": "CRH",
            "location": "Hamburg, Germany",
            "quote": "\"An essential partner for our climate tech scale-up. They optimized our carbon accounting infrastructure to handle rapid user growth while maintaining 100% compliance during intensive third-party client audits.\"",
            "fallback_asset": "vectra-28a1d7e111c00e8a7fc45b900983e7447e9874e4.png"
          }
        },
        {
          "type": "_vectra-case-card",
          "settings": {
            "name": "Kodak",
            "location": "Hamburg, Germany",
            "quote": "\"Finding partners who truly understand Scope 3 emissions tracing is rare. They brought deep domain expertise and seamless execution, enabling us to verify and onboard over 150 sustainable suppliers in under six months.\"",
            "fallback_asset": "vectra-c581678ac8eabd45e9273d17ceb6fa657d364dc9.png"
          }
        }
      ]
    }
  ]
}
{% endschema %}
