{% render 'vectra-recent-posts', block: block %}

{% schema %}
{
  "name": "VECTRA: Recent posts",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recent post"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Posts to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "url",
      "id": "fallback_link",
      "label": "Placeholder link",
      "info": "Used when the selected blog has no articles yet."
    }
  ],
  "presets": [{ "name": "VECTRA: Recent posts" }]
}
{% endschema %}
