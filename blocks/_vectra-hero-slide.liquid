{%- doc -%}
  Homepage hero slide — Section 2 final copy.
  Order is fixed (never reorders on scroll/animation):
  1) Small visible H1
  2) Large display text
  3) Body paragraphs
  4) CTAs
  5) AEO supporting copy
{%- enddoc -%}

{% capture hero_h1_v2 %}Business Resilience Partner for Responsible Business & Operational Resilience{% endcapture %}
{% capture hero_display_v2 %}Your Success Is Our Success.{% endcapture %}
{% capture hero_body_v2 %}There's a version of your week that doesn't include the same problem showing up again. Where a supplier issue gets fixed and actually stays fixed. Where the requirement everyone's been worried about becomes something your team can just handle. Where you're not the only person holding it all together.

That's the work we do together.

Whatever brought you here today, you don't have to carry it alone. Our people sit down with your people, learn what's really going on, bring in exactly the expertise the moment calls for, and stay until the next step is something you can actually see happening, not just something written in a report.

We're not here to hand you a deliverable and disappear. We're here because your success is genuinely, personally, ours too.{% endcapture %}
{% capture hero_aeo_v2 %}Responsible business means managing supplier risk, environmental and social impact, and regulatory responsibility in ways that protect people, performance, and long-term value. VECTRA helps organizations turn those responsibilities into clear ownership, practical action, stronger operational resilience, and measurable improvement across teams, suppliers, and systems.{% endcapture %}

{% liquid
  assign hero_h1 = block.settings.heading | strip_html | strip
  assign hero_display = block.settings.subheading | strip_html | strip
  assign hero_body = block.settings.text | strip
  assign hero_aeo = block.settings.aeo_text | strip
  assign hero_btn = block.settings.button_label | strip
  assign hero_btn2 = block.settings.button_2_label | strip

  if hero_h1 == blank or hero_h1 contains 'Turn Business Complexity' or hero_display contains 'Turn Business Complexity'
    assign hero_h1 = hero_h1_v2
  endif
  if hero_display == blank or hero_display contains 'Turn Business Complexity' or hero_display contains 'Operational Capability Building'
    assign hero_display = hero_display_v2
  endif
  if hero_body == blank or hero_body contains 'Turn Business Complexity' or hero_body contains 'clear ownership, practical action, and measurable performance' or hero_body contains 'From strategy through implementation'
    assign hero_body = hero_body_v2
  endif
  if hero_aeo == blank
    assign hero_aeo = hero_aeo_v2
  endif
  if hero_btn == blank
    assign hero_btn = 'Explore How We Help'
  endif
  if hero_btn2 == blank
    assign hero_btn2 = 'Talk to an Expert'
  endif

  if block.settings.button_link != blank
    assign hero_btn_href = block.settings.button_link
  else
    assign hero_btn_href = '#solutions'
  endif
  if block.settings.button_2_link != blank
    assign hero_btn2_href = block.settings.button_2_link
  else
    assign hero_btn2_href = '#VectraContactModal'
  endif
%}

<article
  class="vh-hero__slide{% if block.settings.is_active %} is-active{% endif %} vh-hero__slide--align-{{ block.settings.text_align | default: 'left' }}"
  data-vh-slide
  style="{% render 'vectra-block-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.toggle_overlay or block.settings.overlay_opacity != blank %}
    <span
      class="vh-hero__overlay{% if block.settings.overlay_style == 'gradient' %} vh-hero__overlay--gradient vh-hero__overlay--{{ block.settings.gradient_direction | default: 'to-bottom' }}{% endif %}"
      aria-hidden="true"
    ></span>
  {% endif %}
  {% if block.settings.video != blank %}
    {{
      block.settings.video
      | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        controls: false,
        image_size: '1920x',
        class: 'vh-hero__media vh-hero__media--desktop'
    }}
  {% else %}
    {% render 'vectra-image',
      image: block.settings.image,
      fallback: block.settings.fallback_asset | default: 'vectra-e5f2730422a9a0516df81d548f5c3f4383f99969.png',
      alt: block.settings.alt | default: 'VECTRA team collaborating',
      class: 'vh-hero__media vh-hero__media--desktop',
      width: 1920,
      height: 1080,
      loading: 'eager',
      fetchpriority: 'high',
      image_width: 2400
    %}
  {% endif %}
  {% if block.settings.image_mobile != blank %}
    {{
      block.settings.image_mobile
      | image_url: width: 1200
      | image_tag:
        class: 'vh-hero__media vh-hero__media--mobile',
        loading: 'eager',
        alt: block.settings.alt,
        width: 750,
        height: 1100
    }}
  {% endif %}
  <div class="vh-hero__copy" {% if block.settings.content_max_width != blank and block.settings.content_max_width > 0 %}style="max-width: {{ block.settings.content_max_width }}px;"{% endif %}>
    <h1 class="vh-hero__h1">{{ hero_h1 }}</h1>
    <p class="vh-hero__display">{{ hero_display }}</p>
    <div class="vh-hero__body">
      {% assign hero_paras = hero_body | newline_to_br | split: '<br />' %}
      {% for para in hero_paras %}
        {% assign para_text = para | strip_html | strip %}
        {% if para_text != blank %}
          <p>{{ para_text }}</p>
        {% endif %}
      {% endfor %}
    </div>
    <div class="vh-hero__actions">
      <a
        class="vh-btn vh-btn--{{ block.settings.button_style | default: 'green' }}"
        href="{{ hero_btn_href }}"
        {% if hero_btn_href == '#VectraContactModal' %}data-vh-contact-open{% endif %}
      >
        {{ hero_btn }}
      </a>
      <a
        class="vh-btn vh-btn--{{ block.settings.button_2_style | default: 'outline-light' }}"
        href="{{ hero_btn2_href }}"
        {% if hero_btn2_href == blank or hero_btn2_href == '#VectraContactModal' %}data-vh-contact-open{% endif %}
      >
        {{ hero_btn2 }}
      </a>
    </div>
    <p class="vh-hero__aeo">{{ hero_aeo }}</p>
  </div>
</article>

{% schema %}
{
