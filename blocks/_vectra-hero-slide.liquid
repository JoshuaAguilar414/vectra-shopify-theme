<article
  class="vh-hero__slide{% if block.settings.is_active %} is-active{% endif %} vh-hero__slide--align-{{ block.settings.text_align | default: 'left' }}"
  data-vh-slide
  style="{% render 'vectra-block-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.toggle_overlay or block.settings.overlay_opacity != blank %}
    <span
      class="vh-hero__overlay{% if block.settings.overlay_style == 'gradient' %} vh-hero__overlay--gradient vh-hero__overlay--{{ block.settings.gradient_direction | default: 'to-bottom' }}{% endif %}"
      aria-hidden="true"
    ></span>
  {% endif %}
  {% if block.settings.video != blank %}
    {{
      block.settings.video
      | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        controls: false,
        image_size: '1920x',
        class: 'vh-hero__media vh-hero__media--desktop'
    }}
  {% else %}
    {% render 'vectra-image',
      image: block.settings.image,
      fallback: block.settings.fallback_asset,
      alt: block.settings.alt,
      class: 'vh-hero__media vh-hero__media--desktop',
      width: 1920,
      height: 1080,
      loading: 'eager',
      fetchpriority: 'high',
      image_width: 2400
    %}
  {% endif %}
  {% if block.settings.image_mobile != blank %}
    {{
      block.settings.image_mobile
      | image_url: width: 1200
      | image_tag:
        class: 'vh-hero__media vh-hero__media--mobile',
        loading: 'eager',
        alt: block.settings.alt,
        width: 750,
        height: 1100
    }}
  {% endif %}
  <div class="vh-hero__copy" {% if block.settings.content_max_width != blank and block.settings.content_max_width > 0 %}style="max-width: {{ block.settings.content_max_width }}px;"{% endif %}>
    {% if block.settings.heading != blank %}
      <h1 data-vh-hero-el>{{ block.settings.heading }}</h1>
    {% endif %}
    {% if block.settings.subheading != blank %}
      <p class="vh-hero__display" data-vh-hero-el>{{ block.settings.subheading }}</p>
    {% endif %}
    {% if block.settings.text != blank %}
      <p data-vh-hero-el>{{ block.settings.text }}</p>
    {% endif %}
    {% if block.settings.button_label != blank or block.settings.button_2_label != blank %}
      <div class="vh-hero__actions" data-vh-hero-el>
        {% if block.settings.button_label != blank %}
          <a
            class="vh-btn vh-btn--{{ block.settings.button_style | default: 'green' }}"
            href="{{ block.settings.button_link | default: '#VectraContactModal' }}"
            {% if block.settings.button_link == blank or block.settings.button_link == '#VectraContactModal' %}
              data-vh-contact-open
            {% endif %}
            {% if block.settings.open_in_new_tab and block.settings.button_link != blank %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}
          >
            {{ block.settings.button_label }}
          </a>
        {% endif %}
        {% if block.settings.button_2_label != blank %}
          <a
            class="vh-btn vh-btn--{{ block.settings.button_2_style | default: 'outline-light' }}"
            href="{{ block.settings.button_2_link | default: '#' }}"
            {% if block.settings.open_in_new_tab and block.settings.button_2_link != blank %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}
          >
            {{ block.settings.button_2_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>

