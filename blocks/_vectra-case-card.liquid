<article class="vh-case" data-vh-reveal style="{% render 'vectra-block-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="vh-case__main">
    <div class="vh-case__photo">
      {% render 'vectra-image',
        image: block.settings.image,
        fallback: block.settings.fallback_asset,
        alt: block.settings.name,
        image_width: 400
      %}
    </div>
    <div class="vh-case__caption">
      {% if block.settings.name != blank %}
        <p class="vh-case__name">{{ block.settings.name }}</p>
      {% endif %}
      {% if block.settings.location != blank %}
        <p class="vh-case__loc">{{ block.settings.location }}</p>
      {% endif %}
    </div>
  </div>
  <div class="vh-case__quote">
    <div class="vh-case__stars" aria-label="5 stars">
      <svg width="20" height="19" viewBox="0 0 20 19" aria-hidden="true"><path fill="currentColor" d="M10 0l2.47 6.28H19.4l-5.44 3.88 2.08 6.4L10 12.68 3.96 16.56l2.08-6.4L.6 6.28h6.93z"/></svg>
      <svg width="20" height="19" viewBox="0 0 20 19" aria-hidden="true"><path fill="currentColor" d="M10 0l2.47 6.28H19.4l-5.44 3.88 2.08 6.4L10 12.68 3.96 16.56l2.08-6.4L.6 6.28h6.93z"/></svg>
      <svg width="20" height="19" viewBox="0 0 20 19" aria-hidden="true"><path fill="currentColor" d="M10 0l2.47 6.28H19.4l-5.44 3.88 2.08 6.4L10 12.68 3.96 16.56l2.08-6.4L.6 6.28h6.93z"/></svg>
      <svg width="20" height="19" viewBox="0 0 20 19" aria-hidden="true"><path fill="currentColor" d="M10 0l2.47 6.28H19.4l-5.44 3.88 2.08 6.4L10 12.68 3.96 16.56l2.08-6.4L.6 6.28h6.93z"/></svg>
      <svg width="20" height="19" viewBox="0 0 20 19" aria-hidden="true"><path fill="currentColor" d="M10 0l2.47 6.28H19.4l-5.44 3.88 2.08 6.4L10 12.68 3.96 16.56l2.08-6.4L.6 6.28h6.93z"/></svg>
    </div>
    {% if block.settings.quote != blank %}
      <blockquote>{{ block.settings.quote }}</blockquote>
    {% endif %}
    {% if block.settings.link_label != blank and block.settings.link != blank %}
      <a
        class="vh-case__link"
        href="{{ block.settings.link }}"
        {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
      >
        {{ block.settings.link_label }}
      </a>
    {% endif %}
  </div>
</article>

{% schema %}
{
  "name": "Case study",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Logo / photo"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in a new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "fallback_asset",
      "label": "Theme fallback image",
      "info": "Filename in the theme assets folder. Used until you upload an image."
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Border",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border thickness",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "visible_if": "{{ block.settings.border != 'none' }}"
    }
  ]
}
{% endschema %}
