{% comment %}
  Nested hero slides are captured but not rendered — homepage uses a single static banner.
{% endcomment %}
{% capture nested_slides %}
  {% content_for 'blocks' %}
{% endcapture %}
{% render 'vectra-home-modules', module: 'hero', block: block %}

{% schema %}
{
  "name": "VECTRA: Hero banner",
  "tag": null,
  "blocks": [
    {
      "type": "_vectra-hero-slide"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Homepage hero uses one static centered banner. Nested slides are not shown right now."
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "VECTRA: Hero banner"
    }
  ]
}
{% endschema %}
