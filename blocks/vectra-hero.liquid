{% capture nested_slides %}
  {% content_for 'blocks' %}
{% endcapture %}
{% render 'vectra-home-modules', module: 'hero', block: block, nested_slides: nested_slides %}

{% schema %}
{
  "name": "VECTRA: Hero banner",
  "tag": null,
  "blocks": [
    {
      "type": "_vectra-hero-slide"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Add, remove, or reorder slides. Each slide supports image/video, overlay, alignment, and buttons — similar to Horizon slides."
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "VECTRA: Hero banner",
      "blocks": [
        {
          "type": "_vectra-hero-slide",
          "settings": {
            "is_active": true,
            "alt": "VECTRA team collaborating",
            "heading": "Business Resilience Partner for Responsible Business & Operational Resilience",
            "subheading": "Your Success Is Our Success.",
            "text": "There's a version of your week that doesn't include the same problem showing up again. Where a supplier issue gets fixed and actually stays fixed. Where the requirement everyone's been worried about becomes something your team can just handle. Where you're not the only person holding it all together.\n\nThat's the work we do together.\n\nWhatever brought you here today, you don't have to carry it alone. Our people sit down with your people, learn what's really going on, bring in exactly the expertise the moment calls for, and stay until the next step is something you can actually see happening, not just something written in a report.\n\nWe're not here to hand you a deliverable and disappear. We're here because your success is genuinely, personally, ours too.",
            "aeo_text": "Responsible business means managing supplier risk, environmental and social impact, and regulatory responsibility in ways that protect people, performance, and long-term value. VECTRA helps organizations turn those responsibilities into clear ownership, practical action, stronger operational resilience, and measurable improvement across teams, suppliers, and systems.",
            "button_label": "Explore How We Help",
            "button_2_label": "Talk to an Expert",
            "fallback_asset": "vectra-e5f2730422a9a0516df81d548f5c3f4383f99969.png",
            "overlay_opacity": 20,
            "text_align": "left"
          }
        }
      ]
    }
  ]
}
{% endschema %}
