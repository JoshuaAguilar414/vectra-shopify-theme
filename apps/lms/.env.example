PORT=3456
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vectra_lms

# Shopify app credentials (app proxy HMAC)
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_API_KEY=
SHOPIFY_APP_URL=https://your-lms-app.example.com

# Local/dev without Shopify signature
LMS_DEV_BYPASS=true
# Optional default shop when bypassing
LMS_DEV_SHOP=vectra-dev.myshopify.com

# Cron job secret for POST /jobs/reminders
CRON_SECRET=change-me

# Public storefront / login links used in emails
APP_URL=http://localhost:3456
STOREFRONT_URL=https://your-store.myshopify.com

# Reminder cadence (days after assignment with NOT_STARTED)
REMINDER_DAYS=3

# Mail (optional — invitations/reminders skip or fail soft if unset)
MAIL_FROM="VECTRA Academy <noreply@example.com>"
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SCORM storage (local by default; set R2_* for Cloudflare R2)
COURSE_STORAGE_DIR=./storage/courses
MAX_SCORM_UPLOAD_MB=500
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PREFIX=courses

# Branding
LMS_TENANT=vectra
LMS_PRODUCT_NAME=VECTRA Academy

# Optional: Shopify Admin API for customer tag checks
SHOPIFY_ADMIN_ACCESS_TOKEN=
